---
import BaseLayout from '../layouts/BaseLayout.astro';
import CarrierBillingTable from '../components/CarrierBillingTable.astro';
import {
  PERSONAL_BILLING_CARRIERS,
  COMMERCIAL_BILLING_CARRIERS,
} from '../data/billingCarriers';

const payBillStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Pay Your Insurance Bill Online",
  "description": "Make secure online premium payments directly to your insurance company. Direct billing phone numbers and online payment portals for all Associated Insurance Agency personal and commercial carrier partners in Connecticut.",
  "publisher": {
    "@type": "InsuranceAgency",
    "name": "Associated Insurance Agency",
    "telephone": "+1-203-748-9272",
    "url": "https://aia-danbury.com"
  }
};
---

<BaseLayout
  title="Pay Your Bill Online | Associated Insurance Agency CT"
  description="Pay your insurance premium directly and securely with your carrier. Direct billing phone numbers and online payment portals for all AIA Connecticut personal and commercial carriers."
  structuredData={payBillStructuredData}
  lang="en"
>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-16 sm:py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/5 border border-accent/10 text-accent text-xs font-semibold uppercase tracking-wider">
        <span class="w-1.5 h-1.5 rounded-full bg-accent-gold"></span>
        Direct Carrier Payment Directory
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-accent leading-none">
        Pay Your Bill Online
      </h1>
      <p class="text-sm sm:text-base text-text-secondary max-w-[65ch] leading-relaxed">
        Make your premium payments quickly and securely directly with your insurance carrier. Select your carrier below to pay online or call their dedicated billing phone support.
      </p>

      <!-- Quick Category Jump Chips -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href="#personal-carriers"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold bg-white border border-border-subtle hover:border-accent-gold hover:text-accent shadow-xs transition-all"
        >
          <span>Personal Lines Carriers ({PERSONAL_BILLING_CARRIERS.length})</span>
          <span class="text-accent-gold">↓</span>
        </a>
        <a
          href="#commercial-carriers"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold bg-white border border-border-subtle hover:border-accent-gold hover:text-accent shadow-xs transition-all"
        >
          <span>Commercial Lines Carriers ({COMMERCIAL_BILLING_CARRIERS.length})</span>
          <span class="text-accent-gold">↓</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Main Directory Section -->
  <section class="py-16 sm:py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Advisory Alert Banner & Security Notice -->
      <div class="p-6 bg-bg-secondary border border-border-subtle rounded-xl text-left space-y-2 shadow-xs">
        <h3 class="text-xs font-bold uppercase tracking-wider text-accent flex items-center gap-2">
          <svg class="w-4 h-4 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 111.063.852l-.708 2.836a.75.75 0 001.063.852l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
          </svg>
          Direct Carrier Billing Notice
        </h3>
        <p class="text-xs text-text-secondary leading-relaxed">
          The phone numbers and payment links listed below belong directly to their respective insurance carriers, not Associated Insurance Agency. These links will take you to external, secure payment portals operated by each company. Associated Insurance Agency will never solicit payments via unverified wire transfers, gift cards, or mobile peer-to-peer payment apps. If you need policy or payment assistance, contact our licensed agents directly.
        </p>
      </div>

      <!-- 1. Personal Lines Carriers -->
      <CarrierBillingTable
        id="personal-carriers"
        carriers={PERSONAL_BILLING_CARRIERS}
        sectionTitle="Personal Lines Carriers"
        sectionSubtitle="Direct payment portals and phone support for Homeowners, Personal Auto, Umbrella, and Renters insurance policies."
        badgeText="Personal Lines • Home & Auto"
        carrierColHeader="Insurance Carrier"
        phoneColHeader="Phone Support"
        payColHeader="Online Bill Pay"
        payButtonText="Pay Online"
        loginButtonText="Login to Pay"
      />

      <!-- 2. Commercial Lines Carriers -->
      <CarrierBillingTable
        id="commercial-carriers"
        carriers={COMMERCIAL_BILLING_CARRIERS}
        sectionTitle="Commercial Lines Carriers"
        sectionSubtitle="Direct payment portals and dedicated billing lines for General Liability, Commercial Auto, Workers' Compensation, and Business Owner packages."
        badgeText="Commercial Lines • Business & Fleet"
        carrierColHeader="Insurance Carrier"
        phoneColHeader="Phone Support"
        payColHeader="Online Bill Pay"
        payButtonText="Pay Online"
        loginButtonText="Login to Pay"
      />

      <!-- Office Assistance Card -->
      <div class="rounded-2xl bg-gradient-to-br from-bg-secondary via-white to-bg-secondary p-8 border border-border-subtle shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-2 max-w-2xl">
          <h3 class="text-lg font-bold text-accent">Need Help With Your Bill or Policy?</h3>
          <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
            If your carrier is not listed above, or if your policy is pending cancellation, contact our local offices immediately. Our licensed multilingual team is ready to assist you.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href="tel:2037489272"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-xs font-bold uppercase tracking-wider text-white bg-accent hover:bg-accent/90 shadow-sm transition-all"
          >
            <svg class="w-3.5 h-3.5 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.942-6.942l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <span>Danbury: (203) 748-9272</span>
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-lg text-xs font-semibold text-accent bg-white border border-border-subtle hover:border-accent-gold transition-colors"
          >
            <span>All Office Locations &rarr;</span>
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
