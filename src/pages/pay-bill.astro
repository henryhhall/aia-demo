---
import BaseLayout from '../layouts/BaseLayout.astro';

const billingCarriers = [
  { name: "Safeco", phone: "1-800-332-3226", payLinks: [{ url: "https://customer.safeco.com/accountservices/login.aspx", text: "Online Payments" }] },
  { name: "Met Life", phone: "1-800-638-5433", payLinks: [{ url: "https://www.metlife.com/individual/index.html?WT.ac=GN_individual", text: "Individuals" }, { url: "https://www.metlife.com/business/index.html?WT.ac=GN_business", text: "Business" }] },
  { name: "The Hartford", phone: "1-877-896-9320", payLinks: [{ url: "https://service.thehartford.com/consumer/public/service/login", text: "Online Payments" }] },
  { name: "Progressive", phone: "General: 1-800-776-4737\nCommercial: 1-888-240-9839", payLinks: [{ url: "https://onlineservice7.progressive.com/SelfService.Web/SelfService.aspx?Page=Login.AuthenticateUser&QueryStringSetKey=SessionGateway&OfferingID=SelfService&SessionStart=TRUE", text: "Online Payments" }] },
  { name: "Foremost", phone: "Auto: 1-888-888-0080\nOther: 1-800-532-4221", payLinks: [{ url: "http://www.foremost.com/payonline/index.asp", text: "Online Payments" }] },
  { name: "Travelers", phone: "1-800-842-5075", payLinks: [{ url: "https://www.travelers.com/login/#/", text: "Online Payments" }] },
  { name: "Victoria Insurance", phone: "1-800-888-8424", payLinks: [{ url: "https://www.victoriainsurance.com/pay/SearchPayment.do?dispatch=search", text: "Online Payments" }] },
  { name: "Guard Insurance", phone: "N/A", payLinks: [{ url: "https://policyholder.guard.com/scripts/psc/psc.exe/showpage?page=/wwwroot/static/policyholders.htm", text: "Online Payments" }] },
  { name: "Infinity", phone: "1-800-782-1020", payLinks: [{ url: "https://www.infinityauto.com/make-your-payments-go", text: "Online Payments" }] },
  { name: "K & K Insurance", phone: "1-800-637-4757", payLinks: [{ url: "http://www.kandkinsurance.com/Pages/Home.aspx", text: "Online Payments" }] },
  { name: "Utica First Insurance", phone: "1-315-736-8211", payLinks: [{ url: "https://www.uticafirst.com/dirbill.html", text: "Online Payments" }] }
];

const payBillStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Pay Your Bill",
  "description": "Make secure online premium payments directly to your insurance company. Phone numbers and online portals for Associated Insurance Agency partners in CT."
};
---

<BaseLayout
  title="Pay Your Bill Online | Associated Insurance Agency CT"
  description="Pay your insurance premium directly and securely with your carrier. Direct billing phone numbers and online payment portals for all AIA Connecticut carriers."
  structuredData={payBillStructuredData}
>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-accent leading-none">
        Pay Your Bill
      </h1>
      <p class="mt-4 text-sm sm:text-base text-text-secondary max-w-[60ch]">
        Make your premium payments quickly and securely directly with your insurance carrier.
      </p>
    </div>
  </section>

  <!-- Directory Section -->
  <section class="py-24 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <!-- Advisory Alert Banner -->
      <div class="p-6 bg-bg-secondary border border-border-subtle rounded-lg text-left space-y-2">
        <h3 class="text-xs font-bold uppercase tracking-wider text-accent flex items-center gap-1.5">
          <!-- Information Icon -->
          <svg class="w-4 h-4 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 111.063.852l-.708 2.836a.75.75 0 001.063.852l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
          </svg>
          Important Notice
        </h3>
        <p class="text-xs text-text-secondary leading-relaxed">
          The phone numbers and links listed on this page belong to their respective insurance companies, not Associated Insurance Agency. The links will send you to external, secure payment portals which we do not control. If you have any questions or need assistance, feel free to contact our office directly.
        </p>
      </div>

      <!-- Billing Table -->
      <div class="rounded-lg border border-border-subtle bg-white overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="bg-bg-secondary border-b border-border-subtle font-semibold text-accent">
                <th class="px-6 py-4">Insurance Carrier</th>
                <th class="px-6 py-4">Phone Support</th>
                <th class="px-6 py-4 text-right">Online Bill Pay</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border-subtle text-text-secondary text-xs sm:text-sm">
              {billingCarriers.map((carrier) => (
                <tr class="hover:bg-bg-secondary/30 transition-colors">
                  <td class="px-6 py-4 font-semibold text-accent">{carrier.name}</td>
                  <td class="px-6 py-4 font-mono text-xs whitespace-pre-line">{carrier.phone}</td>
                  <td class="px-6 py-4 text-right space-y-1 sm:space-y-0 sm:space-x-3">
                    {carrier.payLinks.map((link, index) => (
                      <>
                        {index > 0 && <span class="hidden sm:inline text-border-subtle">|</span>}
                        <a href={link.url} target="_blank" rel="noopener noreferrer" class="inline-block text-xs font-semibold text-accent-gold hover:underline">
                          {link.text}
                        </a>
                      </>
                    ))}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
