---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CertificateRequestForm from '../../components/CertificateRequestForm';
import { useTranslations } from '../../i18n/utils';

const lang = 'es';
const t = useTranslations(lang);

const certificateStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": "https://aia-danbury.com/es/certificate-request#webpage",
      "name": "Solicitud de Certificado de Seguro (COI) | Associated Insurance Agency",
      "description": "Solicite un Certificado de Seguro oficial ACORD 25 con endosos de asegurado adicional, renuncias de subrogación y emisión el mismo día en Connecticut.",
      "url": "https://aia-danbury.com/es/certificate-request"
    },
    {
      "@type": "Service",
      "@id": "https://aia-danbury.com/es/certificate-request#service",
      "name": "Emisión de Certificados de Seguro ACORD 25",
      "serviceType": "Documentación de Seguro Comercial",
      "provider": {
        "@type": "InsuranceAgency",
        "name": "Associated Insurance Agency",
        "telephone": "+1-203-748-9272",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "50 Newtown Road, Suite 1",
          "addressLocality": "Danbury",
          "addressRegion": "CT",
          "postalCode": "06810"
        }
      },
      "areaServed": [
        { "@type": "State", "name": "Connecticut" },
        { "@type": "City", "name": "Danbury" },
        { "@type": "City", "name": "Watertown" },
        { "@type": "City", "name": "Bridgeport" }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://aia-danbury.com/es/certificate-request#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Con qué rapidez emite Associated Insurance Agency un Certificado de Seguro?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La mayoría de los certificados estándar ACORD 25 se emiten en un plazo de 2 a 4 horas hábiles durante el horario de atención (lunes a viernes de 8:30 AM a 5:00 PM EST). Los certificados urgentes para obras en curso se pueden acelerar llamando a nuestra sede de Danbury al 203-748-9272."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuál es la diferencia entre un Titular del Certificado y un Asegurado Adicional?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El Titular del Certificado es simplemente la entidad a quien se le proporciona la prueba de que usted tiene seguro. El Asegurado Adicional es una entidad que recibe cobertura legal bajo su póliza por reclamos derivados de sus operaciones, exigida mediante un contrato firmado."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  title="Solicitud de Certificado de Seguro (COI) | Associated Insurance Agency CT"
  description="Solicite un Certificado de Seguro oficial ACORD 25 con endosos de asegurado adicional y renuncias de subrogación con agentes en español en Danbury, Watertown y Bridgeport, CT."
  structuredData={certificateStructuredData}
  lang={lang}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-bg-secondary via-bg-primary to-bg-primary py-16 sm:py-20 border-b border-border-subtle overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#122b5f_1px,transparent_1px)] [background-size:24px_24px] opacity-[0.03] pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/5 border border-accent/15 text-accent text-xs font-semibold">
        <span class="w-1.5 h-1.5 rounded-full bg-accent-gold animate-pulse"></span>
        <span>{t('certificate.heroTag')}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-accent leading-[1.15]">
        {t('certificate.title')}
      </h1>

      <p class="text-sm sm:text-base text-text-secondary max-w-[65ch] mx-auto leading-relaxed">
        {t('certificate.subtitle')}
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 pt-3 text-xs font-medium text-text-muted">
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path strokeLinecap="round" strokeLinejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Entrega en 2 a 4 Horas Hábiles</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path strokeLinecap="round" strokeLinejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Formato Estándar Oficial ACORD 25</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path strokeLinecap="round" strokeLinejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Envío Directo por Email y Fax</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path strokeLinecap="round" strokeLinejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Atención Directa en Español</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Form Section -->
  <section class="py-12 sm:py-16 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <!-- Specialized COI Rush Banner -->
      <div class="max-w-4xl mx-auto p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-accent/5 via-accent/10 to-accent-gold/10 border border-accent/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-accent-gold">Emisión Urgente</span>
            <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">Mismo Día</span>
          </div>
          <h2 class="text-sm sm:text-base font-bold text-accent">¿Tiene una Obra o Inspección Hoy?</h2>
          <p class="text-xs text-text-secondary leading-relaxed">
            Adjunte el pliego o contrato de seguros de su cliente para emitir el certificado con los endosos exactos sin retrasos.
          </p>
        </div>
        <a
          href="tel:2037489272"
          class="shrink-0 px-4 py-2.5 rounded-xl bg-accent text-white text-xs font-bold hover:bg-accent/90 transition-all shadow-xs flex items-center gap-2"
        >
          <span>Llamar a Danbury: 203 748 9272</span>
        </a>
      </div>

      <!-- React Island Form with Honeypots & Google reCAPTCHA v3 Defense -->
      <CertificateRequestForm client:load lang={lang} />

      <!-- Educational Guidance & FAQ Section -->
      <div class="max-w-4xl mx-auto pt-12 border-t border-border-subtle space-y-10">
        <div class="text-center space-y-2">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-accent tracking-tight">
            Guía sobre Certificados de Seguro en Connecticut
          </h2>
          <p class="text-sm text-text-secondary max-w-2xl mx-auto">
            Información clave sobre los requisitos de ACORD 25, asegurados adicionales y normas legales de CT.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-6 rounded-2xl border border-border-subtle bg-white shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center font-bold text-base">
              01
            </div>
            <h3 class="text-base font-bold text-accent">¿Qué es un Certificado ACORD 25?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              El ACORD 25 es el formato estándar reconocido en EE.UU. que resume los números de póliza, aseguradoras, fechas de vigencia y límites de Responsabilidad General, Auto Comercial y Compensación de Trabajadores.
            </p>
          </div>

          <div class="p-6 rounded-2xl border border-border-subtle bg-white shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center font-bold text-base">
              02
            </div>
            <h3 class="text-base font-bold text-accent">Endosos de Asegurado Adicional</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Contratistas generales y municipios exigen figurar como Asegurado Adicional (formularios CG 20 10 y CG 20 37) para protegerse contra responsabilidades derivadas de sus trabajos. Se requiere contrato escrito previo.
            </p>
          </div>

          <div class="p-6 rounded-2xl border border-border-subtle bg-white shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center font-bold text-base">
              03
            </div>
            <h3 class="text-base font-bold text-accent">Renuncia de Subrogación</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Prohíbe a la compañía de seguros reclamar legalmente el reembolso al titular del certificado tras indemnizar un siniestro, protegiendo las relaciones comerciales entre subcontratistas y clientes.
            </p>
          </div>

          <div class="p-6 rounded-2xl border border-border-subtle bg-white shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center font-bold text-base">
              04
            </div>
            <h3 class="text-base font-bold text-accent">Primario y No Contributorio</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Cuando el contrato exige redacción "Primaria y No Contributoria", su póliza responderá en primer lugar ante cualquier reclamo cubierto, sin solicitar aporte a la póliza del cliente.
            </p>
          </div>
        </div>

        <!-- Agency Support Contacts -->
        <div class="p-6 sm:p-8 rounded-2xl bg-zinc-950 text-white border border-zinc-800 space-y-6">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-zinc-800 pb-4">
            <div>
              <h3 class="text-lg font-bold text-white">Nuestras Oficinas en Connecticut</h3>
              <p class="text-xs text-zinc-400 mt-0.5">¿Necesita asistencia inmediata con un agente en español?</p>
            </div>
            <span class="px-3 py-1 rounded-full bg-accent-gold/20 text-accent-gold text-xs font-mono font-medium">
              Lun–Vie 8:30 AM – 5:00 PM EST
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs text-zinc-300">
            <div class="space-y-1.5">
              <p class="font-bold text-white text-sm">Sede Danbury (HQ)</p>
              <p>50 Newtown Road, Suite 1</p>
              <p>Danbury, CT 06810</p>
              <p class="pt-1">
                <a href="tel:2037489272" class="text-accent-gold font-bold hover:underline">203 748 9272</a>
              </p>
            </div>

            <div class="space-y-1.5">
              <p class="font-bold text-white text-sm">Sucursal Watertown</p>
              <p>51 Depot St, Suite 112</p>
              <p>Watertown, CT 06795</p>
              <p class="pt-1">
                <a href="tel:8602748888" class="text-accent-gold font-bold hover:underline">860 274 8888</a>
              </p>
            </div>

            <div class="space-y-1.5">
              <p class="font-bold text-white text-sm">Sucursal Bridgeport</p>
              <p>2465 Main Street</p>
              <p>Bridgeport, CT 06606</p>
              <p class="pt-1">
                <a href="tel:2033338880" class="text-accent-gold font-bold hover:underline">203 333 8880</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
