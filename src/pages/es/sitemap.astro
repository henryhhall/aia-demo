---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'es';
const t = useTranslations(lang);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Mapa del Sitio de Associated Insurance Agency",
  "description": "Directorio del mapa del sitio HTML y XML para Associated Insurance Agency. Navegación rápida por páginas de seguros personales, comerciales y sucursales.",
};
---

<BaseLayout
  title="Mapa del Sitio | Associated Insurance Agency CT"
  description="Explore el directorio completo de páginas de Associated Insurance Agency, seguros personales y comerciales, sucursales y mapas de sitio XML."
  structuredData={structuredData}
>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-16 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/5 text-accent text-xs font-semibold mb-2">
        <span class="w-2 h-2 rounded-full bg-accent-gold"></span>
        Directorio y Fuentes de Rastreo
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-accent leading-none">
        {t('sitemap.title')}
      </h1>
      <p class="text-sm sm:text-base text-text-secondary max-w-[65ch] mx-auto leading-relaxed">
        {t('sitemap.subtitle')}
      </p>
    </div>
  </section>

  <!-- Sitemap Categories Grid -->
  <section class="py-16 sm:py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- XML Feeds Banner -->
      <div class="mb-12 p-6 bg-zinc-950 text-white rounded-xl border border-zinc-800 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 shadow-lg">
        <div class="space-y-1.5">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12.75 19.5v-.75a7.5 7.5 0 0 0-7.5-7.5H4.5m0-6.75h.75c7.87 0 14.25 6.38 14.25 14.25v.75M6 18.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
            </svg>
            <h2 class="text-lg font-bold">Fuentes XML para Motores de Búsqueda e IA</h2>
          </div>
          <p class="text-xs text-zinc-400">
            Mapas de sitio XML estructurados y feeds WebMCP para Googlebot, Bingbot y modelos de lenguaje.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3 text-xs">
          <a
            href="/sitemap-index.xml"
            target="_blank"
            class="px-4 py-2 rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-200 hover:text-white font-mono transition-colors"
          >
            /sitemap-index.xml
          </a>
          <a
            href="/sitemap.xml"
            target="_blank"
            class="px-4 py-2 rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-200 hover:text-white font-mono transition-colors"
          >
            /sitemap.xml
          </a>
          <a
            href="/llms.txt"
            target="_blank"
            class="px-4 py-2 rounded bg-accent-gold/20 hover:bg-accent-gold/30 text-accent-gold font-mono transition-colors"
          >
            /llms.txt
          </a>
        </div>
      </div>

      <!-- Categories 3-Column Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

        <!-- Column 1: Core Pages & Offices -->
        <div class="space-y-6">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
            <h3 class="text-base font-bold text-accent border-b border-border-subtle pb-2 flex items-center gap-2">
              <span class="w-1.5 h-4 bg-accent-gold rounded-full"></span>
              Páginas Principales
            </h3>
            <ul class="space-y-2.5 text-sm text-text-secondary">
              <li><a href="/es" class="hover:text-accent font-medium transition-colors">Inicio en Español</a></li>
              <li><a href="/es/about" class="hover:text-accent font-medium transition-colors">Sobre AIA y Equipo</a></li>
              <li><a href="/es/contact" class="hover:text-accent font-medium transition-colors">Contáctenos y Ubicaciones</a></li>
              <li><a href="/es/quote" class="hover:text-accent font-medium transition-colors">Solicitar Cotización Gratis</a></li>
              <li><a href="/es/service" class="hover:text-accent font-medium transition-colors">Centro de Servicio</a></li>
              <li><a href="/es/pay-bill" class="hover:text-accent font-medium transition-colors">Pago de Facturas por Aseguradora</a></li>
              <li><a href="/es/blog" class="hover:text-accent font-medium transition-colors">Artículos e Información</a></li>
              <li><a href="/es/terms" class="hover:text-accent font-medium transition-colors">Términos de Servicio y Avisos</a></li>
              <li><a href="/es/privacy" class="hover:text-accent font-medium transition-colors">Política de Privacidad y GLBA</a></li>
            </ul>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
            <h3 class="text-base font-bold text-accent border-b border-border-subtle pb-2 flex items-center gap-2">
              <span class="w-1.5 h-4 bg-accent-gold rounded-full"></span>
              Oficinas en Connecticut
            </h3>
            <ul class="space-y-2.5 text-sm text-text-secondary">
              <li>
                <a href="/es/contact#danbury" class="hover:text-accent font-medium transition-colors">Sede Central en Danbury</a>
                <span class="block text-xs text-text-muted">50 Newtown Rd, Suite 1 • (203) 748-9272</span>
              </li>
              <li>
                <a href="/es/contact#watertown" class="hover:text-accent font-medium transition-colors">Sucursal Watertown</a>
                <span class="block text-xs text-text-muted">1157 Main St • (860) 274-8888</span>
              </li>
              <li>
                <a href="/es/contact#bridgeport" class="hover:text-accent font-medium transition-colors">Sucursal Bridgeport</a>
                <span class="block text-xs text-text-muted">2465 Main St • (203) 333-8880</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Column 2: Personal & Commercial Solutions -->
        <div class="space-y-6">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
            <h3 class="text-base font-bold text-accent border-b border-border-subtle pb-2 flex items-center gap-2">
              <span class="w-1.5 h-4 bg-accent-gold rounded-full"></span>
              Seguros Personales
            </h3>
            <ul class="space-y-2.5 text-sm text-text-secondary">
              <li><a href="/es/personal" class="hover:text-accent font-medium transition-colors">Resumen de Seguros Personales</a></li>
              <li><a href="/es/personal#home" class="hover:text-accent font-medium transition-colors">Seguro de Propietarios</a></li>
              <li><a href="/es/personal#auto" class="hover:text-accent font-medium transition-colors">Seguro de Autos y RV</a></li>
              <li><a href="/es/personal#renters" class="hover:text-accent font-medium transition-colors">Seguro de Inquilinos</a></li>
              <li><a href="/es/personal#umbrella" class="hover:text-accent font-medium transition-colors">Responsabilidad Paraguas</a></li>
            </ul>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
            <h3 class="text-base font-bold text-accent border-b border-border-subtle pb-2 flex items-center gap-2">
              <span class="w-1.5 h-4 bg-accent-gold rounded-full"></span>
              Seguros Comerciales
            </h3>
            <ul class="space-y-2.5 text-sm text-text-secondary">
              <li><a href="/es/commercial" class="hover:text-accent font-medium transition-colors">Resumen de Seguros Comerciales</a></li>
              <li><a href="/es/commercial#bop" class="hover:text-accent font-medium transition-colors">Póliza para Dueños de Negocio (BOP)</a></li>
              <li><a href="/es/commercial#gl" class="hover:text-accent font-medium transition-colors">Responsabilidad General</a></li>
              <li><a href="/es/commercial#property" class="hover:text-accent font-medium transition-colors">Propiedad Comercial</a></li>
              <li><a href="/es/commercial#wc" class="hover:text-accent font-medium transition-colors">Compensación de Trabajadores</a></li>
            </ul>
          </div>
        </div>

        <!-- Column 3: Multilingual & Guides -->
        <div class="space-y-6">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
            <h3 class="text-base font-bold text-accent border-b border-border-subtle pb-2 flex items-center gap-2">
              <span class="w-1.5 h-4 bg-accent-gold rounded-full"></span>
              Portales Multilingües
            </h3>
            <ul class="space-y-2.5 text-sm text-text-secondary">
              <li>
                <a href="/" class="hover:text-accent font-medium transition-colors">English (Portal en Inglés)</a>
                <span class="block text-xs text-text-muted">/, /about, /quote, /contact, /service</span>
              </li>
              <li>
                <a href="/pt" class="hover:text-accent font-medium transition-colors">Português (Portal en Portugués)</a>
                <span class="block text-xs text-text-muted">/pt, /pt/about, /pt/quote, /pt/contact</span>
              </li>
              <li>
                <a href="/tr" class="hover:text-accent font-medium transition-colors">Türkçe (Portal en Turco)</a>
                <span class="block text-xs text-text-muted">/tr, /tr/about, /tr/quote, /tr/contact</span>
              </li>
            </ul>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
            <h3 class="text-base font-bold text-accent border-b border-border-subtle pb-2 flex items-center gap-2">
              <span class="w-1.5 h-4 bg-accent-gold rounded-full"></span>
              Guías y Consejos
            </h3>
            <ul class="space-y-2.5 text-sm text-text-secondary">
              <li><a href="/es/blog/preventing-ice-dams-on-homes" class="hover:text-accent font-medium transition-colors">Prevención de Represas de Hielo</a></li>
              <li><a href="/es/blog/travel-adventure-6-essential-tips" class="hover:text-accent font-medium transition-colors">Consejos para Seguros de Viaje</a></li>
              <li><a href="/es/blog/wedding-insurance-need" class="hover:text-accent font-medium transition-colors">Seguro para Bodas y Eventos</a></li>
            </ul>
          </div>
        </div>

      </div>

    </div>
  </section>
</BaseLayout>
