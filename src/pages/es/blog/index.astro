---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import BlogArchiveList from '../../../components/BlogArchiveList.astro';

const lang = 'es';
const posts = await getCollection('blog', ({ id, data }) => id.startsWith(`${lang}/`) && !data.draft);
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const blogPageStructuredData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Blog de Associated Insurance Agency",
  "description": "Consejos de seguros, consejos de seguridad en el hogar para el invierno e información sobre responsabilidad de eventos de la agencia independiente de confianza de Connecticut.",
  "url": "https://aia-danbury.com/es/blog",
};
---

<BaseLayout
  title="Blog de Seguros y Perspectivas | Associated Insurance Agency CT"
  description="Manténgase informado con consejos de seguros, listas de verificación de protección de propiedades para el invierno y guías de cobertura para eventos especiales de AIA."
  structuredData={blogPageStructuredData}
>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-accent leading-none">
        Perspectivas y Consejos de AIA
      </h1>
      <p class="mt-4 text-sm sm:text-base text-text-secondary max-w-[60ch]">
        Manténgase actualizado con consejos de seguridad para el invierno, orientación sobre responsabilidad de bodas y listas de verificación para planificación de viajes.
      </p>
    </div>
  </section>

  <!-- Blog List Section with Location Filtering -->
  <section class="py-16 sm:py-20 bg-bg-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <BlogArchiveList posts={sortedPosts} lang="es" />
    </div>
  </section>
</BaseLayout>
