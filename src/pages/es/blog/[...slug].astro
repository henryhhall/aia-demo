---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ id, data }) => id.startsWith('es/') && !data.draft);
  return posts.map((entry) => ({
    params: { slug: entry.id.replace(/^es\//, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const siteUrl = 'https://aia-danbury.com';
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
const orgId = `${siteUrl}/#organization`;
const articleId = `${canonicalUrl}#article`;
const authorId = `${canonicalUrl}#author`;

const graph: any[] = [
  {
    '@type': 'BlogPosting',
    '@id': articleId,
    'isPartOf': { '@id': orgId },
    'publisher': { '@id': orgId },
    'headline': entry.data.title,
    'description': entry.data.description,
    'image': entry.data.image,
    'datePublished': entry.data.pubDate.toISOString(),
    'dateModified': (entry.data.updatedDate || entry.data.pubDate).toISOString(),
    'inLanguage': 'es',
    'mainEntityOfPage': canonicalUrl,
    'author': {
      '@type': 'Person',
      '@id': authorId,
      'name': entry.data.author,
      'worksFor': { '@id': orgId }
    },
    'about': entry.data.about && entry.data.about.length > 0 ? entry.data.about : [
      {
        '@type': 'Place',
        'name': 'Bridgeport, Connecticut',
        'sameAs': 'https://www.wikidata.org/wiki/Q49174'
      },
      {
        '@type': 'Thing',
        'name': 'Commercial Auto Insurance',
        'sameAs': 'https://www.wikidata.org/wiki/Q11089901'
      },
      {
        '@type': 'Thing',
        'name': 'Inland Marine Insurance',
        'sameAs': 'https://en.wikipedia.org/wiki/Inland_marine_insurance'
      }
    ]
  }
];

if (entry.data.faq && entry.data.faq.length > 0) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${canonicalUrl}#faq`,
    'mainEntity': entry.data.faq.map((item) => ({
      '@type': 'Question',
      'name': item.question,
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': item.answer
      }
    }))
  });
}

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': graph
};
---

<BaseLayout
  title={`${entry.data.title} | Blog de AIA`}
  description={entry.data.description}
  ogImage={entry.data.image}
  ogType="article"
  publishDate={entry.data.pubDate.toISOString()}
  tags={entry.data.tags}
  structuredData={structuredData}
>
  <article class="max-w-[75ch] mx-auto px-4 sm:px-6 py-16 text-left">
    <!-- Header -->
    <header class="space-y-4 mb-12 border-b border-border-subtle pb-8">
      <div class="flex items-center gap-2 text-xs font-semibold text-text-muted">
        <span class="text-text-primary">Por {entry.data.author}</span>
        <span>•</span>
        <time class="font-mono uppercase">
          {new Date(entry.data.pubDate).toLocaleDateString('es-ES', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </time>
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tighter text-accent leading-tight">
        {entry.data.title}
      </h1>
      <p class="text-base text-text-secondary italic">
        {entry.data.description}
      </p>
    </header>

    <!-- Content -->
    <div class="prose prose-zinc max-w-none text-base text-text-secondary leading-relaxed space-y-6 
      [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-accent [&_h2]:mt-10 [&_h2]:mb-4
      [&_h3]:text-lg [&_h3]:font-bold [&_h3]:text-accent [&_h3]:mt-8 [&_h3]:mb-2
      [&_ul]:list-disc [&_ul]:list-inside [&_ul]:space-y-2 [&_ul]:pl-4
      [&_ol]:list-decimal [&_ol]:list-inside [&_ol]:space-y-2 [&_ol]:pl-4
      [&_strong]:font-semibold [&_strong]:text-text-primary">
      <Content />
    </div>

    <!-- Footer link -->
    <div class="mt-16 pt-8 border-t border-border-subtle flex justify-between items-center text-xs">
      <a href="/es/blog" class="font-semibold text-accent hover:text-accent-gold transition-colors flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        Volver al Blog
      </a>
      <span class="text-text-muted">Publicado por Associated Insurance Agency</span>
    </div>
  </article>
</BaseLayout>
