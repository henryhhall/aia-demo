---
/**
 * Privacy Policy (Spanish) - Associated Insurance Agency
 * Política de Privacidad en Español para correduría de seguros independiente,
 * cubriendo GLBA (Gramm-Leach-Bliley Act), protección de datos financieros NPI,
 * transmisión a aseguradoras y confidencialidad estricta de SMS / telefonía móvil.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'es';
const t = useTranslations(lang);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Política de Privacidad | Associated Insurance Agency",
  "description": "Política de privacidad y aviso financiero del consumidor GLBA para Associated Insurance Agency en Connecticut.",
  "inLanguage": "es",
  "publisher": {
    "@type": "InsuranceAgency",
    "name": "Associated Insurance Agency",
    "telephone": "+1-203-748-9272",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "50 Newtown Road, Suite 1",
      "addressLocality": "Danbury",
      "addressRegion": "CT",
      "postalCode": "06810",
      "addressCountry": "US"
    }
  }
};
---

<BaseLayout
  title="Política de Privacidad | Associated Insurance Agency CT"
  description="Lea la Política de Privacidad de Associated Insurance Agency. Conozca cómo protegemos su información personal, privacidad financiera GLBA y confidencialidad estricta de telefonía móvil."
  structuredData={structuredData}
>
  <!-- Encabezado de Página / Hero -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-16 sm:py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-accent/5 text-accent text-xs font-semibold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-accent-gold animate-pulse"></span>
        Privacidad y Protección de Datos
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-accent leading-none">
        {t('privacy.title')}
      </h1>
      <p class="text-sm sm:text-base text-text-secondary max-w-[65ch] mx-auto leading-relaxed">
        {t('privacy.subtitle')}
      </p>
      <div class="pt-2 flex items-center justify-center gap-3 text-xs text-text-muted">
        <span>Fecha de Entrada en Vigor: Octubre 2026</span>
        <span>•</span>
        <span>Última Actualización: Octubre 2026</span>
      </div>
    </div>
  </section>

  <!-- Contenido Principal -->
  <section class="py-16 sm:py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Tabla de Contenidos Fija (Desktop) -->
        <aside class="hidden lg:block lg:col-span-4 sticky top-28 space-y-6">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
            <h2 class="text-sm font-bold text-accent uppercase tracking-wider border-b border-border-subtle pb-3 flex items-center gap-2">
              <span class="w-1.5 h-4 bg-accent-gold rounded-full"></span>
              Índice de Contenido
            </h2>
            <nav class="space-y-1.5 text-xs text-text-secondary">
              <a href="#vision-general" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">1. Visión General y Aviso GLBA</a>
              <a href="#informacion-recopilada" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">2. Información que Recopilamos</a>
              <a href="#privacidad-movil" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors text-accent font-semibold">3. Confidencialidad Móvil y SMS</a>
              <a href="#uso-informacion" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">4. Cómo Usamos la Información</a>
              <a href="#divulgacion-aseguradoras" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">5. Divulgación a Aseguradoras</a>
              <a href="#cookies-registros" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">6. Cookies y Registros Técnicos</a>
              <a href="#seguridad-datos" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">7. Medidas de Seguridad</a>
              <a href="#retencion-datos" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">8. Período de Retención</a>
              <a href="#derechos-usuario" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">9. Sus Derechos de Privacidad</a>
              <a href="#privacidad-menores" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">10. Privacidad de Menores</a>
              <a href="#modificaciones" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">11. Cambios a esta Política</a>
              <a href="#contacto-privacidad" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">12. Contacto de Privacidad</a>
            </nav>
          </div>

          <!-- Asistencia Rápida -->
          <div class="bg-accent text-white p-6 rounded-xl shadow-md space-y-3">
            <h3 class="text-sm font-bold text-accent-gold">¿Preguntas sobre su Privacidad?</h3>
            <p class="text-xs text-zinc-300 leading-relaxed">
              Nuestro equipo con licencia está comprometido a proteger sus datos financieros no públicos (NPI). Llámenos para cualquier consulta.
            </p>
            <div class="pt-2">
              <a href="tel:2037489272" class="inline-flex items-center gap-2 text-xs font-semibold text-white hover:text-accent-gold transition-colors">
                <svg class="w-4 h-4 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.942-6.942l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                </svg>
                (203) 748-9272
              </a>
            </div>
          </div>
        </aside>

        <!-- Secciones de Contenido -->
        <div class="lg:col-span-8 space-y-10 text-left">
          
          <!-- Resumen del Compromiso -->
          <div class="p-5 sm:p-6 bg-accent/5 border-l-4 border-accent-gold rounded-r-xl space-y-2">
            <h2 class="text-base font-bold text-accent">Nuestro Compromiso con su Privacidad</h2>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              <strong>Associated Insurance Agency</strong> ("AIA", "nosotros" o "nuestro") valora su confianza. Como agencia de seguros independiente que opera en Danbury, Watertown y Bridgeport, Connecticut, gestionamos información personal y financiera necesaria para obtener cotizaciones, emitir coberturas y administrar pólizas. Nunca vendemos sus datos personales ni números móviles a comercializadores externos o listas de telemercadeo.
            </p>
          </div>

          <!-- Sección 1 -->
          <article id="vision-general" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Sección 1</span>
              Visión General y Aviso de la Ley Gramm-Leach-Bliley (GLBA)
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Esta Política de Privacidad describe cómo Associated Insurance Agency recopila, utiliza, resguarda y divulga información personal e información financiera personal no pública (NPI) a través de nuestro sitio web (<a href="https://aia-danbury.com/es" class="text-accent underline font-medium">https://aia-danbury.com/es</a>), cotizadores en línea, llamadas telefónicas y consultas presenciales.
            </p>
            <p class="text-sm text-text-secondary leading-relaxed">
              Conforme al Título V de la Ley Gramm-Leach-Bliley (GLBA) y las regulaciones del Departamento de Seguros de Connecticut, las instituciones financieras y agencias de seguros autorizadas están obligadas a informar sus políticas y prácticas de privacidad a los consumidores.
            </p>
          </article>

          <!-- Sección 2 -->
          <article id="informacion-recopilada" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Sección 2</span>
              Información que Recopilamos
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Para evaluar el riesgo de seguro y solicitar propuestas precisas a las compañías aseguradoras, recopilamos las siguientes categorías de datos:
            </p>
            <div class="space-y-2.5 text-xs text-text-secondary">
              <div class="p-3 bg-bg-secondary rounded-lg border border-border-subtle">
                <strong class="text-text-primary block mb-0.5">Datos de Contacto</strong>
                Nombre completo, dirección residencial y postal, correo electrónico, números telefónicos y oficina de preferencia.
              </div>
              <div class="p-3 bg-bg-secondary rounded-lg border border-border-subtle">
                <strong class="text-text-primary block mb-0.5">Datos de Seguros y Suscripción</strong>
                Número de identificación del vehículo (VIN), historial de conducción, antigüedad y características de la propiedad, acreedores hipotecarios, aseguradora anterior y registros de reclamos.
              </div>
              <div class="p-3 bg-bg-secondary rounded-lg border border-border-subtle">
                <strong class="text-text-primary block mb-0.5">Información Comercial</strong>
                Nombre comercial, identificación fiscal patronal (FEIN), nómina, ventas brutas, ubicaciones operativas y clasificaciones de negocio.
              </div>
              <div class="p-3 bg-bg-secondary rounded-lg border border-border-subtle">
                <strong class="text-text-primary block mb-0.5">Datos Técnicos y de Seguridad</strong>
                Direcciones IP, navegador, sistema operativo, fecha/hora y parámetros de seguridad honeypot para mitigar envíos de bots automatizados.
              </div>
            </div>
          </article>

          <!-- Sección 3: Confidencialidad Móvil Estricta (10DLC / CTIA) -->
          <article id="privacidad-movil" class="space-y-4 scroll-mt-28 p-6 bg-accent/5 border border-accent/20 rounded-xl">
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
              </svg>
              <div>
                <h2 class="text-lg font-bold text-accent">
                  Sección 3: Confidencialidad Estricta de Telefonía Móvil y Mensajes SMS (10DLC / CTIA)
                </h2>
                <div class="mt-2 p-3 bg-white border border-border-subtle rounded-lg text-sm text-text-primary font-medium leading-relaxed">
                  "No se compartirá información móvil con terceros o afiliados con fines de marketing o promocionales. Todas las demás categorías excluyen los datos de suscripción y consentimiento del originador de mensajes de texto; esta información no se compartirá con ningún tercero."
                </div>
              </div>
            </div>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              En nuestros formularios en línea, nuestro aviso indica: <em>"Proporcionar un número permite llamadas/mensajes de texto de nuestra parte sobre el mensaje."</em>
            </p>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Su número de teléfono celular y el consentimiento para SMS son utilizados <strong>exclusivamente</strong> por Associated Insurance Agency para comunicarse directamente con usted con relación a su solicitud de cotización, servicio de póliza o renovaciones. Jamás vendemos, alquilamos ni cedemos su número ni el consentimiento de suscripción a terceros o redes de comercialización.
            </p>
            <ul class="space-y-1 text-xs text-text-secondary pl-5 list-disc">
              <li>Puede cancelar las comunicaciones por SMS en cualquier momento respondiendo <strong>STOP</strong>.</li>
              <li>Responda <strong>HELP</strong> para obtener asistencia o información de servicio al cliente.</li>
            </ul>
          </article>

          <!-- Sección 4 -->
          <article id="uso-informacion" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Sección 4</span>
              Cómo Usamos su Información
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Utilizamos los datos recopilados estrictamente para operaciones legítimas de correduría de seguros:
            </p>
            <ul class="space-y-2 text-xs sm:text-sm text-text-secondary pl-5 list-disc">
              <li><strong>Comparación de Tarifas:</strong> Enviar los datos preliminares a aseguradoras líderes autorizadas para comparar precios y pólizas.</li>
              <li><strong>Servicio de Pólizas:</strong> Asistir en la adición de vehículos o conductores, expedición de certificados (COI) y consultas de facturación.</li>
              <li><strong>Comunicación Directa:</strong> Contactarlo por teléfono, correo electrónico, mensaje de texto o correo postal sobre sus cotizaciones o pólizas activas.</li>
              <li><strong>Prevención de Fraudes:</strong> Proteger nuestros sistemas contra envíos automatizados no deseados y solicitudes maliciosas.</li>
              <li><strong>Cumplimiento Legal:</strong> Cumplir con las normativas y requerimientos del Departamento de Seguros de Connecticut.</li>
            </ul>
          </article>

          <!-- Sección 5 -->
          <article id="divulgacion-aseguradoras" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Sección 5</span>
              Divulgación y Compartición de Información
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Como agencia independiente, AIA comparte sus datos únicamente con las partes necesarias para procesar sus trámites de seguros:
            </p>
            <ul class="space-y-2 text-xs sm:text-sm text-text-secondary pl-5 list-disc">
              <li><strong>Compañías Aseguradoras:</strong> Para cotizar, evaluar el riesgo y emitir pólizas (Safeco, Travelers, Progressive, The Hartford, Foremost, Guard, etc.).</li>
              <li><strong>Agencias de Informes del Consumidor:</strong> Las aseguradoras pueden solicitar reportes de manejo (MVR) e historial de reclamos (C.L.U.E.).</li>
              <li><strong>Proveedores de Tecnología:</strong> Empresas que alojan nuestros sistemas de gestión de pólizas bajo estrictos acuerdos de confidencialidad.</li>
              <li><strong>Autoridades Gubernamentales:</strong> En respuesta a órdenes judiciales o requerimientos del Departamento de Seguros de Connecticut.</li>
            </ul>
            <p class="text-xs font-semibold text-accent pt-1">
              NO VENDEMOS NI ALQUILAMOS SU INFORMACIÓN PERSONAL A TERCEROS PARA PUBLICIDAD COMERCIAL.
            </p>
          </article>

          <!-- Sección 6 -->
          <article id="cookies-registros" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Sección 6</span>
              Cookies y Registros Técnicos
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Nuestro sitio web utiliza cookies de sesión estándar y mecanismos de seguridad para garantizar una navegación fluida y evitar formularios falsos. No utilizamos píxeles invasivos ni rastreadores de perfiles de terceros con fines publicitarios.
            </p>
          </article>

          <!-- Sección 7 -->
          <article id="seguridad-datos" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Sección 7</span>
              Medidas de Seguridad y Protección de Datos
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              AIA implementa medidas de seguridad físicas, electrónicas y de procedimiento de conformidad con los estándares de la ley GLBA y la Ley de Privacidad de Datos de Connecticut (CTDPA). Esto incluye cifrado SSL/TLS, cortafuegos y acceso restringido exclusivo para agentes autorizados.
            </p>
          </article>

          <!-- Sección 8 -->
          <article id="retencion-datos" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Sección 8</span>
              Requisitos de Retención de Documentos
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Las agencias de seguros están sujetas a normas estatales y federales de conservación de registros. Conservamos expedientes de asegurados, solicitudes y comunicaciones durante los períodos exigidos por la ley estatal (generalmente entre 5 y 7 años tras el vencimiento o cancelación de la póliza).
            </p>
          </article>

          <!-- Sección 9 -->
          <article id="derechos-usuario" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Sección 9</span>
              Sus Derechos de Privacidad
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Conforme a la legislación aplicable y sujeto a los requisitos de archivo regulatorio, usted tiene derecho a:
            </p>
            <ul class="space-y-1.5 text-xs sm:text-sm text-text-secondary pl-5 list-disc">
              <li>Solicitar acceso para revisar los datos personales en su expediente activo.</li>
              <li>Solicitar la corrección de datos incorrectos o desactualizados.</li>
              <li>Darse de baja de comunicaciones comerciales (respondiendo STOP o mediante enlaces de correo).</li>
            </ul>
          </article>

          <!-- Sección 10 -->
          <article id="privacidad-menores" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Sección 10</span>
              Privacidad de Menores (COPPA)
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Este sitio está destinado a adultos y propietarios de empresas. No recopilamos conscientemente información de menores de 13 años. Si cree que un menor nos ha provisto datos, comuníquese con nosotros para eliminarlos inmediatamente.
            </p>
          </article>

          <!-- Sección 11 -->
          <article id="modificaciones" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Sección 11</span>
              Modificaciones a esta Política
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              AIA se reserva el derecho de actualizar esta Política de Privacidad periódicamente. Toda modificación entrará en vigor al publicarse con la fecha de actualización correspondiente.
            </p>
          </article>

          <!-- Sección 12: Contacto -->
          <article id="contacto-privacidad" class="space-y-4 scroll-mt-28 pt-6 border-t border-border-subtle">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Sección 12</span>
              Contacto con el Responsable de Privacidad
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Si tiene preguntas o solicitudes sobre esta Política de Privacidad o el tratamiento de sus datos, comuníquese con nuestro equipo:
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
              <div class="p-4 bg-bg-secondary rounded-lg border border-border-subtle space-y-1 text-xs">
                <span class="font-bold text-accent block">Sede Danbury</span>
                <span class="text-text-secondary block">50 Newtown Road, Suite 1</span>
                <span class="text-text-secondary block">Danbury, CT 06810</span>
                <a href="tel:2037489272" class="text-accent font-semibold hover:underline block pt-1">(203) 748-9272</a>
              </div>
              <div class="p-4 bg-bg-secondary rounded-lg border border-border-subtle space-y-1 text-xs">
                <span class="font-bold text-accent block">Oficina Watertown</span>
                <span class="text-text-secondary block">51 Depot St Ste 112</span>
                <span class="text-text-secondary block">Watertown, CT 06795</span>
                <a href="tel:8602747100" class="text-accent font-semibold hover:underline block pt-1">(860) 274-7100</a>
              </div>
              <div class="p-4 bg-bg-secondary rounded-lg border border-border-subtle space-y-1 text-xs">
                <span class="font-bold text-accent block">Oficina Bridgeport</span>
                <span class="text-text-secondary block">2465 Main Street</span>
                <span class="text-text-secondary block">Bridgeport, CT 06606</span>
                <a href="tel:2033675300" class="text-accent font-semibold hover:underline block pt-1">(203) 367-5300</a>
              </div>
            </div>
          </article>

        </div>

      </div>
    </div>
  </section>
</BaseLayout>
