---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://aia-danbury.com/es/personal/renters#service",
      "name": "Seguro de Inquilinos Connecticut",
      "serviceType": "Renters Insurance",
      "description": "Seguro accesible para inquilinos y arrendatarios en Connecticut. Cobertura a costo de reemplazo para muebles, electrónicos, responsabilidad civil y pérdida de uso desde $15/mes.",
      "provider": {
        "@type": "InsuranceAgency",
        "name": "Associated Insurance Agency",
        "telephone": "+1-203-748-9272",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "50 Newtown Road, Suite 1",
          "addressLocality": "Danbury",
          "addressRegion": "CT",
          "postalCode": "06810"
        }
      },
      "areaServed": [
        { "@type": "State", "name": "Connecticut" },
        { "@type": "City", "name": "Danbury" },
        { "@type": "City", "name": "Watertown" },
        { "@type": "City", "name": "Bridgeport" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://aia-danbury.com/es"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Seguros Personales",
          "item": "https://aia-danbury.com/es/personal"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Seguro de Inquilinos",
          "item": "https://aia-danbury.com/es/personal/renters"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Por qué los propietarios y administradores en Connecticut exigen seguro de inquilinos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La mayoría de los complejos de apartamentos y propietarios en Connecticut exigen un comprobante de póliza con al menos $100,000 en responsabilidad civil antes de entregar las llaves. Si un inquilino provoca un daño por agua o un incendio en la cocina, su seguro cubre las reparaciones en lugar de la póliza del propietario."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cubre el seguro del edificio del propietario mis pertenencias personales?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La póliza del arrendador cubre exclusivamente la estructura física, el techo y las áreas comunes. No ofrece protección para muebles, ropa, aparatos electrónicos o efectos personales. Sin una póliza de inquilinos (HO-4), el costo de reposición tras un incendio o robo corre por su cuenta."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto cuesta el seguro de inquilinos al mes en Connecticut?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El seguro de inquilinos suele costar entre $15 y $25 al mes ($180–$250 al año) por una cobertura de entre $25,000 y $40,000 para bienes personales y $100,000 a $300,000 en responsabilidad civil. Al combinarlo con el seguro de auto, los descuentos reducen significativamente el costo final."
          }
        },
        {
          "@type": "Question",
          "name": "¿Están protegidas mis pertenencias si me las roban fuera de mi apartamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El seguro de inquilinos incluye cobertura mundial para bienes personales fuera del domicilio. Si le roban una computadora portátil del maletero de su auto o el equipaje durante un viaje, la póliza responde descontando el deducible."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  lang="es"
  title="Seguro de Inquilinos en Connecticut | Cobertura de Renta | AIA Danbury"
  description="Seguro accesible para inquilinos en CT. Proteja sus pertenencias y responsabilidad civil desde solo $15 al mes. Pólizas aprobadas para contratos de alquiler."
  structuredData={structuredData}
>
  <!-- Breadcrumb -->
  <nav class="bg-bg-secondary border-b border-border-subtle py-3 text-xs text-text-muted" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2">
      <a href="/es" class="hover:text-accent transition-colors">Inicio</a>
      <span>/</span>
      <a href="/es/personal" class="hover:text-accent transition-colors">Seguros Personales</a>
      <span>/</span>
      <span class="text-text-primary font-medium">Seguro de Inquilinos</span>
    </div>
  </nav>

  <!-- Hero Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-16 sm:py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-accent-gold"></span>
          Protección para Inquilinos en Connecticut
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-accent leading-tight">
          Seguro de Inquilinos en Connecticut
        </h1>
        <p class="text-base sm:text-lg text-text-secondary leading-relaxed">
          La póliza del arrendador cubre únicamente la estructura del edificio. El seguro de inquilinos protege sus muebles, aparatos electrónicos, ropa y responsabilidad civil desde unos $15 al mes, con certificados emitidos rápidamente para su contrato de alquiler.
        </p>
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="/es/quote?type=renters"
            class="px-6 py-3 rounded-lg bg-accent text-white font-semibold text-sm hover:bg-accent/90 transition-all shadow-sm"
          >
            Solicitar Cotización de Inquilinos
          </a>
          <a
            href="tel:2037489272"
            class="px-6 py-3 rounded-lg border border-border-subtle bg-white text-text-primary font-semibold text-sm hover:bg-bg-secondary transition-all"
          >
            Llamar al (203) 748-9272
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Highlights Strip -->
  <section class="border-b border-border-subtle bg-white py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <span class="block text-2xl font-bold text-accent">~$15 / Mes</span>
          <span class="text-xs text-text-muted">Costo Típico en CT</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">Mismo Día</span>
          <span class="text-xs text-text-muted">Certificados para Arrendadores</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">Costo de Reemplazo</span>
          <span class="text-xs text-text-muted">Cobertura de Bienes Personales</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">Mundial</span>
          <span class="text-xs text-text-muted">Robo Fuera del Domicilio</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Sections -->
  <section class="py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">

      <!-- The Landlord Myth Snippet -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-7 space-y-5">
          <h2 class="text-3xl font-bold text-accent tracking-tight">
            Lo que no cubre el seguro del propietario
          </h2>
          <div class="p-4 bg-accent/5 border-l-4 border-accent-gold rounded-r text-sm text-text-secondary leading-relaxed">
            <p class="font-medium text-text-primary">
              Muchos inquilinos asumen erróneamente que el seguro del arrendador cubre daños por fuego, goteras o tuberías rotas. La póliza del propietario cubre únicamente la estructura física. Los inquilinos son legalmente responsables de sus propias pertenencias y de cualquier daño accidental que causen a otras unidades.
            </p>
          </div>
          <p class="text-sm text-text-secondary leading-relaxed">
            Una póliza de inquilinos (HO-4) cubre esas diferencias. Ya sea que alquile un apartamento en Danbury, una casa en Bridgeport o un townhouse en Watertown, la póliza protege sus bienes y su responsabilidad civil con tarifas mensuales reducidas.
          </p>
        </div>

        <div class="lg:col-span-5 bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
          <h3 class="text-base font-bold text-accent flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-accent-gold"></span>
            Requisitos del Contrato de Alquiler
          </h3>
          <p class="text-xs text-text-secondary leading-relaxed">
            La mayoría de las empresas administradoras de propiedades en Connecticut exigen prueba de una póliza activa con al menos <strong>$100,000 en cobertura de responsabilidad personal</strong> antes de la mudanza.
          </p>
          <p class="text-xs text-text-secondary leading-relaxed">
            Associated Insurance Agency emite certificados el mismo día nombrando a su arrendador o inmobiliaria como <strong>Parte Interesada</strong> para evitar retrasos.
          </p>
        </div>
      </div>

      <!-- Core Coverage Grid -->
      <div class="space-y-8">
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <h2 class="text-3xl font-bold text-accent">¿Qué Cubre el Seguro de Inquilinos?</h2>
          <p class="text-sm text-text-secondary">Coberturas principales incluidas en una póliza HO-4 para arrendatarios.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">01</div>
            <h3 class="text-base font-bold text-text-primary">Bienes Personales (Costo de Reemplazo)</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Paga el reemplazo de su ropa, muebles, computadoras, televisores y enseres si resultan dañados por fuego, humo, agua de tuberías rotas o robo.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">02</div>
            <h3 class="text-base font-bold text-text-primary">Responsabilidad Civil del Inquilino</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Cubre su defensa legal e indemnizaciones si un visitante se lesiona en su apartamento o si un descuido causa daños por agua en una unidad vecina.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">03</div>
            <h3 class="text-base font-bold text-text-primary">Pérdida de Uso / Gastos de Hospedaje</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Si un incendio o problema cubierto deja su vivienda inhabitable, la póliza paga hotel, alquiler temporal y gastos adicionales de alimentación mientras duran las reparaciones.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">04</div>
            <h3 class="text-base font-bold text-text-primary">Protección Fuera del Domicilio</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Sus pertenencias están cubiertas fuera de casa en cualquier parte del mundo, incluidos artículos sustraídos de un vehículo cerrado o equipaje durante viajes.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">05</div>
            <h3 class="text-base font-bold text-text-primary">Pagos Médicos a Terceros</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Cubre la atención médica inmediata para invitados lesionados en su vivienda, sin necesidad de determinar culpas legales.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">06</div>
            <h3 class="text-base font-bold text-text-primary">Protección Contra Robo de Identidad</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Endosos opcionales cubren honorarios legales, trámites de restauración de documentos y pérdida de salarios en caso de robo de identidad.
            </p>
          </div>
        </div>
      </div>

      <!-- Bundling Savings Strip -->
      <div class="bg-bg-secondary p-8 sm:p-10 rounded-2xl border border-border-subtle space-y-6">
        <div class="max-w-2xl space-y-2">
          <h2 class="text-2xl sm:text-3xl font-bold text-accent">Combine con Seguro de Auto para Ahorrar</h2>
          <p class="text-xs sm:text-sm text-text-secondary">
            Al combinar su seguro de inquilinos en Connecticut con su póliza de auto, el descuento por múltiples pólizas compensa la mayor parte de la prima de inquilinos.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs text-text-secondary">
          <div class="bg-white p-6 rounded-xl border border-border-subtle space-y-2">
            <strong class="text-accent text-sm block">Descuento Multipóliza</strong>
            <p>La mayoría de las aseguradoras ofrece entre 5% y 15% de descuento en la prima del auto al añadir una póliza de inquilinos.</p>
          </div>
          <div class="bg-white p-6 rounded-xl border border-border-subtle space-y-2">
            <strong class="text-accent text-sm block">Deducible Único por Siniestro</strong>
            <p>Si una tormenta o robo daña su vehículo y sus bienes en la residencia, muchas compañías aplican un solo deducible.</p>
          </div>
          <div class="bg-white p-6 rounded-xl border border-border-subtle space-y-2">
            <strong class="text-accent text-sm block">Facturación Centralizada</strong>
            <p>Gestione ambas pólizas en una sola cuenta con pagos coordinados y el respaldo de nuestros asesores locales.</p>
          </div>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="space-y-8 max-w-4xl mx-auto">
        <div class="text-center space-y-2">
          <h2 class="text-3xl font-bold text-accent">Preguntas Frecuentes</h2>
          <p class="text-sm text-text-secondary">Respuestas sobre el seguro de inquilinos en Connecticut.</p>
        </div>

        <div class="space-y-4">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">¿Por qué exigen seguro de inquilinos los administradores de edificios?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              La mayoría de los complejos de apartamentos y propietarios en Connecticut exigen un comprobante de póliza con al menos $100,000 en responsabilidad civil antes de entregar las llaves. Si un inquilino provoca un daño por agua o un incendio en la cocina, su seguro cubre las reparaciones en lugar de la póliza del propietario.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">¿Cubre el seguro del edificio del propietario mis pertenencias?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              No. La póliza del arrendador cubre exclusivamente la estructura física, el techo y las áreas comunes. No ofrece protección para muebles, ropa, aparatos electrónicos o efectos personales. Sin una póliza de inquilinos (HO-4), el costo de reposición tras un incendio o robo corre por su cuenta.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">¿Cuánto cuesta el seguro de inquilinos al mes en Connecticut?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              El seguro de inquilinos suele costar entre $15 y $25 al mes ($180–$250 al año) por una cobertura de entre $25,000 y $40,000 para bienes personales y $100,000 a $300,000 en responsabilidad civil. Al combinarlo con el seguro de auto, los descuentos reducen significativamente el costo final.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">¿Están protegidas mis pertenencias si me las roban fuera de mi apartamento?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              El seguro de inquilinos incluye cobertura mundial para bienes personales fuera del domicilio. Si le roban una computadora portátil del maletero de su auto o el equipaje durante un viaje, la póliza responde descontando el deducible.
            </p>
          </div>
        </div>
      </div>

      <!-- Conversion Banner -->
      <div class="bg-accent text-white p-8 sm:p-12 rounded-2xl shadow-xl flex flex-col md:flex-row justify-between items-center gap-8">
        <div class="space-y-2 text-center md:text-left">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">Obtenga su Certificado de Inquilinos Hoy Mismo</h2>
          <p class="text-sm text-zinc-300 max-w-xl">
            Cumpla con los requisitos de su contrato de arrendamiento sin demoras. Emitimos certificados el mismo día y le ayudamos a ahorrar al combinar con su seguro de auto.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a
            href="/es/quote?type=renters"
            class="px-6 py-3 rounded-lg bg-accent-gold hover:bg-accent-gold-hover text-zinc-950 font-bold text-sm transition-colors text-center"
          >
            Cotizar Seguro de Inquilinos
          </a>
          <a
            href="tel:2037489272"
            class="px-6 py-3 rounded-lg bg-white/10 hover:bg-white/20 text-white font-semibold text-sm transition-colors text-center"
          >
            (203) 748-9272
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
