---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://aia-danbury.com/es/personal/renters#service",
      "name": "Seguro de Inquilinos Connecticut",
      "serviceType": "Renters Insurance",
      "description": "Seguro accesible para inquilinos y arrendatarios en Connecticut. Cobertura a costo de reemplazo para muebles, electrónicos, responsabilidad civil y pérdida de uso desde $15/mes.",
      "provider": {
        "@type": "InsuranceAgency",
        "name": "Associated Insurance Agency",
        "telephone": "+1-203-748-9272",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "50 Newtown Road, Suite 1",
          "addressLocality": "Danbury",
          "addressRegion": "CT",
          "postalCode": "06810"
        }
      },
      "areaServed": [
        { "@type": "State", "name": "Connecticut" },
        { "@type": "City", "name": "Danbury" },
        { "@type": "City", "name": "Watertown" },
        { "@type": "City", "name": "Bridgeport" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://aia-danbury.com/es"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Seguros Personales",
          "item": "https://aia-danbury.com/es/personal"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Seguro de Inquilinos",
          "item": "https://aia-danbury.com/es/personal/renters"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Por qué los propietarios y administradores en Connecticut exigen seguro de inquilinos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La mayoría de los complejos de apartamentos y propietarios en Connecticut exigen un comprobante de póliza con al menos $100,000 en responsabilidad civil antes de entregar las llaves. Esto garantiza que si un inquilino provoca involuntariamente un daño por agua o un incendio en la cocina, su seguro cubrirá las reparaciones en lugar de generar un conflicto legal costoso."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cubre el seguro del edificio del propietario mis pertenencias personales?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. La póliza comercial del arrendador cubre exclusivamente las paredes, el tejado, los cimientos y los pasillos comunitarios. No ofrece ninguna protección para sus muebles, ropa, ordenadores, televisores o efectos personales. Sin una póliza de inquilinos (HO-4), usted deberá reponerlo todo de su propio bolsillo tras un incendio, robo o siniestro."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto cuesta el seguro de inquilinos al mes en Connecticut?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Es muy económico: suele costar entre $15 y $25 al mes ($180–$250 al año) por una cobertura de entre $25,000 y $40,000 para sus bienes personales y $100,000 a $300,000 en responsabilidad civil. Al agruparlo con su seguro de auto, el descuento resultante prácticamente cubre el costo de la póliza de inquilinos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Están protegidas mis pertenencias si me las roban fuera de mi apartamento?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "¡Sí! El seguro de inquilinos incluye cobertura mundial para bienes personales fuera del domicilio. Si le roban su computadora portátil o equipaje del maletero de su coche, o su bicicleta frente a una tienda, la póliza responde descontando el deducible."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  lang="es"
  title="Seguro de Inquilinos en Connecticut | Cobertura de Renta | AIA Danbury"
  description="Seguro accesible para inquilinos en CT. Proteja sus pertenencias y responsabilidad civil desde solo $15 al mes. Pólizas aprobadas para contratos de alquiler."
  structuredData={structuredData}
>
  <!-- Breadcrumb -->
  <nav class="bg-bg-secondary border-b border-border-subtle py-3 text-xs text-text-muted" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2">
      <a href="/es" class="hover:text-accent transition-colors">Inicio</a>
      <span>/</span>
      <a href="/es/personal" class="hover:text-accent transition-colors">Seguros Personales</a>
      <span>/</span>
      <span class="text-text-primary font-medium">Seguro de Inquilinos</span>
    </div>
  </nav>

  <!-- Hero Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-16 sm:py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-accent-gold"></span>
          Protección para Inquilinos en Connecticut
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-accent leading-tight">
          Seguro de Inquilinos en Connecticut
        </h1>
        <p class="text-base sm:text-lg text-text-secondary leading-relaxed">
          El seguro de su arrendador protege su edificio, no sus cosas. Resguarde sus muebles, tecnología, ropa y responsabilidad civil con una cobertura integral desde solo $15 al mes. Certificados rápidos para su contrato de alquiler.
        </p>
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="/es/quote?type=renters"
            class="px-6 py-3 rounded-lg bg-accent text-white font-semibold text-sm hover:bg-accent/90 transition-all shadow-sm"
          >
            Solicitar Cotización de Inquilinos
          </a>
          <a
            href="tel:2037489272"
            class="px-6 py-3 rounded-lg border border-border-subtle bg-white text-text-primary font-semibold text-sm hover:bg-bg-secondary transition-all"
          >
            Llamar al (203) 748-9272
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Highlights Strip -->
  <section class="border-b border-border-subtle bg-white py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <span class="block text-2xl font-bold text-accent">~$15 / Mes</span>
          <span class="text-xs text-text-muted">Costo Promedio en CT</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">Mismo Día</span>
          <span class="text-xs text-text-muted">Certificados para Arrendadores</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">Costo Nuevo</span>
          <span class="text-xs text-text-muted">Valor de Reemplazo para sus Bienes</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">Mundial</span>
          <span class="text-xs text-text-muted">Protección ante Robo Fuera de Casa</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Sections -->
  <section class="py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">

      <!-- The Landlord Myth Snippet -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-7 space-y-5">
          <h2 class="text-3xl font-bold text-accent tracking-tight">
            El Peligroso Mito del Seguro del Propietario
          </h2>
          <div class="p-4 bg-accent/5 border-l-4 border-accent-gold rounded-r text-sm text-text-secondary leading-relaxed">
            <p class="font-medium text-text-primary">
              Muchos inquilinos en Connecticut creen erróneamente que si el edificio de apartamentos sufre un incendio o una tubería se rompe en el piso de arriba, el seguro del casero cubrirá sus muebles y pertenencias dañadas. En realidad, la póliza del propietario cubre únicamente la estructura física. Los inquilinos son 100% responsables legal y financieramente de sus propias cosas.
            </p>
          </div>
          <p class="text-sm text-text-secondary leading-relaxed">
            Una póliza de inquilinos (HO-4) soluciona este problema por completo. Ya sea que rente un apartamento en Danbury, Bridgeport o Watertown, nuestras pólizas protegen su patrimonio personal por menos de lo que cuesta una cena rápida.
          </p>
        </div>

        <div class="lg:col-span-5 bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
          <h3 class="text-base font-bold text-accent flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-accent-gold"></span>
            Requisito Obligatorio del Contrato de Alquiler
          </h3>
          <p class="text-xs text-text-secondary leading-relaxed">
            Casi todas las empresas de administración de propiedades en Connecticut requieren prueba de una póliza activa con al menos <strong>$100,000 en cobertura de responsabilidad</strong> antes de entregarle las llaves.
          </p>
          <p class="text-xs text-text-secondary leading-relaxed">
            Associated Insurance Agency emite certificados inmediatos nombrando a su arrendador o inmobiliaria como <strong>Parte Interesada</strong>, facilitando su mudanza sin retrasos.
          </p>
        </div>
      </div>

      <!-- Core Coverage Grid -->
      <div class="space-y-8">
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <h2 class="text-3xl font-bold text-accent">¿Qué Cubre el Seguro de Inquilinos?</h2>
          <p class="text-sm text-text-secondary">Protección integral para sus pertenencias, responsabilidad civil y vivienda.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">01</div>
            <h3 class="text-base font-bold text-text-primary">Bienes Personales (Costo de Reemplazo)</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Paga el reemplazo de su ropa, muebles, computadoras, televisores y vajilla si resultan dañados por fuego, humo, agua de tuberías rotas o robo.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">02</div>
            <h3 class="text-base font-bold text-text-primary">Responsabilidad Civil del Inquilino</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Le protege si un invitado tropieza en su apartamento o si usted accidentalmente desborda la tina y causa daños por agua a los vecinos de abajo.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">03</div>
            <h3 class="text-base font-bold text-text-primary">Pérdida de Uso / Gastos de Hospedaje</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Si un incendio o problema grave deja su vivienda inhabitable, la póliza paga su estadía de hotel, alquiler temporal y alimentación durante las reparaciones.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">04</div>
            <h3 class="text-base font-bold text-text-primary">Protección Fuera del Domicilio</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Sus cosas están cubiertas en cualquier parte del mundo. Si le roban una maleta en un aeropuerto o una laptop del maletero de su auto, el seguro responde.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">05</div>
            <h3 class="text-base font-bold text-text-primary">Pagos Médicos a Terceros</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Cubre la atención de urgencia para invitados que se lesionen levemente en su casa sin necesidad de presentar demandas judiciales.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">06</div>
            <h3 class="text-base font-bold text-text-primary">Protección Contra Robo de Identidad</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Endosos opcionales para restituir su identidad y cubrir gastos legales si alguien abre cuentas bancarias o de crédito a su nombre.
            </p>
          </div>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="space-y-8 max-w-4xl mx-auto">
        <div class="text-center space-y-2">
          <h2 class="text-3xl font-bold text-accent">Preguntas Frecuentes</h2>
          <p class="text-sm text-text-secondary">Respuestas sobre el seguro de inquilinos en Connecticut.</p>
        </div>

        <div class="space-y-4">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">¿Por qué exigen seguro de inquilinos los administradores de edificios?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              La mayoría de los complejos de apartamentos y propietarios en Connecticut exigen un comprobante de póliza con al menos $100,000 en responsabilidad civil antes de entregar las llaves. Esto garantiza que si un inquilino provoca involuntariamente un daño por agua o un incendio en la cocina, su seguro cubrirá las reparaciones en lugar de generar un conflicto legal costoso.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">¿Cubre el seguro del edificio del propietario mis pertenencias?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              No. La póliza comercial del arrendador cubre exclusivamente las paredes, el tejado, los cimientos y los pasillos comunitarios. No ofrece ninguna protección para sus muebles, ropa, ordenadores, televisores o efectos personales. Sin una póliza de inquilinos (HO-4), usted deberá reponerlo todo de su propio bolsillo tras un incendio, robo o siniestro.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">¿Cuánto cuesta el seguro de inquilinos al mes en Connecticut?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Es muy económico: suele costar entre $15 y $25 al mes ($180–$250 al año) por una cobertura de entre $25,000 y $40,000 para sus bienes personales y $100,000 a $300,000 en responsabilidad civil. Al agruparlo con su seguro de auto, el descuento resultante prácticamente cubre el costo de la póliza de inquilinos.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">¿Están protegidas mis pertenencias si me las roban fuera de mi apartamento?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              ¡Sí! El seguro de inquilinos incluye cobertura mundial para bienes personales fuera del domicilio. Si le roban su computadora portátil o equipaje del maletero de su coche, o su bicicleta frente a una tienda, la póliza responde descontando el deducible.
            </p>
          </div>
        </div>
      </div>

      <!-- Conversion Banner -->
      <div class="bg-accent text-white p-8 sm:p-12 rounded-2xl shadow-xl flex flex-col md:flex-row justify-between items-center gap-8">
        <div class="space-y-2 text-center md:text-left">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">Obtenga su Certificado de Inquilinos Hoy Mismo</h2>
          <p class="text-sm text-zinc-300 max-w-xl">
            Cumpla con los requisitos de su contrato de arrendamiento al instante. Emitimos certificados en minutos y le ayudamos a ahorrar al combinar con su seguro de auto.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a
            href="/es/quote?type=renters"
            class="px-6 py-3 rounded-lg bg-accent-gold hover:bg-accent-gold-hover text-zinc-950 font-bold text-sm transition-colors text-center"
          >
            Cotizar Seguro de Inquilinos
          </a>
          <a
            href="tel:2037489272"
            class="px-6 py-3 rounded-lg bg-white/10 hover:bg-white/20 text-white font-semibold text-sm transition-colors text-center"
          >
            (203) 748-9272
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
