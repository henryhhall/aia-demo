---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://aia-danbury.com/es/personal/auto#service",
      "name": "Seguro de Auto y RV Connecticut",
      "serviceType": "Auto and Recreational Vehicle Insurance",
      "description": "Seguro de autos, camionetas, casas rodantes y vehículos recreativos en Connecticut. Cumplimiento legal de CGS § 14-112, colisión, cobertura integral y conductores sin seguro.",
      "provider": {
        "@type": "InsuranceAgency",
        "name": "Associated Insurance Agency",
        "telephone": "+1-203-748-9272",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "50 Newtown Road, Suite 1",
          "addressLocality": "Danbury",
          "addressRegion": "CT",
          "postalCode": "06810"
        }
      },
      "areaServed": [
        { "@type": "State", "name": "Connecticut" },
        { "@type": "City", "name": "Danbury" },
        { "@type": "City", "name": "Watertown" },
        { "@type": "City", "name": "Bridgeport" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://aia-danbury.com/es"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Seguros Personales",
          "item": "https://aia-danbury.com/es/personal"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Seguro de Auto y RV",
          "item": "https://aia-danbury.com/es/personal/auto"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuáles son los límites mínimos obligatorios de seguro de auto en Connecticut (CGS § 14-112)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bajo las leyes de Connecticut (CGS § 14-112), todo conductor debe portar una cobertura mínima de responsabilidad civil de $25,000 por lesiones corporales por persona, $50,000 por accidente en total, y $25,000 por daños a la propiedad (25/50/25), además de cobertura equivalente para conductores sin seguro o con seguro insuficiente (UM/UIM)."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué los límites mínimos estatales representan un grave riesgo financiero?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Con el precio promedio de un automóvil nuevo superando los $48,000, el límite estatal de $25,000 para daños a la propiedad no cubre ni siquiera el reemplazo de un vehículo común en un choque. Si los costos médicos superan los $50,000, las partes afectadas pueden demandar directamente sus ahorros personales, embargar el valor de su casa y retener ingresos futuros. Recomendamos límites de al menos 100/300/100 o 250/500/100."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuál es la diferencia entre cobertura de Colisión e Integral (Comprehensive)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La cobertura de Colisión paga los daños materiales de su auto si choca contra otro vehículo, un poste o barandilla en carreteras heladas. La cobertura Integral cubre incidentes fuera de su control: impactos con animales (ciervos), rotura de parabrisas, robo, vandalismo, caída de ramas y granizo."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo asegurar una casa rodante (RV), cámper o remolque recreativo en la misma agencia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Associated Insurance Agency ofrece pólizas especializadas para vehículos recreativos (RV, autocaravanas, remolques y botes), que incluyen reemplazo de pertenencias personales, responsabilidad civil en campamentos y asistencia en carretera 24/7."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  lang="es"
  title="Seguro de Auto y RV en Connecticut | CGS § 14-112 | AIA Danbury"
  description="Seguro de autos, camionetas y casas rodantes en CT. Conozca los requisitos mínimos CGS § 14-112, colisión, cobertura integral y descuentos."
  structuredData={structuredData}
>
  <!-- Breadcrumb -->
  <nav class="bg-bg-secondary border-b border-border-subtle py-3 text-xs text-text-muted" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2">
      <a href="/es" class="hover:text-accent transition-colors">Inicio</a>
      <span>/</span>
      <a href="/es/personal" class="hover:text-accent transition-colors">Seguros Personales</a>
      <span>/</span>
      <span class="text-text-primary font-medium">Seguro de Auto y RV</span>
    </div>
  </nav>

  <!-- Hero Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-16 sm:py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-accent-gold"></span>
          Protección Vial y Recreativa en Connecticut
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-accent leading-tight">
          Seguro de Auto y Vehículos Recreativos (RV) en Connecticut
        </h1>
        <p class="text-base sm:text-lg text-text-secondary leading-relaxed">
          Conduzca con total tranquilidad en la I-84, la Ruta 7 y las carreteras locales de Connecticut. Protegemos vehículos familiares, camionetas de trabajo, casas rodantes y cámpers con coberturas diseñadas para resguardar su patrimonio familiar.
        </p>
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="/es/quote?type=auto"
            class="px-6 py-3 rounded-lg bg-accent text-white font-semibold text-sm hover:bg-accent/90 transition-all shadow-sm"
          >
            Solicitar Cotización de Auto
          </a>
          <a
            href="tel:2037489272"
            class="px-6 py-3 rounded-lg border border-border-subtle bg-white text-text-primary font-semibold text-sm hover:bg-bg-secondary transition-all"
          >
            Llamar al (203) 748-9272
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Highlights Strip -->
  <section class="border-b border-border-subtle bg-white py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <span class="block text-2xl font-bold text-accent">CGS § 14-112</span>
          <span class="text-xs text-text-muted">Cumplimiento Legal de CT</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">100/300/100</span>
          <span class="text-xs text-text-muted">Límites Óptimos Recomendados</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">20+</span>
          <span class="text-xs text-text-muted">Compañías de Auto Comparadas</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">Auto + Casa</span>
          <span class="text-xs text-text-muted">Hasta 25% de Descuento Combinado</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Sections -->
  <section class="py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">

      <!-- Statutory Mandate & Risk Framing -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-7 space-y-5">
          <h2 class="text-3xl font-bold text-accent tracking-tight">
            Requisitos de Seguro de Auto en Connecticut (CGS § 14-112)
          </h2>
          <div class="p-4 bg-accent/5 border-l-4 border-accent-gold rounded-r text-sm text-text-secondary leading-relaxed">
            <p class="font-medium text-text-primary">
              La ley estatal exige que cada conductor mantenga un seguro con límites mínimos de $25,000 por lesiones corporales por persona, $50,000 por siniestro y $25,000 por daños materiales (25/50/25), junto con protección para conductores no asegurados (UM/UIM).
            </p>
          </div>
          <p class="text-sm text-text-secondary leading-relaxed">
            Aunque estos límites satisfacen el requisito del DMV para renovar su registro, dejan a los conductores expuestos ante un accidente serio. En choques múltiples o con vehículos de lujo, los costos de reparación y hospital superan los $25,000 en cuestión de horas. Nuestros agentes independientes le ayudan a obtener verdadera protección financiera a un costo accesible.
          </p>
        </div>

        <div class="lg:col-span-5 bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
          <h3 class="text-base font-bold text-accent flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-accent-gold"></span>
            El Riesgo de Mantener Solo el Mínimo Legal
          </h3>
          <p class="text-xs text-text-secondary leading-relaxed">
            El valor promedio de los automóviles actuales supera con creces el límite estatal de $25,000 para daños a la propiedad.
          </p>
          <p class="text-xs text-text-secondary leading-relaxed">
            Si su póliza se agota, los tribunales de Connecticut pueden dictaminar embargos sobre sus bienes personales, su casa y hasta el 25% de sus ingresos laborales futuros. Incrementar su cobertura a <strong>100/300/100 o 250/500/100</strong> cuesta una fracción adicional y protege todo lo que ha construido.
          </p>
        </div>
      </div>

      <!-- Core Coverage Grid -->
      <div class="space-y-8">
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <h2 class="text-3xl font-bold text-accent">Coberturas Esenciales para su Vehículo</h2>
          <p class="text-sm text-text-secondary">Protección integral adaptada a las carreteras de Connecticut.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">01</div>
            <h3 class="text-base font-bold text-text-primary">Responsabilidad por Lesiones Corporales</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Paga los gastos médicos, rehabilitación y defensa legal si usted resulta responsable de un accidente donde otra persona resulte herida.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">02</div>
            <h3 class="text-base font-bold text-text-primary">Responsabilidad por Daños a la Propiedad</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Cubre las reparaciones del vehículo ajeno, postes o estructuras comerciales dañadas en un accidente donde usted sea responsable.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">03</div>
            <h3 class="text-base font-bold text-text-primary">Cobertura de Colisión</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Repara o compensa el valor real de su vehículo si choca contra otro auto, resbala sobre nieve hacia una zanja o sufre una colisión directa.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">04</div>
            <h3 class="text-base font-bold text-text-primary">Cobertura Integral (Comprehensive)</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Cubre riesgos no causados por choques: impacto con animales (ciervos), vidrios rotos, robo, vandalismo y caída de árboles durante tormentas.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">05</div>
            <h3 class="text-base font-bold text-text-primary">Conductores No Asegurados (UM/UIM)</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Le protege si es embestido por un conductor sin seguro o por alguien que huye del lugar del accidente (hit-and-run).
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">06</div>
            <h3 class="text-base font-bold text-text-primary">Asistencia Vial y Auto de Reemplazo</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Servicio de grúa las 24 horas, recarga de batería, cambio de llantas y reembolso de alquiler de vehículo mientras el suyo está en el taller.
            </p>
          </div>
        </div>
      </div>

      <!-- RV & Campers Section -->
      <div class="bg-bg-secondary p-8 sm:p-10 rounded-2xl border border-border-subtle space-y-6">
        <div class="max-w-2xl space-y-2">
          <h2 class="text-2xl sm:text-3xl font-bold text-accent">Pólizas para RV, Casas Rodantes y Cámper</h2>
          <p class="text-xs sm:text-sm text-text-secondary">
            Los vehículos recreativos requieren coberturas especializadas más amplias que una póliza tradicional de automóvil:
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
          <div class="bg-white p-4 rounded-lg border border-border-subtle">
            <strong class="text-accent block mb-1">Casas Rodantes (Clase A, B, C)</strong>
            <p class="text-text-muted">Protección integral y de responsabilidad civil diseñada para vehículos motorizados de alto valor.</p>
          </div>
          <div class="bg-white p-4 rounded-lg border border-border-subtle">
            <strong class="text-accent block mb-1">Remolques y Cámper</strong>
            <p class="text-text-muted">Protección mientras son remolcados en autopistas y cuando se encuentran estacionados en el camping.</p>
          </div>
          <div class="bg-white p-4 rounded-lg border border-border-subtle">
            <strong class="text-accent block mb-1">Responsabilidad en Campamento</strong>
            <p class="text-text-muted">Cobertura de responsabilidad civil si alguien resulta herido alrededor de su RV estacionado.</p>
          </div>
          <div class="bg-white p-4 rounded-lg border border-border-subtle">
            <strong class="text-accent block mb-1">Pertenencias Personales</strong>
            <p class="text-text-muted">Reemplazo total de equipos de acampar, tecnología, ropa y utensilios guardados en su vehículo.</p>
          </div>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="space-y-8 max-w-4xl mx-auto">
        <div class="text-center space-y-2">
          <h2 class="text-3xl font-bold text-accent">Preguntas Frecuentes</h2>
          <p class="text-sm text-text-secondary">Respuestas sobre el seguro de auto y vehículos recreativos en Connecticut.</p>
        </div>

        <div class="space-y-4">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">¿Cuáles son los límites mínimos de seguro de auto en CT (CGS § 14-112)?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Bajo las leyes de Connecticut (CGS § 14-112), todo conductor debe portar una cobertura mínima de responsabilidad civil de $25,000 por lesiones corporales por persona, $50,000 por accidente en total, y $25,000 por daños a la propiedad (25/50/25), además de cobertura equivalente para conductores sin seguro o con seguro insuficiente (UM/UIM).
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">¿Por qué los límites mínimos estatales representan un grave riesgo financiero?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Con el precio promedio de un automóvil nuevo superando los $48,000, el límite estatal de $25,000 para daños a la propiedad no cubre ni siquiera el reemplazo de un vehículo común en un choque. Si los costos médicos superan los $50,000, las partes afectadas pueden demandar directamente sus ahorros personales, embargar el valor de su casa y retener ingresos futuros. Recomendamos límites de al menos 100/300/100 o 250/500/100.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">¿Cuál es la diferencia entre cobertura de Colisión e Integral?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              La cobertura de Colisión paga los daños materiales de su auto si choca contra otro vehículo, un poste o barandilla en carreteras heladas. La cobertura Integral cubre incidentes fuera de su control: impactos con animales (ciervos), rotura de parabrisas, robo, vandalismo, caída de ramas y granizo.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">¿Puedo asegurar una casa rodante (RV), cámper o remolque en la misma póliza?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Sí. Associated Insurance Agency ofrece pólizas especializadas para vehículos recreativos (RV, autocaravanas, remolques y botes), que incluyen reemplazo de pertenencias personales, responsabilidad civil en campamentos y asistencia en carretera 24/7.
            </p>
          </div>
        </div>
      </div>

      <!-- Conversion Banner -->
      <div class="bg-accent text-white p-8 sm:p-12 rounded-2xl shadow-xl flex flex-col md:flex-row justify-between items-center gap-8">
        <div class="space-y-2 text-center md:text-left">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">Compare Tarifas de Auto y RV en Connecticut</h2>
          <p class="text-sm text-zinc-300 max-w-xl">
            No pague de más. Nuestros agentes bilingües comparan las mejores aseguradoras para maximizar sus descuentos y darle la protección que usted merece.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a
            href="/es/quote?type=auto"
            class="px-6 py-3 rounded-lg bg-accent-gold hover:bg-accent-gold-hover text-zinc-950 font-bold text-sm transition-colors text-center"
          >
            Cotizar Seguro de Auto
          </a>
          <a
            href="tel:2037489272"
            class="px-6 py-3 rounded-lg bg-white/10 hover:bg-white/20 text-white font-semibold text-sm transition-colors text-center"
          >
            (203) 748-9272
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
