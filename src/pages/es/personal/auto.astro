---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://aia-danbury.com/es/personal/auto#service",
      "name": "Seguro de Auto y RV Connecticut",
      "serviceType": "Auto and Recreational Vehicle Insurance",
      "description": "Seguro de autos, camionetas y vehículos recreativos en Connecticut. Cumplimiento legal de CGS § 14-112, colisión, cobertura integral y conductores sin seguro.",
      "provider": {
        "@type": "InsuranceAgency",
        "name": "Associated Insurance Agency",
        "telephone": "+1-203-748-9272",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "50 Newtown Road, Suite 1",
          "addressLocality": "Danbury",
          "addressRegion": "CT",
          "postalCode": "06810"
        }
      },
      "areaServed": [
        { "@type": "State", "name": "Connecticut" },
        { "@type": "City", "name": "Danbury" },
        { "@type": "City", "name": "Watertown" },
        { "@type": "City", "name": "Bridgeport" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://aia-danbury.com/es"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Seguros Personales",
          "item": "https://aia-danbury.com/es/personal"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Seguro de Auto y RV",
          "item": "https://aia-danbury.com/es/personal/auto"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Cuáles son los límites mínimos obligatorios de seguro de auto en Connecticut (CGS § 14-112)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bajo la ley de Connecticut (CGS § 14-112), todo conductor debe portar una cobertura mínima de responsabilidad civil de $25,000 por lesiones por persona, $50,000 por accidente en total y $25,000 por daños a la propiedad (25/50/25), además de cobertura equivalente para conductores sin seguro o con seguro insuficiente (UM/UIM)."
          }
        },
        {
          "@type": "Question",
          "name": "¿Por qué los límites mínimos estatales son insuficientes para la mayoría de los conductores?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "El precio promedio de un auto nuevo supera los $48,000. Si causa un choque que destruye un auto reciente, el límite estatal de $25,000 deja una diferencia de más de $20,000 que saldrá de su propio bolsillo. Si los gastos médicos de los lesionados superan los $50,000 de su póliza, pueden demandar sus cuentas de ahorro y su vivienda. Recomendamos contratar límites de al menos 100/300/100 o 250/500/100."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuál es la diferencia entre cobertura de Colisión e Integral en Connecticut?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La cobertura de Colisión paga la reparación o reemplazo de su propio auto si choca contra otro vehículo, un poste o patina en hielo. La cobertura Integral cubre daños ajenos a una colisión: impacto con venados en carreteras rurales, piedras en el parabrisas, robo, vandalismo, incendio y ramas caídas por tormentas."
          }
        },
        {
          "@type": "Question",
          "name": "¿Puedo asegurar una casa rodante, cámper o remolque en la misma póliza?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La mayoría de las aseguradoras requieren una póliza especializada para vehículos recreativos en vez de añadirlos a una póliza de auto estándar. Podemos emitir ambas pólizas con la misma compañía para aprovechar descuentos y cubrir responsabilidad en campamentos, remolque y pertenencias personales."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  lang="es"
  title="Seguro de Auto y RV en Connecticut | CGS § 14-112 | AIA Danbury"
  description="Seguro de autos, camionetas y vehículos recreativos en CT. Compare requisitos CGS § 14-112, colisión, cobertura integral y descuentos con más de 20 aseguradoras."
  structuredData={structuredData}
>
  <!-- Breadcrumb -->
  <nav class="bg-bg-secondary border-b border-border-subtle py-3 text-xs text-text-muted" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2">
      <a href="/es" class="hover:text-accent transition-colors">Inicio</a>
      <span>/</span>
      <a href="/es/personal" class="hover:text-accent transition-colors">Seguros Personales</a>
      <span>/</span>
      <span class="text-text-primary font-medium">Seguro de Auto y RV</span>
    </div>
  </nav>

  <!-- Hero Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-16 sm:py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-accent-gold"></span>
          Seguros de Auto en Danbury y Connecticut
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-accent leading-tight">
          Seguro de Auto y Vehículos Recreativos en Connecticut
        </h1>
        <p class="text-base sm:text-lg text-text-secondary leading-relaxed">
          Ya sea que viaje a diario por la I-84 y la Ruta 7 o salga los fines de semana en cámper por Connecticut, los límites mínimos del estado rara vez cubren un accidente grave. Comparamos más de 20 aseguradoras para encontrar coberturas completas de responsabilidad, colisión e integral al precio adecuado.
        </p>
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="/es/quote?type=auto"
            class="px-6 py-3 rounded-lg bg-accent text-white font-semibold text-sm hover:bg-accent/90 transition-all shadow-sm"
          >
            Solicitar Cotización de Auto
          </a>
          <a
            href="tel:2037489272"
            class="px-6 py-3 rounded-lg border border-border-subtle bg-white text-text-primary font-semibold text-sm hover:bg-bg-secondary transition-all"
          >
            Llamar al (203) 748-9272
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Highlights Strip -->
  <section class="border-b border-border-subtle bg-white py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <span class="block text-2xl font-bold text-accent">CGS § 14-112</span>
          <span class="text-xs text-text-muted">Mínimo Legal del Estado</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">100/300/100</span>
          <span class="text-xs text-text-muted">Cobertura Recomendada</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">20+</span>
          <span class="text-xs text-text-muted">Aseguradoras Comparadas</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">Auto + Casa</span>
          <span class="text-xs text-text-muted">Ahorro de hasta el 25% en Paquetes</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Sections -->
  <section class="py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">

      <!-- Statutory Mandate & Risk Framing -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-7 space-y-5">
          <h2 class="text-3xl font-bold text-accent tracking-tight">
            Requisitos de Seguro de Auto en Connecticut (CGS § 14-112)
          </h2>
          <div class="p-4 bg-accent/5 border-l-4 border-accent-gold rounded-r text-sm text-text-secondary leading-relaxed">
            <p class="font-medium text-text-primary">
              La ley de Connecticut exige límites mínimos de responsabilidad civil: $25,000 por lesiones por persona, $50,000 por accidente y $25,000 por daños a la propiedad (25/50/25), además de cobertura equivalente para conductores sin seguro (UM/UIM).
            </p>
          </div>
          <p class="text-sm text-text-secondary leading-relaxed">
            Cumplir con el mínimo legal permite registrar el vehículo en el DMV, pero $25,000 por daños materiales no alcanza para reponer la mayoría de los vehículos en Connecticut hoy en día. Si causa un choque con varios heridos o destruye un auto reciente, las cuentas médicas y de taller superan el mínimo estatal con rapidez. Cualquier saldo que exceda su póliza saldrá de su propio bolsillo.
          </p>
        </div>

        <div class="lg:col-span-5 bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
          <h3 class="text-base font-bold text-accent">
            Por qué el mínimo de 25/50/25 arriesga su patrimonio
          </h3>
          <p class="text-xs text-text-secondary leading-relaxed">
            El precio promedio de un auto nuevo supera los $48,000. Si su límite de daños a la propiedad es de $25,000, usted responde personalmente por la diferencia.
          </p>
          <p class="text-xs text-text-secondary leading-relaxed">
            Cuando la póliza se agota, los tribunales de Connecticut pueden autorizar embargos sobre sus cuentas bancarias, el valor de su vivienda o retener ingresos futuros. Subir su cobertura a 100/300/100 o 250/500/100 representa una diferencia mínima al mes y protege sus bienes.
          </p>
        </div>
      </div>

      <!-- Core Coverage Grid -->
      <div class="space-y-8">
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <h2 class="text-3xl font-bold text-accent">Cómo Funcionan las Coberturas en Connecticut</h2>
          <p class="text-sm text-text-secondary">Detalle de protecciones obligatorias de responsabilidad y coberturas de daños al vehículo.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">01</div>
            <h3 class="text-base font-bold text-text-primary">Responsabilidad por Lesiones Corporales</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Paga gastos médicos, rehabilitación y defensa legal si usted resulta responsable de un accidente con personas lesionadas.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">02</div>
            <h3 class="text-base font-bold text-text-primary">Responsabilidad por Daños a la Propiedad</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Cubre reparaciones de otros vehículos, barandillas, postes o estructuras dañadas en un accidente donde usted sea responsable.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">03</div>
            <h3 class="text-base font-bold text-text-primary">Cobertura de Colisión</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Paga la reparación o reemplazo de su propio vehículo si choca contra otro auto, patina sobre hielo contra una barrera o vuelca, menos su deducible.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">04</div>
            <h3 class="text-base font-bold text-text-primary">Cobertura Integral</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Cubre daños ajenos a un choque: impacto con venados en carreteras rurales, piedras en el parabrisas, robo, vandalismo, inundaciones y ramas caídas por tormentas.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">05</div>
            <h3 class="text-base font-bold text-text-primary">Conductores Sin Seguro (UM/UIM)</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Le protege a usted y a sus pasajeros si un conductor sin seguro o que se da a la fuga causa el accidente y no cubre sus facturas médicas.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">06</div>
            <h3 class="text-base font-bold text-text-primary">Asistencia Vial y Auto de Alquiler</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Grúa las 24 horas, recarga de batería, cambio de llantas ponchadas y reembolso de auto de alquiler mientras su vehículo está en el taller tras un siniestro.
            </p>
          </div>
        </div>
      </div>

      <!-- RV & Campers Section -->
      <div class="bg-bg-secondary p-8 sm:p-10 rounded-2xl border border-border-subtle space-y-6">
        <div class="max-w-2xl space-y-2">
          <h2 class="text-2xl sm:text-3xl font-bold text-accent">Seguro para Casas Rodantes, Autocaravanas y Cámper</h2>
          <p class="text-xs sm:text-sm text-text-secondary">
            Una póliza de auto común no cubre áreas habitables ni responsabilidad civil en campamentos. Emitimos pólizas especializadas para vehículos recreativos:
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
          <div class="bg-white p-4 rounded-lg border border-border-subtle">
            <strong class="text-accent block mb-1">Autocaravanas (Clase A, B y C)</strong>
            <p class="text-text-muted">Cobertura de daños físicos y responsabilidad civil para autocaravanas y camionetas camperizadas.</p>
          </div>
          <div class="bg-white p-4 rounded-lg border border-border-subtle">
            <strong class="text-accent block mb-1">Cámper y Remolques de Viaje</strong>
            <p class="text-text-muted">Protección para remolques quintarrueda y cámpers plegables, tanto en carretera como estacionados.</p>
          </div>
          <div class="bg-white p-4 rounded-lg border border-border-subtle">
            <strong class="text-accent block mb-1">Responsabilidad en Campamento</strong>
            <p class="text-text-muted">Protección civil si un visitante tropieza o sufre un accidente cerca de su vehículo estacionado.</p>
          </div>
          <div class="bg-white p-4 rounded-lg border border-border-subtle">
            <strong class="text-accent block mb-1">Pertenencias Personales</strong>
            <p class="text-text-muted">Reposición de equipo de acampar, ropa y dispositivos electrónicos que transporte dentro del vehículo.</p>
          </div>
        </div>
      </div>

      <!-- Connecticut Discounts Strip -->
      <div class="bg-white p-8 rounded-2xl border border-border-subtle shadow-sm space-y-4">
        <h2 class="text-2xl font-bold text-accent">Cómo Ahorrar en su Seguro de Auto en Connecticut</h2>
        <p class="text-sm text-text-secondary leading-relaxed">
          Associated Insurance Agency compara más de 20 aseguradoras para aplicar todos los descuentos disponibles a su póliza:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-2 text-xs text-text-secondary">
          <div class="space-y-1">
            <strong class="text-accent block">Paquetes Multipóliza</strong>
            <p>Ahorre del 15% al 25% al asegurar su auto junto con su casa, condominio o seguro de inquilino con la misma compañía.</p>
          </div>
          <div class="space-y-1">
            <strong class="text-accent block">Telemática y Buen Conductor</strong>
            <p>Aplicaciones móviles o dispositivos opcionales que registran bajo millaje y frenado suave para descuentos de hasta el 30%.</p>
          </div>
          <div class="space-y-1">
            <strong class="text-accent block">Estudiantes y Cursos de Manejo</strong>
            <p>Descuentos para estudiantes con buen promedio, jóvenes que estudian lejos sin auto y conductores de 60+ con curso de manejo defensivo.</p>
          </div>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="space-y-8 max-w-4xl mx-auto">
        <div class="text-center space-y-2">
          <h2 class="text-3xl font-bold text-accent">Preguntas Frecuentes</h2>
          <p class="text-sm text-text-secondary">Respuestas claras sobre el seguro de auto y vehículos recreativos en Connecticut.</p>
        </div>

        <div class="space-y-4">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">¿Cuáles son los límites mínimos obligatorios de seguro de auto en Connecticut (CGS § 14-112)?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Bajo la ley de Connecticut (CGS § 14-112), todo conductor debe portar una cobertura mínima de responsabilidad civil de $25,000 por lesiones por persona, $50,000 por accidente en total y $25,000 por daños a la propiedad (25/50/25), además de cobertura equivalente para conductores sin seguro o con seguro insuficiente (UM/UIM).
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">¿Por qué los límites mínimos estatales son insuficientes para la mayoría de los conductores?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              El precio promedio de un auto nuevo supera los $48,000. Si causa un choque que destruye un auto reciente, el límite estatal de $25,000 deja una diferencia de más de $20,000 que saldrá de su propio bolsillo. Si los gastos médicos de los lesionados superan los $50,000 de su póliza, pueden demandar sus cuentas de ahorro y su vivienda. Recomendamos contratar límites de al menos 100/300/100 o 250/500/100.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">¿Cuál es la diferencia entre cobertura de Colisión e Integral en Connecticut?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              La cobertura de Colisión paga la reparación o reemplazo de su propio auto si choca contra otro vehículo, un poste o patina en hielo. La cobertura Integral cubre daños ajenos a una colisión: impacto con venados en carreteras rurales, piedras en el parabrisas, robo, vandalismo, incendio y ramas caídas por tormentas.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">¿Puedo asegurar una casa rodante, cámper o remolque en la misma póliza?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              La mayoría de las aseguradoras requieren una póliza especializada para vehículos recreativos en vez de añadirlos a una póliza de auto estándar. Podemos emitir ambas pólizas con la misma compañía para aprovechar descuentos y cubrir responsabilidad en campamentos, remolque y pertenencias personales.
            </p>
          </div>
        </div>
      </div>

      <!-- Conversion Banner -->
      <div class="bg-accent text-white p-8 sm:p-12 rounded-2xl shadow-xl flex flex-col md:flex-row justify-between items-center gap-8">
        <div class="space-y-2 text-center md:text-left">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">Hable con un Agente en Danbury Sobre su Seguro de Auto</h2>
          <p class="text-sm text-zinc-300 max-w-xl">
            Cotizamos con más de 20 aseguradoras para encontrar el balance justo entre precio y cobertura para sus vehículos personales y recreativos.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a
            href="/es/quote?type=auto"
            class="px-6 py-3 rounded-lg bg-accent-gold hover:bg-accent-gold-hover text-zinc-950 font-bold text-sm transition-colors text-center"
          >
            Cotizar Seguro de Auto
          </a>
          <a
            href="tel:2037489272"
            class="px-6 py-3 rounded-lg bg-white/10 hover:bg-white/20 text-white font-semibold text-sm transition-colors text-center"
          >
            (203) 748-9272
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
