---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://aia-danbury.com/es/personal/umbrella#service",
      "name": "Seguro de Responsabilidad Sombrilla Personal Connecticut",
      "serviceType": "Personal Umbrella Liability",
      "description": "Seguro de responsabilidad civil sombrilla (Umbrella) de $1M a $5M+ en Connecticut. Protege el valor de su vivienda, ahorros de jubilación e ingresos frente a demandas millonarias.",
      "provider": {
        "@type": "InsuranceAgency",
        "name": "Associated Insurance Agency",
        "telephone": "+1-203-748-9272",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "50 Newtown Road, Suite 1",
          "addressLocality": "Danbury",
          "addressRegion": "CT",
          "postalCode": "06810"
        }
      },
      "areaServed": [
        { "@type": "State", "name": "Connecticut" },
        { "@type": "City", "name": "Danbury" },
        { "@type": "City", "name": "Watertown" },
        { "@type": "City", "name": "Bridgeport" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://aia-danbury.com/es"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Seguros Personales",
          "item": "https://aia-danbury.com/es/personal"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Responsabilidad Sombrilla",
          "item": "https://aia-danbury.com/es/personal/umbrella"
        }
      ]
    },
    {      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué es una póliza Sombrilla (Umbrella) y cómo funciona?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Una póliza sombrilla personal proporciona cobertura de responsabilidad civil por encima de los límites de sus pólizas de auto, casa o inquilinos. Cuando una demanda agota los límites de su póliza primaria, la sombrilla cubre el saldo restante hasta el límite contratado ($1,000,000 a $5,000,000 o más)."
          }
        },
        {
          "@type": "Question",
          "name": "¿Quién necesita un seguro sombrilla en Connecticut?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cualquier persona con activos que proteger—como una vivienda, ahorros, cuentas de retiro o ingresos futuros—se beneficia de una póliza sombrilla. Las demandas judiciales no afectan únicamente a familias adineradas. Los factores de riesgo más habituales incluyen conductores jóvenes, piscinas, perros y propiedades en alquiler."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuánto cuesta una póliza sombrilla de $1,000,000 en Connecticut?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Debido a que la cobertura sombrilla responde únicamente después de agotarse las pólizas base, su costo es bajo. Una póliza típica de $1,000,000 cuesta entre $150 y $300 al año (unos $15 a $25 al mes). Cada millón adicional cuesta todavía menos."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cuáles son los límites básicos requeridos antes de contratar una sombrilla?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Las compañías aseguradoras exigen límites mínimos en las pólizas base: normalmente $250,000/$500,000 de responsabilidad en auto y de $300,000 a $500,000 en responsabilidad de vivienda. Associated Insurance Agency revisa sus pólizas para asegurar que no existan vacíos de cobertura."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  lang="es"
  title="Seguro Sombrilla Personal en Connecticut | Protección de Patrimonio | AIA"
  description="Póliza sombrilla (Umbrella) en CT de $1M a $5M+. Cobertura de responsabilidad en exceso para resguardar su casa, ahorros e ingresos futuros."
  structuredData={structuredData}
>
  <!-- Breadcrumb -->
  <nav class="bg-bg-secondary border-b border-border-subtle py-3 text-xs text-text-muted" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2">
      <a href="/es" class="hover:text-accent transition-colors">Inicio</a>
      <span>/</span>
      <a href="/es/personal" class="hover:text-accent transition-colors">Seguros Personales</a>
      <span>/</span>
      <span class="text-text-primary font-medium">Responsabilidad Sombrilla</span>
    </div>
  </nav>

  <!-- Hero Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-16 sm:py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-accent-gold"></span>
          Protección de Exceso de Responsabilidad en CT
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-accent leading-tight">
          Seguro de Responsabilidad Sombrilla (Umbrella) en Connecticut
        </h1>
        <p class="text-base sm:text-lg text-text-secondary leading-relaxed">
          Un accidente grave de auto o una lesión en su propiedad puede derivar en una sentencia judicial millonaria. La póliza sombrilla agrega entre $1,000,000 y más de $5,000,000 en cobertura adicional sobre sus seguros de auto y hogar para proteger su casa, ahorros e ingresos futuros.
        </p>
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="/es/quote?type=umbrella"
            class="px-6 py-3 rounded-lg bg-accent text-white font-semibold text-sm hover:bg-accent/90 transition-all shadow-sm"
          >
            Solicitar Cotización Sombrilla
          </a>
          <a
            href="tel:2037489272"
            class="px-6 py-3 rounded-lg border border-border-subtle bg-white text-text-primary font-semibold text-sm hover:bg-bg-secondary transition-all"
          >
            Llamar al (203) 748-9272
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Highlights Strip -->
  <section class="border-b border-border-subtle bg-white py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <span class="block text-2xl font-bold text-accent">$1M - $5M+</span>
          <span class="text-xs text-text-muted">Límites Adicionales de Responsabilidad</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">~$20 / Mes</span>
          <span class="text-xs text-text-muted">Costo Inicial Típico</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">Mundial</span>
          <span class="text-xs text-text-muted">Protección en Viajes y Alquileres</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">Defensa Legal</span>
          <span class="text-xs text-text-muted">Cubierta Fuera del Límite de Póliza</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Sections -->
  <section class="py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">

      <!-- How it Works Snippet -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-7 space-y-5">
          <h2 class="text-3xl font-bold text-accent tracking-tight">
            ¿Cómo Funciona la Cobertura Sombrilla Personal?
          </h2>
          <div class="p-4 bg-accent/5 border-l-4 border-accent-gold rounded-r text-sm text-text-secondary leading-relaxed">
            <p class="font-medium text-text-primary">
              La póliza sombrilla actúa por encima de sus pólizas existentes de auto y hogar en Connecticut. Si una demanda o indemnización supera el límite de su póliza básica ($300,000 o $500,000), la sombrilla cubre el saldo restante hasta el límite contratado ($1,000,000 o más).
            </p>
          </div>
          <p class="text-sm text-text-secondary leading-relaxed">
            Sin esta cobertura, un fallo judicial en Connecticut puede embargar el valor acumulado de su vivienda, cuentas bancarias, inversiones, fondos 401(k) y hasta el 25% de sus ingresos laborales para cubrir una indemnización.
          </p>
        </div>

        <div class="lg:col-span-5 bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
          <h3 class="text-base font-bold text-accent flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-accent-gold"></span>
            Ejemplo de Reclamación
          </h3>
          <p class="text-xs text-text-secondary leading-relaxed">
            Un conductor de su familia causa un choque grave en la I-84 con lesiones severas. El tribunal fija una indemnización de $1,500,000.
          </p>
          <div class="space-y-1.5 text-xs text-text-secondary bg-bg-secondary p-3 rounded-lg border border-border-subtle">
            <p><strong>Póliza de Auto:</strong> Paga el tope de $500,000</p>
            <p><strong>Saldo Restante sin Cobertura:</strong> $1,000,000</p>
            <p class="text-accent font-semibold">Con Sombrilla: La póliza cubre el millón restante, protegiendo su vivienda y sus ahorros.</p>
          </div>
        </div>
      </div>

      <!-- High-Risk Triggers Grid -->
      <div class="space-y-8">
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <h2 class="text-3xl font-bold text-accent">Situaciones Cotidianas que Exigen Cobertura Sombrilla</h2>
          <p class="text-sm text-text-secondary">Situaciones habituales donde las reclamaciones de responsabilidad superan los límites básicos del seguro de auto y hogar.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">01</div>
            <h3 class="text-base font-bold text-text-primary">Conductores Jóvenes</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Los conductores con poca experiencia registran tasas de accidentes más altas. Una colisión grave puede agotar rápidamente los límites de responsabilidad del seguro de auto.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">02</div>
            <h3 class="text-base font-bold text-text-primary">Piscinas y Trampolines</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Las piscinas y trampolines conllevan un alto riesgo de lesiones graves o ahogamientos. Los gastos médicos e indemnizaciones suelen exceder la cobertura básica del hogar.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">03</div>
            <h3 class="text-base font-bold text-text-primary">Tener Mascotas (Perros)</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Bajo la ley de responsabilidad estricta de Connecticut (C.G.S. § 22-357), los dueños responden por cualquier lesión o mordedura causada por su perro. Las reclamaciones suelen superar los límites de la póliza de vivienda.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">04</div>
            <h3 class="text-base font-bold text-text-primary">Reuniones Sociales en Casa</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Si un invitado consume alcohol en su casa y causa un choque de regreso, las leyes de responsabilidad del anfitrión en Connecticut pueden responsabilizarlo económicamente.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">05</div>
            <h3 class="text-base font-bold text-text-primary">Botes y Embarcaciones</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Navegar en Candlewood Lake o en Long Island Sound conlleva riesgos de colisión y lesiones que con frecuencia superan las pólizas náuticas básicas.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">06</div>
            <h3 class="text-base font-bold text-text-primary">Difamación y Redes Sociales</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Cubre costos de defensa y demandas por difamación, calumnia e invasión de la privacidad, situaciones excluidas en los seguros de hogar estándar.
            </p>
          </div>
        </div>
      </div>

      <!-- Límites Primarios Requeridos -->
      <div class="bg-bg-secondary p-8 sm:p-10 rounded-2xl border border-border-subtle space-y-6">
        <div class="max-w-2xl space-y-2">
          <h2 class="text-2xl sm:text-3xl font-bold text-accent">Límites Básicos Requeridos</h2>
          <p class="text-xs sm:text-sm text-text-secondary">
            Las aseguradoras exigen que sus pólizas primarias cumplan con ciertos límites mínimos antes de que la cobertura sombrilla entre en vigor:
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-xs text-text-secondary">
          <div class="bg-white p-6 rounded-xl border border-border-subtle space-y-2">
            <h3 class="text-base font-bold text-accent">Requisitos para Seguro de Auto</h3>
            <p>La mayoría de las compañías exige $250,000 / $500,000 en lesiones corporales y $100,000 en daños a la propiedad, o un límite único combinado de $500,000.</p>
          </div>
          <div class="bg-white p-6 rounded-xl border border-border-subtle space-y-2">
            <h3 class="text-base font-bold text-accent">Requisitos para Seguro de Hogar</h3>
            <p>La mayoría de las compañías exige entre $300,000 y $500,000 en responsabilidad personal (Cobertura E) en residencias principales y secundarias.</p>
          </div>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="space-y-8 max-w-4xl mx-auto">
        <div class="text-center space-y-2">
          <h2 class="text-3xl font-bold text-accent">Preguntas Frecuentes</h2>
          <p class="text-sm text-text-secondary">Dudas comunes sobre el seguro sombrilla en Connecticut.</p>
        </div>

        <div class="space-y-4">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">¿Qué es una póliza Sombrilla (Umbrella) y cómo funciona?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Una póliza sombrilla personal proporciona cobertura de responsabilidad civil por encima de los límites de sus pólizas de auto, casa o inquilinos. Cuando una demanda agota los límites de su póliza primaria, la sombrilla cubre el saldo restante hasta el límite contratado ($1,000,000 a $5,000,000 o más).
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">¿Quién necesita un seguro sombrilla en Connecticut?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Cualquier persona con activos que proteger—como una vivienda, ahorros, cuentas de retiro o ingresos futuros—se beneficia de una póliza sombrilla. Las demandas judiciales no afectan únicamente a familias adineradas. Los factores de riesgo más habituales incluyen conductores jóvenes, piscinas, perros y propiedades en alquiler.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">¿Cuánto cuesta una póliza sombrilla de $1,000,000 en Connecticut?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Debido a que la cobertura sombrilla responde únicamente después de agotarse las pólizas base, su costo es bajo. Una póliza típica de $1,000,000 cuesta entre $150 y $300 al año (unos $15 a $25 al mes). Cada millón adicional cuesta todavía menos.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">¿Cuáles son los límites básicos requeridos antes de contratar una sombrilla?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Las compañías aseguradoras exigen límites mínimos en las pólizas base: normalmente $250,000/$500,000 de responsabilidad en auto y de $300,000 a $500,000 en responsabilidad de vivienda. Associated Insurance Agency revisa sus pólizas para asegurar que no existan vacíos de cobertura.
            </p>
          </div>
        </div>
      </div>

      <!-- Conversion Banner -->
      <div class="bg-accent text-white p-8 sm:p-12 rounded-2xl shadow-xl flex flex-col md:flex-row justify-between items-center gap-8">
        <div class="space-y-2 text-center md:text-left">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">Proteja su Patrimonio y sus Ingresos Futuros</h2>
          <p class="text-sm text-zinc-300 max-w-xl">
            Por menos de un dólar al día, una póliza sombrilla protege su vivienda, ahorros y salario frente a demandas millonarias. Hable con un asesor de AIA en Danbury, Watertown o Bridgeport.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a
            href="/es/quote?type=umbrella"
            class="px-6 py-3 rounded-lg bg-accent-gold hover:bg-accent-gold-hover text-zinc-950 font-bold text-sm transition-colors text-center"
          >
            Cotizar Seguro Sombrilla
          </a>
          <a
            href="tel:2037489272"
            class="px-6 py-3 rounded-lg bg-white/10 hover:bg-white/20 text-white font-semibold text-sm transition-colors text-center"
          >
            (203) 748-9272
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
