---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm';
import { useTranslations } from '../../i18n/utils';

const lang = 'es';
const t = useTranslations(lang);

const contactStructuredData = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Comuníquese con Associated Insurance Agency",
  "description": "Comuníquese con Associated Insurance Agency en Connecticut. Visite nuestra sede en Danbury o sucursales en Watertown y Bridgeport.",
};
---

<BaseLayout
  title="Contáctenos | Associated Insurance Agency CT"
  description="Póngase en contacto con Associated Insurance Agency en Connecticut. Visite nuestra oficina central en Danbury o sucursales en Watertown y Bridgeport. Asistencia multilingüe en español."
  structuredData={contactStructuredData}
>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-16 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-3">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-accent leading-none">
        {t('contact.title')}
      </h1>
      <p class="text-sm sm:text-base text-text-secondary max-w-[65ch] mx-auto leading-relaxed">
        {t('contact.subtitle')}
      </p>
    </div>
  </section>

  <!-- Main Content Grid -->
  <section class="py-16 sm:py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-start">
        
        <!-- Left Column: Interactive Contact Form with Honeypots -->
        <div class="lg:col-span-6 space-y-6">
          <ContactForm client:load lang={lang} />
        </div>

        <!-- Right Column: Google Maps Embed & Branch Locations -->
        <div class="lg:col-span-6 space-y-8">
          
          <!-- Danbury HQ Map Card -->
          <div class="border border-border-subtle bg-white shadow-xl rounded-xl overflow-hidden">
            <div class="p-6 border-b border-border-subtle">
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-xs font-semibold uppercase tracking-wider text-accent-gold">Sede Central</span>
                  <h2 class="text-xl font-bold text-accent mt-0.5">{t('contact.hqTitle')}</h2>
                </div>
                <a
                  href="https://maps.google.com/?q=50+Newtown+Road,+Suite+1,+Danbury,+CT+06810"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-bg-secondary text-xs font-semibold text-accent hover:bg-accent hover:text-white transition-all"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 21 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                  </svg>
                  {t('contact.getDirections')}
                </a>
              </div>
              <p class="text-sm text-text-secondary mt-2">
                50 Newtown Road, Suite 1, Danbury, CT 06810
              </p>
              <div class="flex flex-wrap items-center gap-4 text-xs text-text-muted mt-3 pt-3 border-t border-border-subtle/60">
                <span class="flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.942-6.942l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                  </svg>
                  <a href="tel:2037489272" class="hover:text-accent font-semibold transition-colors">(203) 748-9272</a>
                </span>
                <span class="text-zinc-300">•</span>
                <span class="flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                  </svg>
                  Lun - Vie 8:30 AM - 5:00 PM
                </span>
              </div>
            </div>

            <!-- Responsive Google Maps Embed with specified embed URL -->
            <div class="w-full aspect-[4/3] sm:h-[320px] bg-bg-secondary relative">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2879.6344940730055!2d-73.42662732423537!3d41.403672894985256!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89e7ff217cb29b37%3A0x264721e992b3c2ee!2sAssociated%20Insurance%20Agency%20LLC!5e1!3m2!1sen!2sus!4v1791229405450!5m2!1sen!2sus"
                width="400"
                height="300"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                class="w-full h-full border-0"
                title="Associated Insurance Agency LLC Google Map"
              ></iframe>
            </div>
          </div>

          <!-- Additional Branch Offices Card -->
          <div class="border border-border-subtle bg-white shadow-xl rounded-xl p-6 sm:p-8 space-y-6">
            <h3 class="text-lg font-bold text-accent tracking-tight border-b border-border-subtle pb-3">
              {t('contact.branchLocations')}
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <!-- Watertown Branch -->
              <div class="p-4 bg-bg-secondary/40 border border-border-subtle rounded-lg space-y-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-accent-gold">Sucursal Watertown</span>
                <p class="text-sm font-semibold text-accent">1157 Main Street</p>
                <p class="text-xs text-text-secondary">Watertown, CT 06795</p>
                <div class="pt-2 text-xs">
                  <a href="tel:8602748888" class="font-semibold text-accent hover:text-accent-gold transition-colors flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.942-6.942l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                    </svg>
                    (860) 274-8888
                  </a>
                </div>
              </div>

              <!-- Bridgeport Branch -->
              <div class="p-4 bg-bg-secondary/40 border border-border-subtle rounded-lg space-y-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-accent-gold">Sucursal Bridgeport</span>
                <p class="text-sm font-semibold text-accent">2465 Main Street</p>
                <p class="text-xs text-text-secondary">Bridgeport, CT 06606</p>
                <div class="pt-2 text-xs">
                  <a href="tel:2033338880" class="font-semibold text-accent hover:text-accent-gold transition-colors flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.942-6.942l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                    </svg>
                    (203) 333-8880
                  </a>
                </div>
              </div>
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>
</BaseLayout>
