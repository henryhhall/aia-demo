---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HomeownersQuoteWizard from '../../../components/homeowners-quote/HomeownersQuoteWizard';

const homeownersQuoteStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": "https://aia-danbury.com/es/quote/homeowners#webpage",
      "name": "Cotización de Seguro de Propietarios en Connecticut | Associated Insurance Agency",
      "description": "Solicite una cotización competitiva de seguro de propietarios de vivienda en Connecticut. Cotizador en varios pasos que compara Travelers, Safeco, The Hartford y aseguradoras regionales.",
      "url": "https://aia-danbury.com/es/quote/homeowners"
    },
    {
      "@type": "Service",
      "@id": "https://aia-danbury.com/es/quote/homeowners#service",
      "name": "Comparación de Cotizaciones de Seguro de Propietarios",
      "serviceType": "Property & Casualty Insurance",
      "provider": {
        "@type": "InsuranceAgency",
        "name": "Associated Insurance Agency",
        "telephone": "+1-203-748-9272",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "50 Newtown Road, Suite 1",
          "addressLocality": "Danbury",
          "addressRegion": "CT",
          "postalCode": "06810"
        }
      },
      "areaServed": [
        { "@type": "State", "name": "Connecticut" },
        { "@type": "City", "name": "Danbury" },
        { "@type": "City", "name": "Watertown" },
        { "@type": "City", "name": "Bridgeport" }
      ]
    }
  ]
};
---

<BaseLayout
  title="Cotización de Seguro de Propietario de Vivienda | Associated Insurance Agency CT"
  description="Solicite una cotización gratuita de seguro de propietarios en Connecticut. Complete nuestro formulario paso a paso para comparar tarifas de Travelers, Safeco, Hartford y más."
  structuredData={homeownersQuoteStructuredData}
  lang="es"
>
  {/* Page Hero */}
  <section class="relative bg-gradient-to-b from-bg-secondary via-bg-primary to-bg-primary py-16 sm:py-20 border-b border-border-subtle overflow-hidden">
    {/* Subtle Background Radial Pattern */}
    <div class="absolute inset-0 bg-[radial-gradient(#122b5f_1px,transparent_1px)] [background-size:24px_24px] opacity-[0.03] pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mx-auto text-center space-y-4">
        {/* Trust Pill */}
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/5 border border-accent/15 text-accent text-xs font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-gold animate-pulse"></span>
          <span>Agencia Independiente en CT • Comparación de Tarifas Multiaseguradora</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-accent leading-[1.15]">
          Cotizador de Seguro de <span class="text-accent-gold">Propietario de Vivienda</span>
        </h1>

        <p class="text-sm sm:text-base text-text-secondary max-w-[65ch] mx-auto leading-relaxed">
          Complete nuestro formulario de 4 pasos para que uno de nuestros agentes licenciados evalúe el costo de reemplazo de su vivienda y busque su mejor tarifa de póliza.
        </p>

        {/* Value Highlights */}
        <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 pt-2 text-xs font-medium text-text-muted">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Cálculo Real del Costo de Reemplazo</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Créditos por Sistemas de Protección</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Cero Presión de Ventas</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Quote Form Interactive Section */}
  <section class="py-12 sm:py-16 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* React Island Client Hydration */}
      <HomeownersQuoteWizard client:load lang="es" />

      {/* Disclaimers & Licensing Footnote */}
      <div class="mt-12 max-w-3xl mx-auto text-center space-y-2 px-4 border-t border-border-subtle pt-6">
        <p class="text-xs text-text-muted leading-relaxed">
          Associated Insurance Agency es un productor de seguros con licencia en Connecticut (Sede: 50 Newtown Rd, Danbury CT 06810). Las cotizaciones generadas en línea representan parámetros de suscripción estimados y no vinculan ni garantizan cobertura hasta que un representante autorizado la emita por escrito.
        </p>
        <p class="text-[11px] text-text-muted/80">
          ¿Necesita asistencia inmediata o busca emitir cobertura para un cierre inmobiliario próximo? Llame directamente a nuestra oficina de Danbury al <a href="tel:+12037489272" class="text-accent font-semibold hover:underline">(203) 748-9272</a>.
        </p>
      </div>
    </div>
  </section>

  {/* Why Choose AIA Section */}
  <section class="py-16 bg-bg-secondary border-t border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-2">
        <h2 class="text-2xl sm:text-3xl font-bold text-accent">
          Por Qué los Propietarios en Connecticut Confían en AIA
        </h2>
        <p class="text-sm text-text-secondary">
          Como agencia independiente, no trabajamos para una sola compañía de seguros: trabajamos para usted.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-bg-primary border border-border-subtle shadow-xs space-y-3">
          <div class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center font-bold">
            <svg class="w-5 h-5 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-accent">Comparamos Más de 10 Aseguradoras</h3>
          <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
            Comparamos tarifas entre Travelers, Safeco, The Hartford, Chubb, Andover y más para encontrar descuentos que los agentes exclusivos no pueden ofrecer.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-bg-primary border border-border-subtle shadow-xs space-y-3">
          <div class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center font-bold">
            <svg class="w-5 h-5 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-accent">Expertos en Riesgos Climáticos de CT</h3>
          <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
            Adaptamos la cobertura a los riesgos de Nueva Inglaterra: congelación en invierno, acumulación de hielo, peso de nieve en techos y deducibles por tormentas de viento.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-bg-primary border border-border-subtle shadow-xs space-y-3">
          <div class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center font-bold">
            <svg class="w-5 h-5 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-accent">Equipo Local Multilingüe</h3>
          <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
            Atención personalizada de corredores que viven aquí en los condados de Fairfield, Litchfield y New Haven, con servicio fluido en inglés, español, portugués y turco.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
