---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQAccordion from '../../components/FAQAccordion';

const faqItems = [
  {
    question: "¿Qué es una agencia de seguros independiente?",
    answer: "Una agencia de seguros independiente representa a múltiples compañías aseguradoras en lugar de a una sola empresa cautiva. Associated Insurance Agency compara pólizas de más de 20 aseguradoras de primer nivel (como Travelers, The Hartford, Safeco y Progressive) para ofrecer coberturas personalizadas a tarifas competitivas, con defensa de reclamos en Connecticut."
  },
  {
    question: "¿Qué debo hacer inmediatamente después de un accidente de auto en Connecticut?",
    answer: "Bajo las leyes de Connecticut, asegure primero la integridad de los pasajeros y llame al 911. Intercambie licencias de conducir, registros e información del seguro, tome fotografías de los daños y obtenga el número de reporte policial. Comuníquese de inmediato con Associated Insurance Agency para que nuestros agentes coordinen el reclamo ante la aseguradora."
  },
  {
    question: "¿Por qué cambian las primas de mi seguro de propietario de vivienda en Connecticut?",
    answer: "Las primas de seguro de propietarios en Connecticut se ajustan principalmente por la inflación en materiales y mano de obra, revaluaciones de riesgo del Departamento de Seguros de Connecticut, historial de reclamos y renovaciones en la propiedad. Associated Insurance Agency realiza revisiones anuales para garantizar que los límites de reemplazo coincidan con los costos reales."
  },
  {
    question: "¿El seguro contra inundaciones está cubierto por las pólizas estándar de propietarios de viviendas?",
    answer: "Las pólizas estándar de propietarios en Connecticut excluyen expresamente los daños por inundaciones superficiales, marejadas y desbordamientos. La cobertura contra inundaciones debe contratarse por separado mediante el Programa Nacional de Seguro contra Inundaciones (NFIP) de FEMA o aseguradoras privadas. Associated Insurance Agency analiza mapas de FEMA para gestionar la protección adecuada."
  }
];

const carriers = [
  { name: "Safeco", phone: "1-800-332-3226", claimUrl: "http://www.safeco.com/claims-center", claimText: "Centro de Reclamaciones" },
  { name: "Met Life", phone: "1-800-845-6011", claimUrl: "https://www.metlife.com/about/corporate-profile/pay-a-bill/claims/index.html", claimText: "Centro de Reclamaciones" },
  { name: "The Hartford", phone: "1-800-243-5860", claimUrl: "http://www.thehartford.com/claims-center", claimText: "Centro de Reclamaciones" },
  { name: "Progressive", phone: "General: 1-800-776-4737\nComercial: 1-888-240-9839", claimUrl: "http://www.progressive.com/claims/", claimText: "Centro de Reclamaciones" },
  { name: "Foremost", phone: "Ver Centro de Reclamaciones", claimUrl: "http://www.foremost.com/claims/", claimText: "Centro de Reclamaciones" },
  { name: "Travelers", phone: "Personal: 1-800-252-4633\nNegocios: Ver Centro de Reclamaciones", claimUrl: "https://www.travelers.com/claim/index.aspx", claimText: "Centro de Reclamaciones" },
  { name: "Victoria Insurance", phone: "1-800-926-3168", claimUrl: "https://www.victoriainsurance.com/ClaimsService.do", claimText: "Centro de Reclamaciones" },
  { name: "Guard Insurance", phone: "1-888-639-2567", claimUrl: "http://www.guard.com/docs/ClaimReport.pdf", claimText: "Formulario de Reporte de Reclamación" },
  { name: "Infinity", phone: "1-800-334-1661", claimUrl: "https://www.infinityauto.com/report-claim", claimText: "Centro de Reclamaciones" },
  { name: "K & K Insurance", phone: "1-800-237-2917", claimUrl: "https://www.kandkinsurance.com/Pages/Claims.aspx", claimText: "Centro de Reclamaciones" },
  { name: "Utica First Insurance", phone: "Llamar a Associated Insurance Agency", claimUrl: "https://www.uticafirst.com/claims.html", claimText: "Información de Reclamaciones" }
];

const serviceStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<BaseLayout
  title="Centro de Servicio al Cliente | Associated Insurance Agency CT"
  description="Presente reclamos, pague facturas directamente con las principales aseguradoras y encuentre respuestas a preguntas frecuentes sobre seguros en nuestro centro de servicio de CT."
  structuredData={serviceStructuredData}
>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-accent leading-none">
        Centro de Servicio al Cliente
      </h1>
      <p class="mt-4 text-sm sm:text-base text-text-secondary max-w-[60ch]">
        Envíe pagos, reporte reclamos y encuentre soluciones inmediatas.
      </p>
    </div>
  </section>

  <!-- Content Sections -->
  <section class="py-24 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-24">
      
      <!-- Carrier Billing & Claims Directory -->
      <div class="space-y-8">
        <div class="max-w-3xl space-y-4 text-left">
          <h2 class="text-2xl font-bold text-accent">¿Cómo pago facturas o reporto reclamos ante las aseguradoras aliadas?</h2>
          <div class="p-4 bg-accent/5 border-l-4 border-accent-gold rounded-r text-sm text-text-secondary leading-relaxed">
            <p class="font-medium text-text-primary">
              Los asegurados de Associated Insurance Agency tienen acceso directo 24/7 para pagar facturas y reportar reclamos a través de nuestras compañías asociadas autorizadas. Para defensa personalizada de reclamos o dudas de cobertura, comuníquese con nuestras oficinas en Danbury, Watertown o Bridgeport en horario laboral regular.
            </p>
          </div>
          <p class="text-sm text-text-secondary leading-relaxed">
            Como agencia independiente, su cobertura está respaldada por una de nuestras aseguradoras asociadas. Puede pagar facturas o reportar reclamos las 24 horas del día, los 7 días de la semana directamente con ellas usando los contactos a continuación.
          </p>
        </div>

        <div class="rounded-lg border border-border-subtle bg-white overflow-hidden shadow-sm">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead>
                <tr class="bg-bg-secondary border-b border-border-subtle font-semibold text-accent">
                  <th class="px-6 py-4">Compañía de Seguros</th>
                  <th class="px-6 py-4">Soporte Telefónico</th>
                  <th class="px-6 py-4 text-right">Reclamaciones en Línea</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border-subtle text-text-secondary text-xs sm:text-sm">
                {carriers.map((carrier) => (
                  <tr class="hover:bg-bg-secondary/30 transition-colors">
                    <td class="px-6 py-4 font-semibold text-accent">{carrier.name}</td>
                    <td class="px-6 py-4 font-mono text-xs whitespace-pre-line">{carrier.phone}</td>
                    <td class="px-6 py-4 text-right">
                      <a href={carrier.claimUrl} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-accent-gold hover:underline">{carrier.claimText}</a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- File a Claim Checklist -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 pt-12 border-t border-border-subtle">
        <div class="lg:col-span-4 space-y-4 text-left">
          <h2 class="text-2xl font-bold text-accent">¿Va a presentar un reclamo?</h2>
          <p class="text-sm text-text-secondary leading-relaxed">
            Lidiar con daños o un accidente es estresante. Siga estas pautas estándar para asegurarse de que su proceso de reclamo transcurra sin problemas.
          </p>
        </div>
        <div class="lg:col-span-8 bg-bg-secondary border border-border-subtle p-8 rounded-lg space-y-6 text-left">
          <h3 class="text-base font-bold text-accent">Lista de Acción Inmediata</h3>
          <ol class="space-y-4 text-xs text-text-secondary leading-relaxed list-decimal list-inside">
            <li>
              <strong>Documente los daños:</strong> Tome fotografías claras o videos de los daños a su propiedad o vehículo antes de realizar cualquier reparación temporal.
            </li>
            <li>
              <strong>Evite pérdidas mayores:</strong> Tome medidas temporales razonables para proteger su propiedad de daños adicionales (por ejemplo, colocar una lona sobre un agujero en el techo o sellar una ventana rota). Guarde los recibos de cualquier material comprado.
            </li>
            <li>
              <strong>Comuníquese con la policía si corresponde:</strong> En caso de robo, vandalismo o accidentes automovilísticos, asegúrese de presentar un informe policial y solicite una copia del número de informe.
            </li>
            <li>
              <strong>Presente el reclamo de inmediato:</strong> Comuníquese con AIA o con su aseguradora directamente para iniciar el reclamo lo antes posible. Los retrasos pueden complicar la inspección y el pago.
            </li>
          </ol>
        </div>
      </div>

      <!-- Frequently Asked Questions -->
      <div class="space-y-8 pt-12 border-t border-border-subtle">
        <div class="text-center max-w-2xl mx-auto space-y-4">
          <h2 class="text-2xl font-bold text-accent">Preguntas Frecuentes</h2>
          <p class="text-sm text-text-secondary">Respuestas rápidas a preguntas comunes sobre primas, reclamos y cobertura.</p>
        </div>
        
        <!-- React FAQ accordion island -->
        <FAQAccordion client:visible items={faqItems} />
      </div>

    </div>
  </section>
</BaseLayout>
