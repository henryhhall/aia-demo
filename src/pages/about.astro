---
import BaseLayout from '../layouts/BaseLayout.astro';

const aboutStructuredData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Associated Insurance Agency",
  "description": "Learn about Associated Insurance Agency, an independent agency providing customized personal and commercial insurance solutions across Connecticut.",
};
---

<BaseLayout
  title="About Associated Insurance Agency | Independent CT Insurance Agents"
  description="Learn about Associated Insurance Agency, our history serving CT since 2016, and why working with an independent agent protects your property and saves you money."
  structuredData={aboutStructuredData}
>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-accent leading-none">
        About Our Agency
      </h1>
      <p class="mt-4 text-sm sm:text-base text-text-secondary max-w-[60ch]">
        Serving Danbury, Watertown, Bridgeport, and the wider Connecticut community since 2016.
      </p>
    </div>
  </section>

  <!-- Narrative Content (Split Screen) -->
  <section class="py-24 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-start">
        <!-- Text Content -->
        <div class="lg:col-span-8 space-y-8 text-left">
          <h2 class="text-2xl font-bold text-accent">What is Associated Insurance Agency?</h2>
          <div class="p-4 bg-accent/5 border-l-4 border-accent-gold rounded-r text-sm text-text-secondary leading-relaxed">
            <p class="font-medium text-text-primary">
              Associated Insurance Agency (AIA) is a full-service independent insurance brokerage established in 2016, operating physical branch offices in Danbury, Watertown, and Bridgeport, Connecticut. AIA partners with leading national carriers to provide personalized personal, commercial, and umbrella liability coverage, supported by licensed multilingual agents fluent in English, Spanish, Portuguese, and Turkish.
            </p>
          </div>
          <div class="prose prose-zinc max-w-none text-sm sm:text-base text-text-secondary leading-relaxed space-y-6">
            <p>
              Associated Insurance Agency (AIA) was founded on a simple principle: Connecticut residents deserve insurance policies tailored to their unique lives and businesses, without paying inflated prices.
            </p>
            <p>
              As a full-service independent agency, we do not work for any single insurance company. Instead, we have partnerships with a wide network of the nation's and region's top-rated carriers. This independence allows us to shop around, compare policies, and present you with options that offer the best coverage at the lowest available market rates.
            </p>
            <p>
              Whether you are buying your first home, adding a new vehicle to your family policy, or managing a growing local business, our experienced agents take the time to analyze your risks and match you with options that protect what matters most.
            </p>
            <p>
              To better serve our diverse Connecticut communities, our team is fully multilingual. We are proud to provide consultation, policy servicing, and claims support in English, Spanish, Portuguese, and Turkish, ensuring that language is never a barrier to getting the protection you need.
            </p>
            <div class="pt-1">
              <a
                href="/team"
                class="inline-flex items-center gap-2 text-sm font-semibold text-accent hover:text-accent-gold transition-colors"
              >
                <span>Meet our licensed multilingual agents and leadership team</span>
                <svg class="w-4 h-4 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 pt-6 border-t border-border-subtle">
            <div class="space-y-2">
              <h3 class="text-base font-bold text-accent">Why Choose an Independent Agent?</h3>
              <p class="text-xs text-text-secondary leading-relaxed">
                When you work with a direct writer, they can only sell you their specific brand. If their rates increase or your needs change, you have to start shopping all over again. With AIA, we represent multiple carriers, meaning we can adjust your policy or shop the market on your behalf without you ever needing to switch agencies.
              </p>
            </div>
            <div class="space-y-2">
              <h3 class="text-base font-bold text-accent">Commitment to Connecticut</h3>
              <p class="text-xs text-text-secondary leading-relaxed">
                With office locations in Danbury, Watertown, and Bridgeport, we are deeply embedded in local Connecticut communities. We know the regional risks, climate factors (like freezing winters and heavy snow load), and state insurance regulations, allowing us to provide highly accurate, local advice.
              </p>
            </div>
          </div>
        </div>

        <!-- Sidebar / Trust Signals -->
        <div class="lg:col-span-4 space-y-8">
          <div class="bg-bg-secondary border border-border-subtle p-6 rounded-lg shadow-sm space-y-4">
            <h3 class="text-base font-bold text-accent border-b border-border-subtle pb-2">AIA Quick Facts</h3>
            <ul class="space-y-3.5 text-xs text-text-secondary">
              <li class="flex justify-between">
                <span class="font-medium">Established:</span>
                <span>2016</span>
              </li>
              <li class="flex justify-between">
                <span class="font-medium">Service Areas:</span>
                <span>All of CT & NY</span>
              </li>
              <li class="flex justify-between">
                <span class="font-medium">Primary Offices:</span>
                <span>Danbury, Watertown, Bridgeport</span>
              </li>
              <li class="flex justify-between">
                <span class="font-medium">Languages:</span>
                <span>English, Spanish, Portuguese, Turkish</span>
              </li>
              <li class="flex justify-between">
                <span class="font-medium">Partner Carriers:</span>
                <span>Progressive, Travelers, Liberty Mutual, etc.</span>
              </li>
              <li class="pt-2 border-t border-border-subtle">
                <a href="/team" class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent hover:text-accent-gold transition-colors">
                  <span>View Our Full Team & Bios</span>
                  <svg class="w-3.5 h-3.5 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </li>
            </ul>
          </div>

          <div class="bg-accent text-white p-6 rounded-lg space-y-4 shadow-md">
            <h3 class="text-base font-bold text-accent-gold">Need advice on a policy?</h3>
            <p class="text-xs text-white/80 leading-relaxed">
              We offer free, no-obligation policy reviews. Bring us your current insurance declarations page, and we will tell you if you are overpaying or underinsured.
            </p>
            <a
              href="/quote"
              class="inline-flex items-center justify-center w-full px-4 py-2.5 text-xs font-semibold uppercase bg-accent-gold text-accent hover:bg-accent-gold-hover rounded transition-colors text-center"
            >
              Request a Review
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
