---
import BaseLayout from '../layouts/BaseLayout.astro';

Astro.response.status = 404;
Astro.response.statusText = 'Not Found';
---

<BaseLayout
  title="404 Page Not Found | Associated Insurance Agency"
  description="The page you were looking for could not be found. Explore our Connecticut insurance services, quote requests, or office locations."
  noindex={true}
>
  <div class="min-h-[60vh] flex items-center justify-center px-4 py-24 sm:py-32">
    <div class="text-center max-w-xl">
      <p class="text-base font-semibold text-accent-gold uppercase tracking-wider">404 Error</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight text-accent sm:text-5xl">
        Page Not Found
      </h1>
      <p class="mt-4 text-base text-text-secondary leading-relaxed">
        We could not find the page you were looking for. It may have moved or been updated. Choose one of the helpful links below to get back on track.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center justify-center px-5 py-3 text-sm font-semibold text-white bg-accent hover:bg-accent/90 rounded-md shadow-sm transition-colors"
        >
          Return to Homepage
        </a>
        <a
          href="/personal"
          class="inline-flex items-center justify-center px-5 py-3 text-sm font-semibold text-accent bg-accent/5 hover:bg-accent/10 border border-accent/20 rounded-md transition-colors"
        >
          Personal Lines
        </a>
        <a
          href="/commercial"
          class="inline-flex items-center justify-center px-5 py-3 text-sm font-semibold text-accent bg-accent/5 hover:bg-accent/10 border border-accent/20 rounded-md transition-colors"
        >
          Commercial Lines
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-5 py-3 text-sm font-semibold text-accent bg-accent/5 hover:bg-accent/10 border border-accent/20 rounded-md transition-colors"
        >
          Contact Us
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
