---
import BaseLayout from '../layouts/BaseLayout.astro';
import CertificateRequestForm from '../components/CertificateRequestForm';
import { useTranslations } from '../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);

const certificateStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": "https://aia-danbury.com/certificate-request#webpage",
      "name": "Certificate of Insurance (COI) Request | Associated Insurance Agency",
      "description": "Request an official ACORD 25 Certificate of Insurance with additional insured endorsements, waivers of subrogation, and same-day delivery across Connecticut.",
      "url": "https://aia-danbury.com/certificate-request"
    },
    {
      "@type": "Service",
      "@id": "https://aia-danbury.com/certificate-request#service",
      "name": "ACORD 25 Certificate of Insurance Issuance",
      "serviceType": "Commercial Insurance Documentation",
      "provider": {
        "@type": "InsuranceAgency",
        "name": "Associated Insurance Agency",
        "telephone": "+1-203-748-9272",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "50 Newtown Road, Suite 1",
          "addressLocality": "Danbury",
          "addressRegion": "CT",
          "postalCode": "06810"
        }
      },
      "areaServed": [
        { "@type": "State", "name": "Connecticut" },
        { "@type": "City", "name": "Danbury" },
        { "@type": "City", "name": "Watertown" },
        { "@type": "City", "name": "Bridgeport" }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Commercial Endorsements",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "General Liability ACORD 25 Certificate" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Additional Insured Endorsement (CG 20 10 / CG 20 37)" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Waiver of Subrogation Endorsement" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Workers' Compensation Statutory Verification" } }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://aia-danbury.com/certificate-request#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How quickly can Associated Insurance Agency issue a Certificate of Insurance?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most standard ACORD 25 certificates are issued within 2 to 4 business hours during normal agency hours (Monday through Friday, 8:30 AM to 5:00 PM EST). Rush certificates for active job sites or vehicle release can often be expedited by calling our Danbury headquarters at 203-748-9272."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between a Certificate Holder and an Additional Insured?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A Certificate Holder is simply the party being provided proof that you maintain insurance. An Additional Insured is a specific entity granted legal coverage status under your policy for claims arising from your operations, usually mandated by an executed written contract."
          }
        },
        {
          "@type": "Question",
          "name": "Why do commercial contracts require a Waiver of Subrogation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A Waiver of Subrogation prevents your insurance carrier from suing the certificate holder (such as the property owner or general contractor) to recover claim payments if an accident occurs on their premises, protecting all parties from protracted third-party litigation."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  title="Certificate of Insurance Request (COI) | Associated Insurance Agency CT"
  description="Request an official ACORD 25 Certificate of Insurance with additional insured endorsements, waivers of subrogation, and same-day delivery in Danbury, Watertown, and Bridgeport, CT."
  structuredData={certificateStructuredData}
  lang={lang}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-bg-secondary via-bg-primary to-bg-primary py-16 sm:py-20 border-b border-border-subtle overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#122b5f_1px,transparent_1px)] [background-size:24px_24px] opacity-[0.03] pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center space-y-4">
      <!-- Trust Pill -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/5 border border-accent/15 text-accent text-xs font-semibold">
        <span class="w-1.5 h-1.5 rounded-full bg-accent-gold animate-pulse"></span>
        <span>{t('certificate.heroTag')}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-accent leading-[1.15]">
        {t('certificate.title')}
      </h1>

      <p class="text-sm sm:text-base text-text-secondary max-w-[65ch] mx-auto leading-relaxed">
        {t('certificate.subtitle')}
      </p>

      <!-- Key Benefits Bar -->
      <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 pt-3 text-xs font-medium text-text-muted">
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Standard 2–4 Hour Turnaround</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Official ACORD 25 Standard</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Direct Email & Fax Dispatch</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Licensed Connecticut Producers</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Form Section -->
  <section class="py-12 sm:py-16 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <!-- Specialized COI Rush Banner -->
      <div class="max-w-4xl mx-auto p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-accent/5 via-accent/10 to-accent-gold/10 border border-accent/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-accent-gold">Rush Processing</span>
            <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">Same-Day</span>
          </div>
          <h2 class="text-sm sm:text-base font-bold text-accent">Contractor Job Site or Bid Deadline Today?</h2>
          <p class="text-xs text-text-secondary leading-relaxed">
            Attach your client's written insurance specifications below to ensure immediate endorsement compliance without rejected revisions.
          </p>
        </div>
        <a
          href="tel:2037489272"
          class="shrink-0 px-4 py-2.5 rounded-xl bg-accent text-white text-xs font-bold hover:bg-accent/90 transition-all shadow-xs flex items-center gap-2"
        >
          <span>Call Danbury: 203 748 9272</span>
        </a>
      </div>

      <!-- React Island Form -->
      <CertificateRequestForm client:load lang={lang} />

      <!-- Educational Guidance & FAQ Section -->
      <div class="max-w-4xl mx-auto pt-12 border-t border-border-subtle space-y-10">
        <div class="text-center space-y-2">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-accent tracking-tight">
            Understanding Connecticut Certificates of Insurance
          </h2>
          <p class="text-sm text-text-secondary max-w-2xl mx-auto">
            Clear guidelines on ACORD 25 requirements, additional insured language, and state statutory provisions.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-6 rounded-2xl border border-border-subtle bg-white shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center font-bold text-base">
              01
            </div>
            <h3 class="text-base font-bold text-accent">What is an ACORD 25 Certificate?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              The ACORD 25 is the nationally recognized standard form used by insurance brokers to certify policy existence. It summarizes policy numbers, carrier ratings, effective terms, and dollar limits for Commercial General Liability, Commercial Automobile, and Workers' Compensation.
            </p>
          </div>

          <div class="p-6 rounded-2xl border border-border-subtle bg-white shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center font-bold text-base">
              02
            </div>
            <h3 class="text-base font-bold text-accent">Additional Insured Endorsements</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Commercial landlords, general contractors, and municipalities often require status as an Additional Insured (commonly forms CG 20 10 for ongoing operations and CG 20 37 for completed operations). An executed written contract is required prior to loss occurrence.
            </p>
          </div>

          <div class="p-6 rounded-2xl border border-border-subtle bg-white shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center font-bold text-base">
              03
            </div>
            <h3 class="text-base font-bold text-accent">Waiver of Subrogation</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              A Waiver of Subrogation endorsement prohibits the insurance carrier from pursuing financial recovery against the certificate holder after paying a loss. This protects the working relationship between subcontractors and project owners.
            </p>
          </div>

          <div class="p-6 rounded-2xl border border-border-subtle bg-white shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center font-bold text-base">
              04
            </div>
            <h3 class="text-base font-bold text-accent">Primary & Non-Contributory</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              When contract specifications require "Primary and Non-Contributory" language, your policy will respond first to any covered claim, without seeking any contribution from the certificate holder's own commercial general liability policy.
            </p>
          </div>
        </div>

        <!-- Agency Support Contacts -->
        <div class="p-6 sm:p-8 rounded-2xl bg-zinc-950 text-white border border-zinc-800 space-y-6">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-zinc-800 pb-4">
            <div>
              <h3 class="text-lg font-bold text-white">Direct Agency Contact Points</h3>
              <p class="text-xs text-zinc-400 mt-0.5">Need immediate assistance or verification on an active certificate?</p>
            </div>
            <span class="px-3 py-1 rounded-full bg-accent-gold/20 text-accent-gold text-xs font-mono font-medium">
              Mon–Fri 8:30 AM – 5:00 PM EST
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs text-zinc-300">
            <div class="space-y-1.5">
              <p class="font-bold text-white text-sm">Danbury Corporate HQ</p>
              <p>50 Newtown Road, Suite 1</p>
              <p>Danbury, CT 06810</p>
              <p class="pt-1">
                <a href="tel:2037489272" class="text-accent-gold font-bold hover:underline">203 748 9272</a>
              </p>
            </div>

            <div class="space-y-1.5">
              <p class="font-bold text-white text-sm">Watertown Branch</p>
              <p>51 Depot St, Suite 112</p>
              <p>Watertown, CT 06795</p>
              <p class="pt-1">
                <a href="tel:8602748888" class="text-accent-gold font-bold hover:underline">860 274 8888</a>
              </p>
            </div>

            <div class="space-y-1.5">
              <p class="font-bold text-white text-sm">Bridgeport Branch</p>
              <p>2465 Main Street</p>
              <p>Bridgeport, CT 06606</p>
              <p class="pt-1">
                <a href="tel:2033338880" class="text-accent-gold font-bold hover:underline">203 333 8880</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
