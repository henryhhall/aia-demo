---
import BaseLayout from '../../layouts/BaseLayout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://aia-danbury.com/personal/auto#service",
      "name": "Personal Auto and RV Insurance Connecticut",
      "serviceType": "Auto and Recreational Vehicle Insurance",
      "description": "Auto, truck, RV, camper, and motorcycle insurance in Connecticut. Statutory CGS § 14-112 compliance, collision, comprehensive, and uninsured motorist protection.",
      "provider": {
        "@type": "InsuranceAgency",
        "name": "Associated Insurance Agency",
        "telephone": "+1-203-748-9272",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "50 Newtown Road, Suite 1",
          "addressLocality": "Danbury",
          "addressRegion": "CT",
          "postalCode": "06810"
        }
      },
      "areaServed": [
        { "@type": "State", "name": "Connecticut" },
        { "@type": "City", "name": "Danbury" },
        { "@type": "City", "name": "Watertown" },
        { "@type": "City", "name": "Bridgeport" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://aia-danbury.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Personal Insurance",
          "item": "https://aia-danbury.com/personal"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Auto & RV Insurance",
          "item": "https://aia-danbury.com/personal/auto"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What are Connecticut's mandatory auto insurance minimums (CGS § 14-112)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Under Connecticut General Statutes (CGS § 14-112), registered drivers must carry liability coverage of at least $25,000 bodily injury per person, $50,000 total bodily injury per accident, and $25,000 property damage (25/50/25), along with matching Uninsured and Underinsured Motorist (UM/UIM) coverage."
          }
        },
        {
          "@type": "Question",
          "name": "Why are Connecticut state minimum limits inadequate for most drivers?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "New vehicles in Connecticut now average around $48,000. If you cause a crash that totals a late-model car, a $25,000 property damage cap leaves a $23,000 gap that you have to pay out of pocket. If medical expenses for other passengers exceed your $50,000 bodily injury limit, injured parties can seek judgments against your personal savings and real estate. We recommend carrying at least 100/300/100 or 250/500/100 in liability."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between Collision and Comprehensive coverage in Connecticut?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Collision pays to repair or replace your vehicle when you hit another vehicle, hit a fixed object like a guardrail or tree, or roll over. Comprehensive covers damage from incidents outside a crash: hitting a deer or wild animal, windshield chips and cracks, theft, vandalism, fire, and branches knocked down during storms."
          }
        },
        {
          "@type": "Question",
          "name": "Can I insure my RV, camper, or travel trailer on the same policy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Most carriers require a dedicated recreational vehicle policy rather than adding an RV directly to a standard auto policy. We can bundle both policies with the same carrier or place your RV with a specialized insurer to cover campsite liability, roadside towing, and contents replacement."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  title="Connecticut Auto & RV Insurance | CGS § 14-112 Coverage | AIA Danbury"
  description="Personal car, truck, RV, and camper insurance in CT. Compare CGS § 14-112 minimum limits, collision, comprehensive, and bundling discounts across 20+ carriers."
  structuredData={structuredData}
>
  <!-- Breadcrumb -->
  <nav class="bg-bg-secondary border-b border-border-subtle py-3 text-xs text-text-muted" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2">
      <a href="/" class="hover:text-accent transition-colors">Home</a>
      <span>/</span>
      <a href="/personal" class="hover:text-accent transition-colors">Personal Insurance</a>
      <span>/</span>
      <span class="text-text-primary font-medium">Auto & RV Insurance</span>
    </div>
  </nav>

  <!-- Hero Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-16 sm:py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-accent-gold"></span>
          Danbury & Greater Western CT Auto Coverage
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-accent leading-tight">
          Connecticut Auto & RV Insurance
        </h1>
        <p class="text-base sm:text-lg text-text-secondary leading-relaxed">
          Whether you commute on I-84 and Route 7 or tow a camper up to Litchfield County on weekends, state minimum coverage rarely covers a serious crash. We compare rates across 20+ carriers to get you real liability limits, collision, and comprehensive coverage at a rate that makes sense.
        </p>
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="/quote?type=auto"
            class="px-6 py-3 rounded-lg bg-accent text-white font-semibold text-sm hover:bg-accent/90 transition-all shadow-sm"
          >
            Request Auto & RV Quote
          </a>
          <a
            href="tel:2037489272"
            class="px-6 py-3 rounded-lg border border-border-subtle bg-white text-text-primary font-semibold text-sm hover:bg-bg-secondary transition-all"
          >
            Call (203) 748-9272
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Highlights Strip -->
  <section class="border-b border-border-subtle bg-white py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <span class="block text-2xl font-bold text-accent">CGS § 14-112</span>
          <span class="text-xs text-text-muted">Statutory Minimum Compliance</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">100/300/100</span>
          <span class="text-xs text-text-muted">Recommended Minimum Liability</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">20+</span>
          <span class="text-xs text-text-muted">Regional & National Carriers</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">Auto + Home</span>
          <span class="text-xs text-text-muted">Save up to 25% with Multi-Policy Bundles</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Sections -->
  <section class="py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">

      <!-- Statutory Mandate & Risk Framing -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-7 space-y-5">
          <h2 class="text-3xl font-bold text-accent tracking-tight">
            Connecticut Auto Insurance Mandates (CGS § 14-112)
          </h2>
          <div class="p-4 bg-accent/5 border-l-4 border-accent-gold rounded-r text-sm text-text-secondary leading-relaxed">
            <p class="font-medium text-text-primary">
              Connecticut law requires every motor vehicle owner to maintain financial responsibility with minimum liability limits of $25,000 bodily injury per person, $50,000 per accident, and $25,000 property damage (25/50/25), plus matching Uninsured and Underinsured Motorist (UM/UIM) protection.
            </p>
          </div>
          <p class="text-sm text-text-secondary leading-relaxed">
            Meeting that minimum lets you legally register a car with the DMV, but $25,000 in property damage does not even cover the replacement cost of an average vehicle on Connecticut roads today. If you cause an accident with multiple injuries or total a newer car, repair and medical bills exceed state minimums fast. Any balance beyond your policy limits comes out of your own pocket.
          </p>
        </div>

        <div class="lg:col-span-5 bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
          <h3 class="text-base font-bold text-accent">
            Why 25/50/25 Limits Put Your Assets at Risk
          </h3>
          <p class="text-xs text-text-secondary leading-relaxed">
            The average new car sold today costs over $48,000. If your property damage cap is $25,000, you are personally liable for the rest.
          </p>
          <p class="text-xs text-text-secondary leading-relaxed">
            If damages exceed your policy, the other driver's attorney can pursue your personal bank accounts, place liens on your home, or garnish future wages under Connecticut court judgments. Stepping up to 100/300/100 or 250/500/100 liability usually adds only a modest amount to your monthly bill while protecting your assets.
          </p>
        </div>
      </div>

      <!-- Core Coverage Grid -->
      <div class="space-y-8">
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <h2 class="text-3xl font-bold text-accent">How Auto Coverage Works in Connecticut</h2>
          <p class="text-sm text-text-secondary">A breakdown of mandatory liability and physical damage protections.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">01</div>
            <h3 class="text-base font-bold text-text-primary">Bodily Injury Liability</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Pays medical expenses, rehabilitation, and legal representation when you are at fault in an accident causing injury to other drivers or pedestrians.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">02</div>
            <h3 class="text-base font-bold text-text-primary">Property Damage Liability</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Pays to repair or replace vehicles, guardrails, utility poles, or buildings damaged in an accident where you are at fault.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">03</div>
            <h3 class="text-base font-bold text-text-primary">Collision Coverage</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Pays to repair or replace your car if you hit another vehicle, slide off an icy road into a guardrail, or roll over, minus your deductible.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">04</div>
            <h3 class="text-base font-bold text-text-primary">Comprehensive Coverage</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Pays for damage from hazards other than crashes: hitting a deer on a rural backroad, stone chips on the windshield, theft, vandalism, storm flooding, and fallen tree branches.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">05</div>
            <h3 class="text-base font-bold text-text-primary">Uninsured / Underinsured Motorist (UM/UIM)</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Protects you and your passengers if struck by an uninsured driver, a hit-and-run motorist, or a driver whose policy limits fall short of your medical bills.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">06</div>
            <h3 class="text-base font-bold text-text-primary">Roadside Assistance & Rental Reimbursement</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Covers 24/7 towing, jump-starts, flat tire changes, and rental car reimbursements while your vehicle is in the repair shop following a claim.
            </p>
          </div>
        </div>
      </div>

      <!-- RV, Camper & Recreational Vehicles -->
      <div class="bg-bg-secondary p-8 sm:p-10 rounded-2xl border border-border-subtle space-y-6">
        <div class="max-w-2xl space-y-2">
          <h2 class="text-2xl sm:text-3xl font-bold text-accent">RV, Motorhome, and Camper Insurance</h2>
          <p class="text-xs sm:text-sm text-text-secondary">
            A standard auto policy does not cover living quarters, detached trailers, or campsite liability. We write specialized policies for recreational vehicles:
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
          <div class="bg-white p-4 rounded-lg border border-border-subtle">
            <strong class="text-accent block mb-1">Motorhomes (Class A, B, C)</strong>
            <p class="text-text-muted">Physical damage and liability coverage tailored to drivable motorhomes, camper vans, and custom conversions.</p>
          </div>
          <div class="bg-white p-4 rounded-lg border border-border-subtle">
            <strong class="text-accent block mb-1">Travel Trailers & Campers</strong>
            <p class="text-text-muted">Protection for fifth wheels, pop-up campers, and toy haulers both while being towed on highways and unhitched at campsites.</p>
          </div>
          <div class="bg-white p-4 rounded-lg border border-border-subtle">
            <strong class="text-accent block mb-1">Campsite Liability</strong>
            <p class="text-text-muted">Premises liability protection if a visitor trips or is injured around your parked RV at a campground.</p>
          </div>
          <div class="bg-white p-4 rounded-lg border border-border-subtle">
            <strong class="text-accent block mb-1">Personal Effects Coverage</strong>
            <p class="text-text-muted">Replacement coverage for camping equipment, cooking gear, clothing, and electronics kept inside your vehicle.</p>
          </div>
        </div>
      </div>

      <!-- Connecticut Discounts Strip -->
      <div class="bg-white p-8 rounded-2xl border border-border-subtle shadow-sm space-y-4">
        <h2 class="text-2xl font-bold text-accent">Ways to Save on Connecticut Auto Insurance</h2>
        <p class="text-sm text-text-secondary leading-relaxed">
          Associated Insurance Agency shops across 20+ top auto insurance carriers to apply every discount you qualify for:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-2 text-xs text-text-secondary">
          <div class="space-y-1">
            <strong class="text-accent block">Multi-Policy Bundles</strong>
            <p>Save 15% to 25% when you combine auto coverage with homeowners, condo, or renters insurance under the same carrier.</p>
          </div>
          <div class="space-y-1">
            <strong class="text-accent block">Telematics & Safe Driver</strong>
            <p>Optional mobile apps or plug-in devices reward safe driving habits, low mileage, and gentle braking with discounts up to 30%.</p>
          </div>
          <div class="space-y-1">
            <strong class="text-accent block">Student & Defensive Driving</strong>
            <p>Discounts for full-time students maintaining a B average, college students away at school without a car, and drivers age 60+ who complete an approved defensive driving course.</p>
          </div>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="space-y-8 max-w-4xl mx-auto">
        <div class="text-center space-y-2">
          <h2 class="text-3xl font-bold text-accent">Frequently Asked Questions</h2>
          <p class="text-sm text-text-secondary">Answers to common Connecticut auto and RV insurance questions.</p>
        </div>

        <div class="space-y-4">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">What are Connecticut's mandatory auto insurance minimums (CGS § 14-112)?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Under Connecticut General Statutes (CGS § 14-112), registered drivers must carry liability coverage of at least $25,000 bodily injury per person, $50,000 total bodily injury per accident, and $25,000 property damage (25/50/25), along with matching Uninsured and Underinsured Motorist (UM/UIM) coverage.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-y-2">
            <h3 class="text-base font-bold text-accent">Why are Connecticut state minimum limits inadequate for most drivers?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              New vehicles in Connecticut now average around $48,000. If you cause a crash that totals a late-model car, a $25,000 property damage cap leaves a $23,000 gap that you have to pay out of pocket. If medical expenses for other passengers exceed your $50,000 bodily injury limit, injured parties can seek judgments against your personal savings and real estate. We recommend carrying at least 100/300/100 or 250/500/100 in liability.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">What is the difference between Collision and Comprehensive coverage in Connecticut?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Collision pays to repair or replace your vehicle when you hit another vehicle, hit a fixed object like a guardrail or tree, or roll over. Comprehensive covers damage from incidents outside a crash: hitting a deer or wild animal, windshield chips and cracks, theft, vandalism, fire, and branches knocked down during storms.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">Can I insure my RV, camper, or travel trailer on the same policy?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Most carriers require a dedicated recreational vehicle policy rather than adding an RV directly to a standard auto policy. We can bundle both policies with the same carrier or place your RV with a specialized insurer to cover campsite liability, roadside towing, and contents replacement.
            </p>
          </div>
        </div>
      </div>

      <!-- Conversion Banner -->
      <div class="bg-accent text-white p-8 sm:p-12 rounded-2xl shadow-xl flex flex-col md:flex-row justify-between items-center gap-8">
        <div class="space-y-2 text-center md:text-left">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">Talk to a Danbury Agent About Auto Coverage</h2>
          <p class="text-sm text-zinc-300 max-w-xl">
            We shop your policy across more than 20 carriers to find the right balance of price and protection for your cars and recreational vehicles.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a
            href="/quote?type=auto"
            class="px-6 py-3 rounded-lg bg-accent-gold hover:bg-accent-gold-hover text-zinc-950 font-bold text-sm transition-colors text-center"
          >
            Get an Auto Quote
          </a>
          <a
            href="tel:2037489272"
            class="px-6 py-3 rounded-lg bg-white/10 hover:bg-white/20 text-white font-semibold text-sm transition-colors text-center"
          >
            (203) 748-9272
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
