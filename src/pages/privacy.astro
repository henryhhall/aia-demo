---
/**
 * Privacy Policy (English) - Associated Insurance Agency
 * Comprehensive boilerplate privacy policy tailored to independent insurance brokerages,
 * covering GLBA (Gramm-Leach-Bliley Act), Connecticut Data Privacy Act (CTDPA),
 * non-public personal information (NPI), carrier sharing, and strict 10DLC / SMS privacy rules.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Privacy Policy | Associated Insurance Agency",
  "description": "Privacy policy and Gramm-Leach-Bliley Act (GLBA) consumer financial notice for Associated Insurance Agency in Connecticut.",
  "publisher": {
    "@type": "InsuranceAgency",
    "name": "Associated Insurance Agency",
    "telephone": "+1-203-748-9272",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "50 Newtown Road, Suite 1",
      "addressLocality": "Danbury",
      "addressRegion": "CT",
      "postalCode": "06810",
      "addressCountry": "US"
    }
  }
};
---

<BaseLayout
  title="Privacy Policy | Associated Insurance Agency CT"
  description="Read the Privacy Policy for Associated Insurance Agency. Learn how we safeguard your personal information, GLBA insurance financial privacy, and strict mobile SMS confidentiality."
  structuredData={structuredData}
>
  <!-- Page Header / Hero -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-16 sm:py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-accent/5 text-accent text-xs font-semibold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-accent-gold animate-pulse"></span>
        Privacy & Data Protection Notice
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-accent leading-none">
        {t('privacy.title')}
      </h1>
      <p class="text-sm sm:text-base text-text-secondary max-w-[65ch] mx-auto leading-relaxed">
        {t('privacy.subtitle')}
      </p>
      <div class="pt-2 flex items-center justify-center gap-3 text-xs text-text-muted">
        <span>Effective Date: October 2026</span>
        <span>•</span>
        <span>Last Updated: October 2026</span>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16 sm:py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Sticky Table of Contents (Desktop Sidebar) -->
        <aside class="hidden lg:block lg:col-span-4 sticky top-28 space-y-6">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
            <h2 class="text-sm font-bold text-accent uppercase tracking-wider border-b border-border-subtle pb-3 flex items-center gap-2">
              <span class="w-1.5 h-4 bg-accent-gold rounded-full"></span>
              Table of Contents
            </h2>
            <nav class="space-y-1.5 text-xs text-text-secondary">
              <a href="#overview" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">1. Overview & GLBA Notice</a>
              <a href="#information-collected" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">2. Information We Collect</a>
              <a href="#mobile-sms-privacy" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors text-accent font-semibold">3. Strict Mobile & SMS Privacy</a>
              <a href="#how-we-use" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">4. How We Use Information</a>
              <a href="#sharing-disclosures" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">5. Sharing & Carrier Disclosures</a>
              <a href="#cookies-tracking" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">6. Cookies & Automated Logs</a>
              <a href="#data-security" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">7. Safeguards & Data Security</a>
              <a href="#data-retention" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">8. Record Retention Requirements</a>
              <a href="#your-rights" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">9. Your Privacy Rights & Choices</a>
              <a href="#children" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">10. Children's Privacy</a>
              <a href="#policy-changes" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">11. Changes to this Policy</a>
              <a href="#privacy-contact" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">12. Contact Our Privacy Officer</a>
            </nav>
          </div>

          <!-- Quick Assistance Widget -->
          <div class="bg-accent text-white p-6 rounded-xl shadow-md space-y-3">
            <h3 class="text-sm font-bold text-accent-gold">Questions on Your Privacy?</h3>
            <p class="text-xs text-zinc-300 leading-relaxed">
              Our licensed insurance team is committed to safeguarding your Non-public Personal Information (NPI). Contact our Danbury office with any inquiries.
            </p>
            <div class="pt-2">
              <a href="tel:2037489272" class="inline-flex items-center gap-2 text-xs font-semibold text-white hover:text-accent-gold transition-colors">
                <svg class="w-4 h-4 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.942-6.942l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                </svg>
                (203) 748-9272
              </a>
            </div>
          </div>
        </aside>

        <!-- Privacy Content Sections -->
        <div class="lg:col-span-8 space-y-10 text-left">
          
          <!-- Executive Summary Card -->
          <div class="p-5 sm:p-6 bg-accent/5 border-l-4 border-accent-gold rounded-r-xl space-y-2">
            <h2 class="text-base font-bold text-accent">Our Commitment to Your Privacy</h2>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              <strong>Associated Insurance Agency</strong> ("AIA", "we", "us", or "our") values your trust. As an independent insurance agency operating in Danbury, Watertown, and Bridgeport, Connecticut, we handle sensitive personal and financial information necessary to obtain insurance quotes, bind coverages, and service policies. We never sell your personal information or mobile numbers to third-party telemarketers or marketing lists.
            </p>
          </div>

          <!-- Section 1 -->
          <article id="overview" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Section 1</span>
              Overview & Gramm-Leach-Bliley Act (GLBA) Notice
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              This Privacy Policy explains how Associated Insurance Agency collects, uses, protects, and discloses personal information and Non-public Personal Financial Information (NPI) obtained through our website (<a href="https://aia-danbury.com" class="text-accent underline font-medium">https://aia-danbury.com</a>), online quote tools, telephone calls, electronic mail, and in-person consultations.
            </p>
            <p class="text-sm text-text-secondary leading-relaxed">
              Under Title V of the Gramm-Leach-Bliley Act (GLBA) and Connecticut Insurance Department privacy regulations, financial institutions including licensed insurance agencies are required to disclose their privacy policies and practices to consumers.
            </p>
          </article>

          <!-- Section 2 -->
          <article id="information-collected" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Section 2</span>
              Information We Collect
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              To evaluate your insurance risk and obtain accurate premium proposals from our carrier partners, we collect various categories of information:
            </p>
            <div class="space-y-2.5 text-xs text-text-secondary">
              <div class="p-3 bg-bg-secondary rounded-lg border border-border-subtle">
                <strong class="text-text-primary block mb-0.5">Contact Information</strong>
                Full name, residential and mailing address, email address, telephone numbers, and preferred office branch.
              </div>
              <div class="p-3 bg-bg-secondary rounded-lg border border-border-subtle">
                <strong class="text-text-primary block mb-0.5">Insurance & Underwriting Details</strong>
                Vehicle Identification Numbers (VIN), driving records, property age, construction characteristics, mortgage holders, prior insurance carrier, and past claims history.
              </div>
              <div class="p-3 bg-bg-secondary rounded-lg border border-border-subtle">
                <strong class="text-text-primary block mb-0.5">Commercial & Business Information</strong>
                Business name, Federal Employer Identification Number (FEIN), payroll, gross sales, commercial locations, and operational classifications.
              </div>
              <div class="p-3 bg-bg-secondary rounded-lg border border-border-subtle">
                <strong class="text-text-primary block mb-0.5">Technical & Automated Data</strong>
                IP addresses, browser type, operating system, referring URL, time stamps, and honeypot form security parameters used to prevent bot submissions.
              </div>
            </div>
          </article>

          <!-- Section 3: Strict Mobile / SMS Privacy (Carrier 10DLC Compliance) -->
          <article id="mobile-sms-privacy" class="space-y-4 scroll-mt-28 p-6 bg-accent/5 border border-accent/20 rounded-xl">
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
              </svg>
              <div>
                <h2 class="text-lg font-bold text-accent">
                  Section 3: Strict Mobile Information & SMS Confidentiality (10DLC / CTIA)
                </h2>
                <div class="mt-2 p-3 bg-white border border-border-subtle rounded-lg text-sm text-text-primary font-medium leading-relaxed">
                  "No mobile information will be shared with third parties/affiliates for marketing/promotional purposes. All other categories exclude text messaging originator opt-in data and consent; this information will not be shared with any third parties."
                </div>
              </div>
            </div>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              When you submit a contact inquiry or quote request on our forms, our disclosure states: <em>"Providing a number permits calls/texts from us regarding the message."</em>
            </p>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Your mobile phone number and SMS consent records are used <strong>exclusively</strong> by Associated Insurance Agency to communicate directly with you regarding your quote request, policy servicing questions, policy documents, or renewal notices. We never sell, lease, transfer, or distribute your mobile number or SMS opt-in consent to any third-party marketing networks, lead generators, or affiliates.
            </p>
            <ul class="space-y-1 text-xs text-text-secondary pl-5 list-disc">
              <li>You may opt out of SMS communications at any time by replying <strong>STOP</strong>.</li>
              <li>Reply <strong>HELP</strong> for information or customer service.</li>
            </ul>
          </article>

          <!-- Section 4 -->
          <article id="how-we-use" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Section 4</span>
              How We Use Your Information
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              We use the collected information strictly for legitimate insurance brokerage operations:
            </p>
            <ul class="space-y-2 text-xs sm:text-sm text-text-secondary pl-5 list-disc">
              <li><strong>Shopping Rates:</strong> Submitting preliminary risk data to licensed insurance carriers to compare policy premiums and terms on your behalf.</li>
              <li><strong>Policy Servicing:</strong> Assisting you with policy changes, adding drivers or vehicles, certificate of insurance (COI) issuance, and billing inquiries.</li>
              <li><strong>Direct Communication:</strong> Contacting you by phone, email, text message, or postal mail regarding your requested quotes, active policies, and renewal reviews.</li>
              <li><strong>Fraud Mitigation:</strong> Protecting our systems against automated spam, fraudulent submissions, and unauthorized access.</li>
              <li><strong>Legal Compliance:</strong> Complying with Connecticut state insurance licensing requirements, audit mandates, and regulatory oversight.</li>
            </ul>
          </article>

          <!-- Section 5 -->
          <article id="sharing-disclosures" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Section 5</span>
              Information Sharing & Disclosures
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              As an independent agency, AIA shares your information solely with parties necessary to complete your insurance transactions:
            </p>
            <ul class="space-y-2 text-xs sm:text-sm text-text-secondary pl-5 list-disc">
              <li><strong>Insurance Carriers & General Agencies:</strong> To obtain competitive quotes, underwrite policies, and bind coverage (e.g., Safeco, Travelers, Progressive, The Hartford, Foremost, Guard, etc.).</li>
              <li><strong>Consumer Reporting Agencies:</strong> Authorized underwriting carriers may request motor vehicle reports (MVR) and Comprehensive Loss Underwriting Exchange (C.L.U.E.) reports to calculate final rates.</li>
              <li><strong>Service Providers:</strong> Secure technology vendors who host our website, agency management systems, or document storage under strict contractual confidentiality duties.</li>
              <li><strong>Legal & Regulatory Authorities:</strong> In response to valid subpoenas, court orders, or official inquiries by the Connecticut Insurance Department.</li>
            </ul>
            <p class="text-xs font-semibold text-accent pt-1">
              WE DO NOT SELL, RENT, OR TRADE YOUR PERSONAL INFORMATION TO THIRD PARTIES FOR COMMERCIAL ADVERTISING.
            </p>
          </article>

          <!-- Section 6 -->
          <article id="cookies-tracking" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Section 6</span>
              Cookies & Automated Technical Data
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Our website uses standard session cookies and security tokens to ensure proper navigation and prevent fraudulent submissions. We do not use intrusive cross-site tracking pixels or invasive third-party behavioral profiling cookies.
            </p>
            <p class="text-sm text-text-secondary leading-relaxed">
              You can set your browser to refuse cookies; however, certain interactive form features may not function as intended without session cookies enabled.
            </p>
          </article>

          <!-- Section 7 -->
          <article id="data-security" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Section 7</span>
              Safeguards & Data Security
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              AIA maintains physical, electronic, and procedural safeguards in compliance with federal GLBA standards and the Connecticut Data Privacy Act (CTDPA). These safeguards include SSL/TLS encryption for all website communications, firewall protections, restricted agent access controls, and secure agency management software.
            </p>
            <p class="text-sm text-text-secondary leading-relaxed">
              While we employ robust security measures, no data transmission over the Internet or electronic storage can be guaranteed 100% secure. We encourage you to use caution when transmitting sensitive records.
            </p>
          </article>

          <!-- Section 8 -->
          <article id="data-retention" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Section 8</span>
              Record Retention Requirements
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Insurance agencies are subject to specific record retention regulations enforced by the Connecticut Insurance Department and federal authorities. We retain policyholder records, quote applications, and communications for the statutory periods mandated by state insurance law (typically a minimum of five to seven years following policy expiration or cancellation).
            </p>
          </article>

          <!-- Section 9 -->
          <article id="your-rights" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Section 9</span>
              Your Privacy Rights & Choices
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Depending on your jurisdiction and subject to statutory insurance recordkeeping requirements, you have the right to:
            </p>
            <ul class="space-y-1.5 text-xs sm:text-sm text-text-secondary pl-5 list-disc">
              <li>Request access to review personal information maintained in your active customer file.</li>
              <li>Request corrections to any inaccurate, outdated, or incomplete information.</li>
              <li>Opt out of promotional communications at any time (via email unsubscribe links or texting STOP).</li>
            </ul>
          </article>

          <!-- Section 10 -->
          <article id="children" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Section 10</span>
              Children's Privacy (COPPA)
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Our website is intended for adult consumers and commercial business owners. We do not knowingly collect personal information online from children under the age of 13. If you believe a child has provided us with personal information, please contact us immediately so we can remove the data.
            </p>
          </article>

          <!-- Section 11 -->
          <article id="policy-changes" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Section 11</span>
              Changes to this Privacy Policy
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              AIA reserves the right to amend or update this Privacy Policy periodically to reflect changes in our practices or applicable legal mandates. Revisions become effective upon posting to this page with an updated "Last Updated" timestamp.
            </p>
          </article>

          <!-- Section 12: Contact -->
          <article id="privacy-contact" class="space-y-4 scroll-mt-28 pt-6 border-t border-border-subtle">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Section 12</span>
              Contact Our Agency Privacy Officer
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              If you have any questions, concerns, or requests regarding this Privacy Policy or our handling of your information, please reach out to our team:
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
              <div class="p-4 bg-bg-secondary rounded-lg border border-border-subtle space-y-1 text-xs">
                <span class="font-bold text-accent block">Danbury HQ</span>
                <span class="text-text-secondary block">50 Newtown Road, Suite 1</span>
                <span class="text-text-secondary block">Danbury, CT 06810</span>
                <a href="tel:2037489272" class="text-accent font-semibold hover:underline block pt-1">(203) 748-9272</a>
              </div>
              <div class="p-4 bg-bg-secondary rounded-lg border border-border-subtle space-y-1 text-xs">
                <span class="font-bold text-accent block">Watertown Office</span>
                <span class="text-text-secondary block">1157 Main Street</span>
                <span class="text-text-secondary block">Watertown, CT 06795</span>
                <a href="tel:8602747100" class="text-accent font-semibold hover:underline block pt-1">(860) 274-7100</a>
              </div>
              <div class="p-4 bg-bg-secondary rounded-lg border border-border-subtle space-y-1 text-xs">
                <span class="font-bold text-accent block">Bridgeport Office</span>
                <span class="text-text-secondary block">2465 Main Street</span>
                <span class="text-text-secondary block">Bridgeport, CT 06606</span>
                <a href="tel:2033675300" class="text-accent font-semibold hover:underline block pt-1">(203) 367-5300</a>
              </div>
            </div>
          </article>

        </div>

      </div>
    </div>
  </section>
</BaseLayout>
