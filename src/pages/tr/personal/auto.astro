---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://aia-danbury.com/tr/personal/auto#service",
      "name": "Otomobil ve Karavan Sigortası Connecticut",
      "serviceType": "Auto and Recreational Vehicle Insurance",
      "description": "Connecticut'ta otomobil, SUV, kamyonet ve karavan sigortası. CGS § 14-112 yasal uyumluluğu, kasko (çarpışma/kapsamlı) ve sigortasız sürücü teminatları.",
      "provider": {
        "@type": "InsuranceAgency",
        "name": "Associated Insurance Agency",
        "telephone": "+1-203-748-9272",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "50 Newtown Road, Suite 1",
          "addressLocality": "Danbury",
          "addressRegion": "CT",
          "postalCode": "06810"
        }
      },
      "areaServed": [
        { "@type": "State", "name": "Connecticut" },
        { "@type": "City", "name": "Danbury" },
        { "@type": "City", "name": "Watertown" },
        { "@type": "City", "name": "Bridgeport" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Ana Sayfa",
          "item": "https://aia-danbury.com/tr"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Bireysel Sigorta",
          "item": "https://aia-danbury.com/tr/personal"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Otomobil ve Karavan",
          "item": "https://aia-danbury.com/tr/personal/auto"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Connecticut zorunlu araç sigortası yasal asgari limitleri nelerdir (CGS § 14-112)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Connecticut Genel Kanunları (CGS § 14-112) uyarınca sürücüler kişi başına en az $25,000 bedensel yaralanma, kaza başına toplam $50,000 bedensel yaralanma ve $25,000 maddi hasar (25/50/25) sorumluluk teminatı ve buna denk Sigortasız/Yetersiz Sigortalı Sürücü (UM/UIM) teminatı taşımak zorundadır."
          }
        },
        {
          "@type": "Question",
          "name": "Eyalet asgari limitleri çoğu sürücü için neden yetersizdir?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bugün yeni bir aracın ortalama fiyatı $48,000'ı aşmaktadır. Yeni model bir aracın perte çıktığı bir kazaya neden olursanız, eyaletin $25,000'lık maddi hasar tavanı geriye kalan $23,000'ı cebinizden ödemenize yol açar. Tıbbi masraflar $50,000 limitinizi aşarsa karşı taraf birikimlerinize ve gayrimenkulünüze dava açabilir. En az 100/300/100 veya 250/500/100 limitlerini öneriyoruz."
          }
        },
        {
          "@type": "Question",
          "name": "Çarpışma (Collision) ile Kapsamlı (Comprehensive) kasko arasındaki fark nedir?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Çarpışma teminatı başka bir araca çarpma, bariyerlere vurma veya devrilme durumunda kendi aracınızın hasarını karşılar. Kapsamlı kasko ise kaza dışındaki riskleri öder: geyik çarpması, ön cam çatlağı, hırsızlık, yangın, dolu ve fırtınada düşen ağaç dalları."
          }
        },
        {
          "@type": "Question",
          "name": "Karavan veya kamp römorkumu aynı poliçeye ekleyebilir miyim?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Çoğu sigorta şirketi rekreasyonel araçlar için standart araç poliçesi yerine özel karavan poliçesi düzenler. Her iki poliçeyi aynı şirkette birleştirerek paket indirimlerinden faydalanabilir ve kamp alanı sorumluluğu ile kişisel eşya güvencesini sağlayabiliriz."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  lang="tr"
  title="Connecticut Otomobil ve Karavan Sigortası | CGS § 14-112 | AIA Danbury"
  description="Connecticut'ta araba, kamyonet ve karavan sigortası. CGS § 14-112 yasal asgari limitleri, kasko, sigortasız sürücü ve 20'den fazla şirkette indirimler."
  structuredData={structuredData}
>
  <!-- Breadcrumb -->
  <nav class="bg-bg-secondary border-b border-border-subtle py-3 text-xs text-text-muted" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2">
      <a href="/tr" class="hover:text-accent transition-colors">Ana Sayfa</a>
      <span>/</span>
      <a href="/tr/personal" class="hover:text-accent transition-colors">Bireysel Sigorta</a>
      <span>/</span>
      <span class="text-text-primary font-medium">Otomobil ve Karavan</span>
    </div>
  </nav>

  <!-- Hero Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-16 sm:py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-accent-gold"></span>
          Danbury ve Connecticut Araç Sigortası
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-accent leading-tight">
          Connecticut Otomobil ve Karavan Sigortası
        </h1>
        <p class="text-base sm:text-lg text-text-secondary leading-relaxed">
          İster her gün I-84 ve Route 7 güzergâhında işe gidip gelin, ister hafta sonu karavanınızla Connecticut yollarına çıkın; eyaletin zorunlu tuttuğu asgari teminatlar ciddi bir kazada yetersiz kalır. 20'den fazla sigorta şirketinin tekliflerini karşılaştırarak bütçenizi sarsmadan gerçek sorumluluk, çarpışma ve kapsamlı kasko limitleri sunuyoruz.
        </p>
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="/tr/quote?type=auto"
            class="px-6 py-3 rounded-lg bg-accent text-white font-semibold text-sm hover:bg-accent/90 transition-all shadow-sm"
          >
            Araç Sigortası Teklifi Al
          </a>
          <a
            href="tel:2037489272"
            class="px-6 py-3 rounded-lg border border-border-subtle bg-white text-text-primary font-semibold text-sm hover:bg-bg-secondary transition-all"
          >
            (203) 748-9272 Numarasını Arayın
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Highlights Strip -->
  <section class="border-b border-border-subtle bg-white py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <span class="block text-2xl font-bold text-accent">CGS § 14-112</span>
          <span class="text-xs text-text-muted">Eyalet Yasal Asgari Limiti</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">100/300/100</span>
          <span class="text-xs text-text-muted">Tavsiye Edilen Teminat</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">20+</span>
          <span class="text-xs text-text-muted">Karşılaştırılan Sigorta Şirketi</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">Ev + Araç</span>
          <span class="text-xs text-text-muted">Pakette %25'e Varan Tasarruf</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Sections -->
  <section class="py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">

      <!-- Statutory Mandate & Risk Framing -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-7 space-y-5">
          <h2 class="text-3xl font-bold text-accent tracking-tight">
            Connecticut Araç Sigortası Zorunlulukları (CGS § 14-112)
          </h2>
          <div class="p-4 bg-accent/5 border-l-4 border-accent-gold rounded-r text-sm text-text-secondary leading-relaxed">
            <p class="font-medium text-text-primary">
              Connecticut yasaları, her araç sahibinin kişi başı $25,000 bedensel yaralanma, kaza başı $50,000 toplam bedensel yaralanma ve $25,000 maddi hasar (25/50/25) asgari sorumluluk limitine ve buna denk sigortasız sürücü (UM/UIM) teminatına sahip olmasını şart koşar.
            </p>
          </div>
          <p class="text-sm text-text-secondary leading-relaxed">
            Bu asgari limitler DMV tescili için yeterlidir; ancak $25,000'lık maddi hasar tavanı Connecticut yollarındaki ortalama bir aracın pert bedelini bile karşılamaz. Yaralanmaların olduğu veya yeni model bir aracın karıştığı kazalarda faturalar eyalet limitlerini hızla aşar. Poliçenizin limitini aşan her tutar doğrudan kendi cebinizden çıkar.
          </p>
        </div>

        <div class="lg:col-span-5 bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
          <h3 class="text-base font-bold text-accent">
            25/50/25 limitleri mal varlığınızı neden riske atar?
          </h3>
          <p class="text-xs text-text-secondary leading-relaxed">
            Bugün satılan yeni bir aracın ortalama fiyatı $48,000'ın üzerindedir. Maddi hasar teminatınız $25,000 ise aradaki farktan şahsen sorumlu olursunuz.
          </p>
          <p class="text-xs text-text-secondary leading-relaxed">
            Poliçe tavanı tükendiğinde Connecticut mahkemeleri banka birikimlerinize ve gayrimenkulünüze haciz koyabilir, gelecekteki maaşınızdan kesinti yapabilir. Teminatınızı 100/300/100 veya 250/500/100 seviyesine yükseltmek aylık priminize cüzi bir miktar eklerken birikimlerinizi korur.
          </p>
        </div>
      </div>

      <!-- Core Coverage Grid -->
      <div class="space-y-8">
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <h2 class="text-3xl font-bold text-accent">Connecticut'ta Araç Teminatları Nasıl Çalışır?</h2>
          <p class="text-sm text-text-secondary">Zorunlu mali mesuliyet ve araç hasar güvencelerinin ayrıntıları.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">01</div>
            <h3 class="text-base font-bold text-text-primary">Bedensel Yaralanma Sorumluluğu</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Kusurlu olduğunuz bir kazada karşı taraftaki sürücü ve yolcuların tedavi, rehabilitasyon masraflarını ve mahkeme savunma giderlerini karşılar.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">02</div>
            <h3 class="text-base font-bold text-text-primary">Maddi Hasar Sorumluluğu</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Kusurlu kazalarda başkalarının araçlarında, yol bariyerlerinde, direklerde veya binalarda oluşan hasarları öder.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">03</div>
            <h3 class="text-base font-bold text-text-primary">Çarpışma (Collision) Kaskosu</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Başka bir araca çarpma, buzda kayıp bariyerlere vurma veya devrilme durumunda muafiyet düşüldükten sonra kendi aracınızın tamirini veya rayiç bedelini karşılar.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">04</div>
            <h3 class="text-base font-bold text-text-primary">Kapsamlı (Comprehensive) Kasko</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Trafik kazası dışındaki riskleri karşılar: kırsal yollarda geyik çarpması, ön cam çatlaması, hırsızlık, vandalizm, dolu ve fırtınada devrilen ağaç dalları.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">05</div>
            <h3 class="text-base font-bold text-text-primary">Sigortasız Sürücü (UM/UIM) Teminatı</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Sigortasız veya olay yerinden kaçan bir sürücü size çarptığında sizin ve yolcularınızın tıbbi masraflarını güvenceye alır.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">06</div>
            <h3 class="text-base font-bold text-text-primary">Çekici ve İkame Araç</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              7/24 yol yardımı, akü takviyesi, lastik değişimi ve aracınız hasar sonrası onarımdayken kiralık araç giderlerinin karşılanmasını sağlar.
            </p>
          </div>
        </div>
      </div>

      <!-- RV & Campers Section -->
      <div class="bg-bg-secondary p-8 sm:p-10 rounded-2xl border border-border-subtle space-y-6">
        <div class="max-w-2xl space-y-2">
          <h2 class="text-2xl sm:text-3xl font-bold text-accent">Karavan, Motokaravan ve Çekme Karavan Sigortası</h2>
          <p class="text-xs sm:text-sm text-text-secondary">
            Standart otomobil sigortası karavan yaşam alanlarını ve kamp alanı sorumluluğunu kapsamaz. Rekreasyonel araçlar için özel poliçeler düzenliyoruz:
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
          <div class="bg-white p-4 rounded-lg border border-border-subtle">
            <strong class="text-accent block mb-1">Motokaravanlar (A, B, C Sınıfı)</strong>
            <p class="text-text-muted">Motokaravanlar ve özel karavan dönüşümleri için hasar ve sorumluluk teminatı.</p>
          </div>
          <div class="bg-white p-4 rounded-lg border border-border-subtle">
            <strong class="text-accent block mb-1">Çekme Karavan ve Römorklar</strong>
            <p class="text-text-muted">Otoyolda çekilme anında ve kamp alanında sabit dururken tam güvence.</p>
          </div>
          <div class="bg-white p-4 rounded-lg border border-border-subtle">
            <strong class="text-accent block mb-1">Kamp Alanı Sorumluluk Teminatı</strong>
            <p class="text-text-muted">Karavanınız park halindeyken bir misafirin düşmesi veya yaralanması riskine karşı üçüncü şahıs koruması.</p>
          </div>
          <div class="bg-white p-4 rounded-lg border border-border-subtle">
            <strong class="text-accent block mb-1">Karavan İçi Kişisel Eşyalar</strong>
            <p class="text-text-muted">Karavan içinde saklanan kamp ekipmanları, mutfak gereçleri ve elektronik cihazlar için yeni alım bedeli güvencesi.</p>
          </div>
        </div>
      </div>

      <!-- Connecticut Discounts Strip -->
      <div class="bg-white p-8 rounded-2xl border border-border-subtle shadow-sm space-y-4">
        <h2 class="text-2xl font-bold text-accent">Connecticut'ta Araç Sigortasından Tasarruf Etmenin Yolları</h2>
        <p class="text-sm text-text-secondary leading-relaxed">
          Associated Insurance Agency, 20'den fazla şirketi tarayarak adınıza tüm indirimleri uygular:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-2 text-xs text-text-secondary">
          <div class="space-y-1">
            <strong class="text-accent block">Çoklu Poliçe Paketi</strong>
            <p>Araç sigortanızı konut, daire veya kiracı sigortanızla aynı şirkette birleştirerek %15 ile %25 arasında tasarruf edin.</p>
          </div>
          <div class="space-y-1">
            <strong class="text-accent block">Telematik ve Güvenli Sürüş</strong>
            <p>Düşük kilometre ve kontrollü frenleme için mobil uygulama veya cihaz takibiyle %30'a varan indirimler.</p>
          </div>
          <div class="space-y-1">
            <strong class="text-accent block">Öğrenci ve İleri Sürüş</strong>
            <p>Not ortalaması yüksek öğrenciler, uzakta okuyan gençler ve eyalet onaylı güvenli sürüş kursu alan 60 yaş üstü sürücüler için özel indirimler.</p>
          </div>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="space-y-8 max-w-4xl mx-auto">
        <div class="text-center space-y-2">
          <h2 class="text-3xl font-bold text-accent">Sıkça Sorulan Sorular</h2>
          <p class="text-sm text-text-secondary">Connecticut araç ve karavan sigortası hakkında net cevaplar.</p>
        </div>

        <div class="space-y-4">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">Connecticut zorunlu araç sigortası yasal asgari limitleri nelerdir (CGS § 14-112)?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Connecticut Genel Kanunları (CGS § 14-112) uyarınca sürücüler kişi başına en az $25,000 bedensel yaralanma, kaza başına toplam $50,000 bedensel yaralanma ve $25,000 maddi hasar (25/50/25) sorumluluk teminatı ve buna denk Sigortasız/Yetersiz Sigortalı Sürücü (UM/UIM) teminatı taşımak zorundadır.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">Eyalet asgari limitleri çoğu sürücü için neden yetersizdir?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Bugün yeni bir aracın ortalama fiyatı $48,000'ı aşmaktadır. Yeni model bir aracın perte çıktığı bir kazaya neden olursanız, eyaletin $25,000'lık maddi hasar tavanı geriye kalan $23,000'ı cebinizden ödemenize yol açar. Tıbbi masraflar $50,000 limitinizi aşarsa karşı taraf birikimlerinize ve gayrimenkulünüze dava açabilir. En az 100/300/100 veya 250/500/100 limitlerini öneriyoruz.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">Çarpışma (Collision) ile Kapsamlı (Comprehensive) kasko arasındaki fark nedir?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Çarpışma teminatı başka bir araca çarpma, bariyerlere vurma veya devrilme durumunda kendi aracınızın hasarını karşılar. Kapsamlı kasko ise kaza dışındaki riskleri öder: geyik çarpması, ön cam çatlağı, hırsızlık, yangın, dolu ve fırtınada düşen ağaç dalları.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">Karavan veya kamp römorkumu aynı poliçeye ekleyebilir miyim?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Çoğu sigorta şirketi rekreasyonel araçlar için standart araç poliçesi yerine özel karavan poliçesi düzenler. Her iki poliçeyi aynı şirkette birleştirerek paket indirimlerinden faydalanabilir ve kamp alanı sorumluluğu ile kişisel eşya güvencesini sağlayabiliriz.
            </p>
          </div>
        </div>
      </div>

      <!-- Conversion Banner -->
      <div class="bg-accent text-white p-8 sm:p-12 rounded-2xl shadow-xl flex flex-col md:flex-row justify-between items-center gap-8">
        <div class="space-y-2 text-center md:text-left">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">Danbury Acentemizle Araç Sigortanızı Değerlendirin</h2>
          <p class="text-sm text-zinc-300 max-w-xl">
            Araçlarınız ve karavanınız için en doğru fiyat-koruma dengesini bulmak üzere 20'den fazla lider sigorta şirketinden teklif alıyoruz.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a
            href="/tr/quote?type=auto"
            class="px-6 py-3 rounded-lg bg-accent-gold hover:bg-accent-gold-hover text-zinc-950 font-bold text-sm transition-colors text-center"
          >
            Araç Teklifi İsteyin
          </a>
          <a
            href="tel:2037489272"
            class="px-6 py-3 rounded-lg bg-white/10 hover:bg-white/20 text-white font-semibold text-sm transition-colors text-center"
          >
            (203) 748-9272
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
