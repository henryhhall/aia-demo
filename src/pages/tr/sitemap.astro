---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'tr';
const t = useTranslations(lang);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Associated Insurance Agency Site Haritası",
  "description": "Associated Insurance Agency için HTML ve XML site haritası dizini. Kişisel ve ticari sigorta poliçeleri, şubeler ve kaynaklar.",
};
---

<BaseLayout
  title="Site Haritası | Associated Insurance Agency CT"
  description="Associated Insurance Agency'nin tüm sayfalarını, bireysel ve ticari sigorta çözümlerini, Connecticut şubelerini ve XML beslemelerini keşfedin."
  structuredData={structuredData}
>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-16 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/5 text-accent text-xs font-semibold mb-2">
        <span class="w-2 h-2 rounded-full bg-accent-gold"></span>
        Dizin ve Tarama Beslemeleri
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-accent leading-none">
        {t('sitemap.title')}
      </h1>
      <p class="text-sm sm:text-base text-text-secondary max-w-[65ch] mx-auto leading-relaxed">
        {t('sitemap.subtitle')}
      </p>
    </div>
  </section>

  <!-- Sitemap Categories Grid -->
  <section class="py-16 sm:py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- XML Feeds Banner -->
      <div class="mb-12 p-6 bg-zinc-950 text-white rounded-xl border border-zinc-800 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 shadow-lg">
        <div class="space-y-1.5">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12.75 19.5v-.75a7.5 7.5 0 0 0-7.5-7.5H4.5m0-6.75h.75c7.87 0 14.25 6.38 14.25 14.25v.75M6 18.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
            </svg>
            <h2 class="text-lg font-bold">Arama Motorları ve Yapay Zeka için XML Beslemeleri</h2>
          </div>
          <p class="text-xs text-zinc-400">
            Googlebot, Bingbot ve yapay zeka arama motorları için yapılandırılmış XML site haritaları ve WebMCP beslemeleri.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3 text-xs">
          <a
            href="/sitemap-index.xml"
            target="_blank"
            class="px-4 py-2 rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-200 hover:text-white font-mono transition-colors"
          >
            /sitemap-index.xml
          </a>
          <a
            href="/sitemap.xml"
            target="_blank"
            class="px-4 py-2 rounded bg-zinc-800 hover:bg-zinc-700 text-zinc-200 hover:text-white font-mono transition-colors"
          >
            /sitemap.xml
          </a>
          <a
            href="/llms.txt"
            target="_blank"
            class="px-4 py-2 rounded bg-accent-gold/20 hover:bg-accent-gold/30 text-accent-gold font-mono transition-colors"
          >
            /llms.txt
          </a>
        </div>
      </div>

      <!-- Categories 3-Column Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

        <!-- Column 1: Core Pages & Offices -->
        <div class="space-y-6">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
            <h3 class="text-base font-bold text-accent border-b border-border-subtle pb-2 flex items-center gap-2">
              <span class="w-1.5 h-4 bg-accent-gold rounded-full"></span>
              Ana Sayfalar
            </h3>
            <ul class="space-y-2.5 text-sm text-text-secondary">
              <li><a href="/tr" class="hover:text-accent font-medium transition-colors">Türkçe Ana Sayfa</a></li>
              <li><a href="/tr/about" class="hover:text-accent font-medium transition-colors">AIA Hakkında ve Ekibimiz</a></li>
              <li><a href="/tr/contact" class="hover:text-accent font-medium transition-colors">İletişim ve Adresler</a></li>
              <li><a href="/tr/quote" class="hover:text-accent font-medium transition-colors">Ücretsiz Teklif Alın</a></li>
              <li><a href="/tr/service" class="hover:text-accent font-medium transition-colors">Müşteri Hizmetleri Merkezi</a></li>
              <li><a href="/tr/pay-bill" class="hover:text-accent font-medium transition-colors">Sigorta Şirketi Fatura Ödeme</a></li>
              <li><a href="/tr/blog" class="hover:text-accent font-medium transition-colors">Makaleler ve Bilgiler</a></li>
            </ul>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
            <h3 class="text-base font-bold text-accent border-b border-border-subtle pb-2 flex items-center gap-2">
              <span class="w-1.5 h-4 bg-accent-gold rounded-full"></span>
              Connecticut Şubelerimiz
            </h3>
            <ul class="space-y-2.5 text-sm text-text-secondary">
              <li>
                <a href="/tr/contact#danbury" class="hover:text-accent font-medium transition-colors">Danbury Genel Merkezi</a>
                <span class="block text-xs text-text-muted">50 Newtown Rd, Suite 1 • (203) 748-9272</span>
              </li>
              <li>
                <a href="/tr/contact#watertown" class="hover:text-accent font-medium transition-colors">Watertown Şubesi</a>
                <span class="block text-xs text-text-muted">1157 Main St • (860) 274-8888</span>
              </li>
              <li>
                <a href="/tr/contact#bridgeport" class="hover:text-accent font-medium transition-colors">Bridgeport Şubesi</a>
                <span class="block text-xs text-text-muted">2465 Main St • (203) 333-8880</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Column 2: Personal & Commercial Solutions -->
        <div class="space-y-6">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
            <h3 class="text-base font-bold text-accent border-b border-border-subtle pb-2 flex items-center gap-2">
              <span class="w-1.5 h-4 bg-accent-gold rounded-full"></span>
              Bireysel Sigortalar
            </h3>
            <ul class="space-y-2.5 text-sm text-text-secondary">
              <li><a href="/tr/personal" class="hover:text-accent font-medium transition-colors">Bireysel Sigortalara Genel Bakış</a></li>
              <li><a href="/tr/personal#home" class="hover:text-accent font-medium transition-colors">Ev Sahibi Sigortası</a></li>
              <li><a href="/tr/personal#auto" class="hover:text-accent font-medium transition-colors">Oto ve Karavan Sigortası</a></li>
              <li><a href="/tr/personal#renters" class="hover:text-accent font-medium transition-colors">Kiracı Sigortası</a></li>
              <li><a href="/tr/personal#umbrella" class="hover:text-accent font-medium transition-colors">Şemsiye (Ek Sorumluluk) Sigortası</a></li>
            </ul>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
            <h3 class="text-base font-bold text-accent border-b border-border-subtle pb-2 flex items-center gap-2">
              <span class="w-1.5 h-4 bg-accent-gold rounded-full"></span>
              Ticari Sigortalar
            </h3>
            <ul class="space-y-2.5 text-sm text-text-secondary">
              <li><a href="/tr/commercial" class="hover:text-accent font-medium transition-colors">Ticari Sigortalara Genel Bakış</a></li>
              <li><a href="/tr/commercial#bop" class="hover:text-accent font-medium transition-colors">İşletme Sahibi Paketi (BOP)</a></li>
              <li><a href="/tr/commercial#gl" class="hover:text-accent font-medium transition-colors">Genel Sorumluluk Sigortası</a></li>
              <li><a href="/tr/commercial#property" class="hover:text-accent font-medium transition-colors">Ticari Mülk Sigortası</a></li>
              <li><a href="/tr/commercial#wc" class="hover:text-accent font-medium transition-colors">İşçi Tazminatı Sigortası</a></li>
            </ul>
          </div>
        </div>

        <!-- Column 3: Multilingual & Guides -->
        <div class="space-y-6">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
            <h3 class="text-base font-bold text-accent border-b border-border-subtle pb-2 flex items-center gap-2">
              <span class="w-1.5 h-4 bg-accent-gold rounded-full"></span>
              Çok Dilli Portallar
            </h3>
            <ul class="space-y-2.5 text-sm text-text-secondary">
              <li>
                <a href="/" class="hover:text-accent font-medium transition-colors">English (İngilizce Portalı)</a>
                <span class="block text-xs text-text-muted">/, /about, /quote, /contact, /service</span>
              </li>
              <li>
                <a href="/es" class="hover:text-accent font-medium transition-colors">Español (İspanyolca Portalı)</a>
                <span class="block text-xs text-text-muted">/es, /es/about, /es/quote, /es/contact</span>
              </li>
              <li>
                <a href="/pt" class="hover:text-accent font-medium transition-colors">Português (Portekizce Portalı)</a>
                <span class="block text-xs text-text-muted">/pt, /pt/about, /pt/quote, /pt/contact</span>
              </li>
            </ul>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
            <h3 class="text-base font-bold text-accent border-b border-border-subtle pb-2 flex items-center gap-2">
              <span class="w-1.5 h-4 bg-accent-gold rounded-full"></span>
              Rehberler ve Kaynaklar
            </h3>
            <ul class="space-y-2.5 text-sm text-text-secondary">
              <li><a href="/tr/blog/preventing-ice-dams-on-homes" class="hover:text-accent font-medium transition-colors">Evlerde Buz Barajlarını Önleme</a></li>
              <li><a href="/tr/blog/travel-adventure-6-essential-tips" class="hover:text-accent font-medium transition-colors">Seyahat Maceraları İçin 6 Önemli İpucu</a></li>
              <li><a href="/tr/blog/wedding-insurance-need" class="hover:text-accent font-medium transition-colors">Düğün Sigortası İhtiyaç Rehberi</a></li>
            </ul>
          </div>
        </div>

      </div>

    </div>
  </section>
</BaseLayout>
