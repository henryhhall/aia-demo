---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import BlogArchiveList from '../../../components/BlogArchiveList.astro';

const lang = 'tr';
const posts = await getCollection('blog', ({ id, data }) => id.startsWith(`${lang}/`) && !data.draft);
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const blogPageStructuredData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Associated Insurance Agency Blogu",
  "description": "Connecticut'ın güvenilir bağımsız acentesinden sigorta ipuçları, kışın ev güvenliği tavsiyeleri ve etkinlik sorumluluk bilgileri.",
  "url": "https://aia-danbury.com/tr/blog",
};
---

<BaseLayout
  title="Sigorta Blogu ve İpuçları | Associated Insurance Agency CT"
  description="AIA'dan sigorta tavsiyeleri, kışın mülk koruma kontrol listeleri ve özel etkinlik teminat kılavuzları ile bilgili kalın."
  structuredData={blogPageStructuredData}
>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-accent leading-none">
        AIA İpuçları ve Tavsiyeler
      </h1>
      <p class="mt-4 text-sm sm:text-base text-text-secondary max-w-[60ch]">
        Kış güvenliği tavsiyeleri, düğün sorumluluğu rehberliği ve seyahat planlama kontrol listeleri ile güncel kalın.
      </p>
    </div>
  </section>

  <!-- Blog List Section with Location Filtering -->
  <section class="py-16 sm:py-20 bg-bg-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <BlogArchiveList posts={sortedPosts} lang="tr" />
    </div>
  </section>
</BaseLayout>
