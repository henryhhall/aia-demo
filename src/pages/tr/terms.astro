---
/**
 * Terms of Service (Turkish) - Associated Insurance Agency
 * Türkçe Hizmet Şartları: Bağımsız acente rolü, TCPA ve SMS iletişim onayı,
 * web üzerinden bağlayıcı olmayan teminat uyarısı, sorumluluk sınırlaması ve Connecticut hukuku.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'tr';
const t = useTranslations(lang);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Hizmet Şartları | Associated Insurance Agency",
  "description": "Associated Insurance Agency yasal hizmet şartları ve web sitesi kullanım sözleşmesi (Connecticut).",
  "inLanguage": "tr",
  "publisher": {
    "@type": "InsuranceAgency",
    "name": "Associated Insurance Agency",
    "telephone": "+1-203-748-9272",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "50 Newtown Road, Suite 1",
      "addressLocality": "Danbury",
      "addressRegion": "CT",
      "postalCode": "06810",
      "addressCountry": "US"
    }
  }
};
---

<BaseLayout
  title="Hizmet Şartları | Associated Insurance Agency CT"
  description="Associated Insurance Agency Hizmet Şartlarını inceleyin. Web sitesi kullanım koşulları, teklif sorumluluk retleri, iletişim onayları ve sigorta şirketleri ilişkileri hakkında bilgi edinin."
  structuredData={structuredData}
>
  <!-- Sayfa Başlığı / Hero -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-16 sm:py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-accent/5 text-accent text-xs font-semibold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-accent-gold animate-pulse"></span>
        Yasal ve Mevzuata Uygunluk
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-accent leading-none">
        {t('terms.title')}
      </h1>
      <p class="text-sm sm:text-base text-text-secondary max-w-[65ch] mx-auto leading-relaxed">
        {t('terms.subtitle')}
      </p>
      <div class="pt-2 flex items-center justify-center gap-3 text-xs text-text-muted">
        <span>Yürürlük Tarihi: Ekim 2026</span>
        <span>•</span>
        <span>Son Güncelleme: Ekim 2026</span>
      </div>
    </div>
  </section>

  <!-- Hizmet Şartları Ana İçeriği -->
  <section class="py-16 sm:py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Sabit İçindekiler Tablosu (Masaüstü Kenar Çubuğu) -->
        <aside class="hidden lg:block lg:col-span-4 sticky top-28 space-y-6">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
            <h2 class="text-sm font-bold text-accent uppercase tracking-wider border-b border-border-subtle pb-3 flex items-center gap-2">
              <span class="w-1.5 h-4 bg-accent-gold rounded-full"></span>
              İçindekiler
            </h2>
            <nav class="space-y-1.5 text-xs text-text-secondary">
              <a href="#kabul" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">1. Şartların Kabulü</a>
              <a href="#rol" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">2. Bağımsız Sigorta Acentesi Rolü</a>
              <a href="#baglayici-olmayan" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors text-red-600 font-semibold">3. Bağlayıcı Olmayan Teminat Uyarısı</a>
              <a href="#teklifler" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">4. Teklifler ve Fiyat Tahminleri</a>
              <a href="#iletisim" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors text-accent font-semibold">5. Telefon ve SMS İletişim Onayı</a>
              <a href="#sirketler" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">6. Üçüncü Taraf Sigorta Şirketleri</a>
              <a href="#kullanim-kurallari" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">7. Kullanıcı Sorumlulukları</a>
              <a href="#fikri-mulkiyet" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">8. Fikri Mülkiyet Hakları</a>
              <a href="#sorumluluk-sinirlamasi" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">9. Sorumluluğun Sınırlandırılması</a>
              <a href="#hukuk" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">10. Geçerli Hukuk ve Yargı Yetkisi</a>
              <a href="#degisiklikler" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">11. Şartlardaki Değişiklikler</a>
              <a href="#iletisim-bilgileri" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">12. İletişim Bilgileri</a>
            </nav>
          </div>

          <!-- Hızlı Destek Kutusu -->
          <div class="bg-accent text-white p-6 rounded-xl shadow-md space-y-3">
            <h3 class="text-sm font-bold text-accent-gold">Poliçenizle İlgili Sorunuz mu Var?</h3>
            <p class="text-xs text-zinc-300 leading-relaxed">
              Lisanslı sigorta temsilcilerimiz Türkçe dil desteği ile poliçe şartları ve eyalet mevzuatı hakkında yardımcı olmaktan memnuniyet duyar.
            </p>
            <div class="pt-2">
              <a href="tel:2037489272" class="inline-flex items-center gap-2 text-xs font-semibold text-white hover:text-accent-gold transition-colors">
                <svg class="w-4 h-4 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.942-6.942l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                </svg>
                Ara: (203) 748-9272
              </a>
            </div>
          </div>
        </aside>

        <!-- Maddeler -->
        <div class="lg:col-span-8 space-y-10 text-left">
          
          <!-- Sözleşme Özeti -->
          <div class="p-5 sm:p-6 bg-accent/5 border-l-4 border-accent-gold rounded-r-xl space-y-2">
            <h2 class="text-base font-bold text-accent">Sözleşme Özeti</h2>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Bu Hizmet Şartları ("Şartlar"), <strong>Associated Insurance Agency</strong> ("AIA", "biz" veya "bizim") tarafından işletilen web sitesi, çevrimiçi teklif sistemleri, iletişim formları ve dijital servislerin kullanımını düzenler. Web sitemizi kullanarak veya form göndererek bu Şartları kabul etmiş sayılırsınız.
            </p>
          </div>

          <!-- Madde 1 -->
          <article id="kabul" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Madde 1</span>
              Şartların Kabulü
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Bu web sitesine (<a href="https://aia-danbury.com/tr" class="text-accent underline font-medium">https://aia-danbury.com/tr</a>) ve bağlı servislerine erişerek bu Şartları okuduğunuzu, anladığınızı ve bunlarla yasal olarak bağlı olduğunuzu onaylarsınız. Şartları kabul etmiyorsanız lütfen site kullanımını sonlandırın.
            </p>
          </article>

          <!-- Madde 2 -->
          <article id="rol" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Madde 2</span>
              Hizmetlerin Niteliği ve Bağımsız Sigorta Acentesi Rolü
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Associated Insurance Agency, Danbury, Connecticut merkezli, Watertown ve Bridgeport şubeleri bulunan tam kapsamlı ve bağımsız bir sigorta acentesidir. AIA bağımsız bir acente olarak birçok önde gelen sigorta şirketini temsil eder (Safeco, Travelers, Progressive, The Hartford, Foremost vb.).
            </p>
            <p class="text-sm text-text-secondary leading-relaxed">
              AIA bir sigorta şirketi (underwriter) değildir ve doğrudan risk üstlenmez. Tüm poliçeler, teminatlar, zeyilnameler, fiyatlar, istisnalar ve hasar ödemeleri poliçeyi düzenleyen ilgili sigorta şirketinin sözleşmesine tabidir.
            </p>
          </article>

          <!-- Madde 3: Önemli Yasal Uyarı -->
          <article id="baglayici-olmayan" class="space-y-4 scroll-mt-28 p-6 bg-red-500/5 border border-red-500/20 rounded-xl">
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-red-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
              </svg>
              <div>
                <h2 class="text-lg font-bold text-red-700">
                  Madde 3: Zorunlu Yasal Uyarı — İnternet Üzerinden Bağlayıcı Olmayan Teminat
                </h2>
                <p class="mt-2 text-sm text-red-950 font-medium leading-relaxed">
                  <strong>SİGORTA TEMİNATI WEB SİTESİ FORMU, E-POSTA, KISA MESAJ VEYA SESLİ MESAJ YOLUYLA BAŞLATILAMAZ, DEĞİŞTİRİLEMEZ VEYA İPTAL EDİLEMEZ.</strong>
                </p>
              </div>
            </div>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Web sitemiz üzerinden teklif formu veya mesaj gönderilmesi bağlayıcı bir sigorta teminatı oluşturmaz. Sigorta teminatı yalnızca lisanslı bir acente tarafından doğrudan yazılı olarak teyit edildikten ve zorunlu ilk prim ödemesi sigorta şirketince tahsil edildikten sonra geçerlilik kazanır.
            </p>
          </article>

          <!-- Madde 4 -->
          <article id="teklifler" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Madde 4</span>
              Fiyat Teklifleri, Tahminler ve Bilgi Doğruluğu
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Bu sitede sunulan tüm fiyat tahminleri ve karşılaştırmalar, tarafınızca sağlanan ön bilgilere dayanan bağlayıcı olmayan tahminlerdir.
            </p>
            <p class="text-sm text-text-secondary leading-relaxed">
              Nihai prim oranları ve teminat onayı; sigorta şirketinin risk değerlendirmesine, araç şasi numarası (VIN) doğrulamasına, mülk ekspertizine, motorlu taşıt sürücü geçmişi (MVR) ve hasar kayıtlarına (C.L.U.E.) bağlıdır. Herhangi bir uyuşmazlıkta sigorta şirketince düzenlenen poliçe hükümleri geçerlidir.
            </p>
          </article>

          <!-- Madde 5: Telefon ve SMS Onayı -->
          <article id="iletisim" class="space-y-4 scroll-mt-28 p-6 bg-accent/5 border border-accent/15 rounded-xl">
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a.75.75 0 0 1-.974-.943 4.464 4.464 0 0 0 1.04-2.887A8.19 8.19 0 0 1 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
              </svg>
              <div>
                <h2 class="text-lg font-bold text-accent">
                  Madde 5: Telefon ve SMS İletişim Onayı (TCPA / 10DLC Bildirimi)
                </h2>
                <div class="mt-2 p-3 bg-white border border-border-subtle rounded-lg text-sm text-text-primary font-medium">
                  "Bir numara belirtmek, mesajınızla ilgili olarak tarafımızdan arama/kısa mesaj yapılmasına izin verir."
                </div>
              </div>
            </div>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Bu sitedeki herhangi bir formda telefon numaranızı belirterek, Associated Insurance Agency ve lisanslı temsilcilerine teklif talebiniz veya poliçe işlemleriniz kapsamında telefon aramaları ve kısa mesajlar (SMS) yoluyla sizinle iletişim kurma yetkisi vermiş olursunuz.
            </p>
            <ul class="space-y-1.5 text-xs text-text-secondary pl-5 list-disc">
              <li><strong>Sıklık:</strong> Mesaj sıklığı talebinize ve poliçe işlemlerinize bağlı olarak değişir.</li>
              <li><strong>Ücretlendirme:</strong> Operatörünüzün standart mesaj ve veri tarifeleri geçerli olabilir.</li>
              <li><strong>İptal (Opt-Out):</strong> Dilediğiniz an gelen herhangi bir mesaja <strong>STOP</strong> yanıtı vererek SMS onayınızı geri çekebilirsiniz.</li>
              <li><strong>Yardım:</strong> Bilgi için <strong>HELP</strong> yazabilir veya Danbury ofisimizi arayabilirsiniz: <a href="tel:2037489272" class="text-accent underline font-semibold">(203) 748-9272</a>.</li>
            </ul>
          </article>

          <!-- Madde 6 -->
          <article id="sirketler" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Madde 6</span>
              Üçüncü Taraf Sigorta Portalları ve Dış Bağlantılar
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Web sitemiz, doğrudan sigorta şirketlerinin çevrimiçi fatura ödeme ve hasar bildirim portallarına bağlantılar içerir (Progressive, Safeco, Travelers, MetLife vb.). Bu siteler bağımsız üçüncü taraflara aittir.
            </p>
            <p class="text-sm text-text-secondary leading-relaxed">
              AIA üçüncü taraf web sitelerinin içeriğinden, gizlilik politikalarından veya ödeme güvenliğinden sorumlu tutulamaz.
            </p>
          </article>

          <!-- Madde 7 -->
          <article id="kullanim-kurallari" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Madde 7</span>
              Kullanıcı Davranışları ve Doğru Bilgi Verme Yükümlülüğü
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Formlar aracılığıyla gönderilen bilgilerin doğru, eksiksiz ve güncel olduğunu kabul edersiniz. Kasıtlı olarak yanıltıcı veya sahte bilgi verilmesi poliçenin geçersiz kılınmasına yol açabilir ve sigorta dolandırıcılığı teşkil edebilir.
            </p>
            <p class="text-sm text-text-secondary leading-relaxed">
              Siteden yetkisiz veri çekmek (scraping), otomatik botlar kullanmak veya sistemlerimizi spam mesajlarla meşgul etmek kesinlikle yasaktır.
            </p>
          </article>

          <!-- Madde 8 -->
          <article id="fikri-mulkiyet" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Madde 8</span>
              Fikri Mülkiyet Hakları
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Sitedeki tüm tasarımlar, logolar, metinler ve yazılım kodları Associated Insurance Agency'nin mülkiyetindedir ve telif hakkı yasalarıyla korunmaktadır.
            </p>
          </article>

          <!-- Madde 9 -->
          <article id="sorumluluk-sinirlamasi" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Madde 9</span>
              Garanti Reddi ve Sorumluluğun Sınırlandırılması
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              BU WEB SİTESİ "OLDUĞU GİBİ" VE "MEVCUT OLDUĞU KADARIYLA" SUNULMAKTADIR. AIA HERHANGİ BİR AÇIK VEYA ZIMNİ GARANTİ VERMEMEKTEDİR.
            </p>
            <p class="text-sm text-text-secondary leading-relaxed">
              ASSOCIATED INSURANCE AGENCY VE LİSANSLI TEMSİLCİLERİ, SİTENİN KULLANIMINDAN VEYA KULLANILAMAMASINDAN DOĞABİLECEK DOĞRUDAN VEYA DOLAYLI ZARARLARDAN SORUMLU TUTULAMAZ.
            </p>
          </article>

          <!-- Madde 10 -->
          <article id="hukuk" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Madde 10</span>
              Geçerli Hukuk ve Yetkili Mahkeme
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Bu Şartlar <strong>Connecticut Eyaleti</strong> kanunlarına tabidir. Doğabilecek ihtilaflarda Fairfield County veya Hartford County, Connecticut eyalet ve federal mahkemeleri münhasıran yetkilidir.
            </p>
          </article>

          <!-- Madde 11 -->
          <article id="degisiklikler" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Madde 11</span>
              Şartlarda Değişiklik Yapılması
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              AIA bu Şartları dilediği zaman güncelleme hakkını saklı tutar. Değişiklikler sitede yayımlandığı anda yürürlüğe girer.
            </p>
          </article>

          <!-- Madde 12: İletişim -->
          <article id="iletisim-bilgileri" class="space-y-4 scroll-mt-28 pt-6 border-t border-border-subtle">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Madde 12</span>
              İletişim Bilgileri ve Şubelerimiz
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Bu Hizmet Şartları hakkında sorularınız için bize ulaşabilirsiniz:
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
              <div class="p-4 bg-bg-secondary rounded-lg border border-border-subtle space-y-1 text-xs">
                <span class="font-bold text-accent block">Danbury Merkez</span>
                <span class="text-text-secondary block">50 Newtown Road, Suite 1</span>
                <span class="text-text-secondary block">Danbury, CT 06810</span>
                <a href="tel:2037489272" class="text-accent font-semibold hover:underline block pt-1">(203) 748-9272</a>
              </div>
              <div class="p-4 bg-bg-secondary rounded-lg border border-border-subtle space-y-1 text-xs">
                <span class="font-bold text-accent block">Watertown Şubesi</span>
                <span class="text-text-secondary block">51 Depot St Ste 112</span>
                <span class="text-text-secondary block">Watertown, CT 06795</span>
                <a href="tel:8602747100" class="text-accent font-semibold hover:underline block pt-1">(860) 274-7100</a>
              </div>
              <div class="p-4 bg-bg-secondary rounded-lg border border-border-subtle space-y-1 text-xs">
                <span class="font-bold text-accent block">Bridgeport Şubesi</span>
                <span class="text-text-secondary block">2465 Main Street</span>
                <span class="text-text-secondary block">Bridgeport, CT 06606</span>
                <a href="tel:2033675300" class="text-accent font-semibold hover:underline block pt-1">(203) 367-5300</a>
              </div>
            </div>
          </article>

        </div>

      </div>
    </div>
  </section>
</BaseLayout>
