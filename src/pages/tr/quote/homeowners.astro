---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HomeownersQuoteWizard from '../../../components/homeowners-quote/HomeownersQuoteWizard';

const homeownersQuoteStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": "https://aia-danbury.com/tr/quote/homeowners#webpage",
      "name": "Connecticut Konut Sigortası Teklifi | Associated Insurance Agency",
      "description": "Connecticut için avantajlı ev sahibi sigortası teklifi alın. Travelers, Safeco, The Hartford ve bölgesel sigorta şirketlerini karşılaştıran çok adımlı teklif sihirbazı.",
      "url": "https://aia-danbury.com/tr/quote/homeowners"
    },
    {
      "@type": "Service",
      "@id": "https://aia-danbury.com/tr/quote/homeowners#service",
      "name": "Ev Sahibi Sigortası Teklif Karşılaştırması",
      "serviceType": "Property & Casualty Insurance",
      "provider": {
        "@type": "InsuranceAgency",
        "name": "Associated Insurance Agency",
        "telephone": "+1-203-748-9272",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "50 Newtown Road, Suite 1",
          "addressLocality": "Danbury",
          "addressRegion": "CT",
          "postalCode": "06810"
        }
      },
      "areaServed": [
        { "@type": "State", "name": "Connecticut" },
        { "@type": "City", "name": "Danbury" },
        { "@type": "City", "name": "Watertown" },
        { "@type": "City", "name": "Bridgeport" }
      ]
    }
  ]
};
---

<BaseLayout
  title="Konut Sigortası Teklifi | Associated Insurance Agency CT"
  description="Connecticut konut sigortası teklifi alın. Travelers, Safeco, Hartford ve daha fazlasından en uygun fiyatları karşılaştırmak için adım adım formumuzu doldurun."
  structuredData={homeownersQuoteStructuredData}
  lang="tr"
>
  {/* Page Hero */}
  <section class="relative bg-gradient-to-b from-bg-secondary via-bg-primary to-bg-primary py-16 sm:py-20 border-b border-border-subtle overflow-hidden">
    {/* Subtle Background Radial Pattern */}
    <div class="absolute inset-0 bg-[radial-gradient(#122b5f_1px,transparent_1px)] [background-size:24px_24px] opacity-[0.03] pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mx-auto text-center space-y-4">
        {/* Trust Pill */}
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/5 border border-accent/15 text-accent text-xs font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-gold animate-pulse"></span>
          <span>Bağımsız CT Acentesi • Çoklu Sigorta Şirketi Fiyat Karşılaştırması</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-accent leading-[1.15]">
          Konut Sigortası <span class="text-accent-gold">Teklif Oluşturucu</span>
        </h1>

        <p class="text-sm sm:text-base text-text-secondary max-w-[65ch] mx-auto leading-relaxed">
          Lisanslı acentelerimizden birinin konut yeniden inşa maliyetinizi belirlemesi ve en iyi poliçe oranını araştırması için 4 adımlı formumuzu doldurun.
        </p>

        {/* Value Highlights */}
        <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 pt-2 text-xs font-medium text-text-muted">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Gerçek Yeniden İnşa Maliyeti Hesabı</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Koruma Sistemleri İndirimleri Dahil</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>Sıfır Satış Baskısı</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Quote Form Interactive Section */}
  <section class="py-12 sm:py-16 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* React Island Client Hydration */}
      <HomeownersQuoteWizard client:load lang="tr" />

      {/* Disclaimers & Licensing Footnote */}
      <div class="mt-12 max-w-3xl mx-auto text-center space-y-2 px-4 border-t border-border-subtle pt-6">
        <p class="text-xs text-text-muted leading-relaxed">
          Associated Insurance Agency, Connecticut lisanslı bir sigorta acentesidir (Merkez: 50 Newtown Rd, Danbury CT 06810). Çevrimiçi oluşturulan teklifler tahmini sigortalama parametrelerini temsil eder ve yetkili bir temsilci tarafından yazılı olarak onaylanana kadar teminat sağlamaz veya garanti etmez.
        </p>
        <p class="text-[11px] text-text-muted/80">
          Acil yardıma mı ihtiyacınız var veya yaklaşan bir gayrimenkul tapu devri için poliçenizi hemen başlatmak mı istiyorsunuz? Danbury ofisimizi doğrudan <a href="tel:+12037489272" class="text-accent font-semibold hover:underline">(203) 748-9272</a> numaralı telefondan arayın.
        </p>
      </div>
    </div>
  </section>

  {/* Why Choose AIA Section */}
  <section class="py-16 bg-bg-secondary border-t border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-2">
        <h2 class="text-2xl sm:text-3xl font-bold text-accent">
          Connecticut Ev Sahipleri Neden AIA'ya Güveniyor?
        </h2>
        <p class="text-sm text-text-secondary">
          Bağımsız bir acente olarak tek bir sigorta şirketi için değil, sizin için çalışıyoruz.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-bg-primary border border-border-subtle shadow-xs space-y-3">
          <div class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center font-bold">
            <svg class="w-5 h-5 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-accent">10+ Lider Sigorta Şirketini Karşılaştırıyoruz</h3>
          <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
            Bağlı acentelerin sunamayacağı indirimleri bulmak için Travelers, Safeco, The Hartford, Chubb, Andover ve daha birçok şirketin tekliflerini karşılaştırıyoruz.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-bg-primary border border-border-subtle shadow-xs space-y-3">
          <div class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center font-bold">
            <svg class="w-5 h-5 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-accent">CT Hava Koşulları ve Risk Uzmanlığı</h3>
          <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
            Teminatı New England bölgesi risklerine özel olarak uyarlıyoruz: kış don hasarları, buz barajları, çatıda yoğun kar yükü ve fırtına muafiyetleri.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-bg-primary border border-border-subtle shadow-xs space-y-3">
          <div class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center font-bold">
            <svg class="w-5 h-5 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-accent">Çok Dilli Yerel Ekip</h3>
          <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
            Fairfield, Litchfield ve New Haven bölgelerinde yaşayan uzmanlarımızdan İngilizce, İspanyolca, Portekizce ve Türkçe akıcı destekle kişisel hizmet alın.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
