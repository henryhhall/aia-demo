---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import BlogArchiveList from '../../components/BlogArchiveList.astro';

const lang = 'en';
const posts = await getCollection('blog', ({ id, data }) => id.startsWith(`${lang}/`) && !data.draft);
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const blogPageStructuredData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Associated Insurance Agency Blog",
  "description": "Insurance tips, winter home safety advice, and event liability information from Connecticut's trusted independent agency.",
  "url": "https://aia-danbury.com/blog",
};
---

<BaseLayout
  title="Insurance Blog & Insights | Associated Insurance Agency CT"
  description="Stay informed with insurance advice, winter property protection checklists, and special event coverage guides from AIA."
  structuredData={blogPageStructuredData}
>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-accent leading-none">
        AIA Insights & Advice
      </h1>
      <p class="mt-4 text-sm sm:text-base text-text-secondary max-w-[60ch]">
        Stay updated with winter safety advice, wedding liability guidance, and travel planning checklists.
      </p>
    </div>
  </section>

  <!-- Blog List Section with Location Filtering -->
  <section class="py-16 sm:py-20 bg-bg-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <BlogArchiveList posts={sortedPosts} lang="en" />
    </div>
  </section>
</BaseLayout>
