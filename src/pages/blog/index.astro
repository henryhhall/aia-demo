---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const lang = 'en';
const posts = await getCollection('blog', ({ id, data }) => id.startsWith(`${lang}/`) && !data.draft);
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const blogPageStructuredData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Associated Insurance Agency Blog",
  "description": "Insurance tips, winter home safety advice, and event liability information from Connecticut's trusted independent agency.",
  "url": "https://aia-danbury.com/blog",
};
---

<BaseLayout
  title="Insurance Blog & Insights | Associated Insurance Agency CT"
  description="Stay informed with insurance advice, winter property protection checklists, and special event coverage guides from AIA."
  structuredData={blogPageStructuredData}
>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-accent leading-none">
        AIA Insights & Advice
      </h1>
      <p class="mt-4 text-sm sm:text-base text-text-secondary max-w-[60ch]">
        Stay updated with winter safety advice, wedding liability guidance, and travel planning checklists.
      </p>
    </div>
  </section>

  <!-- Blog List Section -->
  <section class="py-24 bg-bg-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      {sortedPosts.length === 0 ? (
        <div class="text-center py-12 border border-border-subtle bg-bg-secondary rounded-lg">
          <p class="text-sm text-text-secondary">No articles published yet. Check back soon!</p>
        </div>
      ) : (
        <div class="divide-y divide-border-subtle">
          {sortedPosts.map((post) => (
            <article class="py-12 first:pt-0 last:pb-0 flex flex-col md:flex-row gap-8 items-start text-left">
              <!-- Post Meta & Date -->
              <div class="w-full md:w-1/4 shrink-0 text-left">
                <time class="font-mono text-xs font-semibold text-text-muted uppercase">
                  {new Date(post.data.pubDate).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                <div class="flex flex-wrap gap-1.5 mt-2">
                  {post.data.tags.map((tag) => (
                    <span class="text-[9px] px-2 py-0.5 bg-bg-secondary border border-border-subtle text-text-secondary rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Post Details -->
              <div class="space-y-3 flex-1">
                <h2 class="text-xl sm:text-2xl font-bold text-accent hover:text-accent-gold transition-colors leading-tight">
                  <a href={`/blog/${post.id.replace(/^en\//, '')}`}>{post.data.title}</a>
                </h2>
                <p class="text-sm text-text-secondary leading-relaxed font-light">
                  {post.data.description}
                </p>
                <div>
                  <a
                    href={`/blog/${post.id.replace(/^en\//, '')}`}
                    class="inline-flex items-center gap-1 text-xs font-semibold text-accent-gold hover:text-accent-gold-hover transition-colors"
                  >
                    Read Article
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
