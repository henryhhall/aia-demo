---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('en');

const quoteStructuredData = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Request an Insurance Quote",
  "description": "Request a free homeowners, auto, renters, or commercial business insurance quote from Associated Insurance Agency.",
};
---

<BaseLayout
  title="Request a Free Insurance Quote | Associated Insurance Agency CT"
  description="Request a free, no-obligation homeowners, auto, or business insurance quote. We shop the market to find you the lowest rates in CT."
  structuredData={quoteStructuredData}
>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-16 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-3">
      <h1 class="text-4xl font-bold tracking-tighter text-accent leading-none">
        Request a Free Quote
      </h1>
      <p class="text-sm text-text-secondary max-w-[60ch] mx-auto">
        Complete our simple 3-step form to have our agents shop the CT market for your best rate.
      </p>
    </div>
  </section>

  <!-- Quote Form Section -->
  <section class="py-12 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Specialized Homeowners Quote Banner -->
      <div class="mb-10 max-w-2xl mx-auto p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-accent/5 via-accent/10 to-accent-gold/10 border border-accent/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-accent-gold">Dedicated Tool</span>
            <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">New</span>
          </div>
          <h2 class="text-base font-bold text-accent">Looking for Connecticut Homeowners Insurance?</h2>
          <p class="text-xs text-text-secondary leading-relaxed">
            Use our full 4-step rating wizard with building specs, GIS hydrant rating, and instant replacement estimates.
          </p>
        </div>
        <a
          href="/quote/homeowners"
          class="shrink-0 px-4 py-2.5 rounded-xl bg-accent text-white text-xs font-bold hover:bg-accent/90 transition-all shadow-xs flex items-center gap-1.5"
        >
          <span>Launch Home Builder</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- React multi-step quote form island -->
      <QuoteForm client:load />

      <!-- Legal Disclaimer directly beneath form -->
      <div class="mt-8 max-w-xl mx-auto text-center px-4">
        <p class="text-xs sm:text-sm text-text-secondary font-medium leading-relaxed">
          {t('quote.disclaimer')}
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
