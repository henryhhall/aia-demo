---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm';
import OfficeLocationsMap from '../components/OfficeLocationsMap.astro';
import ContactHero from '../components/ContactHero.astro';

const lang = 'en';

const contactStructuredData = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact Associated Insurance Agency",
  "description": "Get in touch with Associated Insurance Agency. Visit our Danbury HQ, Watertown, or Bridgeport offices or contact our licensed agents directly.",
};
---

<BaseLayout
  title="Contact Us | Associated Insurance Agency CT"
  description="Contact Associated Insurance Agency in Connecticut. Visit our Danbury headquarters or branches in Watertown and Bridgeport. Multi-lingual assistance available."
  structuredData={contactStructuredData}
>
  <!-- Hero Section with Team Photo -->
  <ContactHero lang={lang} />

  <!-- Main Content Grid -->
  <section class="py-16 sm:py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-start">
        
        <!-- Left Column: Interactive Contact Form with Honeypots -->
        <div id="contact-form" class="lg:col-span-6 space-y-6 scroll-mt-24">
          <ContactForm client:load lang={lang} />
        </div>

        <!-- Right Column: Interactive Google Maps Embed & Branch Locations -->
        <div class="lg:col-span-6">
          <OfficeLocationsMap lang={lang} />
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
