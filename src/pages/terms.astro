---
/**
 * Terms of Service (English) - Associated Insurance Agency
 * Comprehensive boilerplate terms covering independent agency status,
 * electronic communication / TCPA consent, non-binding online quote submissions,
 * limitation of liability, and Connecticut governing law.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Terms of Service | Associated Insurance Agency",
  "description": "Legal terms of service and website usage agreement for Associated Insurance Agency in Connecticut.",
  "publisher": {
    "@type": "InsuranceAgency",
    "name": "Associated Insurance Agency",
    "telephone": "+1-203-748-9272",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "50 Newtown Road, Suite 1",
      "addressLocality": "Danbury",
      "addressRegion": "CT",
      "postalCode": "06810",
      "addressCountry": "US"
    }
  }
};
---

<BaseLayout
  title="Terms of Service | Associated Insurance Agency CT"
  description="Read the Terms of Service for Associated Insurance Agency. Review our website usage terms, insurance quotation disclaimers, TCPA communications consent, and regulatory notices."
  structuredData={structuredData}
>
  <!-- Page Header / Hero -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-16 sm:py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-accent/5 text-accent text-xs font-semibold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-accent-gold animate-pulse"></span>
        Legal & Regulatory Compliance
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-accent leading-none">
        {t('terms.title')}
      </h1>
      <p class="text-sm sm:text-base text-text-secondary max-w-[65ch] mx-auto leading-relaxed">
        {t('terms.subtitle')}
      </p>
      <div class="pt-2 flex items-center justify-center gap-3 text-xs text-text-muted">
        <span>Effective Date: October 2026</span>
        <span>•</span>
        <span>Last Updated: October 2026</span>
      </div>
    </div>
  </section>

  <!-- Main Terms Content -->
  <section class="py-16 sm:py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Sticky Table of Contents (Desktop Sidebar) -->
        <aside class="hidden lg:block lg:col-span-4 sticky top-28 space-y-6">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
            <h2 class="text-sm font-bold text-accent uppercase tracking-wider border-b border-border-subtle pb-3 flex items-center gap-2">
              <span class="w-1.5 h-4 bg-accent-gold rounded-full"></span>
              Table of Contents
            </h2>
            <nav class="space-y-1.5 text-xs text-text-secondary">
              <a href="#acceptance" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">1. Acceptance of Terms</a>
              <a href="#agency-role" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">2. Independent Agency Role</a>
              <a href="#no-binding" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors text-red-600 font-semibold">3. No Electronic Binding</a>
              <a href="#quotes-accuracy" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">4. Quotes & Rate Accuracy</a>
              <a href="#communications" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors text-accent font-semibold">5. Phone & SMS Consent</a>
              <a href="#carriers" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">6. Third-Party Carriers</a>
              <a href="#user-conduct" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">7. User Conduct & Form Submissions</a>
              <a href="#intellectual-property" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">8. Intellectual Property</a>
              <a href="#limitation-liability" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">9. Limitation of Liability</a>
              <a href="#governing-law" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">10. Governing Law (Connecticut)</a>
              <a href="#modifications" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">11. Modifications to Terms</a>
              <a href="#contact-information" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">12. Contact Information</a>
            </nav>
          </div>

          <!-- Quick Contact Assistance Widget -->
          <div class="bg-accent text-white p-6 rounded-xl shadow-md space-y-3">
            <h3 class="text-sm font-bold text-accent-gold">Need Legal or Coverage Clarification?</h3>
            <p class="text-xs text-zinc-300 leading-relaxed">
              Our licensed insurance agents are available to discuss policy terms, coverages, and state regulatory guidelines.
            </p>
            <div class="pt-2">
              <a href="tel:2037489272" class="inline-flex items-center gap-2 text-xs font-semibold text-white hover:text-accent-gold transition-colors">
                <svg class="w-4 h-4 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.942-6.942l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                </svg>
                Call (203) 748-9272
              </a>
            </div>
          </div>
        </aside>

        <!-- Terms Clauses -->
        <div class="lg:col-span-8 space-y-10 text-left">
          
          <!-- Executive Summary Card -->
          <div class="p-5 sm:p-6 bg-accent/5 border-l-4 border-accent-gold rounded-r-xl space-y-2">
            <h2 class="text-base font-bold text-accent">Summary of Agreement</h2>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              These Terms of Service ("Terms") govern your access to and use of the website, online quote request systems, contact forms, and related digital services operated by <strong>Associated Insurance Agency</strong> ("AIA", "we", "us", or "our"). By browsing our website or submitting information through our forms, you agree to be bound by these Terms and our applicable regulatory policies.
            </p>
          </div>

          <!-- Section 1 -->
          <article id="acceptance" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Section 1</span>
              Acceptance of Terms
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              By accessing, browsing, or utilizing this website (<a href="https://aia-danbury.com" class="text-accent underline font-medium">https://aia-danbury.com</a>) and any associated web applications, you confirm that you have read, understood, and agreed to be legally bound by these Terms. If you do not agree to these Terms, you must discontinue your use of this website immediately.
            </p>
          </article>

          <!-- Section 2 -->
          <article id="agency-role" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Section 2</span>
              Nature of Services & Independent Agency Role
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Associated Insurance Agency is a full-service independent insurance brokerage headquartered in Danbury, Connecticut, with additional branch offices in Watertown and Bridgeport. As an independent agency, AIA represents multiple third-party insurance carriers (including, but not limited to, Safeco, Travelers, Progressive, The Hartford, and Foremost).
            </p>
            <p class="text-sm text-text-secondary leading-relaxed">
              AIA is not an insurance company and does not underwrite insurance risk directly. All policies, coverages, endorsements, rates, exclusions, claims adjudications, and cancellations are governed strictly by the contractual policies issued by the respective underwriting insurance companies.
            </p>
          </article>

          <!-- Section 3: Critical Insurance Regulatory Warning -->
          <article id="no-binding" class="space-y-4 scroll-mt-28 p-6 bg-red-500/5 border border-red-500/20 rounded-xl">
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-red-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
              </svg>
              <div>
                <h2 class="text-lg font-bold text-red-700">
                  Section 3: Mandatory Notice — No Electronic Binding or Policy Alteration
                </h2>
                <p class="mt-2 text-sm text-red-950 font-medium leading-relaxed">
                  <strong>COVERAGE CANNOT BE BOUND, ALTERED, OR CANCELLED VIA WEBSITE FORM, EMAIL, TEXT MESSAGE, OR VOICEMAIL.</strong>
                </p>
              </div>
            </div>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Submission of a quote request, contact form inquiry, service ticket, or electronic message does not constitute binding coverage or an alteration of any existing insurance policy. Coverage is effective <strong>only</strong> once an authorized, licensed insurance agent has directly confirmed issuance, binding, or endorsement in writing, and any mandatory down-payment has been received and processed by the underwriting carrier.
            </p>
          </article>

          <!-- Section 4 -->
          <article id="quotes-accuracy" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Section 4</span>
              Quotations, Rate Estimates & Information Accuracy
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              All quotes, premium comparisons, rate estimators, and policy illustrations presented on this website or in preliminary communications are non-binding estimates based solely on the preliminary information you provide.
            </p>
            <p class="text-sm text-text-secondary leading-relaxed">
              Final rates and coverage eligibility are subject to carrier underwriting approval, verification of vehicle identification numbers (VIN), property inspections, Comprehensive Loss Underwriting Exchange (C.L.U.E.) reports, motor vehicle driving records (MVR), and credit-based insurance scores where permissible under Connecticut and federal law. In the event of any discrepancy, the policy contract issued by the insurer shall supersede all prior estimates.
            </p>
          </article>

          <!-- Section 5: Telephone, SMS & Communications Disclosure -->
          <article id="communications" class="space-y-4 scroll-mt-28 p-6 bg-accent/5 border border-accent/15 rounded-xl">
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a.75.75 0 0 1-.974-.943 4.464 4.464 0 0 0 1.04-2.887A8.19 8.19 0 0 1 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
              </svg>
              <div>
                <h2 class="text-lg font-bold text-accent">
                  Section 5: Telephone, Calls & SMS Communications Consent (TCPA / 10DLC)
                </h2>
                <div class="mt-2 p-3 bg-white border border-border-subtle rounded-lg text-sm text-text-primary font-medium">
                  "Providing a number permits calls/texts from us regarding the message."
                </div>
              </div>
            </div>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              By providing your telephone number in any web form on this website, you expressly authorize Associated Insurance Agency and its licensed representatives to communicate with you via telephone calls and text messages (SMS) regarding your quote request, policy servicing inquiry, or message.
            </p>
            <ul class="space-y-1.5 text-xs text-text-secondary pl-5 list-disc">
              <li><strong>Frequency:</strong> Message frequency varies based on your inquiry and policy transaction needs.</li>
              <li><strong>Rates:</strong> Standard carrier message and data rates may apply.</li>
              <li><strong>Opt-Out:</strong> You may revoke SMS consent at any time by replying <strong>STOP</strong> to any text message received from us.</li>
              <li><strong>Assistance:</strong> Reply <strong>HELP</strong> for assistance or contact our Danbury office directly at <a href="tel:2037489272" class="text-accent underline font-semibold">(203) 748-9272</a>.</li>
            </ul>
          </article>

          <!-- Section 6 -->
          <article id="carriers" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Section 6</span>
              Third-Party Carrier Portals & External Links
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Our website provides links to external carrier portals for online bill payment and claims reporting (such as Progressive, Safeco, Travelers, and MetLife). These third-party sites are owned and operated independently from AIA.
            </p>
            <p class="text-sm text-text-secondary leading-relaxed">
              AIA does not control, endorse, or accept liability for the content, privacy policies, payment processing, or operational uptime of any third-party websites. When navigating to an external link, you are governed by the terms of service and privacy notices of that external service.
            </p>
          </article>

          <!-- Section 7 -->
          <article id="user-conduct" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Section 7</span>
              User Conduct & Accurate Submission Obligations
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              You agree to provide true, accurate, current, and complete information when submitting quote requests, contact inquiries, or policy change requests through our forms. Intentionally providing fraudulent, misleading, or deceptive information may void insurance coverage under applicable state law and may constitute insurance fraud.
            </p>
            <p class="text-sm text-text-secondary leading-relaxed">
              You agree not to use automated bots, scrapers, spiders, or automated scripts to harvest information from this website or flood our inquiry endpoints with spam submissions. Violators will be subject to IP blocking, honeypot mitigation, and legal recourse.
            </p>
          </article>

          <!-- Section 8 -->
          <article id="intellectual-property" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Section 8</span>
              Intellectual Property Rights
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              All website content, layout, design, text, graphics, logos, icons, guides, articles, and software code are the intellectual property of Associated Insurance Agency and are protected by United States and international copyright, trademark, and unfair competition laws.
            </p>
            <p class="text-sm text-text-secondary leading-relaxed">
              You are granted a limited, revocable, non-exclusive license to view and print pages from this website for personal, non-commercial use solely in connection with evaluating insurance services.
            </p>
          </article>

          <!-- Section 9 -->
          <article id="limitation-liability" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Section 9</span>
              Disclaimer of Warranties & Limitation of Liability
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              THIS WEBSITE AND ALL CONTENT ARE PROVIDED ON AN "AS IS" AND "AS AVAILABLE" BASIS WITHOUT WARRANTIES OF ANY KIND, EITHER EXPRESS OR IMPLIED. AIA EXPRESSLY DISCLAIMS ALL WARRANTIES, INCLUDING MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, AND NON-INFRINGEMENT.
            </p>
            <p class="text-sm text-text-secondary leading-relaxed">
              IN NO EVENT SHALL ASSOCIATED INSURANCE AGENCY, ITS LICENSED AGENTS, DIRECTORS, OR EMPLOYEES BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, CONSEQUENTIAL, SPECIAL, OR PUNITIVE DAMAGES ARISING OUT OF YOUR USE OF OR INABILITY TO USE THIS WEBSITE, DELAYS IN TRANSMISSION, OR ERRORS IN CONTENT, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGES.
            </p>
          </article>

          <!-- Section 10 -->
          <article id="governing-law" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Section 10</span>
              Governing Law & Jurisdiction
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              These Terms of Service and any disputes arising out of or related to the use of this website shall be governed by, construed, and enforced in accordance with the substantive laws of the <strong>State of Connecticut</strong>, without regard to its conflict of law principles.
            </p>
            <p class="text-sm text-text-secondary leading-relaxed">
              You agree that any legal action or proceeding arising under these Terms shall be instituted exclusively in the state or federal courts situated in Fairfield County or Hartford County, Connecticut, and you submit to the personal jurisdiction of such courts.
            </p>
          </article>

          <!-- Section 11 -->
          <article id="modifications" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Section 11</span>
              Modifications to These Terms
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              AIA reserves the right to modify, amend, or update these Terms at any time without prior notice. Any modifications will be effective immediately upon posting to this website, with an updated "Last Updated" date. Continued use of our website following the posting of changes constitutes your acceptance of the revised Terms.
            </p>
          </article>

          <!-- Section 12: Contact Information -->
          <article id="contact-information" class="space-y-4 scroll-mt-28 pt-6 border-t border-border-subtle">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Section 12</span>
              Contact Information & Office Locations
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              If you have any questions or concerns regarding these Terms of Service, please contact our team:
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
              <div class="p-4 bg-bg-secondary rounded-lg border border-border-subtle space-y-1 text-xs">
                <span class="font-bold text-accent block">Danbury HQ</span>
                <span class="text-text-secondary block">50 Newtown Road, Suite 1</span>
                <span class="text-text-secondary block">Danbury, CT 06810</span>
                <a href="tel:2037489272" class="text-accent font-semibold hover:underline block pt-1">(203) 748-9272</a>
              </div>
              <div class="p-4 bg-bg-secondary rounded-lg border border-border-subtle space-y-1 text-xs">
                <span class="font-bold text-accent block">Watertown Office</span>
                <span class="text-text-secondary block">1157 Main Street</span>
                <span class="text-text-secondary block">Watertown, CT 06795</span>
                <a href="tel:8602747100" class="text-accent font-semibold hover:underline block pt-1">(860) 274-7100</a>
              </div>
              <div class="p-4 bg-bg-secondary rounded-lg border border-border-subtle space-y-1 text-xs">
                <span class="font-bold text-accent block">Bridgeport Office</span>
                <span class="text-text-secondary block">2465 Main Street</span>
                <span class="text-text-secondary block">Bridgeport, CT 06606</span>
                <a href="tel:2033675300" class="text-accent font-semibold hover:underline block pt-1">(203) 367-5300</a>
              </div>
            </div>
          </article>

        </div>

      </div>
    </div>
  </section>
</BaseLayout>
