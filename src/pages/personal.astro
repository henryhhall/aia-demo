---
import BaseLayout from '../layouts/BaseLayout.astro';

const personalStructuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Personal Insurance Lines",
  "description": "Comprehensive personal insurance policies including homeowners, auto, renters, RV, umbrella liability, and pet insurance across Connecticut.",
  "provider": {
    "@type": "InsuranceAgency",
    "name": "Associated Insurance Agency"
  }
};
---

<BaseLayout
  title="Personal Insurance Policies CT | Home, Auto, Umbrella & Renters"
  description="Explore personal insurance coverage from Associated Insurance Agency CT. We shop homeowners, auto, umbrella liability, renters, and pet insurance rates."
  structuredData={personalStructuredData}
>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-accent leading-none">
        Personal Insurance Lines
      </h1>
      <p class="mt-4 text-sm sm:text-base text-text-secondary max-w-[60ch]">
        Shielding your family, home, and vehicles with comprehensive policies tailored for Connecticut families.
      </p>
    </div>
  </section>

  <!-- Detailed Sections (Border-separated vertical stacks - Taste Skill Rule 4) -->
  <section class="py-24 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-24">
        
        <!-- Homeowners Insurance -->
        <div id="home" class="grid grid-cols-1 lg:grid-cols-12 gap-12 pt-12 border-t border-border-subtle first:border-0 first:pt-0">
          <div class="lg:col-span-4 space-y-4">
            <div class="w-10 h-10 rounded bg-accent/5 flex items-center justify-center text-accent">
              <!-- Home Icon -->
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-accent">What Does Connecticut Homeowners Insurance Cover?</h2>
            <div class="p-3.5 bg-accent/5 border-l-4 border-accent-gold rounded-r text-xs text-text-secondary leading-relaxed">
              <p class="font-medium text-text-primary">
                Connecticut homeowners insurance covers dwelling reconstruction, detached structures, personal property, and personal liability against perils including fire, hail, windstorms, and winter ice damming. Associated Insurance Agency compares policies across regional and national carriers to ensure full dwelling replacement value while optimizing discounts for smoke detection, security systems, and combined policy bundles.
              </p>
            </div>
            <p class="text-sm text-text-secondary leading-relaxed">
              Your home is likely your single largest financial investment. A homeowners policy protects the physical structure of your dwelling, detached buildings, personal belongings, and provides liability coverage if a guest is injured on your property.
            </p>
            <div class="flex flex-wrap items-center gap-3 pt-1">
              <a href="/quote?type=home" class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-accent-gold hover:text-accent-gold-hover transition-colors">
                Request Home Quote
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
              <a href="/personal/homeowners" class="inline-flex items-center gap-1 text-xs font-semibold text-accent hover:underline">
                Explore In-Depth Homeowners Guide & FAQs →
              </a>
            </div>
          </div>
          <div class="lg:col-span-8 bg-bg-secondary p-8 rounded-lg border border-border-subtle space-y-6">
            <h3 class="text-base font-bold text-accent">Key Areas of Homeowners Protection</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-xs text-text-secondary leading-relaxed">
              <div>
                <h4 class="font-bold text-text-primary mb-1">Dwelling Coverage</h4>
                <p>Covers the physical structure of your home against hazards like fire, windstorms, hail, and ice dam damage. It pays to repair or rebuild.</p>
              </div>
              <div>
                <h4 class="font-bold text-text-primary mb-1">Personal Property</h4>
                <p>Protects your furniture, clothing, electronics, and appliances. Coverage applies even when you are traveling away from your home.</p>
              </div>
              <div>
                <h4 class="font-bold text-text-primary mb-1">Personal Liability</h4>
                <p>Protects you financially if you are sued for accidental bodily injury or property damage caused to others, either at your home or elsewhere.</p>
              </div>
              <div>
                <h4 class="font-bold text-text-primary mb-1">Loss of Use</h4>
                <p>Reimburses you for temporary living expenses (hotel, dining, rent) if a covered claim makes your home uninhabitable during repairs.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Auto & RV Insurance -->
        <div id="auto" class="grid grid-cols-1 lg:grid-cols-12 gap-12 pt-12 border-t border-border-subtle">
          <div class="lg:col-span-4 space-y-4">
            <div class="w-10 h-10 rounded bg-accent/5 flex items-center justify-center text-accent">
              <!-- Auto Icon -->
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.129-1.125V14.25M3 14.25h18M3 14.25V9.75A2.25 2.25 0 0 1 5.25 7.5h13.5A2.25 2.25 0 0 1 21 9.75v4.5m-18 0h18M6.75 12h.008v.008H6.75V12Zm3.75 0h.008v.008h-.008V12Zm3.75 0h.008v.008h-.008V12Zm3.75 0h.008v.008h-.008V12Z" />
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-accent">What Are Connecticut Auto Insurance Requirements (CGS § 14-112)?</h2>
            <div class="p-3.5 bg-accent/5 border-l-4 border-accent-gold rounded-r text-xs text-text-secondary leading-relaxed">
              <p class="font-medium text-text-primary">
                Under Connecticut General Statutes (CGS § 14-112), drivers must maintain minimum liability limits of $25,000 bodily injury per person, $50,000 per accident, and $25,000 property damage (25/50/25), plus matching uninsured/underinsured motorist protection. Associated Insurance Agency recommends higher limits and comprehensive collision coverage to prevent devastating out-of-pocket financial liability following serious vehicular collisions.
              </p>
            </div>
            <p class="text-sm text-text-secondary leading-relaxed">
              Connecticut law requires minimum auto liability limits, but standard coverage is rarely enough to protect you in a serious accident. We customize your limits and physical damage coverage, shopping national carriers for bundle and safety discounts.
            </p>
            <div class="flex flex-wrap items-center gap-3 pt-1">
              <a href="/quote?type=auto" class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-accent-gold hover:text-accent-gold-hover transition-colors">
                Request Auto Quote
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
              <a href="/personal/auto" class="inline-flex items-center gap-1 text-xs font-semibold text-accent hover:underline">
                Explore In-Depth Auto & RV Guide & FAQs →
              </a>
            </div>
          </div>
          <div class="lg:col-span-8 bg-bg-secondary p-8 rounded-lg border border-border-subtle space-y-6">
            <h3 class="text-base font-bold text-accent">Core Auto Policy Elements</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-xs text-text-secondary leading-relaxed">
              <div>
                <h4 class="font-bold text-text-primary mb-1">Bodily Injury & Property Damage Liability</h4>
                <p>Pays for medical costs and repair bills of other drivers and passengers if you are at fault in an automobile accident.</p>
              </div>
              <div>
                <h4 class="font-bold text-text-primary mb-1">Collision & Comprehensive</h4>
                <p>Collision covers impact damage to your own vehicle. Comprehensive covers non-collision damage (theft, vandalism, animal strikes, glass breakage).</p>
              </div>
              <div>
                <h4 class="font-bold text-text-primary mb-1">Uninsured/Underinsured Motorist</h4>
                <p>Protects you and your passengers if you are struck by a motorist who either carries no insurance or carries limits too low to pay your bills.</p>
              </div>
              <div>
                <h4 class="font-bold text-text-primary mb-1">Recreational Vehicle (RV) Coverage</h4>
                <p>Specialized policies for motorhomes, travel trailers, campers, and boats that address towing, storage, and vacation liability.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Umbrella Insurance -->
        <div id="umbrella" class="grid grid-cols-1 lg:grid-cols-12 gap-12 pt-12 border-t border-border-subtle">
          <div class="lg:col-span-4 space-y-4">
            <div class="w-10 h-10 rounded bg-accent/5 flex items-center justify-center text-accent">
              <!-- Umbrella Icon -->
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18m0-18a8.25 8.25 0 0 1 8.25 8.25v.75H3.75v-.75A8.25 8.25 0 0 1 12 3Z" />
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-accent">Why Do Connecticut Residents Need Personal Umbrella Insurance?</h2>
            <div class="p-3.5 bg-accent/5 border-l-4 border-accent-gold rounded-r text-xs text-text-secondary leading-relaxed">
              <p class="font-medium text-text-primary">
                Personal umbrella insurance provides excess liability protection starting at $1,000,000 above standard homeowners and auto policy limits. In severe accidents or premise liability lawsuits, an umbrella policy safeguards your primary home equity, savings accounts, and future earnings from catastrophic judicial judgments, typically for under $300 in annual premium.
              </p>
            </div>
            <p class="text-sm text-text-secondary leading-relaxed">
              In our highly litigious society, a single severe auto accident or pool injury on your property can result in judgements exceeding your standard auto or home liability limits. Personal umbrella insurance adds an extra layer of liability protection.
            </p>
            <div class="flex flex-wrap items-center gap-3 pt-1">
              <a href="/quote?type=umbrella" class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-accent-gold hover:text-accent-gold-hover transition-colors">
                Request Umbrella Quote
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
              <a href="/personal/umbrella" class="inline-flex items-center gap-1 text-xs font-semibold text-accent hover:underline">
                Explore In-Depth Umbrella Guide & FAQs →
              </a>
            </div>
          </div>
          <div class="lg:col-span-8 bg-bg-secondary p-8 rounded-lg border border-border-subtle space-y-6">
            <h3 class="text-base font-bold text-accent">Why Umbrella Matters</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              If your homeowners policy has a $300,000 liability limit, and a guest falls from a deck and sues you for $800,000, you are responsible for the remaining $500,000 out of pocket. That could put your savings, investments, and home equity at risk. 
            </p>
            <p class="text-xs text-text-secondary leading-relaxed">
              An umbrella policy sits on top of your underlying policies (home, auto, boat) and kicks in when their limits are exhausted. Policies typically start at $1 million in additional coverage for around $150 to $300 a year, making it one of the most cost-effective forms of wealth protection available.
            </p>
          </div>
        </div>

        <!-- Renters & Specialty (RV, Pet) -->
        <div id="renters" class="grid grid-cols-1 lg:grid-cols-12 gap-12 pt-12 border-t border-border-subtle">
          <div class="lg:col-span-4 space-y-4">
            <div class="w-10 h-10 rounded bg-accent/5 flex items-center justify-center text-accent">
              <!-- Star/Specialty Icon -->
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 0 0 .95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 0 0-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 0 0-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 0 0-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 0 0 .951-.69l1.519-4.674Z" />
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-accent">What Does Renters & Specialty Coverage Protect in Connecticut?</h2>
            <div class="p-3.5 bg-accent/5 border-l-4 border-accent-gold rounded-r text-xs text-text-secondary leading-relaxed">
              <p class="font-medium text-text-primary">
                While a landlord's policy protects the physical apartment structure, renters insurance safeguards your personal belongings—including electronics, furniture, and clothing—against fire, theft, and water leaks, while providing personal liability protection. AIA also secures specialized policies for recreational vehicles (motorhomes, boats) and comprehensive veterinary pet insurance across Connecticut.
              </p>
            </div>
            <p class="text-sm text-text-secondary leading-relaxed">
              We also write policies for tenants and niche personal lines. Your landlord's insurance only covers the building structure—it does not cover your personal belongings, furniture, or guest injuries inside your apartment.
            </p>
            <div class="flex flex-wrap items-center gap-3 pt-1">
              <a href="/quote?type=renters" class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-accent-gold hover:text-accent-gold-hover transition-colors">
                Request Renters Quote
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </a>
              <a href="/personal/renters" class="inline-flex items-center gap-1 text-xs font-semibold text-accent hover:underline">
                Explore In-Depth Renters Guide & FAQs →
              </a>
            </div>
          </div>
          <div class="lg:col-span-8 bg-bg-secondary p-8 rounded-lg border border-border-subtle space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-xs text-text-secondary leading-relaxed">
              <div>
                <h4 class="font-bold text-text-primary mb-1">Renters Insurance</h4>
                <p>Covers replacement of clothing, computers, and furniture in the event of theft or fire. Includes tenant liability in case of minor accidents inside the rented unit.</p>
              </div>
              <div>
                <h4 class="font-bold text-text-primary mb-1">Pet Insurance</h4>
                <p>Accident and illness plans for dogs and cats. Covers veterinary visits, surgeries, and prescriptions so you never have to make health decisions based on expense.</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
