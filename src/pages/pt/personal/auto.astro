---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://aia-danbury.com/pt/personal/auto#service",
      "name": "Seguro de Automóvel e RV Connecticut",
      "serviceType": "Auto and Recreational Vehicle Insurance",
      "description": "Seguro completo de automóveis, utilitários e veículos recreativos (RV) em Connecticut. Conformidade legal CGS § 14-112, colisão, cobertura compreensiva e motoristas sem seguro.",
      "provider": {
        "@type": "InsuranceAgency",
        "name": "Associated Insurance Agency",
        "telephone": "+1-203-748-9272",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "50 Newtown Road, Suite 1",
          "addressLocality": "Danbury",
          "addressRegion": "CT",
          "postalCode": "06810"
        }
      },
      "areaServed": [
        { "@type": "State", "name": "Connecticut" },
        { "@type": "City", "name": "Danbury" },
        { "@type": "City", "name": "Watertown" },
        { "@type": "City", "name": "Bridgeport" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Início",
          "item": "https://aia-danbury.com/pt"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Seguros Pessoais",
          "item": "https://aia-danbury.com/pt/personal"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Seguro de Auto e RV",
          "item": "https://aia-danbury.com/pt/personal/auto"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Quais são os limites mínimos obrigatórios de seguro auto em Connecticut (CGS § 14-112)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pelas leis de Connecticut (CGS § 14-112), todo condutor registrado deve manter limites mínimos de responsabilidade civil de $25,000 para lesões corporais por pessoa, $50,000 por acidente e $25,000 para danos materiais a terceiros (25/50/25), além de cobertura idêntica para motoristas não segurados ou com seguro insuficiente (UM/UIM)."
          }
        },
        {
          "@type": "Question",
          "name": "Por que os limites mínimos da lei representam um risco para suas economias?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O valor médio de um veículo novo hoje ultrapassa $48,000. O limite estatal de $25,000 não cobre nem a perda total de um carro comum em uma batida. Se os gastos hospitalares ultrapassarem $50,000, as partes lesadas podem buscar seus bens na justiça, penhorar o valor da sua casa e reter salários futuros. Recomendamos limites de pelo menos 100/300/100 ou 250/500/100."
          }
        },
        {
          "@type": "Question",
          "name": "Qual é a diferença entre cobertura de Colisão e Compreensiva (Comprehensive)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A cobertura de Colisão paga pelo conserto do seu carro se você bater em outro veículo, poste ou escorregar no gelo. A cobertura Compreensiva cobre sinistros fora do seu controle: colisão com animais (como cervos comuns nas estradas de CT), quebra de para-brisa, furto, vandalismo, granizo e galhos caídos durante tempestades."
          }
        },
        {
          "@type": "Question",
          "name": "Posso segurar meu trailer, motorhome ou camper com a mesma agência?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. A Associated Insurance Agency oferece apólices especializadas para veículos recreativos (RVs, trailers de viagem e motorhomes), incluindo reposição de pertences de acampamento, responsabilidade civil no camping e assistência 24 horas na estrada."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  lang="pt"
  title="Seguro de Carro e RV em Connecticut | CGS § 14-112 | AIA Danbury"
  description="Seguro de automóveis, picapes e veículos recreativos em CT. Conheça as exigências legais CGS § 14-112, colisão, compreensiva e descontos de pacote."
  structuredData={structuredData}
>
  <!-- Breadcrumb -->
  <nav class="bg-bg-secondary border-b border-border-subtle py-3 text-xs text-text-muted" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2">
      <a href="/pt" class="hover:text-accent transition-colors">Início</a>
      <span>/</span>
      <a href="/pt/personal" class="hover:text-accent transition-colors">Seguros Pessoais</a>
      <span>/</span>
      <span class="text-text-primary font-medium">Seguro de Auto e RV</span>
    </div>
  </nav>

  <!-- Hero Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-16 sm:py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-accent-gold"></span>
          Proteção nas Estradas de Connecticut
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-accent leading-tight">
          Seguro de Automóveis e Veículos Recreativos (RV) em Connecticut
        </h1>
        <p class="text-base sm:text-lg text-text-secondary leading-relaxed">
          Dirija com segurança na I-84, na Rota 7 e em todas as rodovias de Connecticut. Protegemos seu carro da família, utilitários, motorhomes e trailers com apólices personalizadas que resguardam seu bolso e seu patrimônio.
        </p>
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="/pt/quote?type=auto"
            class="px-6 py-3 rounded-lg bg-accent text-white font-semibold text-sm hover:bg-accent/90 transition-all shadow-sm"
          >
            Cotar Seguro de Auto
          </a>
          <a
            href="tel:2037489272"
            class="px-6 py-3 rounded-lg border border-border-subtle bg-white text-text-primary font-semibold text-sm hover:bg-bg-secondary transition-all"
          >
            Ligar para (203) 748-9272
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Highlights Strip -->
  <section class="border-b border-border-subtle bg-white py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <span class="block text-2xl font-bold text-accent">CGS § 14-112</span>
          <span class="text-xs text-text-muted">Conformidade Legal do Estado</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">100/300/100</span>
          <span class="text-xs text-text-muted">Limites Fortes Recomendados</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">20+</span>
          <span class="text-xs text-text-muted">Companhias de Seguro Comparadas</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">Auto + Casa</span>
          <span class="text-xs text-text-muted">Até 25% de Economia em Pacotes</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Sections -->
  <section class="py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">

      <!-- Statutory Mandate & Risk Framing -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-7 space-y-5">
          <h2 class="text-3xl font-bold text-accent tracking-tight">
            Exigências de Seguro Automóvel em Connecticut (CGS § 14-112)
          </h2>
          <div class="p-4 bg-accent/5 border-l-4 border-accent-gold rounded-r text-sm text-text-secondary leading-relaxed">
            <p class="font-medium text-text-primary">
              A lei de Connecticut exige que todo condutor possua seguro com limites mínimos de $25,000 por lesão corporal individual, $50,000 por acidente coletivo e $25,000 para danos materiais (25/50/25), além de proteção contra motoristas sem seguro (UM/UIM).
            </p>
          </div>
          <p class="text-sm text-text-secondary leading-relaxed">
            Mesmo sendo suficientes para renovar seu documento no DMV, esses valores mínimos deixam os motoristas extremamente vulneráveis. Em acidentes envolvendo carros novos ou múltiplas pessoas, as despesas médicas ultrapassam $25,000 rapidamente. Nossos agentes independentes ajudam você a obter coberturas reais por valores que cabem no seu orçamento.
          </p>
        </div>

        <div class="lg:col-span-5 bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
          <h3 class="text-base font-bold text-accent flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-accent-gold"></span>
            O Risco do Limite Mínimo da Lei
          </h3>
          <p class="text-xs text-text-secondary leading-relaxed">
            Os preços dos veículos modernos superam com folga o limite de $25,000 de danos materiais do estado.
          </p>
          <p class="text-xs text-text-secondary leading-relaxed">
            Se a apólice esgotar, os tribunais de Connecticut autorizam a penhora de contas poupança, patrimônio da casa e retenção de salários para quitar a dívida. Aumentar para <strong>100/300/100 ou 250/500/100</strong> custa pouco a mais por mês e garante tranquilidade absoluta.
          </p>
        </div>
      </div>

      <!-- Core Coverage Grid -->
      <div class="space-y-8">
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <h2 class="text-3xl font-bold text-accent">Coberturas Fundamentais do Veículo</h2>
          <p class="text-sm text-text-secondary">Proteções abrangentes para as condições de trânsito em Connecticut.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">01</div>
            <h3 class="text-base font-bold text-text-primary">Responsabilidade por Lesões Corporais</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Paga despesas médicas, reabilitação e honorários advocatícios se você for considerado culpado por ferimentos causados a outros condutores ou pedestres.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">02</div>
            <h3 class="text-base font-bold text-text-primary">Danos Materiais a Terceiros</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Conserta ou repõe veículos de terceiros, postes ou muros danificados em acidentes onde a responsabilidade foi sua.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">03</div>
            <h3 class="text-base font-bold text-text-primary">Cobertura de Colisão</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Conserta seu próprio automóvel se você colidir com outro veículo, capotar ou derrapar em pistas com neve ou gelo.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">04</div>
            <h3 class="text-base font-bold text-text-primary">Cobertura Compreensiva (Não-Colisão)</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Cobre riscos imprevisíveis: colisão com animais silvestres (veados), vidros trincados, furto, vandalismo e quedas de galhos de árvores.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">05</div>
            <h3 class="text-base font-bold text-text-primary">Motoristas Não Segurados (UM/UIM)</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Protege sua família se você for atingido por um condutor sem seguro ou que fuja do local da batida (hit-and-run).
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">06</div>
            <h3 class="text-base font-bold text-text-primary">Socorro 24 Horas e Carro Reserva</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Serviço de reboque emergencial, carga de bateria, troca de pneus furados e reembolso de locação de veículo enquanto o seu é consertado.
            </p>
          </div>
        </div>
      </div>

      <!-- RV & Campers Section -->
      <div class="bg-bg-secondary p-8 sm:p-10 rounded-2xl border border-border-subtle space-y-6">
        <div class="max-w-2xl space-y-2">
          <h2 class="text-2xl sm:text-3xl font-bold text-accent">Seguros para Motorhomes, Trailers e RVs</h2>
          <p class="text-xs sm:text-sm text-text-secondary">
            Veículos recreativos exigem apólices muito mais detalhadas do que o seguro automotivo regular:
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
          <div class="bg-white p-4 rounded-lg border border-border-subtle">
            <strong class="text-accent block mb-1">Motorhomes (Classes A, B, C)</strong>
            <p class="text-text-muted">Proteção completa e responsabilidade civil personalizada para veículos motorizados de alto padrão.</p>
          </div>
          <div class="bg-white p-4 rounded-lg border border-border-subtle">
            <strong class="text-accent block mb-1">Trailers e Campers</strong>
            <p class="text-text-muted">Proteção enquanto rebocado nas rodovias e quando estacionado em campings.</p>
          </div>
          <div class="bg-white p-4 rounded-lg border border-border-subtle">
            <strong class="text-accent block mb-1">Responsabilidade no Camping</strong>
            <p class="text-text-muted">Protege você caso visitantes se machuquem no espaço onde seu trailer está acampado.</p>
          </div>
          <div class="bg-white p-4 rounded-lg border border-border-subtle">
            <strong class="text-accent block mb-1">Bens Pessoais a Bordo</strong>
            <p class="text-text-muted">Cobre reposição a valor de novo para roupas, equipamentos eletrônicos e itens guardados no RV.</p>
          </div>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="space-y-8 max-w-4xl mx-auto">
        <div class="text-center space-y-2">
          <h2 class="text-3xl font-bold text-accent">Perguntas Frecuentes</h2>
          <p class="text-sm text-text-secondary">Dúvidas comuns sobre o seguro de auto e RV em Connecticut.</p>
        </div>

        <div class="space-y-4">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">Quais são os limites mínimos de seguro auto em CT (CGS § 14-112)?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Pelas leis de Connecticut (CGS § 14-112), todo condutor registrado deve manter limites mínimos de responsabilidade civil de $25,000 para lesões corporais por pessoa, $50,000 por acidente e $25,000 para danos materiais a terceiros (25/50/25), além de cobertura idêntica para motoristas não segurados ou com seguro insuficiente (UM/UIM).
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">Por que os limites mínimos da lei representam um risco para suas economias?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              O valor médio de um veículo novo hoje ultrapassa $48,000. O limite estatal de $25,000 não cobre nem a perda total de um carro comum em uma batida. Se os gastos hospitalares ultrapassarem $50,000, as partes lesadas podem buscar seus bens na justiça, penhorar o valor da sua casa e reter salários futuros. Recomendamos limites de pelo menos 100/300/100 ou 250/500/100.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">Qual é a diferença entre cobertura de Colisão e Compreensiva?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              A cobertura de Colisão paga pelo conserto do seu carro se você bater em outro veículo, poste ou escorregar no gelo. A cobertura Compreensiva cobre sinistros fora do seu controle: colisão com animais (como cervos comuns nas estradas de CT), quebra de para-brisa, furto, vandalismo, granizo e galhos caídos durante tempestades.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">Posso segurar meu trailer, motorhome ou camper na mesma apólice?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Sim. A Associated Insurance Agency oferece apólices especializadas para veículos recreativos (RVs, trailers de viagem e motorhomes), incluindo reposição de pertences de acampamento, responsabilidade civil no camping e assistência 24 horas na estrada.
            </p>
          </div>
        </div>
      </div>

      <!-- Conversion Banner -->
      <div class="bg-accent text-white p-8 sm:p-12 rounded-2xl shadow-xl flex flex-col md:flex-row justify-between items-center gap-8">
        <div class="space-y-2 text-center md:text-left">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">Compare Cotações de Auto e RV em Connecticut</h2>
          <p class="text-sm text-zinc-300 max-w-xl">
            Economize no seguro do seu veículo com o apoio de corretores que falam o seu idioma. Comparamos as seguradoras líderes do mercado para você.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a
            href="/pt/quote?type=auto"
            class="px-6 py-3 rounded-lg bg-accent-gold hover:bg-accent-gold-hover text-zinc-950 font-bold text-sm transition-colors text-center"
          >
            Cotar Seguro de Auto
          </a>
          <a
            href="tel:2037489272"
            class="px-6 py-3 rounded-lg bg-white/10 hover:bg-white/20 text-white font-semibold text-sm transition-colors text-center"
          >
            (203) 748-9272
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
