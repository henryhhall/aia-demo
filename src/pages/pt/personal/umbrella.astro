---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://aia-danbury.com/pt/personal/umbrella#service",
      "name": "Seguro de Responsabilidade Guarda-Chuva Connecticut",
      "serviceType": "Personal Umbrella Liability",
      "description": "Seguro de responsabilidade civil guarda-chuva (Umbrella) de $1M a $5M+ em Connecticut. Protege o valor de sua casa, contas de aposentadoria e patrimônio familiar contra ações judiciais graves.",
      "provider": {
        "@type": "InsuranceAgency",
        "name": "Associated Insurance Agency",
        "telephone": "+1-203-748-9272",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "50 Newtown Road, Suite 1",
          "addressLocality": "Danbury",
          "addressRegion": "CT",
          "postalCode": "06810"
        }
      },
      "areaServed": [
        { "@type": "State", "name": "Connecticut" },
        { "@type": "City", "name": "Danbury" },
        { "@type": "City", "name": "Watertown" },
        { "@type": "City", "name": "Bridgeport" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Início",
          "item": "https://aia-danbury.com/pt"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Seguros Pessoais",
          "item": "https://aia-danbury.com/pt/personal"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Responsabilidade Guarda-Chuva",
          "item": "https://aia-danbury.com/pt/personal/umbrella"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "O que é uma apólice Guarda-Chuva (Umbrella) e como ela funciona?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Uma apólice Guarda-Chuva (Personal Umbrella) adiciona cobertura de responsabilidade civil acima dos limites de suas apólices normais de carro, residência ou embarcação. Quando um processo ou indenização consome os limites básicos, a apólice guarda-chuva cobre o saldo restante até o limite contratado ($1,000,000 a $5,000,000 ou mais)."
          }
        },
        {
          "@type": "Question",
          "name": "Quem precisa de um seguro guarda-chuva em Connecticut?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Qualquer pessoa com patrimônio a proteger—como imóvel próprio, poupança, aposentadoria ou renda futura—se beneficia da apólice guarda-chuva. Processos judiciais afetam famílias de todos os perfis financeiros. Riscos frequentes incluem motoristas jovens, piscinas, animais de estimação e imóveis alugados."
          }
        },
        {
          "@type": "Question",
          "name": "Quanto custa uma apólice guarda-chuva de $1,000,000 em Connecticut?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Como a cobertura atua apenas após o esgotamento das apólices primárias, o custo é relativamente baixo. Uma apólice de $1,000,000 costuma variar entre $150 e $300 por ano (cerca de $15 a $25 por mês). Cada milhão adicional custa proporcionalmente menos."
          }
        },
        {
          "@type": "Question",
          "name": "Quais são os limites básicos exigidos para poder contratar a guarda-chuva?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "As seguradoras exigem limites mínimos nas apólices primárias: normalmente $250,000/$500,000 de responsabilidade por danos corporais no automóvel e $300,000 a $500,000 de responsabilidade na residência. A Associated Insurance Agency alinha suas apólices para evitar lacunas na cobertura."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  lang="pt"
  title="Seguro Guarda-Chuva (Umbrella) em CT | Proteção de Patrimônio | AIA"
  description="Apólice de responsabilidade civil guarda-chuva em CT de $1M a $5M+. Proteja sua casa, investimentos e renda familiar contra processos judiciais."
  structuredData={structuredData}
>
  <!-- Breadcrumb -->
  <nav class="bg-bg-secondary border-b border-border-subtle py-3 text-xs text-text-muted" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2">
      <a href="/pt" class="hover:text-accent transition-colors">Início</a>
      <span>/</span>
      <a href="/pt/personal" class="hover:text-accent transition-colors">Seguros Pessoais</a>
      <span>/</span>
      <span class="text-text-primary font-medium">Responsabilidade Guarda-Chuva</span>
    </div>
  </nav>

  <!-- Hero Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-16 sm:py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-accent-gold"></span>
          Proteção de Excesso de Responsabilidade em CT
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-accent leading-tight">
          Seguro de Responsabilidade Guarda-Chuva (Umbrella) em Connecticut
        </h1>
        <p class="text-base sm:text-lg text-text-secondary leading-relaxed">
          Um acidente grave de trânsito ou ocorrência em sua propriedade pode resultar em indenizações judiciais de milhões de dólares. A apólice guarda-chuva adiciona de $1,000,000 a mais de $5,000,000 em cobertura extra sobre seus seguros de carro e residência para proteger sua casa, reservas financeiras e renda futura.
        </p>
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="/pt/quote?type=umbrella"
            class="px-6 py-3 rounded-lg bg-accent text-white font-semibold text-sm hover:bg-accent/90 transition-all shadow-sm"
          >
            Cotar Apólice Guarda-Chuva
          </a>
          <a
            href="tel:2037489272"
            class="px-6 py-3 rounded-lg border border-border-subtle bg-white text-text-primary font-semibold text-sm hover:bg-bg-secondary transition-all"
          >
            Ligar para (203) 748-9272
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Highlights Strip -->
  <section class="border-b border-border-subtle bg-white py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <span class="block text-2xl font-bold text-accent">$1M - $5M+</span>
          <span class="text-xs text-text-muted">Cobertura Adicional de Responsabilidade</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">~$20 / Mês</span>
          <span class="text-xs text-text-muted">Custo Inicial Típico</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">Mundial</span>
          <span class="text-xs text-text-muted">Proteção em Viagens e Carros Alugados</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">Defesa Jurídica</span>
          <span class="text-xs text-text-muted">Paga Além do Limite da Apólice</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Sections -->
  <section class="py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">

      <!-- How it Works Snippet -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-7 space-y-5">
          <h2 class="text-3xl font-bold text-accent tracking-tight">
            Como Funciona o Seguro Guarda-Chuva Pessoal?
          </h2>
          <div class="p-4 bg-accent/5 border-l-4 border-accent-gold rounded-r text-sm text-text-secondary leading-relaxed">
            <p class="font-medium text-text-primary">
              A apólice guarda-chuva atua sobre as apólices existentes de automóvel e residência em Connecticut. Quando uma indenização ultrapassa o limite da apólice primária ($300,000 ou $500,000), a cobertura guarda-chuva assume o valor restante até o limite contratado ($1,000,000 ou mais).
            </p>
          </div>
          <p class="text-sm text-text-secondary leading-relaxed">
            Sem essa proteção, uma decisão judicial em Connecticut pode determinar a penhora do valor de sua residência, contas bancárias, contas 401(k) e até 25% de seus salários futuros para quitar uma dívida de responsabilidade.
          </p>
        </div>

        <div class="lg:col-span-5 bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
          <h3 class="text-base font-bold text-accent flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-accent-gold"></span>
            Exemplo de Sinistro
          </h3>
          <p class="text-xs text-text-secondary leading-relaxed">
            Um condutor da família se envolve em um acidente grave na I-84 com lesões corporais severas. A justiça determina uma indenização de $1,500,000.
          </p>
          <div class="space-y-1.5 text-xs text-text-secondary bg-bg-secondary p-3 rounded-lg border border-border-subtle">
            <p><strong>Apólice de Auto:</strong> Paga o limite de $500,000</p>
            <p><strong>Saldo Restante sem Cobertura:</strong> $1,000,000</p>
            <p class="text-accent font-semibold">Com Guarda-Chuva: A apólice cobre o restante de $1,000,000, protegendo sua casa e seus investimentos.</p>
          </div>
        </div>
      </div>

      <!-- High-Risk Triggers Grid -->
      <div class="space-y-8">
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <h2 class="text-3xl font-bold text-accent">Situações Cotidianas Que Exigem Proteção Guarda-Chuva</h2>
          <p class="text-sm text-text-secondary">Situações comuns onde as indenizações judiciais ultrapassam com facilidade os limites do seguro de carro e residência.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">01</div>
            <h3 class="text-base font-bold text-text-primary">Filhos Jovens ao Volante</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Condutores iniciantes registram maior incidência de acidentes graves. Uma colisão séria pode esgotar rapidamente os limites de responsabilidade da apólice de automóvel.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">02</div>
            <h3 class="text-base font-bold text-text-primary">Piscinas e Camas Elásticas</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Piscinas e camas elásticas apresentam alto risco de afogamentos e lesões graves. Custos médicos e indenizações frequentemente ultrapassam a cobertura padrão da residência.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">03</div>
            <h3 class="text-base font-bold text-text-primary">Ter Animais de Estimação (Cães)</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Pela lei de responsabilidade objetiva de Connecticut (C.G.S. § 22-357), donos de cães respondem diretamente por mordidas e lesões causadas pelo animal. As indenizações costumam exceder os limites básicos residenciais.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">04</div>
            <h3 class="text-base font-bold text-text-primary">Recepções e Churrascos em Casa</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Se um convidado consumir bebidas alcoólicas na sua residência e causar um acidente no caminho, as leis de responsabilidade do anfitrião em Connecticut podem responsabilizar você judicialmente.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">05</div>
            <h3 class="text-base font-bold text-text-primary">Lanchas, Barcos e Jetskis</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Navegar no Lago Candlewood ou em Long Island Sound envolve riscos de colisão que frequentemente ultrapassam os limites de apólices náuticas comuns.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">06</div>
            <h3 class="text-base font-bold text-text-primary">Difamação e Redes Sociais</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Cobre custas de defesa e indenizações por difamação, calúnia e invasão de privacidade, riscos excluídos pelo seguro residencial padrão.
            </p>
          </div>
        </div>
      </div>

      <!-- Limites Básicos Exigidos -->
      <div class="bg-bg-secondary p-8 sm:p-10 rounded-2xl border border-border-subtle space-y-6">
        <div class="max-w-2xl space-y-2">
          <h2 class="text-2xl sm:text-3xl font-bold text-accent">Limites Mínimos Exigidos nas Apólices Base</h2>
          <p class="text-xs sm:text-sm text-text-secondary">
            As seguradoras exigem que suas apólices primárias atendam a limites mínimos antes que a apólice guarda-chuva entre em vigor:
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 text-xs text-text-secondary">
          <div class="bg-white p-6 rounded-xl border border-border-subtle space-y-2">
            <h3 class="text-base font-bold text-accent">Requisitos para Seguro de Automóvel</h3>
            <p>A maioria das seguradoras exige $250,000 / $500,000 de danos corporais e $100,000 de danos materiais, ou limite único combinado de $500,000.</p>
          </div>
          <div class="bg-white p-6 rounded-xl border border-border-subtle space-y-2">
            <h3 class="text-base font-bold text-accent">Requisitos para Seguro Residencial</h3>
            <p>A maioria das seguradoras exige de $300,000 a $500,000 em responsabilidade pessoal (Cobertura E) na residência principal e em outros imóveis.</p>
          </div>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="space-y-8 max-w-4xl mx-auto">
        <div class="text-center space-y-2">
          <h2 class="text-3xl font-bold text-accent">Perguntas Frequentes</h2>
          <p class="text-sm text-text-secondary">Dúvidas sobre o seguro guarda-chuva em Connecticut.</p>
        </div>

        <div class="space-y-4">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">O que é uma apólice Guarda-Chuva (Umbrella) e como ela funciona?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Uma apólice Guarda-Chuva (Personal Umbrella) adiciona cobertura de responsabilidade civil acima dos limites de suas apólices normais de carro, residência ou embarcação. Quando um processo ou indenização consome os limites básicos, a apólice guarda-chuva cobre o saldo restante até o limite contratado ($1,000,000 a $5,000,000 ou mais).
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">Quem precisa de um seguro guarda-chuva em Connecticut?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Qualquer pessoa com patrimônio a proteger—como imóvel próprio, poupança, aposentadoria ou renda futura—se beneficia da apólice guarda-chuva. Processos judiciais afetam famílias de todos os perfis financeiros. Riscos frequentes incluem motoristas jovens, piscinas, animais de estimação e imóveis alugados.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">Quanto custa uma apólice guarda-chuva de $1,000,000 em Connecticut?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Como a cobertura atua apenas após o esgotamento das apólices primárias, o custo é relativamente baixo. Uma apólice de $1,000,000 costuma variar entre $150 e $300 por ano (cerca de $15 a $25 por mês). Cada milhão adicional custa proporcionalmente menos.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">Quais são os limites básicos exigidos para poder contratar a guarda-chuva?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              As seguradoras exigem limites mínimos nas apólices primárias: normalmente $250,000/$500,000 de responsabilidade por danos corporais no automóvel e $300,000 a $500,000 de responsabilidade na residência. A Associated Insurance Agency alinha suas apólices para evitar lacunas na cobertura.
            </p>
          </div>
        </div>
      </div>

      <!-- Conversion Banner -->
      <div class="bg-accent text-white p-8 sm:p-12 rounded-2xl shadow-xl flex flex-col md:flex-row justify-between items-center gap-8">
        <div class="space-y-2 text-center md:text-left">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">Proteja seu Patrimônio e sua Renda Futura</h2>
          <p class="text-sm text-zinc-300 max-w-xl">
            Por menos de um dólar ao dia, a apólice guarda-chuva protege sua residência, investimentos e renda contra processos judiciais. Fale com um consultor da AIA em Danbury, Watertown ou Bridgeport.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a
            href="/pt/quote?type=umbrella"
            class="px-6 py-3 rounded-lg bg-accent-gold hover:bg-accent-gold-hover text-zinc-950 font-bold text-sm transition-colors text-center"
          >
            Cotar Seguro Guarda-Chuva
          </a>
          <a
            href="tel:2037489272"
            class="px-6 py-3 rounded-lg bg-white/10 hover:bg-white/20 text-white font-semibold text-sm transition-colors text-center"
          >
            (203) 748-9272
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
