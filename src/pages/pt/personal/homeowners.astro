---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": "https://aia-danbury.com/pt/personal/homeowners#service",
      "name": "Seguro de Proprietários de Casas Connecticut",
      "serviceType": "Homeowners Insurance",
      "description": "Seguro residencial completo para proprietários em Connecticut. Custo de reconstrução (replacement cost), proteção de bens móveis, responsabilidade civil e endossos contra tempestades de inverno.",
      "provider": {
        "@type": "InsuranceAgency",
        "name": "Associated Insurance Agency",
        "telephone": "+1-203-748-9272",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "50 Newtown Road, Suite 1",
          "addressLocality": "Danbury",
          "addressRegion": "CT",
          "postalCode": "06810"
        }
      },
      "areaServed": [
        { "@type": "State", "name": "Connecticut" },
        { "@type": "City", "name": "Danbury" },
        { "@type": "City", "name": "Watertown" },
        { "@type": "City", "name": "Bridgeport" }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Início",
          "item": "https://aia-danbury.com/pt"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Seguros Pessoais",
          "item": "https://aia-danbury.com/pt/personal"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Seguro de Proprietários",
          "item": "https://aia-danbury.com/pt/personal/homeowners"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Qual é a diferença entre o custo de reconstrução e o valor de mercado em Connecticut?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O valor de mercado é o preço pago por um comprador, englobando o terreno e a localização. O custo de reconstrução é o valor em materiais e mão de obra necessário para reconstruir o imóvel do zero. Como os custos de mão de obra e construção em Connecticut estão entre os mais altos do país, o custo para reconstruir costuma diferir bastante do valor de mercado ou da avaliação de impostos."
          }
        },
        {
          "@type": "Question",
          "name": "O seguro residencial cobre canos congelados e represamento de gelo no telhado (ice dams)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim. As apólices padrão HO-3 e HO-5 normalmente cobrem canos rompidos pelo frio e infiltrações causadas por diques de gelo no telhado, desde que a calefação tenha sido mantida. Já os danos causados por refluxo de esgoto ou bueiros exigem um endosso específico de retorno de água."
          }
        },
        {
          "@type": "Question",
          "name": "Inundações estão cobertas pelo seguro residencial comum?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Não. O seguro residencial exclui danos causados por inundações de água na superfície, transbordamento de rios ou ressacas marítimas. A cobertura contra inundações exige uma apólice à parte pelo Programa Nacional de Seguros contra Inundação (NFIP) ou por seguradoras privadas, que emitimos junto com a apólice do seu imóvel."
          }
        },
        {
          "@type": "Question",
          "name": "Quanto posso economizar ao combinar o seguro da casa e do carro em Connecticut?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ao agrupar seus seguros de casa e automóvel com a mesma seguradora por meio da Associated Insurance Agency, você geralmente obtém descontos de 15% a 25% em ambos os prêmios, unifica suas faturas e facilita o processo em caso de sinistro."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  lang="pt"
  title="Seguro Residencial em Connecticut | Cobertura para Proprietários | AIA"
  description="Seguro residencial completo em CT. Proteja sua casa, pertences e família contra tempestades de inverno, acúmulo de gelo e nor'easters."
  structuredData={structuredData}
>
  <!-- Breadcrumb -->
  <nav class="bg-bg-secondary border-b border-border-subtle py-3 text-xs text-text-muted" aria-label="Breadcrumb">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2">
      <a href="/pt" class="hover:text-accent transition-colors">Início</a>
      <span>/</span>
      <a href="/pt/personal" class="hover:text-accent transition-colors">Seguros Pessoais</a>
      <span>/</span>
      <span class="text-text-primary font-medium">Seguro de Proprietários</span>
    </div>
  </nav>

  <!-- Hero Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-16 sm:py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 text-accent text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-accent-gold"></span>
          Cobertura Residencial em Connecticut
        </div>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-accent leading-tight">
          Seguro de Proprietários de Imóveis em Connecticut
        </h1>
        <p class="text-base sm:text-lg text-text-secondary leading-relaxed">
          Proteja sua casa contra tempestades de inverno na Nova Inglaterra, canos congelados e processos de responsabilidade civil. Comparamos cotações em seguradoras regionais e nacionais para encontrar cobertura completa pelo custo real de reconstrução com taxas competitivas.
        </p>
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a
            href="/pt/quote?type=home"
            class="px-6 py-3 rounded-lg bg-accent text-white font-semibold text-sm hover:bg-accent/90 transition-all shadow-sm"
          >
            Cotar Seguro Residencial
          </a>
          <a
            href="tel:2037489272"
            class="px-6 py-3 rounded-lg border border-border-subtle bg-white text-text-primary font-semibold text-sm hover:bg-bg-secondary transition-all"
          >
            Ligar para (203) 748-9272
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Highlights Strip -->
  <section class="border-b border-border-subtle bg-white py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <span class="block text-2xl font-bold text-accent">15% - 25%</span>
          <span class="text-xs text-text-muted">Desconto no Pacote Casa + Auto</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">100%</span>
          <span class="text-xs text-text-muted">Custo de Reconstrução Garantido</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">20+</span>
          <span class="text-xs text-text-muted">Seguradoras de Primeira Linha</span>
        </div>
        <div>
          <span class="block text-2xl font-bold text-accent">3 Agências</span>
          <span class="text-xs text-text-muted">Danbury, Watertown, Bridgeport</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Sections -->
  <section class="py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">

      <!-- What is covered Snippet -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-7 space-y-5">
          <h2 class="text-3xl font-bold text-accent tracking-tight">
            O Que o Seguro Residencial Cobre em Connecticut?
          </h2>
          <div class="p-4 bg-accent/5 border-l-4 border-accent-gold rounded-r text-sm text-text-secondary leading-relaxed">
            <p class="font-medium text-text-primary">
              O seguro residencial em Connecticut paga o conserto ou a reconstrução do seu imóvel e a reposição de bens pessoais após danos causados por incêndio, raios, granizo, ventanias, sobrecarga de neve ou vandalismo. Também inclui cobertura de responsabilidade civil caso um convidado se acidente no seu imóvel.
            </p>
          </div>
          <p class="text-sm text-text-secondary leading-relaxed">
            As residências no oeste de Connecticut variam de casas históricas no condado de Litchfield a imóveis no litoral de Fairfield, cada uma com custos de reconstrução e riscos de tempestade próprios. A Associated Insurance Agency trabalha com seguradoras como Travelers, Safeco, Hanover e Liberty Mutual para adequar a cobertura ao valor real de reconstrução da sua casa.
          </p>
        </div>

        <div class="lg:col-span-5 bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
          <h3 class="text-base font-bold text-accent flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-accent-gold"></span>
            Custo de Reconstrução vs. Valor de Mercado
          </h3>
          <p class="text-xs text-text-secondary leading-relaxed">
            Muitos proprietários baseiam a apólice no preço de compra ou no valor venal do imposto predial. O que realmente importa é o custo de reconstrução: o valor dos materiais e da mão de obra de empreiteiros locais para erguer a casa do zero.
          </p>
          <p class="text-xs text-text-secondary leading-relaxed">
            Calculamos a cobertura com base em índices regionais de construção e oferecemos endossos de custo estendido (até 125% a 150%) para que altas no preço dos materiais não deixem você descoberto após um sinistro expressivo.
          </p>
        </div>
      </div>

      <!-- Core Coverage Grid -->
      <div class="space-y-8">
        <div class="text-center max-w-2xl mx-auto space-y-2">
          <h2 class="text-3xl font-bold text-accent">Coberturas Padrão da Apólice (HO-3 e HO-5)</h2>
          <p class="text-sm text-text-secondary">Como as apólices HO-3 e HO-5 organizam as proteções essenciais.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">A</div>
            <h3 class="text-base font-bold text-text-primary">Cobertura A: Estrutura Principal</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Paga o conserto ou reconstrução da estrutura física da residência, incluindo fundação, telhado, paredes e instalações fixas, após danos por fogo, vento ou tempestades.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">B</div>
            <h3 class="text-base font-bold text-text-primary">Cobertura B: Outras Estruturas</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Cobre estruturas anexas ou separadas no seu terreno, incluindo garagens, galpões, cercas, calçadas e piscinas.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">C</div>
            <h3 class="text-base font-bold text-text-primary">Cobertura C: Bens Pessoais</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Paga a reposição de móveis, roupas, eletrônicos e utilidades domésticas em caso de perda, destruição ou furto em casa ou em viagem.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">D</div>
            <h3 class="text-base font-bold text-text-primary">Cobertura D: Perda de Uso</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Paga custos de moradia temporária (como hotéis, aluguel de curto prazo, refeições e armazenamento) se os danos cobertos tornarem o imóvel inabitável durante as reformas.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">E</div>
            <h3 class="text-base font-bold text-text-primary">Cobertura E: Responsabilidade Civil</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Cobre custos de defesa jurídica e indenizações caso um convidado se machuque no seu terreno ou você cause dano material acidental a terceiros.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-3">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-accent font-bold text-sm">F</div>
            <h3 class="text-base font-bold text-text-primary">Cobertura F: Despesas Médicas</h3>
            <p class="text-xs text-text-secondary leading-relaxed">
              Cobre despesas médicas imediatas de visitantes feridos no seu imóvel, independentemente de culpa, resolvendo acidentes leves sem ações judiciais.
            </p>
          </div>
        </div>
      </div>

      <!-- Critical Endorsements -->
      <div class="bg-bg-secondary p-8 sm:p-10 rounded-2xl border border-border-subtle space-y-6">
        <div class="max-w-2xl space-y-2">
          <h2 class="text-2xl sm:text-3xl font-bold text-accent">Endossos Fundamentais para Connecticut</h2>
          <p class="text-xs sm:text-sm text-text-secondary">
            As apólices padrão possuem exclusões pontuais. Recomendamos estes endossos para cobrir os riscos locais mais frequentes:
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
          <div class="bg-white p-4 rounded-lg border border-border-subtle">
            <strong class="text-accent block mb-1">Retorno de Água e Esgoto</strong>
            <p class="text-text-muted">Cobre danos em porões e áreas úteis causados por retorno de água de ralos, esgoto ou falha na bomba de sucção (sump pump).</p>
          </div>
          <div class="bg-white p-4 rounded-lg border border-border-subtle">
            <strong class="text-accent block mb-1">Tubulações Subterrâneas</strong>
            <p class="text-text-muted">Cobre custos de escavação e conserto caso quebrem canos de água, esgoto ou fiação subterrânea dentro da sua propriedade.</p>
          </div>
          <div class="bg-white p-4 rounded-lg border border-border-subtle">
            <strong class="text-accent block mb-1">Avaria de Equipamentos</strong>
            <p class="text-text-muted">Cobre pane mecânica ou elétrica súbita em sistemas de aquecimento, compressores de ar-condicionado, bombas de calor e painéis elétricos.</p>
          </div>
          <div class="bg-white p-4 rounded-lg border border-border-subtle">
            <strong class="text-accent block mb-1">Joias e Objetos de Valor</strong>
            <p class="text-text-muted">Garante cobertura por valor pré-fixado e sem franquia para joias, relógios, arte e coleções acima dos limites da apólice comum.</p>
          </div>
        </div>
      </div>

      <!-- New England Climate & Seasonal Exposures -->
      <div class="bg-white p-8 rounded-2xl border border-border-subtle shadow-sm space-y-4">
        <h2 class="text-2xl font-bold text-accent">Preparado para os Invernos e Nor'easters de Connecticut</h2>
        <p class="text-sm text-text-secondary leading-relaxed">
          Os invernos em Connecticut trazem riscos climáticos específicos: frio abaixo de zero que congela canos, acúmulo de neve pesada que causa infiltrações e diques de gelo no telhado, e tempestades nor'easter que quebram galhos pesados sobre fiações e telhados.
        </p>
        <p class="text-sm text-text-secondary leading-relaxed">
          Ajudamos você a selecionar franquias que caibam no seu orçamento, colocamos você em contato direto com equipes de sinistro após tempestades e garantimos que sua apólice cubra os incidentes de inverno mais comuns da região.
        </p>
      </div>

      <!-- FAQ Section -->
      <div class="space-y-8 max-w-4xl mx-auto">
        <div class="text-center space-y-2">
          <h2 class="text-3xl font-bold text-accent">Perguntas Frequentes</h2>
          <p class="text-sm text-text-secondary">Dúvidas comuns sobre o seguro residencial em Connecticut.</p>
        </div>

        <div class="space-y-4">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">Qual é a diferença entre custo de reconstrução e valor de mercado?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              O valor de mercado é o preço pago por um comprador, englobando o terreno e a localização. O custo de reconstrução é o valor em materiais e mão de obra necessário para reconstruir o imóvel do zero. Como os custos de mão de obra e construção em Connecticut estão entre os mais altos do país, o custo para reconstruir costuma diferir bastante do valor de mercado ou da avaliação de impostos.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">O seguro residencial cobre canos congelados e acúmulo de gelo (ice dams)?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Sim. As apólices padrão HO-3 e HO-5 normalmente cobrem canos rompidos pelo frio e infiltrações causadas por diques de gelo no telhado, desde que a calefação tenha sido mantida. Já os danos causados por refluxo de esgoto ou bueiros exigem um endosso específico de retorno de água.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">Inundações estão cobertas pelo seguro residencial comum?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Não. O seguro residencial exclui danos causados por inundações de água na superfície, transbordamento de rios ou ressacas marítimas. A cobertura contra inundações exige uma apólice à parte pelo Programa Nacional de Seguros contra Inundação (NFIP) ou por seguradoras privadas, que emitimos junto com a apólice do seu imóvel.
            </p>
          </div>

          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-2">
            <h3 class="text-base font-bold text-accent">Quanto posso economizar ao combinar o seguro da casa e do carro?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Ao agrupar seus seguros de casa e automóvel com a mesma seguradora por meio da Associated Insurance Agency, você geralmente obtém descontos de 15% a 25% em ambos os prêmios, unifica suas faturas e facilita o processo em caso de sinistro.
            </p>
          </div>
        </div>
      </div>

      <!-- Conversion Banner -->
      <div class="bg-accent text-white p-8 sm:p-12 rounded-2xl shadow-xl flex flex-col md:flex-row justify-between items-center gap-8">
        <div class="space-y-2 text-center md:text-left">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">Proteja Sua Casa e o Futuro da Sua Família</h2>
          <p class="text-sm text-zinc-300 max-w-xl">
            Nossos corretores independentes comparam as principais seguradoras de Connecticut para oferecer cobertura consistente, franquias claras e descontos especiais em pacotes.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a
            href="/pt/quote?type=home"
            class="px-6 py-3 rounded-lg bg-accent-gold hover:bg-accent-gold-hover text-zinc-950 font-bold text-sm transition-colors text-center"
          >
            Cotar Seguro de Casa
          </a>
          <a
            href="tel:2037489272"
            class="px-6 py-3 rounded-lg bg-white/10 hover:bg-white/20 text-white font-semibold text-sm transition-colors text-center"
          >
            (203) 748-9272
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
