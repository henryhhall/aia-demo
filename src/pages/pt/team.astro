---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TeamSection from '../../components/TeamSection.astro';
import { teamData } from '../../i18n/team';

const lang = 'pt';
const localeData = teamData[lang];

const teamStructuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "name": "Conheça a Nossa Equipe | Associated Insurance Agency",
  "description": "Conheça os corretores de seguros independentes e a equipe de atendimento da Associated Insurance Agency. Especialistas multilíngues atendendo Danbury, Watertown, Bridgeport e todo o Connecticut.",
  "mainEntity": {
    "@type": "InsuranceAgency",
    "name": "Associated Insurance Agency",
    "url": "https://aia-danbury.com/pt",
    "telephone": "+1-203-748-9272",
    "founder": {
      "@type": "Person",
      "name": "Ronald T. Boucher",
      "jobTitle": "Diretor Principal e Fundador"
    },
    "employee": localeData.members.map((member) => ({
      "@type": "Person",
      "name": member.name,
      "jobTitle": member.role,
      "description": member.shortBio,
      "knowsLanguage": member.languages,
      "workLocation": {
        "@type": "Place",
        "name": `Associated Insurance Agency - ${member.officeName}`
      },
      ...(member.isProducer && member.npn ? {
        "identifier": {
          "@type": "PropertyValue",
          "name": "National Producer Number (NPN)",
          "value": member.npn
        }
      } : {})
    }))
  }
};
---

<BaseLayout
  title="Conheça a Nossa Equipe | Associated Insurance Agency CT"
  description="Conheça os corretores de seguros independentes e licenciados da Associated Insurance Agency. Atendimento multilíngue em Danbury, Watertown, Bridgeport e em todo o CT."
  structuredData={teamStructuredData}
>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/5 border border-accent/10 text-accent text-xs font-semibold uppercase tracking-wider mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-accent-gold"></span>
        Corretores Licenciados Multilíngues
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-accent leading-none">
        Conheça a Nossa Equipe
      </h1>
      <p class="mt-4 text-sm sm:text-base text-text-secondary max-w-[65ch] leading-relaxed">
        Nossos profissionais de seguros licenciados e experientes vivem e trabalham aqui mesmo em Connecticut. Como corretora independente, trabalhamos diretamente para você, pesquisando mais de 20 seguradoras de ponta para proteger o que é mais importante.
      </p>

      <!-- Trust Badges & Stats Bar -->
      <div class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 pt-8 border-t border-border-subtle">
        <div class="p-4 rounded-xl bg-bg-secondary/50 border border-border-subtle">
          <div class="text-2xl sm:text-3xl font-extrabold text-accent">9</div>
          <div class="text-xs font-medium text-text-secondary mt-1">Especialistas Dedicados</div>
        </div>
        <div class="p-4 rounded-xl bg-bg-secondary/50 border border-border-subtle">
          <div class="text-2xl sm:text-3xl font-extrabold text-accent-gold">4</div>
          <div class="text-xs font-medium text-text-secondary mt-1">Idiomas Fluentes</div>
        </div>
        <div class="p-4 rounded-xl bg-bg-secondary/50 border border-border-subtle">
          <div class="text-2xl sm:text-3xl font-extrabold text-accent">3</div>
          <div class="text-xs font-medium text-text-secondary mt-1">Filiais em Connecticut</div>
        </div>
        <div class="p-4 rounded-xl bg-bg-secondary/50 border border-border-subtle">
          <div class="text-2xl sm:text-3xl font-extrabold text-accent-gold">20+</div>
          <div class="text-xs font-medium text-text-secondary mt-1">Seguradoras Parceiras</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Value Pillars -->
  <section class="py-14 bg-bg-primary border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Pillar 1 -->
        <div class="p-6 rounded-2xl bg-bg-secondary/30 border border-border-subtle space-y-3">
          <div class="w-10 h-10 rounded-lg bg-accent/5 flex items-center justify-center text-accent">
            <svg class="w-5 h-5 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
            </svg>
          </div>
          <h2 class="text-base font-bold text-accent">Relacionamento Direto e Próximo</h2>
          <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
            Diga adeus a menus telefônicos intermináveis e centrais de atendimento impessoais. Você terá acesso direto a corretores locais em Connecticut que conhecem seu histórico e suas apólices.
          </p>
        </div>

        <!-- Pillar 2 -->
        <div class="p-6 rounded-2xl bg-bg-secondary/30 border border-border-subtle space-y-3">
          <div class="w-10 h-10 rounded-lg bg-accent/5 flex items-center justify-center text-accent">
            <svg class="w-5 h-5 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802" />
            </svg>
          </div>
          <h2 class="text-base font-bold text-accent">Comunicação no Seu Idioma</h2>
          <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
            Apoiamos famílias e empresários de Connecticut em português, inglês, espanhol e turco. Todos os detalhes e cláusulas do seu seguro são explicados de forma clara e sem barreiras.
          </p>
        </div>

        <!-- Pillar 3 -->
        <div class="p-6 rounded-2xl bg-bg-secondary/30 border border-border-subtle space-y-3">
          <div class="w-10 h-10 rounded-lg bg-accent/5 flex items-center justify-center text-accent">
            <svg class="w-5 h-5 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
            </svg>
          </div>
          <h2 class="text-base font-bold text-accent">Representação Independente</h2>
          <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
            Ao contrário de corretores cativos que trabalham para uma única seguradora, nós defendemos exclusivamente seus interesses. Se os preços subirem, pesquisamos novas opções sem que você precise trocar de agência.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Team Cards & Modal -->
  <TeamSection lang="pt" />

  <!-- Bottom CTA Section -->
  <section class="py-16 bg-accent text-white border-t border-accent-gold/20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-r from-accent via-accent-hover to-accent rounded-3xl p-8 sm:p-12 border border-white/10 shadow-2xl flex flex-col lg:flex-row items-center justify-between gap-8">
        <div class="space-y-3 text-center lg:text-left max-w-[60ch]">
          <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-accent-gold/20 text-accent-gold uppercase tracking-wider">
            Corretora Independente de Connecticut
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">
            Pronto para Conversar com um Corretor?
          </h2>
          <p class="text-xs sm:text-sm text-white/80 leading-relaxed">
            Seja para uma revisão gratuita da sua apólice, uma cotação personalizada para seu negócio ou ajuda com sua conta existente, nossa equipe está pronta para atendê-lo.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto">
          <a
            href="tel:2037489272"
            class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-6 py-3.5 rounded-xl text-xs font-bold uppercase tracking-wider bg-accent-gold text-accent hover:bg-accent-gold-hover transition-all shadow-md active:scale-98"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.942-6.942l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            Ligar para (203) 748-9272
          </a>
          <a
            href="/pt/quote"
            class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-6 py-3.5 rounded-xl text-xs font-bold uppercase tracking-wider bg-white/10 hover:bg-white/20 text-white border border-white/20 transition-all shadow-sm active:scale-98"
          >
            Solicitar uma Cotação
          </a>
          <a
            href="/pt/contact"
            class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-6 py-3.5 rounded-xl text-xs font-bold uppercase tracking-wider bg-transparent hover:bg-white/10 text-white/90 transition-all"
          >
            Nossas Agências
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
