---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import BlogArchiveList from '../../../components/BlogArchiveList.astro';

const lang = 'pt';
const posts = await getCollection('blog', ({ id, data }) => id.startsWith(`${lang}/`) && !data.draft);
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const blogPageStructuredData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Blog da Associated Insurance Agency",
  "description": "Dicas de seguros, conselhos de segurança residencial para o inverno e informações sobre responsabilidade de eventos da agência independente de confiança de Connecticut.",
  "url": "https://aia-danbury.com/pt/blog",
};
---

<BaseLayout
  title="Blog de Seguros e Perspectivas | Associated Insurance Agency CT"
  description="Mantenha-se informado com dicas de seguros, listas de verificação de proteção de propriedades para o inverno e guias de cobertura para eventos especiais da AIA."
  structuredData={blogPageStructuredData}
>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-accent leading-none">
        Perspectivas e Conselhos da AIA
      </h1>
      <p class="mt-4 text-sm sm:text-base text-text-secondary max-w-[60ch]">
        Mantenha-se atualizado com conselhos de segurança para o inverno, orientação sobre responsabilidade de casamentos e listas de verificação para planejamento de viagens.
      </p>
    </div>
  </section>

  <!-- Blog List Section with Location Filtering -->
  <section class="py-16 sm:py-20 bg-bg-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <BlogArchiveList posts={sortedPosts} lang="pt" />
    </div>
  </section>
</BaseLayout>
