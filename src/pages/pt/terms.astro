---
/**
 * Terms of Service (Portuguese) - Associated Insurance Agency
 * Termos de Serviço em Português abordando agência independente,
 * consentimento para ligações e SMS (TCPA), aviso de cobertura não vinculante online,
 * limitação de responsabilidade e jurisdição de Connecticut.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'pt';
const t = useTranslations(lang);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Termos de Serviço | Associated Insurance Agency",
  "description": "Termos legais de serviço e acordo de utilização do site da Associated Insurance Agency em Connecticut.",
  "inLanguage": "pt",
  "publisher": {
    "@type": "InsuranceAgency",
    "name": "Associated Insurance Agency",
    "telephone": "+1-203-748-9272",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "50 Newtown Road, Suite 1",
      "addressLocality": "Danbury",
      "addressRegion": "CT",
      "postalCode": "06810",
      "addressCountry": "US"
    }
  }
};
---

<BaseLayout
  title="Termos de Serviço | Associated Insurance Agency CT"
  description="Leia os Termos de Serviço da Associated Insurance Agency. Entenda os termos de uso do site, isenções de cotações, consentimento de comunicações e relação com seguradoras."
  structuredData={structuredData}
>
  <!-- Cabeçalho da Página / Hero -->
  <section class="bg-gradient-to-b from-bg-secondary to-bg-primary py-16 sm:py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-accent/5 text-accent text-xs font-semibold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-accent-gold animate-pulse"></span>
        Conformidade Legal e Regulatória
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-accent leading-none">
        {t('terms.title')}
      </h1>
      <p class="text-sm sm:text-base text-text-secondary max-w-[65ch] mx-auto leading-relaxed">
        {t('terms.subtitle')}
      </p>
      <div class="pt-2 flex items-center justify-center gap-3 text-xs text-text-muted">
        <span>Data de Vigência: Outubro de 2026</span>
        <span>•</span>
        <span>Última Atualização: Outubro de 2026</span>
      </div>
    </div>
  </section>

  <!-- Conteúdo Principal dos Termos -->
  <section class="py-16 sm:py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Índice Fixo (Barra Lateral Desktop) -->
        <aside class="hidden lg:block lg:col-span-4 sticky top-28 space-y-6">
          <div class="bg-white p-6 rounded-xl border border-border-subtle shadow-sm space-y-4">
            <h2 class="text-sm font-bold text-accent uppercase tracking-wider border-b border-border-subtle pb-3 flex items-center gap-2">
              <span class="w-1.5 h-4 bg-accent-gold rounded-full"></span>
              Índice de Conteúdo
            </h2>
            <nav class="space-y-1.5 text-xs text-text-secondary">
              <a href="#aceitacao" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">1. Aceitação dos Termos</a>
              <a href="#papel-agencia" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">2. Papel de Agência Independente</a>
              <a href="#nao-vinculativo" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors text-red-600 font-semibold">3. Cobertura Não Vinculativa Online</a>
              <a href="#cotacoes" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">4. Cotações e Precisão de Tarifas</a>
              <a href="#comunicacoes" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors text-accent font-semibold">5. Consentimento Telefônico e SMS</a>
              <a href="#seguradoras" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">6. Seguradoras Parceiras Terceirizadas</a>
              <a href="#conduta-usuario" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">7. Conduta e Veracidade das Informações</a>
              <a href="#propriedade-intelectual" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">8. Propriedade Intelectual</a>
              <a href="#limitacao-responsabilidade" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">9. Limitação de Responsabilidade</a>
              <a href="#lei-aplicavel" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">10. Legislação Aplicável (Connecticut)</a>
              <a href="#modificacoes" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">11. Modificações dos Termos</a>
              <a href="#contato" class="block py-1.5 px-2.5 rounded hover:bg-bg-secondary hover:text-accent font-medium transition-colors">12. Informações de Contato</a>
            </nav>
          </div>

          <!-- Caixa de Suporte Imediato -->
          <div class="bg-accent text-white p-6 rounded-xl shadow-md space-y-3">
            <h3 class="text-sm font-bold text-accent-gold">Dúvidas sobre sua Cobertura?</h3>
            <p class="text-xs text-zinc-300 leading-relaxed">
              Nossos corretores licenciados estão prontos para explicar apólices, coberturas e exigências estaduais em português.
            </p>
            <div class="pt-2">
              <a href="tel:2037489272" class="inline-flex items-center gap-2 text-xs font-semibold text-white hover:text-accent-gold transition-colors">
                <svg class="w-4 h-4 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.942-6.942l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                </svg>
                Ligar para (203) 748-9272
              </a>
            </div>
          </div>
        </aside>

        <!-- Cláusulas dos Termos -->
        <div class="lg:col-span-8 space-y-10 text-left">
          
          <!-- Resumo do Contrato -->
          <div class="p-5 sm:p-6 bg-accent/5 border-l-4 border-accent-gold rounded-r-xl space-y-2">
            <h2 class="text-base font-bold text-accent">Resumo do Contrato</h2>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Estes Termos de Serviço ("Termos") regem seu acesso e uso do site, pedidos de cotação online, formulários de contato e serviços digitais operados pela <strong>Associated Insurance Agency</strong> ("AIA", "nós" ou "nosso"). Ao navegar pelo site ou enviar dados, você concorda em cumprir estes Termos e as normas vigentes.
            </p>
          </div>

          <!-- Seção 1 -->
          <article id="aceitacao" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Seção 1</span>
              Aceitação dos Termos
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Ao acessar, navegar ou utilizar este site (<a href="https://aia-danbury.com/pt" class="text-accent underline font-medium">https://aia-danbury.com/pt</a>) e aplicações correlatas, você confirma que leu, compreendeu e concorda em estar legalmente vinculado a estes Termos. Caso discorde, interrompa imediatamente a utilização do site.
            </p>
          </article>

          <!-- Seção 2 -->
          <article id="papel-agencia" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Seção 2</span>
              Natureza dos Serviços e Papel de Agência Independente
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              A Associated Insurance Agency é uma corretora de seguros independente de serviço completo com sede em Danbury, Connecticut, e filiais em Watertown e Bridgeport. Como agência independente, a AIA representa múltiplas companhias seguradoras (incluindo Safeco, Travelers, Progressive, The Hartford, Foremost e outras).
            </p>
            <p class="text-sm text-text-secondary leading-relaxed">
              A AIA não é uma seguradora e não assume riscos de subscrição diretamente. Todas as apólices, coberturas, endossos, preços, exclusões, liquidações de sinistros e cancelamentos são estritamente regidos pelos contratos emitidos pelas respectivas companhias seguradoras.
            </p>
          </article>

          <!-- Seção 3: Aviso Regulatório Crítico -->
          <article id="nao-vinculativo" class="space-y-4 scroll-mt-28 p-6 bg-red-500/5 border border-red-500/20 rounded-xl">
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-red-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
              </svg>
              <div>
                <h2 class="text-lg font-bold text-red-700">
                  Seção 3: Aviso Obrigatório — Cobertura Não Vinculativa por Meios Eletrônicos
                </h2>
                <p class="mt-2 text-sm text-red-950 font-medium leading-relaxed">
                  <strong>A COBERTURA NÃO PODE SER VINCULADA, ALTERADA OU CANCELADA ATRAVÉS DE FORMULÁRIO DO SITE, E-MAIL, MENSAGEM DE TEXTO OU CORREIO DE VOZ.</strong>
                </p>
              </div>
            </div>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              O envio de solicitação de cotação ou mensagem não constitui vinculação de seguro nem altera apólices vigentes. A cobertura só entra em vigor após confirmação direta e expressa por escrito de um corretor licenciado e após o processamento do pagamento inicial exigido pela seguradora contratada.
            </p>
          </article>

          <!-- Seção 4 -->
          <article id="cotacoes" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Seção 4</span>
              Cotações, Estimativas e Precisão das Informações
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Todas as cotações, estimativas e comparações exibidas neste site constituem ilustrações não vinculativas com base nos dados preliminares fornecidos pelo usuário.
            </p>
            <p class="text-sm text-text-secondary leading-relaxed">
              Os valores finais e a aprovação de cobertura estão condicionados à análise da seguradora, vistorias, verificação de registros de direção (MVR), histórico de sinistros (C.L.U.E.) e critérios de pontuação permitidos por lei. Em caso de divergência, prevalecerá a apólice emitida pela seguradora.
            </p>
          </article>

          <!-- Seção 5: Consentimento Telefônico e SMS -->
          <article id="comunicacoes" class="space-y-4 scroll-mt-28 p-6 bg-accent/5 border border-accent/15 rounded-xl">
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a.75.75 0 0 1-.974-.943 4.464 4.464 0 0 0 1.04-2.887A8.19 8.19 0 0 1 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
              </svg>
              <div>
                <h2 class="text-lg font-bold text-accent">
                  Seção 5: Consentimento para Comunicações Telefônicas e SMS (TCPA / 10DLC)
                </h2>
                <div class="mt-2 p-3 bg-white border border-border-subtle rounded-lg text-sm text-text-primary font-medium">
                  "Fornecer um número autoriza chamadas/mensagens nossas sobre a mensagem."
                </div>
              </div>
            </div>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Ao fornecer seu número de telefone em qualquer formulário deste site, você autoriza expressamente a Associated Insurance Agency e seus corretores credenciados a entrarem em contato via chamadas e mensagens de texto (SMS) referentes à sua solicitação de cotação ou atendimento.
            </p>
            <ul class="space-y-1.5 text-xs text-text-secondary pl-5 list-disc">
              <li><strong>Frequência:</strong> A frequência das mensagens varia conforme suas demandas de atendimento e apólice.</li>
              <li><strong>Tarifas:</strong> Tarifas padrão de mensagens e dados da sua operadora podem incidir.</li>
              <li><strong>Cancelamento (Opt-Out):</strong> Você pode cancelar o envio de SMS a qualquer momento respondendo <strong>STOP</strong> a qualquer mensagem.</li>
              <li><strong>Ajuda:</strong> Responda <strong>HELP</strong> para obter assistência ou ligue para nossa agência em Danbury: <a href="tel:2037489272" class="text-accent underline font-semibold">(203) 748-9272</a>.</li>
            </ul>
          </article>

          <!-- Seção 6 -->
          <article id="seguradoras" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Seção 6</span>
              Portais de Seguradoras e Links Externos
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Nosso site contém links diretos para portais de seguradoras parceiras para pagamento de contas e comunicação de sinistros (como Progressive, Safeco, Travelers e MetLife). Tais sites pertencem a terceiros e operam de maneira independente da AIA.
            </p>
            <p class="text-sm text-text-secondary leading-relaxed">
              A AIA não monitora, apoia ou assume obrigações quanto ao conteúdo, segurança ou políticas de privacidade de páginas externas.
            </p>
          </article>

          <!-- Seção 7 -->
          <article id="conduta-usuario" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Seção 7</span>
              Conduta do Usuário e Veracidade das Informações
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Você concorda em fornecer informações fidedignas, precisas e atualizadas ao submeter pedidos ou consultas. Informações falsas ou imprecisas podem acarretar a anulação da cobertura de seguro nos termos da legislação estadual e caracterizar fraude de seguro.
            </p>
            <p class="text-sm text-text-secondary leading-relaxed">
              É estritamente proibido o uso de robôs, scrapers ou rotinas automatizadas para coletar dados do site ou sobrecarregar nossos canais de atendimento com mensagens não solicitadas (spam).
            </p>
          </article>

          <!-- Seção 8 -->
          <article id="propriedade-intelectual" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Seção 8</span>
              Direitos de Propriedade Intelectual
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Todo o conteúdo, layout, logotipos, ilustrações, marcas e códigos de software são propriedade exclusiva da Associated Insurance Agency e protegidos pelas leis de direitos autorais e propriedade industrial dos Estados Unidos e internacionais.
            </p>
            <p class="text-sm text-text-secondary leading-relaxed">
              Concede-se licença limitada para visualização e impressão de páginas apenas para fins pessoais e não comerciais de consulta a serviços de seguro.
            </p>
          </article>

          <!-- Seção 9 -->
          <article id="limitacao-responsabilidade" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Seção 9</span>
              Isenção de Garantias e Limitação de Responsabilidade
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              ESTE SITE E SEUS CONTEÚDOS SÃO DISPONIBILIZADOS "NO ESTADO EM QUE SE ENCONTRAM" E "CONFORME DISPONIBILIDADE", SEM GARANTIAS DE QUALQUER NATUREZA, EXPRESSAS OU IMPLÍCITAS.
            </p>
            <p class="text-sm text-text-secondary leading-relaxed">
              EM NENHUM CASO A ASSOCIATED INSURANCE AGENCY, SEUS CORRETORES LICENCIADOS OU DIRETORES SERÃO RESPONSÁVEIS POR QUAISQUER DANOS INDIRETOS, INCIDENTAIS OU EMERGENTES DECORRENTES DO USO OU IMPOSSIBILIDADE DE USO DESTE SITE.
            </p>
          </article>

          <!-- Seção 10 -->
          <article id="lei-aplicavel" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Seção 10</span>
              Legislação Aplicável e Foro
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Estes Termos de Serviço são regidos e interpretados segundo as leis substantivas do <strong>Estado de Connecticut</strong>, sem aplicação de disposições de conflito de leis.
            </p>
            <p class="text-sm text-text-secondary leading-relaxed">
              Qualquer demanda judicial decorrente destes Termos deverá ser ajuizada exclusivamente perante os tribunais estaduais ou federais do Condado de Fairfield ou Condado de Hartford, Connecticut.
            </p>
          </article>

          <!-- Seção 11 -->
          <article id="modificacoes" class="space-y-3 scroll-mt-28">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Seção 11</span>
              Modificações dos Termos
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              A AIA reserva-se o direito de atualizar estes Termos a qualquer momento sem aviso prévio. As atualizações vigoram imediatamente após publicação no site. O uso contínuo do site após alterações representa concordância com os novos Termos.
            </p>
          </article>

          <!-- Seção 12: Contato -->
          <article id="contato" class="space-y-4 scroll-mt-28 pt-6 border-t border-border-subtle">
            <h2 class="text-xl font-bold text-accent flex items-center gap-2">
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-accent/10 text-accent">Seção 12</span>
              Informações de Contato e Agências
            </h2>
            <p class="text-sm text-text-secondary leading-relaxed">
              Em caso de dúvidas a respeito destes Termos de Serviço, entre em contato conosco:
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
              <div class="p-4 bg-bg-secondary rounded-lg border border-border-subtle space-y-1 text-xs">
                <span class="font-bold text-accent block">Sede em Danbury</span>
                <span class="text-text-secondary block">50 Newtown Road, Suite 1</span>
                <span class="text-text-secondary block">Danbury, CT 06810</span>
                <a href="tel:2037489272" class="text-accent font-semibold hover:underline block pt-1">(203) 748-9272</a>
              </div>
              <div class="p-4 bg-bg-secondary rounded-lg border border-border-subtle space-y-1 text-xs">
                <span class="font-bold text-accent block">Agência Watertown</span>
                <span class="text-text-secondary block">51 Depot St Ste 112</span>
                <span class="text-text-secondary block">Watertown, CT 06795</span>
                <a href="tel:8602747100" class="text-accent font-semibold hover:underline block pt-1">(860) 274-7100</a>
              </div>
              <div class="p-4 bg-bg-secondary rounded-lg border border-border-subtle space-y-1 text-xs">
                <span class="font-bold text-accent block">Agência Bridgeport</span>
                <span class="text-text-secondary block">2465 Main Street</span>
                <span class="text-text-secondary block">Bridgeport, CT 06606</span>
                <a href="tel:2033675300" class="text-accent font-semibold hover:underline block pt-1">(203) 367-5300</a>
              </div>
            </div>
          </article>

        </div>

      </div>
    </div>
  </section>
</BaseLayout>
