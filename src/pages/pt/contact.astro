---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm';
import OfficeLocationsMap from '../../components/OfficeLocationsMap.astro';
import ContactHero from '../../components/ContactHero.astro';

const lang = 'pt';

const contactStructuredData = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Entre em Contato com a Associated Insurance Agency",
  "description": "Entre em contato com a Associated Insurance Agency em Connecticut. Visite nossa sede em Danbury ou agências em Watertown e Bridgeport.",
};
---

<BaseLayout
  title="Fale Conosco | Associated Insurance Agency CT"
  description="Entre em contato com a Associated Insurance Agency em Connecticut. Visite nossa sede em Danbury ou agências em Watertown e Bridgeport. Atendimento multilíngue em português."
  structuredData={contactStructuredData}
>
  <!-- Hero Section with Team Photo -->
  <ContactHero lang={lang} />

  <!-- Main Content Grid -->
  <section class="py-16 sm:py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-start">
        
        <!-- Left Column: Interactive Contact Form with Honeypots -->
        <div id="contact-form" class="lg:col-span-6 space-y-6 scroll-mt-24">
          <ContactForm client:load lang={lang} />
        </div>

        <!-- Right Column: Interactive Google Maps Embed & Branch Locations -->
        <div class="lg:col-span-6">
          <OfficeLocationsMap lang={lang} />
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
