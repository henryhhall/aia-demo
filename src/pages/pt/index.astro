---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Fetch content
const posts = await getCollection('blog', ({ id }) => id.startsWith('pt/'));
const sortedPosts = posts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);

const testimonials = await getCollection('testimonials', ({ id }) => id.startsWith('pt/'));

const mainStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Associated Insurance Agency",
  "url": "https://aia-danbury.com/pt",
  "description": "A Associated Insurance Agency é uma agência de seguros independente de serviço completo em Danbury, Watertown e Bridgeport CT, que fornece linhas de seguro residencial, automóvel, comercial e responsabilidade guarda-chuva.",
};
---

<BaseLayout
  title="Associated Insurance Agency CT — Danbury, Watertown e Bridgeport"
  description="A Associated Insurance Agency CT é uma agência de seguros independente que oferece apólices de seguro residencial, automotivo, comercial e guarda-chuva. Compare as melhores tarifas em CT."
  structuredData={mainStructuredData}
>
  <!-- Hero Section -->
  <section class="relative min-h-[85dvh] flex items-center bg-gradient-to-br from-bg-primary via-bg-primary to-bg-secondary overflow-hidden py-20 border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left Side: Content -->
        <div class="lg:col-span-7 space-y-6 text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/5 border border-accent/10 text-accent text-xs font-semibold uppercase tracking-wider">
            <span class="w-1.5 h-1.5 rounded-full bg-accent-gold animate-pulse"></span>
            Agência CT Independente
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tighter leading-none text-accent">
            Nós pesquisamos. <br class="hidden sm:inline" />
            <span class="text-text-primary">Você economiza.</span> <br />
            Seguros independentes em CT.
          </h1>
          <p class="text-base sm:text-lg text-text-secondary leading-relaxed max-w-[60ch]">
            Como corretores independentes em Danbury, Watertown e Bridgeport, trabalhamos diretamente para você, não para uma seguradora. Comparamos cotações em mais de 20 seguradoras para encontrar a cobertura certa com tarifas competitivas. Atendemos em inglês, espanhol, português e turco.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 pt-2">
            <a
              href="/pt/quote"
              class="inline-flex items-center justify-center px-6 py-3.5 text-sm font-semibold tracking-wider uppercase text-white bg-accent hover:bg-accent/90 active:scale-[0.98] rounded transition-all shadow-md text-center"
            >
              Cotação Gratuita
            </a>
            <a
              href="/pt/service"
              class="inline-flex items-center justify-center px-6 py-3.5 text-sm font-semibold tracking-wider uppercase text-accent border border-accent/20 hover:bg-bg-secondary active:scale-[0.98] rounded transition-all text-center"
            >
              Sinistros e Suporte
            </a>
          </div>
        </div>

        <!-- Right Side: Interactive pre-selector -->
        <div class="lg:col-span-5 relative">
          <div class="absolute -inset-4 bg-accent-gold/5 rounded-2xl blur-xl"></div>
          <div class="relative bg-white border border-border-subtle rounded-xl p-8 shadow-xl space-y-6">
            <h3 class="text-lg font-bold text-accent">Compare Tarifas de Seguros em CT</h3>
            <p class="text-xs text-text-secondary">Selecione uma apólice para comparar valores entre seguradoras de CT.</p>
            <div class="grid grid-cols-2 gap-3">
              <a href="/pt/quote?type=home" class="flex flex-col p-4 border border-border-subtle rounded hover:border-accent-gold hover:bg-bg-secondary text-left transition-all">
                <span class="text-sm font-semibold text-accent mb-0.5">Proprietários</span>
                <span class="text-[10px] text-text-muted">Propriedades e Responsabilidade</span>
              </a>
              <a href="/pt/quote?type=auto" class="flex flex-col p-4 border border-border-subtle rounded hover:border-accent-gold hover:bg-bg-secondary text-left transition-all">
                <span class="text-sm font-semibold text-accent mb-0.5">Auto e RV</span>
                <span class="text-[10px] text-text-muted">Responsabilidade e Físico</span>
              </a>
              <a href="/pt/quote?type=business" class="flex flex-col p-4 border border-border-subtle rounded hover:border-accent-gold hover:bg-bg-secondary text-left transition-all">
                <span class="text-sm font-semibold text-accent mb-0.5">Comercial</span>
                <span class="text-[10px] text-text-muted">Geral e Acidentes de Trabalho</span>
              </a>
              <a href="/pt/quote" class="flex flex-col p-4 border border-border-subtle rounded hover:border-accent-gold hover:bg-bg-secondary text-left transition-all">
                <span class="text-sm font-semibold text-accent mb-0.5">Outras Linhas</span>
                <span class="text-[10px] text-text-muted">Guarda-Chuva, Pets, Inquilinos</span>
              </a>
            </div>
            <div class="text-[11px] text-text-muted text-center pt-2 border-t border-border-subtle/50">
              Sem compromisso. Consultas gratuitas. Fale com um agente local.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The Independent Advantage -->
  <section class="py-24 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-16 space-y-4">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-accent">A Vantagem de uma Agência Independente</h2>
        <div class="p-4 bg-accent/5 border-l-4 border-accent-gold rounded-r text-sm text-text-secondary leading-relaxed">
          <p class="font-medium text-text-primary">
            Agentes exclusivos vendem apenas apólices de uma empresa. Por ser independente, a Associated Insurance Agency cota sua proteção em mais de 20 seguradoras, incluindo Travelers, The Hartford, Safeco e Progressive. Você obtém tarifas competitivas, suporte direto em sinistros e corretores licenciados que falam português, inglês, espanhol e turco em Danbury, Watertown e Bridgeport.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-12 border-t border-border-subtle pt-12">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded bg-accent/5 flex items-center justify-center text-accent">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-accent">Mais de 20 Seguradoras em um Só Lugar</h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            Comparamos cotações em empresas como Travelers, Progressive e Liberty Mutual em vez de restringir suas opções a uma única bandeira.
          </p>
        </div>

        <div class="space-y-3">
          <div class="w-10 h-10 rounded bg-accent/5 flex items-center justify-center text-accent">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.752-.376a6.002 6.002 0 0 1 4.496 0l.752.376M3 5.682A24.019 24.019 0 0 1 12 3.17c3.18 0 6.222.62 9 1.73a24.015 24.015 0 0 1-9 16.096c-3.18 0-6.222-.62-9-1.73Z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-accent">Cobertura Sob Medida para Connecticut</h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            Dos limites mínimos estaduais sob a lei CGS § 14-112 aos riscos de congelamento no inverno e tempestades costeiras, montamos apólices adequadas à realidade de CT.
          </p>
        </div>

        <div class="space-y-3">
          <div class="w-10 h-10 rounded bg-accent/5 flex items-center justify-center text-accent">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m0 0a8.967 8.967 0 0 1-2.312-6.086c0-3.482 1.961-6.505 4.88-8.003M18.75 10.5a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM12 15.75a7.488 7.488 0 0 0-5.138 2.029c.148-1.597.973-3.003 2.215-3.879M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9Z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-accent">Suporte Direto em Sinistros</h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            Se você registrar um sinistro, nossa equipe trata diretamente com o perito para manter o andamento dos reparos ou da indenização.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Office Locations Grid -->
  <section class="py-20 bg-bg-secondary border-t border-b border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12 space-y-4">
        <h2 class="text-3xl font-bold tracking-tight text-accent">Nossos Escritórios em Connecticut</h2>
        <div class="p-4 bg-white border border-border-subtle rounded text-sm text-text-secondary leading-relaxed shadow-sm">
          <p>
            Visite qualquer uma das nossas três agências para cotações presenciais, análise de apólices ou dúvidas sobre sinistros. Todas as unidades atendem de segunda a sexta, das 8h30 às 17h00, com equipe fluente em português, inglês, espanhol e turco.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Danbury -->
        <div class="bg-white border border-border-subtle p-8 rounded-lg shadow-sm space-y-4">
          <h3 class="text-lg font-bold text-accent border-b border-border-subtle pb-2">Danbury (Sede)</h3>
          <p class="text-sm leading-relaxed text-text-secondary">
            50 Newtown Road, Suite 1<br />
            Danbury, CT 06810
          </p>
          <div class="text-xs text-text-muted space-y-1">
            <p><strong>Telefone:</strong> <a href="tel:2037489272" class="hover:text-accent">203 748 9272</a></p>
            <p><strong>Horário:</strong> Seg - Sex 8:30 - 5:00</p>
            <p><strong>Idiomas:</strong> English, Español, Português, Türkçe</p>
          </div>
        </div>

        <!-- Watertown -->
        <div class="bg-white border border-border-subtle p-8 rounded-lg shadow-sm space-y-4">
          <h3 class="text-lg font-bold text-accent border-b border-border-subtle pb-2">Watertown</h3>
          <p class="text-sm leading-relaxed text-text-secondary">
            51 Depot St Ste 112<br />
            Watertown, CT 06795
          </p>
          <div class="text-xs text-text-muted space-y-1">
            <p><strong>Telefone:</strong> <a href="tel:8602748888" class="hover:text-accent">860 274 8888</a></p>
            <p><strong>Horário:</strong> Seg - Sex 8:30 - 5:00</p>
            <p><strong>Idiomas:</strong> English, Español, Português</p>
          </div>
        </div>

        <!-- Bridgeport -->
        <div class="bg-white border border-border-subtle p-8 rounded-lg shadow-sm space-y-4">
          <h3 class="text-lg font-bold text-accent border-b border-border-subtle pb-2">Bridgeport</h3>
          <p class="text-sm leading-relaxed text-text-secondary">
            2465 Main Street<br />
            Bridgeport, CT 06606
          </p>
          <div class="text-xs text-text-muted space-y-1">
            <p><strong>Telefone:</strong> <a href="tel:2033338880" class="hover:text-accent">203 333 8880</a></p>
            <p><strong>Horário:</strong> Seg - Sex 8:30 - 5:00</p>
            <p><strong>Idiomas:</strong> English, Español, Português</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="py-24 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16 space-y-4">
        <h2 class="text-3xl font-bold tracking-tight text-accent">O Que Nossos Clientes Dizem</h2>
        <p class="text-sm text-text-secondary">Depoimentos de proprietários residenciais e empresas de Connecticut.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {testimonials.map((t) => (
          <blockquote class="bg-white border border-border-subtle p-6 rounded-lg shadow-sm flex flex-col justify-between">
            <div class="space-y-4">
              <!-- Rating Stars -->
              <div class="flex text-accent-gold gap-0.5">
                {Array.from({ length: t.data.rating }).map((_, i) => (
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <p class="text-sm text-text-secondary leading-relaxed font-light italic">
                "{t.data.quote}"
              </p>
            </div>
            <footer class="mt-6 border-t border-border-subtle pt-4 text-xs font-semibold text-accent flex justify-between items-center">
              <span>{t.data.name}</span>
              <span class="text-text-muted font-normal">{t.data.role}</span>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <!-- From Our Blog -->
  <section class="py-24 bg-bg-secondary border-t border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-end mb-16">
        <div class="space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-accent">Artículos e Guias Recentes</h2>
          <p class="text-sm text-text-secondary">Orientações práticas de seguros e dicas de manutenção para moradores de Connecticut.</p>
        </div>
        <a href="/pt/blog" class="text-sm font-semibold text-accent hover:text-accent-gold transition-colors flex items-center gap-1 group">
          Ver Todos os Artigos
          <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {sortedPosts.map((post) => (
          <article class="bg-white border border-border-subtle rounded-lg overflow-hidden shadow-sm flex flex-col justify-between">
            <div class="p-6 space-y-3">
              <span class="text-[10px] font-mono text-text-muted uppercase">
                {new Date(post.data.pubDate).toLocaleDateString('pt-BR', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </span>
              <h3 class="text-lg font-bold text-accent leading-tight hover:text-accent-gold transition-colors">
                <a href={`/pt/blog/${post.id.replace(/^pt\//, '')}`}>{post.data.title}</a>
              </h3>
              <p class="text-xs text-text-secondary leading-relaxed">
                {post.data.description}
              </p>
            </div>
            <div class="p-6 pt-0">
              <a href={`/pt/blog/${post.id.replace(/^pt\//, '')}`} class="text-xs font-semibold text-accent hover:text-accent-gold transition-colors flex items-center gap-1">
                Ler Artigo
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
