---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CertificateRequestForm from '../../components/CertificateRequestForm';
import CoiSwitchBanner from '../../components/CoiSwitchBanner.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'pt';
const t = useTranslations(lang);

const certificateStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": "https://aia-danbury.com/pt/certificate-request#webpage",
      "name": "Solicitação de Certificado de Seguro (COI) | Associated Insurance Agency",
      "description": "Solicite um Certificado de Seguro oficial ACORD 25 com endosso de segurado adicional, renúncia de sub-rogação e emissão no mesmo dia em Connecticut.",
      "url": "https://aia-danbury.com/pt/certificate-request"
    },
    {
      "@type": "Service",
      "@id": "https://aia-danbury.com/pt/certificate-request#service",
      "name": "Emissão de Certificado de Seguro ACORD 25",
      "serviceType": "Documentação de Seguro Empresarial",
      "provider": {
        "@type": "InsuranceAgency",
        "name": "Associated Insurance Agency",
        "telephone": "+1-203-748-9272",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "50 Newtown Road, Suite 1",
          "addressLocality": "Danbury",
          "addressRegion": "CT",
          "postalCode": "06810"
        }
      },
      "areaServed": [
        { "@type": "State", "name": "Connecticut" },
        { "@type": "City", "name": "Danbury" },
        { "@type": "City", "name": "Watertown" },
        { "@type": "City", "name": "Bridgeport" }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://aia-danbury.com/pt/certificate-request#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Com que rapidez a Associated Insurance Agency emite o certificado?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A maioria dos certificados ACORD 25 é emitida em 2 a 4 horas úteis durante o horário comercial (segunda a sexta, 8h30 às 17h00 EST). Para pedidos urgentes de obras, ligue para nossa sede em Danbury no (203) 748-9272."
          }
        },
        {
          "@type": "Question",
          "name": "O que é Segurado Adicional (Additional Insured)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "É uma entidade (como empreiteiro geral, banco ou proprietário do imóvel) que recebe proteção sob a sua apólice por reivindicações decorrentes dos seus trabalhos, conforme exigido em contrato por escrito."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  title="Solicitação de Certificado de Seguro (COI) | Associated Insurance Agency CT"
  description="Solicite um Certificado de Seguro oficial ACORD 25 com endosso de segurado adicional e renúncia de sub-rogação com atendimento em português em Danbury, Watertown e Bridgeport, CT."
  structuredData={certificateStructuredData}
  lang={lang}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-bg-secondary via-bg-primary to-bg-primary py-16 sm:py-20 border-b border-border-subtle overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#122b5f_1px,transparent_1px)] [background-size:24px_24px] opacity-[0.03] pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/5 border border-accent/15 text-accent text-xs font-semibold">
        <span class="w-1.5 h-1.5 rounded-full bg-accent-gold animate-pulse"></span>
        <span>{t('certificate.heroTag')}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-accent leading-[1.15]">
        {t('certificate.title')}
      </h1>

      <p class="text-sm sm:text-base text-text-secondary max-w-[65ch] mx-auto leading-relaxed">
        {t('certificate.subtitle')}
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 pt-3 text-xs font-medium text-text-muted">
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path strokeLinecap="round" strokeLinejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Emissão em 2 a 4 Horas Úteis</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path strokeLinecap="round" strokeLinejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Padrão Oficial ACORD 25</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path strokeLinecap="round" strokeLinejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Envio por E-mail e Fax</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path strokeLinecap="round" strokeLinejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>Atendimento em Português</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Form Section -->
  <section class="py-12 sm:py-16 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <!-- Specialized COI Rush Banner -->
      <div class="max-w-4xl mx-auto p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-accent/5 via-accent/10 to-accent-gold/10 border border-accent/20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold uppercase tracking-wider text-accent-gold">Emissão Urgente</span>
            <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">Mesmo Dia</span>
          </div>
          <h2 class="text-sm sm:text-base font-bold text-accent">Precisa Liberar uma Obra Hoje?</h2>
          <p class="text-xs text-text-secondary leading-relaxed">
            Anexe as especificações contratuais do cliente abaixo para garantir que todas as cláusulas sejam emitidas de primeira.
          </p>
        </div>
        <a
          href="tel:2037489272"
          class="shrink-0 px-4 py-2.5 rounded-xl bg-accent text-white text-xs font-bold hover:bg-accent/90 transition-all shadow-xs flex items-center gap-2"
        >
          <span>Ligar para Danbury: 203 748 9272</span>
        </a>
      </div>

      <!-- React Island Form with Honeypots & Google reCAPTCHA v3 Defense -->
      <CertificateRequestForm client:load lang={lang} />

      <!-- B2B Commercial Broker Switch & Fast COI Advantage -->
      <div class="max-w-4xl mx-auto">
        <CoiSwitchBanner lang={lang} />
      </div>

      <!-- Educational Guidance & FAQ Section -->
      <div class="max-w-4xl mx-auto pt-12 border-t border-border-subtle space-y-10">
        <div class="text-center space-y-2">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-accent tracking-tight">
            Guia de Certificados de Seguro em Connecticut
          </h2>
          <p class="text-sm text-text-secondary max-w-2xl mx-auto">
            Entenda o que são formulários ACORD 25, endosso de segurado adicional e cláusulas de renúncia de sub-rogação.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-6 rounded-2xl border border-border-subtle bg-white shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center font-bold text-base">
              01
            </div>
            <h3 class="text-base font-bold text-accent">O que é o Certificado ACORD 25?</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              O formulário oficial padronizado nos EUA que comprova a existência de apólices ativas de Responsabilidade Civil Geral, Veículos Comerciais e Acidentes de Trabalho (Workers' Comp).
            </p>
          </div>

          <div class="p-6 rounded-2xl border border-border-subtle bg-white shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center font-bold text-base">
              02
            </div>
            <h3 class="text-base font-bold text-accent">Segurado Adicional (Additional Insured)</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Empreiteiros e clientes exigem essa cláusula (formulários CG 20 10 e CG 20 37) para serem resguardados contra processos judiciais resultantes dos serviços prestados por você.
            </p>
          </div>

          <div class="p-6 rounded-2xl border border-border-subtle bg-white shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center font-bold text-base">
              03
            </div>
            <h3 class="text-base font-bold text-accent">Renúncia de Sub-rogação (Waiver)</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Impede que a seguradora cobre do cliente os valores pagos em uma indenização caso ocorra um acidente, preservando seus contratos comerciais.
            </p>
          </div>

          <div class="p-6 rounded-2xl border border-border-subtle bg-white shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-accent/10 text-accent flex items-center justify-center font-bold text-base">
              04
            </div>
            <h3 class="text-base font-bold text-accent">Primário e Não Contributivo</h3>
            <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
              Determina que a sua apólice atue primeiro sem exigir que a apólice do cliente participe do pagamento do sinistro coberto.
            </p>
          </div>
        </div>

        <!-- Agency Support Contacts -->
        <div class="p-6 sm:p-8 rounded-2xl bg-zinc-950 text-white border border-zinc-800 space-y-6">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-zinc-800 pb-4">
            <div>
              <h3 class="text-lg font-bold text-white">Nossos Escritórios em Connecticut</h3>
              <p class="text-xs text-zinc-400 mt-0.5">Fale com corretores licenciados fluentes em português:</p>
            </div>
            <span class="px-3 py-1 rounded-full bg-accent-gold/20 text-accent-gold text-xs font-mono font-medium">
              Seg–Sex 8:30 às 17:00 EST
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs text-zinc-300">
            <div class="space-y-1.5">
              <p class="font-bold text-white text-sm">Sede Danbury (HQ)</p>
              <p>50 Newtown Road, Suite 1</p>
              <p>Danbury, CT 06810</p>
              <p class="pt-1">
                <a href="tel:2037489272" class="text-accent-gold font-bold hover:underline">203 748 9272</a>
              </p>
            </div>

            <div class="space-y-1.5">
              <p class="font-bold text-white text-sm">Filial Watertown</p>
              <p>51 Depot St, Suite 112</p>
              <p>Watertown, CT 06795</p>
              <p class="pt-1">
                <a href="tel:8602748888" class="text-accent-gold font-bold hover:underline">860 274 8888</a>
              </p>
            </div>

            <div class="space-y-1.5">
              <p class="font-bold text-white text-sm">Filial Bridgeport</p>
              <p>2465 Main Street</p>
              <p>Bridgeport, CT 06606</p>
              <p class="pt-1">
                <a href="tel:2033338880" class="text-accent-gold font-bold hover:underline">203 333 8880</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
