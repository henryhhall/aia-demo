const d = content[currentLang];
---

{mode === 'compact' ? (
  <div class="p-4 sm:p-5 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="space-y-1">
        <span class="text-xs font-bold uppercase tracking-wider text-accent-gold">
          {d.badge}
        </span>
        <h3 class="text-sm sm:text-base font-bold text-white">
          {d.title}
        </h3>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        {d.lanes.map((lane) => (
          <a
            href={`tel:${lane.phoneRaw}`}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 border border-white/15 text-white text-xs font-semibold transition-colors"
          >
            <span>{lane.flag}</span>
            <span>{lane.langName}: {lane.phone}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
) : (
  <section class="py-12 sm:py-16 bg-gradient-to-b from-bg-secondary to-bg-primary border-y border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/5 border border-accent/15 text-accent text-xs font-bold uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-accent-gold animate-pulse"></span>
          <span>{d.badge}</span>
        </div>

        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-accent">
          {d.title}
        </h2>

        <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
          {d.subtitle}
        </p>
      </div>

      <!-- Language Routing Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {d.lanes.map((lane) => (
          <div class="p-5 rounded-2xl bg-white border border-border-subtle shadow-xs hover:border-accent/30 transition-all flex flex-col justify-between space-y-4">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-2xl" role="img" aria-label={lane.langName}>{lane.flag}</span>
                <span class="text-[11px] font-bold text-accent-gold uppercase tracking-wider bg-accent/5 px-2 py-0.5 rounded-md">
                  {lane.branch}
                </span>
              </div>
              <h3 class="text-base font-bold text-accent">
                {lane.langName}
              </h3>
              <p class="text-xs font-semibold text-text-primary">
                {lane.nativeLabel}
              </p>
              <p class="text-xs text-text-secondary leading-relaxed">
                {lane.desc}
              </p>
            </div>

            <a
              href={`tel:${lane.phoneRaw}`}
              class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-accent hover:bg-accent/90 text-white font-bold text-xs transition-colors shadow-xs"
            >
              <svg class="w-3.5 h-3.5 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.942-6.942l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
              </svg>
              <span>{lane.phone}</span>
            </a>
          </div>
        ))}
      </div>

      <!-- Footer Note -->
      <div class="text-center text-xs text-text-muted">
        <span>{d.hoursNotice}</span>
      </div>
    </div>
  </section>
)}
