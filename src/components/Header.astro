---
import Navigation from './Navigation';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../i18n/utils';

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang as any);

const navLinks = [
  { href: getRelativeLocaleUrl(lang, 'about'), label: t('nav.about') },
  { href: getRelativeLocaleUrl(lang, 'personal'), label: t('nav.personal') },
  { href: getRelativeLocaleUrl(lang, 'commercial'), label: t('nav.commercial') },
  { href: getRelativeLocaleUrl(lang, 'service'), label: t('nav.service') },
  { href: getRelativeLocaleUrl(lang, 'pay-bill'), label: t('nav.payBill') },
];

const homeUrl = getRelativeLocaleUrl(lang, '');
const quoteUrl = getRelativeLocaleUrl(lang, 'quote');
---

<header class="sticky top-0 z-40 w-full border-b border-border-subtle bg-bg-primary/80 backdrop-blur-xl">
  <!-- Top bar info -->
  <div class="bg-accent text-white py-2 text-xs font-medium">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center">
      <div class="flex items-center gap-6">
        <span class="flex items-center gap-2">
          <!-- Clock Icon -->
          <svg class="w-3.5 h-3.5 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
          {t('header.hours')}
        </span>
        <span class="hidden sm:flex items-center gap-2">
          <!-- Map Marker -->
          <svg class="w-3.5 h-3.5 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
          </svg>
          {t('header.locations')}
        </span>
      </div>
      <div>
        <a href="tel:2037489272" class="flex items-center gap-2 hover:text-accent-gold transition-colors font-semibold">
          <!-- Phone Icon -->
          <svg class="w-3.5 h-3.5 text-accent-gold animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.942-6.942l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
          </svg>
          203 748 9272
        </a>
      </div>
    </div>
  </div>

  <!-- Main header navigation -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <a href={homeUrl} class="flex items-center gap-3 group">
        <!-- Shield Logo SVG -->
        <svg class="w-8 h-8 text-accent group-hover:scale-105 transition-transform duration-300" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2L4 5V11C4 16.5 8 21 12 22C16 21 20 16.5 20 11V5L12 2Z" fill="currentColor" stroke="currentColor" stroke-width="2"/>
          <path d="M12 6V18" stroke="var(--color-accent-gold)" stroke-width="2" stroke-linecap="round"/>
          <path d="M8 12H16" stroke="var(--color-accent-gold)" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <div class="flex flex-col">
          <span class="text-sm font-semibold tracking-tight text-accent leading-none">{t('header.title')}</span>
          <span class="text-xs font-light tracking-widest text-text-secondary">{t('header.subtitle')}</span>
        </div>
      </a>

      <!-- Navigation island -->
      <Navigation
        client:load
        navLinks={navLinks}
        currentLang={lang}
        currentPath={Astro.url.pathname}
        quoteLabel={t('nav.quote')}
        quoteHref={quoteUrl}
      />
    </div>
  </div>
</header>

