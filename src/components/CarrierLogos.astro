---
import { Image } from 'astro:assets';
import foremostLogo from '../assets/logo-Foremost.jpg';
import hartfordLogo from '../assets/logo-TheHartford.png';
import libertyLogo from '../assets/logo-libertyMutual.png';
import progressiveLogo from '../assets/logo-progressive.svg';
import safecoLogo from '../assets/logo-safeco.jpg';

interface Props {
  lang?: 'en' | 'es' | 'pt' | 'tr';
  headline?: string;
  subheadline?: string;
}

const {
  lang = 'en',
  headline,
  subheadline,
} = Astro.props;

const dict = {
  en: {
    badge: 'Authorized Independent Broker Network',
    headline: 'We Shop 20+ Top-Rated Carriers in Connecticut',
    subheadline: 'Because we are independent, we work directly for you — comparing quotes across premier regional and national insurers to unlock maximum multi-policy discounts.',
    alsoQuoting: 'Also quoting Travelers, Chubb, Andover Companies, Main Street America & 15+ more',
    cta: 'Compare Rates Across All Carriers',
    ctaHref: '/quote',
  },
  es: {
    badge: 'Red de Correduría Independiente Autorizada',
    headline: 'Comparamos más de 20 Aseguradoras Líderes en Connecticut',
    subheadline: 'Porque somos independientes, trabajamos directamente para usted — comparando pólizas entre aseguradoras regionales y nacionales para obtener el máximo descuento.',
    alsoQuoting: 'También cotizamos Travelers, Chubb, Andover Companies, Main Street America y más de 15 adicionales',
    cta: 'Compare Tarifas entre Todas las Aseguradoras',
    ctaHref: '/es/quote',
  },
  pt: {
    badge: 'Rede de Corretores Independentes Autorizados',
    headline: 'Comparamos mais de 20 Seguradoras Líderes em Connecticut',
    subheadline: 'Como somos independentes, trabalhamos diretamente para você — comparando cotações entre as principais seguradoras para garantir seu melhor desconto.',
    alsoQuoting: 'Também cotamos Travelers, Chubb, Andover Companies, Main Street America e mais de 15 outras',
    cta: 'Compare Tarifas em Todas as Seguradoras',
    ctaHref: '/pt/quote',
  },
  tr: {
    badge: 'Yetkili Bağımsız Sigorta Acentesi Ağı',
    headline: "Connecticut'ta 20'den Fazla Lider Sigorta Şirketini Karşılaştırıyoruz",
    subheadline: 'Bağımsız olduğumuz için doğrudan sizin için çalışıyoruz — maksimum indirim elde etmeniz için bölgesel ve ulusal sigorta şirketlerini karşılaştırıyoruz.',
    alsoQuoting: "Ayrıca Travelers, Chubb, Andover Companies, Main Street America ve 15'ten fazla şirketle çalışıyoruz",
    cta: 'Tüm Sigorta Şirketlerinin Oranlarını Karşılaştırın',
    ctaHref: '/tr/quote',
  },
};

const t = dict[lang] || dict.en;

const displayHeadline = headline || t.headline;
const displaySubheadline = subheadline || t.subheadline;

const carriers = [
  { name: 'Progressive', image: progressiveLogo, alt: 'Progressive Authorized Independent Agent' },
  { name: 'The Hartford', image: hartfordLogo, alt: 'The Hartford Commercial & Personal Insurance Partner' },
  { name: 'Safeco Insurance', image: safecoLogo, alt: 'Safeco Insurance Liberty Mutual Company Partner' },
  { name: 'Liberty Mutual', image: libertyLogo, alt: 'Liberty Mutual Insurance Partner' },
  { name: 'Foremost Insurance', image: foremostLogo, alt: 'Foremost Insurance Specialty Property & Auto' },
];
---

<section class="py-12 sm:py-16 bg-white border-y border-border-subtle">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto space-y-3 mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/5 border border-accent/10 text-accent text-xs font-semibold uppercase tracking-wider">
        <span class="w-1.5 h-1.5 rounded-full bg-accent-gold animate-pulse"></span>
        {t.badge}
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-accent">
        {displayHeadline}
      </h2>
      <p class="text-sm text-text-secondary leading-relaxed">
        {displaySubheadline}
      </p>
    </div>

    <!-- Carrier Logo Showcase -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4 sm:gap-6 items-center">
      {carriers.map((carrier) => (
        <div class="group h-20 sm:h-24 bg-bg-primary/50 hover:bg-white rounded-xl border border-border-subtle hover:border-accent/20 p-4 flex items-center justify-center transition-all duration-300 hover:shadow-md hover:-translate-y-0.5">
          <Image
            src={carrier.image}
            alt={carrier.alt}
            class="max-h-10 sm:max-h-12 w-auto object-contain filter grayscale group-hover:grayscale-0 opacity-75 group-hover:opacity-100 transition-all duration-300"
            loading="lazy"
          />
        </div>
      ))}
    </div>

    <!-- Trust Sub-Banner -->
    <div class="mt-8 pt-6 border-t border-border-subtle/60 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div class="flex items-center gap-2 text-xs font-medium text-text-secondary">
        <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
        </svg>
        <span>{t.alsoQuoting}</span>
      </div>
      <a
        href={t.ctaHref}
        class="inline-flex items-center gap-1.5 text-xs font-bold text-accent uppercase tracking-wider hover:text-accent-gold transition-colors"
      >
        <span>{t.cta}</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
