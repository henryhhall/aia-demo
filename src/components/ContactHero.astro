const d = content[currentLang];
---

<section class="relative bg-gradient-to-br from-[#0a1835] via-[#122b5f] to-[#08152e] text-white overflow-hidden border-b border-[#1e3a73]">
  <!-- Subtle Ambient Glow Effects -->
  <div class="absolute -top-32 -left-32 w-96 h-96 bg-accent-gold/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 -right-32 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-6 space-y-6 text-left">
        <!-- Trust Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-accent-gold text-xs font-semibold uppercase tracking-wider shadow-sm">
          <span class="w-2 h-2 rounded-full bg-accent-gold animate-pulse"></span>
          <span>{d.badge}</span>
        </div>

        <!-- Main Heading -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-[1.1] text-white">
          {d.title}
        </h1>

        <!-- Subtitle -->
        <p class="text-sm sm:text-base lg:text-lg text-slate-200 leading-relaxed max-w-[58ch]">
          {d.subtitle}
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-3 pt-2">
          <a
            href="#contact-form"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 text-xs sm:text-sm font-bold uppercase tracking-wider text-[#0a1835] bg-accent-gold hover:bg-accent-gold-hover rounded-lg transition-all shadow-lg hover:shadow-xl hover:scale-[1.01] active:scale-[0.99]"
          >
            <svg class="w-4 h-4 text-[#0a1835]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
            </svg>
            <span>{d.ctaMessage}</span>
          </a>

          <a
            href="#office-map-card"
            class="inline-flex items-center justify-center gap-2 px-5 py-3.5 text-xs sm:text-sm font-semibold tracking-wide text-white border border-white/25 hover:bg-white/10 rounded-lg transition-all active:scale-[0.99]"
          >
            <svg class="w-4 h-4 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
            </svg>
            <span>{d.ctaMaps}</span>
          </a>
        </div>

        <!-- Direct Phone & Hours Card -->
        <div class="pt-2">
          <div class="inline-flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6 p-3.5 bg-white/5 border border-white/10 rounded-xl backdrop-blur-sm">
            <a
              href={`tel:${d.callUsPhoneRaw}`}
              class="inline-flex items-center gap-2.5 text-sm font-semibold text-white hover:text-accent-gold transition-colors"
            >
              <div class="w-8 h-8 rounded-full bg-accent-gold/20 border border-accent-gold/40 flex items-center justify-center text-accent-gold">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                </svg>
              </div>
              <div>
                <span class="block text-[11px] text-slate-300 font-normal">{d.callUsLabel}</span>
                <span class="text-sm font-bold text-accent-gold tracking-wide">{d.callUsPhone}</span>
              </div>
            </a>

            <div class="hidden sm:block w-px h-8 bg-white/15"></div>

            <div class="text-xs text-slate-300 space-y-0.5">
              <div class="flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                <span>{d.hours}</span>
              </div>
              <div class="text-[11px] text-slate-400">
                {d.languages}
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Prominent Team Photo Showcase -->
      <div class="lg:col-span-6">
        <div class="relative group">
          <!-- Ambient Glow Border -->
          <div class="absolute -inset-1 rounded-2xl bg-gradient-to-r from-accent-gold/40 via-blue-500/30 to-accent-gold/40 opacity-70 blur-md group-hover:opacity-100 transition duration-500"></div>
          
          <!-- Image Container Card -->
          <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-white/20 bg-[#0a1835]">
            <Image
              src={teamPhoto}
              alt={d.photoAlt}
              width={1536}
              height={926}
              quality={90}
              class="w-full h-auto object-cover block transform transition-transform duration-700 group-hover:scale-[1.02]"
              loading="eager"
              fetchpriority="high"
            />

            <!-- Framed Caption Bar Below Image (Preserves 100% Face & Team Visibility) -->
            <div class="p-3.5 sm:p-4 bg-[#071328] border-t border-white/10">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2.5">
                <div>
                  <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <h2 class="text-xs sm:text-sm font-bold text-white tracking-tight">
                      {d.captionTitle}
                    </h2>
                  </div>
                  <p class="text-[11px] sm:text-xs text-slate-300 mt-0.5">
                    {d.captionDesc}
                  </p>
                </div>

                <div class="shrink-0">
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-[10px] sm:text-[11px] font-semibold tracking-wide uppercase bg-accent-gold/15 text-accent-gold border border-accent-gold/30">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                    </svg>
                    <span>{d.captionBadge}</span>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Stat & Trust Grid -->
    <div class="mt-12 pt-8 border-t border-white/10 grid grid-cols-1 sm:grid-cols-3 gap-4">
      {d.stats.map((stat) => (
        <div class="p-4 rounded-xl bg-white/5 border border-white/10 backdrop-blur-sm text-left">
          <div class="text-xl sm:text-2xl font-extrabold text-accent-gold tracking-tight">
            {stat.value}
          </div>
          <div class="text-xs font-bold uppercase tracking-wider text-white mt-0.5">
            {stat.label}
          </div>
          <div class="text-xs text-slate-300 mt-0.5">
            {stat.detail}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
