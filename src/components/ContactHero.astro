    ctaMessage: 'Send a Message',
    ctaMaps: 'View Office Maps',
    callUsLabel: 'Call Danbury HQ:',
    callUsPhone: '(203) 748-9272',
    callUsPhoneRaw: '2037489272',
    hours: 'Mon - Fri 8:30 AM - 5:00 PM',
    languages: 'English • Español • Português • Türkçe',
    photoAlt: 'Associated Insurance Agency licensed team photo in Connecticut',
    captionTitle: 'The Associated Insurance Agency Team',
    captionDesc: 'Licensed independent agents & client specialists across CT',
    captionBadge: 'Danbury • Watertown • Bridgeport',
    stats: [
      {
        value: '3 Offices',
        label: 'Connecticut Locations',
        detail: 'Danbury (HQ), Watertown, Bridgeport',
      },
      {
        value: '20+ Carriers',
        label: 'Top-Rated Partners',
        detail: 'Safeco, Travelers, Progressive & more',
      },
      {
        value: '4 Languages',
        label: 'Native Support',
        detail: 'English, Español, Português, Türkçe',
      },
    ],
  },
  es: {
    badge: 'Agencia Independiente con Licencia en Connecticut',
    title: 'Comuníquese con Associated Insurance Agency',
    subtitle: 'Comparamos más de 20 de las mejores aseguradoras para encontrar la cobertura adecuada al mejor precio para su familia o negocio. Hable directamente con nuestro equipo en Danbury, Watertown o Bridgeport.',
    ctaMessage: 'Enviar un Mensaje',
    ctaMaps: 'Ver Nuestras Oficinas',
    callUsLabel: 'Llamar a Sede Danbury:',
    callUsPhone: '(203) 748-9272',
    callUsPhoneRaw: '2037489272',
    hours: 'Lun - Vie 8:30 AM - 5:00 PM',
    languages: 'Inglés • Español • Portugués • Turco',
    photoAlt: 'Foto del equipo de Associated Insurance Agency en Connecticut',
    captionTitle: 'Equipo de Associated Insurance Agency',
    captionDesc: 'Agentes independientes y especialistas de servicio en todo CT',
    captionBadge: 'Danbury • Watertown • Bridgeport',
    stats: [
      {
        value: '3 Oficinas',
        label: 'Sucursales en CT',
        detail: 'Danbury (HQ), Watertown, Bridgeport',
      },
      {
        value: '20+ Aseguradoras',
        label: 'Compañías Líderes',
        detail: 'Safeco, Travelers, Progressive y más',
      },
      {
        value: '4 Idiomas',
        label: 'Atención en su Idioma',
        detail: 'English, Español, Português, Türkçe',
      },
    ],
  },
  pt: {
    badge: 'Corretora Independente Licenciada em Connecticut',
    title: 'Entre em Contato com a Associated Insurance Agency',
    subtitle: 'Comparamos mais de 20 seguradoras para encontrar a melhor proteção com economia para sua família e empresa. Fale diretamente com nossa equipe amigável em Danbury, Watertown e Bridgeport.',
    ctaMessage: 'Enviar uma Mensagem',
    ctaMaps: 'Ver Nossas Agências',
    callUsLabel: 'Ligar para a Sede em Danbury:',
    callUsPhone: '(203) 748-9272',
    callUsPhoneRaw: '2037489272',
    hours: 'Seg - Sex 8:30 AM - 5:00 PM',
    languages: 'Inglês • Espanhol • Português • Turco',
    photoAlt: 'Foto da equipe da Associated Insurance Agency em Connecticut',
    captionTitle: 'Equipe Associated Insurance Agency',
    captionDesc: 'Corretores independentes licenciados servindo toda a região de CT',
    captionBadge: 'Danbury • Watertown • Bridgeport',
    stats: [
      {
        value: '3 Agências',
        label: 'Localizações em CT',
        detail: 'Danbury (HQ), Watertown, Bridgeport',
      },
      {
        value: '20+ Seguradoras',
        label: 'Parceiras de Ponta',
        detail: 'Safeco, Travelers, Progressive e outras',
      },
      {
        value: '4 Idiomas',
        label: 'Suporte Nativo',
        detail: 'English, Español, Português, Türkçe',
      },
    ],
  },
  tr: {
    badge: 'Connecticut Lisanslı Bağımsız Sigorta Acentesi',
    title: 'Associated Insurance Agency ile İletişime Geçin',
    subtitle: 'Aileniz ve işletmeniz için en uygun teminatı rekabetçi fiyatlarla bulmak amacıyla 20\'den fazla lider sigorta şirketini karşılaştırıyoruz. Danbury, Watertown ve Bridgeport\'taki ekibimizle ana dilinizde görüşün.',
    ctaMessage: 'Mesaj Gönderin',
