const currentLang = (lang in officeData ? lang : 'en') as 'en' | 'es' | 'pt' | 'tr';
const offices = officeData[currentLang];
const t = uiTexts[currentLang];
---

<div data-office-map-component class="space-y-8">
  <!-- Interactive Google Maps Showcase Card -->
  <div id="office-map-card" class="border border-border-subtle bg-white shadow-xl rounded-xl overflow-hidden transition-all duration-300">
    <!-- Card Header with Location Details & Tab Selector -->
    <div class="p-6 border-b border-border-subtle bg-white">
      <!-- Office Switcher Pill Tabs -->
      <div class="flex items-center justify-between flex-wrap gap-3 pb-4 mb-4 border-b border-border-subtle/70">
        <span class="text-xs font-semibold text-text-muted tracking-wide flex items-center gap-1.5">
          <svg class="w-4 h-4 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
          </svg>
          {t.selectMap}
        </span>
        <div class="inline-flex items-center p-1 bg-bg-secondary rounded-lg border border-border-subtle gap-1" role="tablist" aria-label="Office locations map tabs">
          {offices.map((office) => (
            <button
              type="button"
              role="tab"
              data-office-tab={office.id}
              aria-selected={office.id === 'danbury' ? 'true' : 'false'}
              aria-controls={`map-frame-${office.id}`}
              class={office.id === 'danbury'
                ? 'office-tab-btn px-3 py-1.5 rounded-md text-xs font-semibold transition-all bg-accent text-white shadow-sm'
                : 'office-tab-btn px-3 py-1.5 rounded-md text-xs font-semibold transition-all text-text-secondary hover:text-accent hover:bg-white/80'}
            >
              {office.shortName}
            </button>
          ))}
        </div>
      </div>

      <!-- Detail Panels per Office -->
      {offices.map((office) => (
        <div
          data-office-header={office.id}
          class={`office-header-panel ${office.id === 'danbury' ? 'block' : 'hidden'} transition-all duration-200`}
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <span class="text-xs font-semibold uppercase tracking-wider text-accent-gold">{office.tag}</span>
              <h2 class="text-xl font-bold text-accent mt-0.5">{office.title}</h2>
            </div>
            <a
              href={office.directionsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-bg-secondary text-xs font-semibold text-accent hover:bg-accent hover:text-white transition-all shrink-0 shadow-xs"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 21 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
              {t.getDirections}
            </a>
          </div>

          <p class="text-sm text-text-secondary mt-2">
            {office.addressLine}, {office.cityStateZip}
          </p>

          <div class="flex flex-wrap items-center gap-4 text-xs text-text-muted mt-3 pt-3 border-t border-border-subtle/60">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.942-6.942l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
              </svg>
              <a href={`tel:${office.phoneRaw}`} class="hover:text-accent font-semibold transition-colors">
                {office.phoneDisplay}
              </a>
            </span>
            <span class="text-zinc-300">•</span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
              {office.hours}
            </span>
          </div>

          <!-- Office Team Members & Producers Roster -->
          <div class="mt-4 pt-3.5 border-t border-border-subtle/70">
            <div class="flex items-center justify-between mb-2.5">
              <span class="text-xs font-bold uppercase tracking-wider text-accent-gold flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                </svg>
                {t.teamAtOffice}
              </span>
              <a href="/team" class="text-[11px] font-semibold text-accent hover:text-accent-gold transition-colors inline-flex items-center gap-1">
                <span>{t.meetFullTeam}</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
            <div class="flex flex-wrap gap-2">
              {getMembersByOffice(office.id, currentLang).map((m) => (
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-bg-secondary text-xs text-accent font-medium border border-border-subtle shadow-2xs">
                  <span class="font-bold text-accent">{m.name.split(' ')[0]}</span>
                  {m.isProducer && m.npn ? (
                    <span class="text-[10px] px-1.5 py-0.5 rounded bg-accent-gold text-accent font-bold uppercase tracking-wider shadow-2xs">
                      Producer • NPN {m.npn}
                    </span>
                  ) : (
                    <span class="text-[10px] px-1.5 py-0.5 rounded bg-accent/5 text-text-secondary border border-accent/10">
                      CSR
                    </span>
                  )}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Responsive Multi-Office Google Maps Viewport with Smooth Crossfade -->
    <div class="w-full aspect-[4/3] sm:h-[350px] bg-bg-secondary relative overflow-hidden">
      {offices.map((office) => (
        <iframe
          id={`map-frame-${office.id}`}
          data-office-frame={office.id}
          src={office.embedUrl}
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          class={`w-full h-full border-0 absolute inset-0 transition-opacity duration-300 ease-in-out ${
            office.id === 'danbury' ? 'opacity-100 z-10 pointer-events-auto' : 'opacity-0 z-0 pointer-events-none'
          }`}
          title={`Associated Insurance Agency - ${office.title} Google Map`}
        />
      ))}
    </div>
  </div>

  <!-- Interactive Office Selection Cards Grid -->
  <div class="border border-border-subtle bg-white shadow-xl rounded-xl p-6 sm:p-8 space-y-6">
    <div class="flex items-center justify-between border-b border-border-subtle pb-3">
      <h3 class="text-lg font-bold text-accent tracking-tight">
        {t.allLocations}
      </h3>
      <span class="text-xs text-text-muted hidden sm:inline">
        {t.hint}
      </span>
    </div>

    <div class="grid grid-cols-1 gap-3.5">
      {offices.map((office) => {
        const isDefault = office.id === 'danbury';
        return (
          <div
            role="button"
            tabindex="0"
            data-office-card={office.id}
            data-text-viewing={t.viewingOnMap}
            data-text-view={t.clickToView}
            aria-pressed={isDefault ? 'true' : 'false'}
            aria-label={`Select ${office.title} map`}
            class={`office-select-card group relative p-4 sm:p-5 rounded-xl border transition-all duration-200 cursor-pointer flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-left select-none hover:shadow-md ${
              isDefault
                ? 'border-accent bg-accent/[0.04] ring-2 ring-accent/25 shadow-md'
                : 'border-border-subtle bg-bg-secondary/40 hover:border-accent/60 hover:bg-white'
            }`}
          >
            <div class="space-y-1 sm:space-y-1.5 flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-[10px] font-bold uppercase tracking-wider text-accent-gold">
                  {office.tag}
                </span>
                <span class="text-zinc-300 hidden sm:inline">•</span>
                <h4 class="text-sm font-bold text-accent group-hover:text-accent-gold transition-colors">
                  {office.title}
                </h4>
              </div>

              <p class="text-xs text-text-secondary leading-relaxed">
                {office.addressLine}, {office.cityStateZip}
              </p>

              <div class="pt-0.5">
                <a
                  href={`tel:${office.phoneRaw}`}
                  onclick="event.stopPropagation();"
                  class="text-xs font-semibold text-accent hover:text-accent-gold transition-colors inline-flex items-center gap-1.5"
                  title={`Call ${office.shortName}`}
                >
                  <svg class="w-3.5 h-3.5 text-accent-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.942-6.942l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                  </svg>
                  {office.phoneDisplay}
                </a>
              </div>

              <!-- Compact Staff List -->
              <div class="pt-1.5 flex flex-wrap items-center gap-1 text-[11px] text-text-secondary">
                <span class="font-bold text-accent">{t.staffLabel}:</span>
                {getMembersByOffice(office.id, currentLang).map((m, idx, arr) => (
                  <span class="inline-flex items-center">
                    <span class="font-medium">{m.name.split(' ')[0]}</span>
                    {m.isProducer && m.npn && (
                      <span class="text-[10px] font-bold text-accent-gold ml-1">
                        (NPN #{m.npn})
                      </span>
                    )}
                    {idx < arr.length - 1 && <span class="text-zinc-300 ml-1">,</span>}
                  </span>
                ))}
              </div>
            </div>

            <div class="shrink-0 flex items-center justify-between sm:justify-end gap-2 pt-2 sm:pt-0 border-t sm:border-t-0 border-border-subtle/60">
              <span
                data-office-status={office.id}
                class={`office-card-badge text-xs px-3 py-1.5 rounded-lg transition-all duration-200 font-semibold inline-flex items-center gap-1.5 ${
                  isDefault
                    ? 'bg-accent text-white shadow-xs'
                    : 'bg-white border border-border-subtle text-text-secondary group-hover:bg-accent group-hover:text-white group-hover:border-accent'
                }`}
              >
                <span>{isDefault ? t.viewingOnMap : t.clickToView}</span>
                <span class="group-hover:translate-x-0.5 transition-transform">→</span>
              </span>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</div>

<script>
  function setupOfficeMap() {
    const root = document.querySelector('[data-office-map-component]');
    if (!root) return;

    const cards = root.querySelectorAll<HTMLElement>('[data-office-card]');
    const tabs = root.querySelectorAll<HTMLElement>('[data-office-tab]');
    const iframes = root.querySelectorAll<HTMLIFrameElement>('[data-office-frame]');
    const headers = root.querySelectorAll<HTMLElement>('[data-office-header]');

    function setActiveOffice(officeId: string, shouldScroll = false) {
      // 1. Update quick pill tabs
      tabs.forEach((tab) => {
        const isCurrent = tab.dataset.officeTab === officeId;
        tab.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
        if (isCurrent) {
          tab.className = 'office-tab-btn px-3 py-1.5 rounded-md text-xs font-semibold transition-all bg-accent text-white shadow-sm';
        } else {
          tab.className = 'office-tab-btn px-3 py-1.5 rounded-md text-xs font-semibold transition-all text-text-secondary hover:text-accent hover:bg-white/80';
        }
      });

      // 2. Update office detail header panels
      headers.forEach((header) => {
        const isCurrent = header.dataset.officeHeader === officeId;
        if (isCurrent) {
          header.classList.remove('hidden');
          header.classList.add('block');
        } else {
          header.classList.remove('block');
          header.classList.add('hidden');
        }
      });

      // 3. Update map iframes with smooth opacity crossfade
      iframes.forEach((iframe) => {
        const isCurrent = iframe.dataset.officeFrame === officeId;
        if (isCurrent) {
          iframe.classList.remove('opacity-0', 'pointer-events-none', 'z-0');
          iframe.classList.add('opacity-100', 'pointer-events-auto', 'z-10');
        } else {
          iframe.classList.remove('opacity-100', 'pointer-events-auto', 'z-10');
          iframe.classList.add('opacity-0', 'pointer-events-none', 'z-0');
        }
      });

      // 4. Update office selector cards
      cards.forEach((card) => {
        const isCurrent = card.dataset.officeCard === officeId;
        const statusBadge = card.querySelector<HTMLElement>('[data-office-status]');
        const viewingText = card.dataset.textViewing || 'Viewing Map';
        const viewText = card.dataset.textView || 'View Map';

        if (isCurrent) {
          card.classList.remove('border-border-subtle', 'bg-bg-secondary/40', 'hover:border-accent/60', 'hover:bg-white');
          card.classList.add('border-accent', 'bg-accent/[0.04]', 'ring-2', 'ring-accent/25', 'shadow-md');
          card.setAttribute('aria-pressed', 'true');
          if (statusBadge) {
            statusBadge.innerHTML = `<span>${viewingText}</span><span class="group-hover:translate-x-0.5 transition-transform">→</span>`;
            statusBadge.className = 'office-card-badge text-xs px-3 py-1.5 rounded-lg transition-all duration-200 font-semibold inline-flex items-center gap-1.5 bg-accent text-white shadow-xs';
          }
        } else {
          card.classList.remove('border-accent', 'bg-accent/[0.04]', 'ring-2', 'ring-accent/25', 'shadow-md');
          card.classList.add('border-border-subtle', 'bg-bg-secondary/40', 'hover:border-accent/60', 'hover:bg-white');
          card.setAttribute('aria-pressed', 'false');
          if (statusBadge) {
            statusBadge.innerHTML = `<span>${viewText}</span><span class="group-hover:translate-x-0.5 transition-transform">→</span>`;
            statusBadge.className = 'office-card-badge text-xs px-3 py-1.5 rounded-lg transition-all duration-200 font-semibold inline-flex items-center gap-1.5 bg-white border border-border-subtle text-text-secondary group-hover:bg-accent group-hover:text-white group-hover:border-accent';
          }
        }
      });

      // 5. Scroll map card into view if needed (useful on mobile devices)
      if (shouldScroll) {
        const mapCard = document.getElementById('office-map-card');
        if (mapCard) {
          const rect = mapCard.getBoundingClientRect();
          if (rect.top < 0) {
            mapCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      }
    }

    // Attach card click & keyboard handlers
    cards.forEach((card) => {
      const officeId = card.dataset.officeCard;
      if (!officeId) return;

      card.addEventListener('click', () => {
        setActiveOffice(officeId, true);
      });

      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          setActiveOffice(officeId, true);
        }
      });
    });

    // Attach tab button click handlers
    tabs.forEach((tab) => {
      const officeId = tab.dataset.officeTab;
      if (!officeId) return;

      tab.addEventListener('click', () => {
        setActiveOffice(officeId, false);
      });
    });
  }

  // Bind to DOM ready and Astro page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupOfficeMap);
  } else {
    setupOfficeMap();
  }
  document.addEventListener('astro:page-load', setupOfficeMap);
</script>
