---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LOCATIONS_DATA } from '../data/locations';
import { getLocationsHubTranslation, getLocationTranslation } from '../i18n/locations';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  lang?: 'en' | 'es' | 'pt' | 'tr';
}

const { lang = 'en' } = Astro.props;
const currentLang = (lang || Astro.currentLocale || 'en') as 'en' | 'es' | 'pt' | 'tr';

const t = getLocationsHubTranslation(currentLang);
const homeUrl = getRelativeLocaleUrl(currentLang, '');
const quoteUrl = getRelativeLocaleUrl(currentLang, 'quote');
const contactUrl = getRelativeLocaleUrl(currentLang, 'contact');

const siteUrl = 'https://aia-danbury.com';
const currentPath = currentLang === 'en' ? '/locations' : `/${currentLang}/locations`;
const fullPageUrl = `${siteUrl}${currentPath}`;

// Structured data for directory hub
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${fullPageUrl}#webpage`,
      url: fullPageUrl,
      name: t.seoTitle,
      description: t.metaDescription,
      isPartOf: {
        '@type': 'WebSite',
        '@id': `${siteUrl}/#website`,
        url: siteUrl,
        name: 'Associated Insurance Agency',
      },
      about: {
        '@type': 'InsuranceAgency',
        '@id': `${siteUrl}/#organization`,
        name: 'Associated Insurance Agency',
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${fullPageUrl}#breadcrumbs`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: currentLang === 'es' ? 'Inicio' : currentLang === 'pt' ? 'Início' : currentLang === 'tr' ? 'Ana Sayfa' : 'Home',
          item: `${siteUrl}${homeUrl}`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: currentLang === 'es' ? 'Sucursales' : currentLang === 'pt' ? 'Agências' : currentLang === 'tr' ? 'Şubeler' : 'Locations',
          item: fullPageUrl,
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={t.seoTitle}
  description={t.metaDescription}
  lang={currentLang}
  structuredData={structuredData}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-bg-secondary via-bg-primary to-bg-primary pt-12 pb-16 border-b border-border-subtle overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-text-muted mb-6" aria-label="Breadcrumb">
        <a href={homeUrl} class="hover:text-accent transition-colors">
          {currentLang === 'es' ? 'Inicio' : currentLang === 'pt' ? 'Início' : currentLang === 'tr' ? 'Ana Sayfa' : 'Home'}
        </a>
        <span>/</span>
        <span class="text-text-primary font-medium">
          {currentLang === 'es' ? 'Sucursales' : currentLang === 'pt' ? 'Agências' : currentLang === 'tr' ? 'Şubeler' : 'Locations'}
        </span>
      </nav>

      <div class="max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/5 border border-accent/10 text-accent text-xs font-semibold uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-accent-gold"></span>
          {t.heroBadge}
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-accent leading-tight">
          {t.heroHeadline}
        </h1>

        <p class="text-base sm:text-lg text-text-secondary leading-relaxed max-w-[65ch]">
          {t.heroSubheadline}
        </p>

        <p class="text-xs text-text-muted pt-2 flex items-center gap-2">
          <svg class="w-4 h-4 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
          {t.allOfficesHours}
        </p>
      </div>

    </div>
  </section>

  <!-- Offices 3-Card Grid -->
  <section class="py-16 sm:py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Intro statement banner -->
      <div class="p-8 rounded-2xl bg-gradient-to-r from-bg-secondary via-white to-bg-secondary border border-border-subtle shadow-sm space-y-3">
        <h2 class="text-xl sm:text-2xl font-bold text-accent">
          {t.introTitle}
        </h2>
        <p class="text-sm sm:text-base text-text-secondary leading-relaxed max-w-4xl">
          {t.introText}
        </p>
      </div>

      <!-- Locations Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {LOCATIONS_DATA.map((loc) => {
          const locTrans = getLocationTranslation(loc.id, currentLang);
          const locPageUrl = getRelativeLocaleUrl(currentLang, `locations/${loc.slug}`);
          return (
            <div class={`rounded-2xl border ${loc.isHQ ? 'border-accent-gold/40 shadow-md ring-1 ring-accent-gold/20' : 'border-border-subtle shadow-sm'} bg-white flex flex-col justify-between hover:shadow-lg transition-all duration-300 hover:-translate-y-1 overflow-hidden`}>
              
              <div>
                <!-- Card Header -->
                <div class="p-6 pb-4 border-b border-border-subtle/80 space-y-2">
                  <div class="flex items-center justify-between">
                    <span class={`px-2.5 py-0.5 rounded-full text-[11px] font-bold uppercase tracking-wider ${loc.isHQ ? 'bg-accent text-white' : 'bg-bg-secondary text-text-secondary border border-border-subtle'}`}>
                      {loc.isHQ ? t.headquartersBadge : t.branchBadge}
                    </span>
                    <span class="text-xs font-semibold text-emerald-600 flex items-center gap-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                      Open Mon–Fri
                    </span>
                  </div>

                  <h3 class="text-xl font-bold text-accent">
                    {locTrans.name}
                  </h3>
                  <p class="text-xs font-medium text-text-muted">
                    {loc.city}, CT • {loc.postalCode}
                  </p>
                </div>

                <!-- Card Body -->
                <div class="p-6 space-y-5 text-sm">
                  <!-- Address -->
                  <div class="flex items-start gap-3">
                    <svg class="w-4 h-4 text-accent-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                    </svg>
                    <div>
                      <p class="font-medium text-text-primary">{loc.streetAddress}</p>
                      <p class="text-xs text-text-muted">{loc.city}, {loc.state} {loc.postalCode}</p>
                    </div>
                  </div>

                  <!-- Phone -->
                  <div class="flex items-center gap-3">
                    <svg class="w-4 h-4 text-accent-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.942-6.942l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                    </svg>
                    <a href={`tel:${loc.phoneRaw}`} class="font-semibold text-accent hover:text-accent-gold transition-colors">
                      {loc.phoneFormatted}
                    </a>
                  </div>

                  <!-- Languages -->
                  <div class="space-y-1.5 pt-2 border-t border-border-subtle/60">
                    <span class="text-[11px] font-bold text-text-muted uppercase tracking-wider block">
                      {currentLang === 'es' ? 'Idiomas en esta oficina' : currentLang === 'pt' ? 'Idiomas na agência' : currentLang === 'tr' ? 'Konuşulan Diller' : 'Languages Spoken'}
                    </span>
                    <div class="flex flex-wrap gap-1">
                      {loc.languages.map((l) => (
                        <span class="px-2 py-0.5 rounded text-[11px] font-medium bg-bg-secondary text-text-secondary border border-border-subtle">
                          {l}
                        </span>
                      ))}
                    </div>
                  </div>

                  <!-- Towns Served Snippet -->
                  <div class="space-y-1.5 pt-2 border-t border-border-subtle/60">
                    <span class="text-[11px] font-bold text-text-muted uppercase tracking-wider block">
                      {currentLang === 'es' ? 'Ciudades que atiende' : currentLang === 'pt' ? 'Cidades atendidas' : currentLang === 'tr' ? 'Hizmet Verilen Bölgeler' : 'Communities Served'}
                    </span>
                    <p class="text-xs text-text-secondary leading-relaxed">
                      {loc.surroundingTowns.slice(0, 5).join(', ')}...
                    </p>
                  </div>
                </div>
              </div>

              <!-- Card Footer Buttons -->
              <div class="p-6 pt-0 space-y-2">
                <a
                  href={locPageUrl}
                  class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-accent hover:bg-accent/90 text-white font-semibold text-xs transition-colors shadow-sm"
                >
                  <span>{t.viewOfficeDetails}</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                  </svg>
                </a>

                <div class="flex items-center gap-2 text-xs">
                  <a
                    href={`tel:${loc.phoneRaw}`}
                    class="flex-1 py-2 px-3 rounded-lg bg-bg-secondary hover:bg-zinc-200 text-text-secondary font-medium text-center transition-colors"
                  >
                    {t.callOffice}
                  </a>
                  <a
                    href={loc.directionsUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-1 py-2 px-3 rounded-lg bg-bg-secondary hover:bg-zinc-200 text-text-secondary font-medium text-center transition-colors"
                  >
                    {t.getDirections}
                  </a>
                </div>
              </div>

            </div>
          );
        })}
      </div>

      <!-- Why Local Matters 3-Pillar Section -->
      <div class="p-10 rounded-2xl bg-zinc-950 text-white border border-zinc-800 space-y-10">
        <div class="max-w-2xl space-y-3">
          <span class="text-xs font-semibold uppercase tracking-wider text-accent-gold">
            The Independent Agency Difference
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold">
            {t.whyLocalMattersTitle}
          </h2>
          <p class="text-sm text-zinc-300 leading-relaxed">
            {t.whyLocalMattersText}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-4 border-t border-zinc-800">
          <div class="space-y-2">
            <div class="w-10 h-10 rounded-xl bg-accent-gold/20 flex items-center justify-center text-accent-gold font-bold">
              01
            </div>
            <h3 class="text-base font-bold text-white">
              {t.feature1Title}
            </h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              {t.feature1Desc}
            </p>
          </div>

          <div class="space-y-2">
            <div class="w-10 h-10 rounded-xl bg-accent-gold/20 flex items-center justify-center text-accent-gold font-bold">
              02
            </div>
            <h3 class="text-base font-bold text-white">
              {t.feature2Title}
            </h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              {t.feature2Desc}
            </p>
          </div>

          <div class="space-y-2">
            <div class="w-10 h-10 rounded-xl bg-accent-gold/20 flex items-center justify-center text-accent-gold font-bold">
              03
            </div>
            <h3 class="text-base font-bold text-white">
              {t.feature3Title}
            </h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              {t.feature3Desc}
            </p>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>
