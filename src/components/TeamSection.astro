---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ronaldImg from '../assets/aia_ronald.png';
import yesicaImg from '../assets/aia_yesica.png';
import betaniaImg from '../assets/aia_batania.png';
import camilaImg from '../assets/aia_camila.png';
import isayeliImg from '../assets/aia_isayeli.png';
import emaImg from '../assets/aia_ema.png';
import claraImg from '../assets/aia_clara.png';
import ashleyImg from '../assets/Ashley_AIA-Meet-the-team.png';
import janaijaImg from '../assets/aia_janaija.png';
import { teamData } from '../i18n/team';

interface Props {
  lang?: 'en' | 'es' | 'pt' | 'tr';
  hideHeader?: boolean;
}

const { lang, hideHeader = false } = Astro.props;
const currentLang = ((lang || Astro.currentLocale || 'en') as 'en' | 'es' | 'pt' | 'tr');
const activeLocaleData = teamData[currentLang] || teamData.en;
const { ui, members } = activeLocaleData;

const imageMap: Record<string, ImageMetadata> = {
  'ronald-boucher': ronaldImg,
  'yesica-ramirez': yesicaImg,
  'betania-almeida': betaniaImg,
  'camila-macedo': camilaImg,
  'isayeli-perez': isayeliImg,
  'ema-rego': emaImg,
  'clara-de-barros': claraImg,
  'ashley-mercan': ashleyImg,
  'janaija-hammer': janaijaImg,
};

const localizedMembers = members.map((member) => ({
  ...member,
  image: imageMap[member.id],
}));
---

<section class="py-20 bg-bg-secondary/60 border-t border-border-subtle" id="team">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    {!hideHeader && (
      <div class="text-left mb-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/5 border border-accent/10 text-accent text-xs font-semibold uppercase tracking-wider mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-gold"></span>
          {ui.badge}
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-accent">
          {ui.title}
        </h2>
        <p class="mt-3 text-sm sm:text-base text-text-secondary max-w-[65ch]">
          {ui.subtitle}
        </p>
      </div>
    )}

    <!-- Office Filter Tabs -->
    <div class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b border-border-subtle/80 pb-4">
      <div class="flex items-center gap-1.5 p-1 bg-bg-secondary rounded-xl border border-border-subtle" role="tablist" aria-label="Filter team by office location">
        <button
          type="button"
          data-filter-office="all"
          class="team-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all bg-accent text-white shadow-sm"
          aria-pressed="true"
        >
          {ui.filterAll}
        </button>
        <button
          type="button"
          data-filter-office="danbury"
          class="team-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all text-text-secondary hover:text-accent hover:bg-white/80"
          aria-pressed="false"
        >
          {ui.filterDanbury}
        </button>
        <button
          type="button"
          data-filter-office="watertown"
          class="team-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all text-text-secondary hover:text-accent hover:bg-white/80"
          aria-pressed="false"
        >
          {ui.filterWatertown}
        </button>
        <button
          type="button"
          data-filter-office="bridgeport"
          class="team-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all text-text-secondary hover:text-accent hover:bg-white/80"
          aria-pressed="false"
        >
          {ui.filterBridgeport}
        </button>
      </div>

      <div class="hidden sm:flex items-center gap-3 text-xs text-text-muted">
        <span class="inline-flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-accent-gold"></span>
          <span>{ui.producerBadge}</span>
        </span>
        <span>•</span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
          </svg>
          <span>{ui.officeLabel}</span>
        </span>
      </div>
    </div>

    <!-- Cards Grid (3 Columns for 9 members = clean 3x3 layout) -->
    <div id="team-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {localizedMembers.map((member) => (
        <button
          type="button"
          class="team-card group flex flex-col text-left bg-bg-primary rounded-2xl border border-border-subtle p-3.5 hover:border-accent-gold/60 hover:shadow-xl transition-all duration-300 cursor-pointer focus:outline-none focus:ring-2 focus:ring-accent-gold/50"
          data-member-id={member.id}
          data-office={member.officeId}
          aria-haspopup="dialog"
        >
          <!-- Portrait Image Container -->
          <div class="relative w-full aspect-[4/5] rounded-xl overflow-hidden bg-zinc-100">
            {member.image ? (
              <Image
                src={member.image}
                alt={member.name}
                class="w-full h-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-105"
                loading="lazy"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center bg-zinc-200 text-zinc-400">
                <span class="text-sm font-medium">{member.name}</span>
              </div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-accent text-white text-xs font-semibold shadow-md">
                <span>{ui.viewBio}</span>
                <svg class="w-3.5 h-3.5 text-accent-gold transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
              </span>
            </div>

            <!-- Top Left: Experience Badge & Office Tag -->
            <div class="absolute top-3 left-3 flex flex-col gap-1.5 items-start">
              <span class="px-2.5 py-1 rounded-md text-[11px] font-semibold bg-bg-primary/95 backdrop-blur-md text-accent shadow-sm border border-border-subtle/60">
                {member.experienceBadge}
              </span>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-semibold bg-accent text-white shadow-xs">
                <svg class="w-2.5 h-2.5 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                </svg>
                {member.officeName}
              </span>
            </div>

            <!-- Top Right: Producer NPN Badge (if producer) -->
            {member.isProducer && member.npn && (
              <div class="absolute top-3 right-3">
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-accent-gold text-accent shadow-md border border-accent-gold/40" title={`National Producer Number: ${member.npn}`}>
                  <svg class="w-3 h-3 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
                  </svg>
                  <span>NPN #{member.npn}</span>
                </span>
              </div>
            )}
          </div>

          <!-- Card Info -->
          <div class="pt-4 pb-2 px-1 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="text-base sm:text-lg font-bold text-accent group-hover:text-accent-gold transition-colors leading-tight">
                {member.name}
              </h3>
              <p class="mt-1 text-xs font-medium text-text-secondary leading-normal">
                {member.role}
              </p>

              <!-- Office & Producer row -->
              <div class="mt-1.5 flex flex-wrap items-center gap-1.5 text-[11px]">
                <span class="inline-flex items-center gap-1 font-medium text-text-secondary">
                  <svg class="w-3 h-3 text-accent-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                  </svg>
                  {member.officeName}
                </span>
                {member.isProducer && member.npn && (
                  <>
                    <span class="text-zinc-300">•</span>
                    <span class="font-semibold text-accent-gold">
                      {ui.producerBadge} (NPN #{member.npn})
                    </span>
                  </>
                )}
              </div>

              <!-- Languages badges -->
              {member.languages && member.languages.length > 0 && (
                <div class="mt-2.5 flex flex-wrap gap-1">
                  {member.languages.map((lang) => (
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-accent/5 text-accent border border-accent/10">
                      {lang}
                    </span>
                  ))}
                </div>
              )}
              <p class="mt-2.5 text-xs text-text-muted line-clamp-2 leading-relaxed">
                {member.shortBio}
              </p>
            </div>

            <!-- Action Prompt -->
            <div class="mt-4 pt-3 border-t border-border-subtle flex items-center justify-between text-xs font-semibold text-accent group-hover:text-accent-gold transition-colors">
              <span>{ui.readBioSpecialties}</span>
              <svg class="w-4 h-4 text-accent-gold transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </div>
          </div>
        </button>
      ))}
    </div>
  </div>

  <!-- Pop-up Modal Container -->
  <div
    id="team-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6 bg-zinc-950/75 backdrop-blur-md opacity-0 transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
  >
    <!-- Modal Card Box -->
    <div
      id="modal-box"
      class="relative w-full max-w-2xl bg-bg-primary rounded-2xl border border-border-subtle shadow-2xl overflow-hidden scale-95 transition-transform duration-300 max-h-[90vh] flex flex-col"
    >
      <!-- Close Button -->
      <button
        type="button"
        id="modal-close-btn"
        class="absolute top-4 right-4 z-20 p-2 rounded-full bg-bg-primary/80 hover:bg-zinc-100 text-zinc-500 hover:text-accent border border-border-subtle transition-colors shadow-sm focus:outline-none focus:ring-2 focus:ring-accent-gold cursor-pointer"
        aria-label={ui.closeModal}
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Scrollable Modal Body -->
      <div class="overflow-y-auto p-6 sm:p-8 space-y-6">
        <!-- Top Profile Row -->
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 border-b border-border-subtle pb-6">
          <div class="relative w-28 h-28 sm:w-32 sm:h-32 rounded-2xl overflow-hidden border-2 border-accent-gold shadow-md shrink-0 bg-zinc-100">
            <img
              id="modal-member-img"
              src=""
              alt=""
              class="w-full h-full object-cover object-top"
            />
          </div>

          <div class="text-center sm:text-left space-y-1.5 flex-1">
            <div class="flex flex-wrap gap-2 justify-center sm:justify-start items-center">
              <span id="modal-member-badge" class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-accent/10 text-accent"></span>
              <span id="modal-member-office" class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-bg-secondary text-accent border border-border-subtle"></span>
              <span id="modal-member-npn" class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-accent-gold/20 text-accent border border-accent-gold/40"></span>
            </div>
            <h3 id="modal-member-name" class="text-2xl font-bold text-accent"></h3>
            <p id="modal-member-role" class="text-sm font-medium text-text-secondary"></p>
            <div class="pt-2 flex flex-wrap gap-2 justify-center sm:justify-start">
              <a
                href="tel:2037489272"
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent hover:text-accent-gold transition-colors py-1 px-2.5 rounded bg-bg-secondary border border-border-subtle"
              >
                <svg class="w-3.5 h-3.5 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.942-6.942l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
                </svg>
                {ui.callBtn}
              </a>
              <a
                href={ui.quoteUrl}
                class="inline-flex items-center gap-1 text-xs font-semibold text-white bg-accent hover:bg-accent/90 transition-colors py-1 px-3 rounded shadow-sm"
              >
                {ui.quoteBtn}
              </a>
            </div>
          </div>
        </div>

        <!-- Full Biography Section -->
        <div class="space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-accent-gold">
            {ui.bioHeading}
          </h4>
          <p id="modal-member-bio" class="text-sm leading-relaxed text-text-secondary whitespace-pre-line">
          </p>
        </div>

        <!-- Languages Spoken Section -->
        <div class="space-y-2 pt-1">
          <h4 class="text-xs font-bold uppercase tracking-wider text-accent-gold">
            {ui.languagesHeading}
          </h4>
          <div id="modal-member-languages" class="flex flex-wrap gap-2">
          </div>
        </div>

        <!-- Specialties Tags -->
        <div class="space-y-2 pt-1">
          <h4 class="text-xs font-bold uppercase tracking-wider text-accent-gold">
            {ui.specialtiesHeading}
          </h4>
          <div id="modal-member-specialties" class="flex flex-wrap gap-2">
          </div>
        </div>

        <!-- Personal / Community Note -->
        <div class="p-4 rounded-xl bg-accent/5 border border-accent/10 text-xs text-text-secondary leading-relaxed">
          <span class="font-semibold text-accent">{ui.beyondDeskHeading}</span>
          <span id="modal-member-highlight" class="ml-1"></span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Client Script to handle popup interactions & office filtering -->
<script is:inline define:vars={{ localizedMembers, ui }}>
  const modal = document.getElementById('team-modal');
  const modalBox = document.getElementById('modal-box');
  const closeBtn = document.getElementById('modal-close-btn');
  const cards = document.querySelectorAll('.team-card');
  const filterBtns = document.querySelectorAll('.team-filter-btn');

  const nameEl = document.getElementById('modal-member-name');
  const roleEl = document.getElementById('modal-member-role');
  const badgeEl = document.getElementById('modal-member-badge');
  const officeEl = document.getElementById('modal-member-office');
  const npnEl = document.getElementById('modal-member-npn');
  const bioEl = document.getElementById('modal-member-bio');
  const imgEl = document.getElementById('modal-member-img');
  const specsEl = document.getElementById('modal-member-specialties');
  const langsEl = document.getElementById('modal-member-languages');
  const highlightEl = document.getElementById('modal-member-highlight');

  let activeCard = null;

  // Filter functionality
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const office = btn.getAttribute('data-filter-office');
      filterBtns.forEach(b => {
        const isActive = b === btn;
        b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        b.className = isActive
          ? 'team-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all bg-accent text-white shadow-sm'
          : 'team-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all text-text-secondary hover:text-accent hover:bg-white/80';
      });

      cards.forEach(card => {
        const cardOffice = card.getAttribute('data-office');
        if (office === 'all' || cardOffice === office) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });

  function openModal(member, card) {
    activeCard = card;
    nameEl.textContent = member.name;
    roleEl.textContent = member.role;
    badgeEl.textContent = member.experienceBadge;
    bioEl.textContent = member.fullBio;
    if (member.image) {
      imgEl.src = member.image.src;
      imgEl.alt = member.name;
    }
    highlightEl.textContent = member.personalHighlight;

    // Office indicator
    if (officeEl) {
      officeEl.innerHTML = `<svg class="w-3 h-3 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg><span>${member.officeName}</span>`;
    }

    // NPN indicator
    if (npnEl) {
      if (member.isProducer && member.npn) {
        npnEl.style.display = 'inline-flex';
        npnEl.innerHTML = `<svg class="w-3 h-3 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg><span>NPN #${member.npn}</span>`;
      } else {
        npnEl.style.display = 'none';
      }
    }

    // Populate languages
    if (langsEl) {
      langsEl.innerHTML = '';
      if (member.languages) {
        member.languages.forEach(lang => {
          const tag = document.createElement('span');
          tag.className = 'px-3 py-1 rounded-full text-xs font-semibold bg-accent/10 text-accent border border-accent/20';
          tag.textContent = lang;
          langsEl.appendChild(tag);
        });
      }
    }

    // Populate specialties
    if (specsEl) {
      specsEl.innerHTML = '';
      if (member.specialties) {
        member.specialties.forEach(spec => {
          const tag = document.createElement('span');
          tag.className = 'px-3 py-1 rounded-full text-xs font-medium bg-bg-secondary text-text-primary border border-border-subtle';
          tag.textContent = spec;
          specsEl.appendChild(tag);
        });
      }
    }

    // Show modal with animation
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    // Trigger transition
    requestAnimationFrame(() => {
      modal.classList.remove('opacity-0');
      modal.classList.add('opacity-100');
      modalBox.classList.remove('scale-95');
      modalBox.classList.add('scale-100');
    });

    closeBtn.focus();
  }

  function closeModal() {
    modal.classList.remove('opacity-100');
    modal.classList.add('opacity-0');
    modalBox.classList.remove('scale-100');
    modalBox.classList.add('scale-95');

    setTimeout(() => {
      modal.classList.remove('flex');
      modal.classList.add('hidden');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (activeCard) {
        activeCard.focus();
      }
    }, 250);
  }

  // Card click event listeners
  cards.forEach(card => {
    card.addEventListener('click', () => {
      const id = card.getAttribute('data-member-id');
      const member = localizedMembers.find(m => m.id === id);
      if (member) {
        openModal(member, card);
      }
    });
  });

  // Close handlers
  closeBtn?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });
</script>
