---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getLocationById, type LocationId } from '../data/locations';
import { getLocationTranslation } from '../i18n/locations';
import { getMembersByOffice } from '../i18n/team';
import FAQAccordion from './FAQAccordion';
import { getRelativeLocaleUrl } from 'astro:i18n';
import QuoteForm from './QuoteForm';

// Import staff profile photos
import ronaldImg from '../assets/Agency Founder and owner Ron Boucher.jpg';
import yesicaImg from '../assets/aia_yesica.png';
import betaniaImg from '../assets/betania-aia.png';
import camilaImg from '../assets/camila-aia.png';
import isayeliImg from '../assets/isayeli-aia.png';
import emaImg from '../assets/aia_ema.png';
import claraImg from '../assets/aia_clara.png';
import ashleyImg from '../assets/Ashley_AIA-Meet-the-team.png';
import janaijaImg from '../assets/aia_janaija.png';

interface Props {
  locationId: LocationId;
  lang?: 'en' | 'es' | 'pt' | 'tr';
}

const { locationId, lang = 'en' } = Astro.props;
const currentLang = (lang || Astro.currentLocale || 'en') as 'en' | 'es' | 'pt' | 'tr';

const location = getLocationById(locationId);
if (!location) {
  throw new Error(`Location not found for ID: ${locationId}`);
}

const t = getLocationTranslation(locationId, currentLang);
const staffMembers = getMembersByOffice(locationId, currentLang);

const imageMap: Record<string, ImageMetadata> = {
  'ronald-boucher': ronaldImg,
  'yesica-ramirez': yesicaImg,
  'betania-almeida': betaniaImg,
  'camila-macedo': camilaImg,
  'isayeli-perez': isayeliImg,
  'ema-rego': emaImg,
  'clara-de-barros': claraImg,
  'ashley-mercan': ashleyImg,
  'janaija-hammer': janaijaImg,
};

const homeUrl = getRelativeLocaleUrl(currentLang, '');
const locationsHubUrl = getRelativeLocaleUrl(currentLang, 'locations');
const quoteUrl = getRelativeLocaleUrl(currentLang, 'quote');

const siteUrl = 'https://aia-danbury.com';
const currentPath = currentLang === 'en' ? `/locations/${location.slug}` : `/${currentLang}/locations/${location.slug}`;
const fullPageUrl = `${siteUrl}${currentPath}`;

// Structured Data: Schema.org @graph with InsuranceAgency + BreadcrumbList + FAQPage
const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'InsuranceAgency',
      '@id': `${fullPageUrl}#location`,
      name: `Associated Insurance Agency - ${t.name}`,
      alternateName: [`AIA ${location.city}`, `Associated Insurance Agency ${location.city} CT`],
      image: `${siteUrl}/images/logo.png`,
      url: fullPageUrl,
      telephone: `+1-${location.phoneRaw}`,
      email: location.email,
      priceRange: '$$',
      parentOrganization: {
        '@type': 'InsuranceAgency',
        '@id': `${siteUrl}/#organization`,
        name: 'Associated Insurance Agency',
        url: siteUrl,
      },
      address: {
        '@type': 'PostalAddress',
        streetAddress: location.streetAddress,
        addressLocality: location.city,
        addressRegion: location.state,
        postalCode: location.postalCode,
        addressCountry: 'US',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: location.lat,
        longitude: location.lng,
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          opens: '08:30',
          closes: '17:00',
        },
      ],
      areaServed: location.surroundingTowns.map((town) => ({
        '@type': 'City',
        name: town,
      })),
      hasMap: location.directionsUrl,
      knowsLanguage: location.languages.map((l) => {
        const codeMap: Record<string, string> = { English: 'en', Spanish: 'es', Portuguese: 'pt', Turkish: 'tr' };
        return codeMap[l] || 'en';
      }),
      employee: staffMembers.map((member) => ({
        '@type': 'Person',
        name: member.name,
        jobTitle: member.role,
        knowsLanguage: member.languages,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${fullPageUrl}#breadcrumbs`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: currentLang === 'es' ? 'Inicio' : currentLang === 'pt' ? 'Início' : currentLang === 'tr' ? 'Ana Sayfa' : 'Home',
          item: `${siteUrl}${homeUrl}`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: currentLang === 'es' ? 'Sucursales' : currentLang === 'pt' ? 'Agências' : currentLang === 'tr' ? 'Şubeler' : 'Locations',
          item: `${siteUrl}${locationsHubUrl}`,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: t.shortName,
          item: fullPageUrl,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${fullPageUrl}#faq`,
      mainEntity: t.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<BaseLayout
  title={t.seoTitle}
  description={t.metaDescription}
  lang={currentLang}
  structuredData={schemaGraph}
  locationId={locationId}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-bg-secondary via-bg-primary to-bg-primary pt-12 pb-16 border-b border-border-subtle overflow-hidden">
    <!-- Subtle Background Glow -->
    <div class="absolute top-0 right-1/4 w-96 h-96 bg-accent-gold/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-text-muted mb-6" aria-label="Breadcrumb">
        <a href={homeUrl} class="hover:text-accent transition-colors">
          {currentLang === 'es' ? 'Inicio' : currentLang === 'pt' ? 'Início' : currentLang === 'tr' ? 'Ana Sayfa' : 'Home'}
        </a>
        <span>/</span>
        <a href={locationsHubUrl} class="hover:text-accent transition-colors">
          {currentLang === 'es' ? 'Sucursales' : currentLang === 'pt' ? 'Agências' : currentLang === 'tr' ? 'Şubeler' : 'Locations'}
        </a>
        <span>/</span>
        <span class="text-text-primary font-medium">{t.shortName}</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        <!-- Left Side: Office Narrative & Actions -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/5 border border-accent/10 text-accent text-xs font-semibold uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-accent-gold animate-pulse"></span>
            {t.tag} • Connecticut
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-accent leading-tight">
            {t.heroHeadline}
          </h1>

          <p class="text-base sm:text-lg text-text-secondary leading-relaxed max-w-[65ch]">
            {t.heroSubheadline}
          </p>

          <!-- Quick Action Buttons -->
          <div class="pt-2 flex flex-wrap items-center gap-3">
            <a
              href={`tel:${location.phoneRaw}`}
              class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-accent text-white hover:bg-accent/90 text-sm font-semibold shadow-sm transition-all hover:shadow hover:-translate-y-0.5"
            >
              <svg class="w-4 h-4 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.942-6.942l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
              </svg>
              {t.callOfficeCta}
            </a>

            <a
              href={location.directionsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-white border border-border-subtle hover:border-accent text-accent text-sm font-semibold shadow-sm transition-all hover:bg-bg-secondary hover:-translate-y-0.5"
            >
              <svg class="w-4 h-4 text-accent-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
              </svg>
              {t.directionsCta}
            </a>
          </div>

          <!-- Trust Badges -->
          <div class="pt-4 flex flex-wrap items-center gap-4 text-xs text-text-muted border-t border-border-subtle/80">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
              </svg>
              {currentLang === 'es' ? 'Agencia Independiente' : currentLang === 'pt' ? 'Agência Independente' : currentLang === 'tr' ? 'Bağımsız Acente' : 'Independent Agency'}
            </span>
            <span>•</span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
              </svg>
              {currentLang === 'es' ? 'Más de 20 Aseguradoras' : currentLang === 'pt' ? 'Mais de 20 Seguradoras' : currentLang === 'tr' ? '20+ Sigorta Şirketi' : '20+ Partner Carriers'}
            </span>
            <span>•</span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
              </svg>
              {currentLang === 'es' ? 'Atención sin Cita' : currentLang === 'pt' ? 'Atendimento sem Hora Marcada' : currentLang === 'tr' ? 'Randevusuz Görüşme' : 'Walk-Ins Welcome'}
            </span>
            <span>•</span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
              </svg>
              {currentLang === 'es' ? 'Licencia en CT y NY' : currentLang === 'pt' ? 'Licenciada em CT e NY' : currentLang === 'tr' ? 'CT ve NY Lisanslı' : 'Licensed in CT & NY'}
            </span>
          </div>
        </div>

        <!-- Right Side: Interactive Hero Quote Starter Island -->
        <div class="lg:col-span-5 relative">
          <div class="absolute -inset-4 bg-accent-gold/10 rounded-3xl blur-xl pointer-events-none"></div>
          <QuoteForm
            client:load
            lang={currentLang}
            defaultZip={location.postalCode}
            hideHeading
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Grid -->
  <section class="py-16 sm:py-20 bg-bg-primary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-start">
        
        <!-- Left 7 Columns: Narrative, Coverage Specialties, Communities & FAQs -->
        <div class="lg:col-span-7 space-y-16">
          
          <!-- Office Narrative Overview -->
          <article class="prose prose-zinc max-w-none space-y-5">
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-accent">
              {t.name}
            </h2>
            {t.officeOverview.map((paragraph) => (
              <p class="text-base text-text-secondary leading-relaxed">
                {paragraph}
              </p>
            ))}
          </article>

          <!-- Coverage Lines & Specialties -->
          <div class="space-y-6">
            <div>
              <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-accent">
                {t.localRisksAndFocusHeading}
              </h2>
              <p class="mt-2 text-sm sm:text-base text-text-secondary">
                {t.localRisksAndFocusDesc}
              </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {t.coverageLines.map((line, idx) => (
                <div class="p-5 rounded-xl bg-bg-secondary border border-border-subtle hover:border-accent/30 transition-all hover:shadow-sm space-y-2.5">
                  <div class="w-9 h-9 rounded-lg bg-accent/10 flex items-center justify-center text-accent">
                    <span class="font-mono text-xs font-bold">0{idx + 1}</span>
                  </div>
                  <h3 class="text-base font-semibold text-accent leading-snug">
                    {line.title}
                  </h3>
                  <p class="text-xs sm:text-sm text-text-secondary leading-relaxed">
                    {line.desc}
                  </p>
                </div>
              ))}
            </div>
          </div>

          <!-- Communities Served Section -->
          <div class="p-8 rounded-2xl bg-gradient-to-br from-bg-secondary to-bg-primary border border-border-subtle space-y-5">
            <div>
              <div class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-accent-gold mb-1">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                </svg>
                {t.communitiesHeading}
              </div>
              <p class="text-sm text-text-secondary">
                {t.communitiesDesc}
              </p>
            </div>

            <div class="flex flex-wrap gap-2">
              {location.surroundingTowns.map((town) => (
                <span class="px-3 py-1.5 rounded-lg bg-white border border-border-subtle text-xs font-medium text-text-primary shadow-2xs">
                  {town}, CT
                </span>
              ))}
            </div>
          </div>

          <!-- Local Branch FAQ -->
          <div class="space-y-6">
            <div>
              <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-accent">
                {currentLang === 'es' ? 'Preguntas Frecuentes' : currentLang === 'pt' ? 'Perguntas Frequentes' : currentLang === 'tr' ? 'Sıkça Sorulan Sorular' : 'Frequently Asked Questions'}
              </h2>
              <p class="mt-1 text-sm text-text-secondary">
                {currentLang === 'es' ? `Respuestas sobre nuestra oficina en ${location.city}.` : currentLang === 'pt' ? `Tire suas dúvidas sobre a nossa agência em ${location.city}.` : currentLang === 'tr' ? `${location.city} şubemiz hakkında merak edilenler.` : `Common questions about visiting our ${location.city} office.`}
              </p>
            </div>

            <FAQAccordion client:load items={t.faqs} />
          </div>

        </div>

        <!-- Right 5 Columns: Sticky NAP Card, Google Map & Fast Quote Card -->
        <div class="lg:col-span-5 space-y-6 lg:sticky lg:top-24">
          
          <!-- Office NAP Details Card -->
          <div class="p-6 sm:p-7 rounded-2xl bg-white border border-border-subtle shadow-sm space-y-6">
            <div class="flex items-center justify-between border-b border-border-subtle pb-4">
              <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-accent-gold">
                  {t.tag}
                </span>
                <h3 class="text-lg font-bold text-accent">
                  {t.shortName}
                </h3>
              </div>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-medium">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                Open Mon–Fri
              </span>
            </div>

            <!-- Address -->
            <div class="space-y-2">
              <span class="text-xs font-bold text-text-muted uppercase tracking-wider">Address</span>
              <div class="flex items-start gap-3 text-sm text-text-primary">
                <svg class="w-5 h-5 text-accent-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                </svg>
                <div>
                  <p class="font-semibold text-accent">{location.streetAddress}</p>
                  <p class="text-text-secondary">{location.city}, {location.state} {location.postalCode}</p>
                </div>
              </div>
              <a
                href={location.directionsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-xs font-semibold text-accent hover:text-accent-gold transition-colors pt-1"
              >
                <span>{t.directionsCta}</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                </svg>
              </a>
            </div>

            <!-- Contact Numbers -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-border-subtle/70">
              <div>
                <span class="text-xs font-bold text-text-muted uppercase tracking-wider">Phone</span>
                <p class="text-sm font-semibold text-accent mt-0.5">
                  <a href={`tel:${location.phoneRaw}`} class="hover:text-accent-gold transition-colors">
                    {location.phoneFormatted}
                  </a>
                </p>
              </div>

              {location.fax && (
                <div>
                  <span class="text-xs font-bold text-text-muted uppercase tracking-wider">Fax</span>
                  <p class="text-sm text-text-secondary mt-0.5">{location.fax}</p>
                </div>
              )}
            </div>

            <!-- Hours & Email -->
            <div class="pt-4 border-t border-border-subtle/70 space-y-3">
              <div>
                <span class="text-xs font-bold text-text-muted uppercase tracking-wider">{t.openHoursLabel}</span>
                <p class="text-sm text-text-primary mt-0.5">{location.hours}</p>
              </div>

              <div>
                <span class="text-xs font-bold text-text-muted uppercase tracking-wider">Email</span>
                <p class="text-sm font-medium text-accent mt-0.5">
                  <a href={`mailto:${location.email}`} class="hover:underline">
                    {location.email}
                  </a>
                </p>
              </div>
            </div>

            <!-- Spoken Languages -->
            <div class="pt-4 border-t border-border-subtle/70">
              <span class="text-xs font-bold text-text-muted uppercase tracking-wider block mb-2">{t.languagesLabel}</span>
              <div class="flex flex-wrap gap-1.5">
                {location.languages.map((langItem) => (
                  <span class="px-2.5 py-1 rounded bg-bg-secondary text-text-primary text-xs font-semibold border border-border-subtle">
                    {langItem}
                  </span>
                ))}
              </div>
            </div>

            <!-- Google Maps Embed -->
            <div class="pt-2">
              <div class="relative w-full h-56 rounded-xl overflow-hidden border border-border-subtle shadow-inner">
                <iframe
                  title={`${location.name} Google Map`}
                  src={location.embedUrl}
                  width="100%"
                  height="100%"
                  style="border:0;"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  class="w-full h-full"
                ></iframe>
              </div>
            </div>

          </div>

          <!-- Fast Local Quote Starter -->
          <div class="p-6 rounded-2xl bg-zinc-950 text-white space-y-4 shadow-lg border border-zinc-800">
            <div class="space-y-1">
              <span class="text-xs font-semibold uppercase tracking-wider text-accent-gold">
                {currentLang === 'es' ? 'Cotizaciones Rápidas' : currentLang === 'pt' ? 'Cotações Rápidas' : currentLang === 'tr' ? 'Hızlı Teklif' : 'Fast Local Quotes'}
              </span>
              <h3 class="text-lg font-bold">
                {currentLang === 'es' ? 'Cotice con un Agente Local' : currentLang === 'pt' ? 'Cote com um Corretor Local' : currentLang === 'tr' ? 'Yerel Temsilcimizden Teklif Alın' : 'Request a Local Quote'}
              </h3>
              <p class="text-xs text-zinc-400">
                {currentLang === 'es' ? 'Comparamos más de 20 aseguradoras en Connecticut para darle el mejor precio.' : currentLang === 'pt' ? 'Comparamos mais de 20 seguradoras para garantir a melhor cobertura.' : currentLang === 'tr' ? '20’den fazla şirketten karşılaştırmalı teklif alın.' : 'Compare coverage across 20+ Connecticut carriers in minutes.'}
              </p>
            </div>

            <div class="pt-2 flex flex-col gap-2.5">
              <a
                href={quoteUrl}
                class="w-full py-3 px-4 rounded-lg bg-accent-gold hover:bg-accent-gold/90 text-zinc-950 font-bold text-sm text-center shadow transition-all hover:shadow-md"
              >
                {t.quoteOfficeCta}
              </a>
              <a
                href={`tel:${location.phoneRaw}`}
                class="w-full py-2.5 px-4 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-200 text-xs font-semibold text-center transition-colors"
              >
                {t.callOfficeCta}
              </a>
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- Assigned Branch Staff Roster -->
  <section class="py-20 bg-bg-secondary/60 border-t border-border-subtle" id="staff">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-left mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/5 border border-accent/10 text-accent text-xs font-semibold uppercase tracking-wider mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-accent-gold"></span>
          {location.city} Staff Roster
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-accent">
          {t.staffHeading}
        </h2>
        <p class="mt-2 text-sm sm:text-base text-text-secondary max-w-[65ch]">
          {t.staffSubheading}
        </p>
      </div>

      <!-- Staff Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {staffMembers.map((member) => {
          const photo = imageMap[member.id];
          return (
            <div class="bg-white rounded-2xl border border-border-subtle overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between">
              <div>
                <!-- Photo and Header -->
                <div class="p-6 pb-4 flex items-start gap-4">
                  {photo ? (
                    <div class="w-20 h-20 rounded-xl overflow-hidden shrink-0 border border-border-subtle bg-bg-secondary shadow-2xs">
                      <Image
                        src={photo}
                        alt={member.name}
                        width={160}
                        height={160}
                        class="w-full h-full object-cover object-top"
                        loading="lazy"
                      />
                    </div>
                  ) : (
                    <div class="w-20 h-20 rounded-xl bg-accent/10 flex items-center justify-center text-accent font-bold text-xl shrink-0">
                      {member.name.charAt(0)}
                    </div>
                  )}

                  <div class="space-y-1">
                    <h3 class="text-base font-bold text-accent leading-tight">
                      {member.name}
                    </h3>
                    <p class="text-xs font-semibold text-text-secondary">
                      {member.role}
                    </p>
                    {member.isProducer && (
                      <span class="inline-flex items-center gap-1 text-[11px] font-bold text-accent-gold">
                        ★ {currentLang === 'es' ? 'Productor Licenciado' : currentLang === 'pt' ? 'Corretor Licenciado' : currentLang === 'tr' ? 'Lisanslı Sigorta Uzmanı' : 'Licensed Producer'}
                      </span>
                    )}
                  </div>
                </div>

                <!-- Languages & Bio -->
                <div class="px-6 pb-4 space-y-3">
                  <div class="flex flex-wrap gap-1">
                    {member.languages.map((l) => (
                      <span class="px-2 py-0.5 rounded text-[10px] font-medium bg-bg-secondary border border-border-subtle text-text-secondary">
                        {l}
                      </span>
                    ))}
                  </div>

                  <p class="text-xs text-text-secondary leading-relaxed line-clamp-4">
                    {member.shortBio || member.fullBio}
                  </p>
                </div>
              </div>

              <!-- Footer with Experience Badge -->
              <div class="px-6 py-3.5 bg-bg-secondary/40 border-t border-border-subtle/80 flex items-center justify-between text-[11px] text-text-muted">
                <span>{member.experienceBadge}</span>
                <a
                  href={`tel:${location.phoneRaw}`}
                  class="font-semibold text-accent hover:text-accent-gold transition-colors"
                >
                  {currentLang === 'es' ? 'Contactar →' : currentLang === 'pt' ? 'Contato →' : currentLang === 'tr' ? 'İletişim →' : 'Contact →'}
                </a>
              </div>
            </div>
          );
        })}
      </div>

    </div>
  </section>

  <!-- Bottom CTA Banner -->
  <section class="py-16 bg-accent text-white border-t border-border-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight max-w-2xl mx-auto">
        {currentLang === 'es'
          ? `Hable con un Agente Licenciado en ${location.city}`
          : currentLang === 'pt'
          ? `Fale com um Corretor Licenciado em ${location.city}`
          : currentLang === 'tr'
          ? `${location.city} Ofisimizden Teklif Alın veya Poliçenizi İnceletin`
          : `Talk with a Licensed Agent in ${location.city}`}
      </h2>
      <p class="text-sm sm:text-base text-zinc-300 max-w-xl mx-auto">
        {currentLang === 'es'
          ? `Visite nuestra oficina en ${location.streetAddress} o llámenos hoy para comparar tarifas entre más de 20 aseguradoras.`
          : currentLang === 'pt'
          ? `Visite nosso escritório na ${location.streetAddress} ou ligue hoje mesmo para comparar preços entre mais de 20 seguradoras.`
          : currentLang === 'tr'
          ? `${location.streetAddress} adresindeki ofisimize uğrayın veya 20’den fazla şirketin teklifini karşılaştırmak için bizi arayın.`
          : `Visit our office at ${location.streetAddress} or call today to compare rates across 20+ carriers.`}
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a
          href={`tel:${location.phoneRaw}`}
          class="px-6 py-3.5 rounded-lg bg-accent-gold text-zinc-950 font-bold text-sm shadow hover:bg-accent-gold/90 transition-all hover:-translate-y-0.5"
        >
          {t.callOfficeCta}
        </a>
        <a
          href={quoteUrl}
          class="px-6 py-3.5 rounded-lg bg-white/10 hover:bg-white/20 text-white font-semibold text-sm border border-white/20 transition-all hover:-translate-y-0.5"
        >
          {t.quoteOfficeCta}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
