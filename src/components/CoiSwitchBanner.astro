---
// CoiSwitchBanner.astro
// B2B Trojan Horse Conversion Component for Certificate Request pages
// Targets commercial contractors and business owners with fast ACORD 25 issuance and policy review
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  lang?: 'en' | 'es' | 'pt' | 'tr';
}

const { lang = 'en' } = Astro.props;
const currentLang = (['en', 'es', 'pt', 'tr'].includes(lang) ? lang : 'en') as 'en' | 'es' | 'pt' | 'tr';

const content = {
  en: {
    badge: 'Contractor & Commercial Advantage',
    headline: 'Tired of Waiting Days for Certificates From Your Current Broker?',
    subheadline:
      'When an active job site, municipal inspector, or general contractor demands proof of insurance today, delays cost you money. Associated Insurance Agency issues official ACORD 25 certificates within 2–4 hours (often under 30 minutes for urgent job sites) complete with custom Additional Insured endorsements (CG 20 10 / CG 20 37) and Waivers of Subrogation.',
    pitch:
      'Let us review your commercial policy at your next renewal — we typically save Connecticut contractors 15% to 25% while giving you same-day turnaround on all future certificates.',
    features: [
      {
        title: '2–4 Hour Turnaround',
        desc: 'Fast issuance with direct PDF delivery to your GC or landlord.',
      },
      {
        title: 'Blanket Endorsements',
        desc: 'CG 20 10 / CG 20 37 additional insured & waiver of subrogation compliance.',
      },
      {
        title: '20+ Top Commercial Carriers',
        desc: 'We shop Travelers, The Hartford, Progressive, Safeco & specialty markets.',
      },
      {
        title: 'Multilingual Commercial Desk',
        desc: 'Licensed producers fluent in English, Spanish, Portuguese & Turkish.',
      },
    ],
    ctaQuote: 'Request Commercial Policy & COI Review',
    ctaCall: 'Call Commercial Desk: (203) 748-9272',
    phoneRaw: '2037489272',
    guarantee: 'Zero cost or obligation. We review your current declarations page in 15 minutes.',
  },
  es: {
    badge: 'Ventaja para Contratistas y Empresas',
    headline: '¿Cansado de esperar días por un certificado con su agente actual?',
    subheadline:
      'Cuando una obra activa, un inspector municipal o un contratista general exige prueba de seguro para hoy, cada retraso le cuesta dinero. Associated Insurance Agency emite certificados oficiales ACORD 25 en 2 a 4 horas hábiles (a menudo en menos de 30 minutos para emergencias en obras), incluyendo endosos de Asegurado Adicional (CG 20 10 / CG 20 37) y Renuncias de Subrogación.',
    pitch:
      'Permítanos revisar su póliza comercial en su próxima renovación: habitualmente ahorramos a los contratistas de Connecticut entre un 15% y un 25% con emisión prioritaria el mismo día.',
    features: [
      {
        title: 'Emisión en 2 a 4 Horas',
        desc: 'Envío directo por correo en PDF a su contratista general o propietario.',
      },
      {
        title: 'Endosos Completos',
        desc: 'Cumplimiento normativo CG 20 10 / CG 20 37 y renuncia de subrogación.',
      },
      {
        title: 'Más de 20 Aseguradoras',
        desc: 'Comparamos Travelers, The Hartford, Progressive, Safeco y mercados especializados.',
      },
      {
        title: 'Atención 100% en Español',
        desc: 'Agentes licenciados bilingües listos para resolver sus dudas de inmediato.',
      },
    ],
    ctaQuote: 'Solicitar Revisión de Póliza y Certificados',
    ctaCall: 'Llamar a Sede Danbury: (203) 748-9272',
    phoneRaw: '2037489272',
    guarantee: 'Sin costo ni compromiso. Revisamos su página de declaraciones en 15 minutos.',
  },
  pt: {
    badge: 'Vantagem para Prestadores e Empresas',
    headline: 'Cansado de esperar dias por certificados do seu corretor atual?',
    subheadline:
      'Quando uma obra, fiscal municipal ou empreiteiro geral exige comprovação de seguro para hoje, atrasos significam prejuízo. A Associated Insurance Agency emite certificados oficiais ACORD 25 em 2 a 4 horas úteis (geralmente em menos de 30 minutos para obras urgentes), completos com endossos de Segurado Adicional (CG 20 10 / CG 20 37) e Renúncia de Sub-rogação.',
    pitch:
      'Permita-nos analisar sua apólice comercial na próxima renovação — economizamos em média de 15% a 25% para empreiteiros em Connecticut com emissão rápida e atendimento no mesmo dia.',
    features: [
      {
        title: 'Emissão em 2 a 4 Horas',
        desc: 'Envio direto em PDF por e-mail para seu contratante ou proprietário.',
      },
      {
        title: 'Endossos Abrangentes',
        desc: 'Conformidade total CG 20 10 / CG 20 37 e renúncia de sub-rogação.',
      },
      {
        title: 'Mais de 20 Seguradoras',
        desc: 'Cotações com Travelers, The Hartford, Progressive, Safeco e mercados de nicho.',
      },
      {
        title: 'Atendimento Nativo em Português',
        desc: 'Corretores licenciados prontos para esclarecer suas dúvidas sem barreiras.',
      },
    ],
    ctaQuote: 'Solicitar Análise de Apólice e Certificados',
    ctaCall: 'Ligar para a Sede: (203) 748-9272',
    phoneRaw: '2037489272',
    guarantee: 'Sem custo ou compromisso. Analisamos sua página de coberturas em 15 minutos.',
  },
  tr: {
    badge: 'Müteahhitler ve İşletmeler İçin Hızlı Geçiş',
    headline: 'Mevcut Sigortacınızdan Sertifika Almak İçin Günlerce Beklemekten Bıktınız mı?',
    subheadline:
      'Aktif bir şantiye, belediye denetmeni veya ana yüklenici sizden bugün sigorta belgesi istediğinde, yaşanan gecikmeler para ve iş kaybına neden olur. Associated Insurance Agency, ek sigortalı (Additional Insured CG 20 10 / CG 20 37) ve rücu feragati (Waiver of Subrogation) onaylı resmi ACORD 25 sertifikalarını 2-4 iş saati içinde (acil durumlarda 30 dakikanın altında) düzenler.',
    pitch:
      'Bir sonraki poliçe yenilemenizde ticari poliçenizi bize inceletin — Connecticut\'taki işletmelere ortalama %15-%25 tasarruf sağlarken tüm sertifikalarınızı aynı gün teslim ediyoruz.',
    features: [
      {
        title: '2–4 Saatte Hızlı Teslimat',
        desc: 'Ana yüklenicinize veya mülk sahibine doğrudan e-posta ve PDF iletimi.',
      },
      {
        title: 'Genişletilmiş Onaylar',
        desc: 'CG 20 10 / CG 20 37 ek sigortalı ve rücu feragati tam uyumluluğu.',
      },
      {
        title: '20\'den Fazla Lider Şirket',
        desc: 'Travelers, The Hartford, Progressive, Safeco ve özel poliçe sağlayıcıları.',
      },
      {
        title: 'Ana Dilinizde Destek',
        desc: 'Türkçe, İngilizce, İspanyolca ve Portekizce konuşan lisanslı uzmanlar.',
      },
    ],
    ctaQuote: 'Ticari Poliçe ve Sertifika Analizi Talep Edin',
    ctaCall: 'Danbury Merkezini Arayın: (203) 748-9272',
    phoneRaw: '2037489272',
    guarantee: 'Tamamen ücretsiz ve bağlayıcılığı yoktur. Poliçenizi 15 dakikada denetliyoruz.',
  },
};

const d = content[currentLang];
const quoteUrl = `${getRelativeLocaleUrl(currentLang, 'quote')}?type=business`;
---

<div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#0c1c3f] via-[#122b5f] to-[#08152e] text-white p-6 sm:p-8 md:p-10 border border-[#1e3a73] shadow-2xl">
  <!-- Ambient background glow elements -->
  <div class="absolute -top-24 -right-24 w-72 h-72 bg-accent-gold/15 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-blue-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="relative z-10 space-y-8">
    <!-- Header Block -->
    <div class="space-y-4 max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-gold/15 border border-accent-gold/30 text-accent-gold text-xs font-bold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-accent-gold animate-pulse"></span>
        <span>{d.badge}</span>
      </div>

      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-white leading-tight">
        {d.headline}
      </h2>

      <p class="text-sm sm:text-base text-slate-200 leading-relaxed">
        {d.subheadline}
      </p>

      <div class="p-3.5 sm:p-4 rounded-xl bg-white/5 border border-white/10 text-xs sm:text-sm text-accent-gold font-medium leading-relaxed">
        {d.pitch}
      </div>
    </div>

    <!-- Feature Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-2">
      {d.features.map((item) => (
        <div class="p-4 rounded-xl bg-white/5 border border-white/10 backdrop-blur-sm space-y-1.5 hover:bg-white/10 transition-colors">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-accent-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            <h3 class="text-xs sm:text-sm font-bold text-white tracking-tight">
              {item.title}
            </h3>
          </div>
          <p class="text-xs text-slate-300 leading-snug pl-6">
            {item.desc}
          </p>
        </div>
      ))}
    </div>

    <!-- Conversion & CTA Block -->
    <div class="pt-4 border-t border-white/10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-5">
      <div class="flex flex-col sm:flex-row gap-3 w-full lg:w-auto">
        <a
          href={quoteUrl}
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-accent-gold hover:bg-accent-gold-hover text-[#0a1835] font-bold text-xs sm:text-sm tracking-wide uppercase shadow-lg hover:shadow-xl transition-all duration-200 active:scale-[0.98] text-center"
        >
          <span>{d.ctaQuote}</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
        </a>

        <a
          href={`tel:${d.phoneRaw}`}
          class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold text-xs sm:text-sm border border-white/20 transition-all duration-200 active:scale-[0.98] text-center"
        >
          <svg class="w-4 h-4 text-accent-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.942-6.942l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
          </svg>
          <span>{d.ctaCall}</span>
        </a>
      </div>

      <div class="flex items-center gap-2 text-xs text-slate-300">
        <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />
        </svg>
        <span>{d.guarantee}</span>
      </div>
    </div>
  </div>
</div>
