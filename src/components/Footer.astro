---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../i18n/utils';

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang as any);
const currentYear = new Date().getFullYear();

const homeUrl = getRelativeLocaleUrl(lang, '');
const aboutUrl = getRelativeLocaleUrl(lang, 'about');
const personalUrl = getRelativeLocaleUrl(lang, 'personal');
const commercialUrl = getRelativeLocaleUrl(lang, 'commercial');
const serviceUrl = getRelativeLocaleUrl(lang, 'service');
const payBillUrl = getRelativeLocaleUrl(lang, 'pay-bill');
const quoteUrl = getRelativeLocaleUrl(lang, 'quote');
---

<footer class="bg-zinc-950 text-zinc-400 border-t border-zinc-900 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
      <!-- Brand & Info -->
      <div class="space-y-4">
        <a href={homeUrl} class="flex items-center gap-3">
          <svg class="w-7 h-7 text-zinc-100" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2L4 5V11C4 16.5 8 21 12 22C16 21 20 16.5 20 11V5L12 2Z" fill="currentColor" stroke="currentColor" stroke-width="2"/>
            <path d="M12 6V18" stroke="var(--color-accent-gold)" stroke-width="2" stroke-linecap="round"/>
            <path d="M8 12H16" stroke="var(--color-accent-gold)" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <div class="flex flex-col">
            <span class="text-xs font-semibold tracking-tight text-zinc-100 leading-none">{t('header.title')}</span>
            <span class="text-[10px] font-light tracking-widest text-zinc-400">{t('header.subtitle')}</span>
          </div>
        </a>
        <p class="text-sm leading-relaxed">
          {t('footer.desc')}
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-sm font-semibold text-zinc-100 tracking-wider uppercase mb-4">{t('footer.links')}</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href={aboutUrl} class="hover:text-white transition-colors">{t('footer.about')}</a></li>
          <li><a href={personalUrl} class="hover:text-white transition-colors">{t('footer.personal')}</a></li>
          <li><a href={commercialUrl} class="hover:text-white transition-colors">{t('footer.commercial')}</a></li>
          <li><a href={serviceUrl} class="hover:text-white transition-colors">{t('footer.service')}</a></li>
          <li><a href={payBillUrl} class="hover:text-white transition-colors">{t('footer.payBill')}</a></li>
          <li><a href={quoteUrl} class="hover:text-white transition-colors">{t('footer.quote')}</a></li>
        </ul>
      </div>

      <!-- Insurance Solutions -->
      <div>
        <h3 class="text-sm font-semibold text-zinc-100 tracking-wider uppercase mb-4">{t('footer.solutions')}</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href={`${personalUrl}#home`} class="hover:text-white transition-colors">{t('footer.homeowners')}</a></li>
          <li><a href={`${personalUrl}#auto`} class="hover:text-white transition-colors">{t('footer.auto')}</a></li>
          <li><a href={`${personalUrl}#umbrella`} class="hover:text-white transition-colors">{t('footer.umbrella')}</a></li>
          <li><a href={`${commercialUrl}#gl`} class="hover:text-white transition-colors">{t('footer.gl')}</a></li>
          <li><a href={`${commercialUrl}#wc`} class="hover:text-white transition-colors">{t('footer.wc')}</a></li>
        </ul>
      </div>

      <!-- Contact & NAP -->
      <div>
        <h3 class="text-sm font-semibold text-zinc-100 tracking-wider uppercase mb-4">{t('footer.contact')}</h3>
        <ul class="space-y-3.5 text-sm font-light">
          <li class="flex items-start gap-2.5">
            <svg class="w-5 h-5 text-accent-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
            </svg>
            <span>
              <strong>{t('footer.hq')}</strong><br />
              50 Newtown Road, Suite 1<br />
              Danbury, CT 06810
            </span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-5 h-5 text-accent-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.802-5.14-4.117-6.942-6.942l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
            </svg>
            <a href="tel:2037489272" class="hover:text-white transition-colors">203 748 9272</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copy -->
    <div class="border-t border-zinc-900 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs">
      <p>Copyright &copy; {currentYear} Associated Insurance Agency. {t('footer.copyright')}</p>
      <div class="flex gap-6">
        <span class="hover:text-white transition-colors">Danbury</span>
        <span class="hover:text-white transition-colors">Watertown</span>
        <span class="hover:text-white transition-colors">Bridgeport</span>
      </div>
    </div>
  </div>
</footer>
