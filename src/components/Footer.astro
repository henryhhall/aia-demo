---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../i18n/utils';
import { Image } from 'astro:assets';
import aiaLogo from '../assets/aia-logo.webp';

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang as any);
const currentYear = new Date().getFullYear();

const homeUrl = getRelativeLocaleUrl(lang, '');
const aboutUrl = getRelativeLocaleUrl(lang, 'about');
const teamUrl = getRelativeLocaleUrl(lang, 'team');
const personalUrl = getRelativeLocaleUrl(lang, 'personal');
const commercialUrl = getRelativeLocaleUrl(lang, 'commercial');
const serviceUrl = getRelativeLocaleUrl(lang, 'service');
const payBillUrl = getRelativeLocaleUrl(lang, 'pay-bill');
const quoteUrl = getRelativeLocaleUrl(lang, 'quote');
const contactUrl = getRelativeLocaleUrl(lang, 'contact');
const termsUrl = getRelativeLocaleUrl(lang, 'terms');
const privacyUrl = getRelativeLocaleUrl(lang, 'privacy');
const sitemapUrl = getRelativeLocaleUrl(lang, 'sitemap');
const certificateUrl = getRelativeLocaleUrl(lang, 'certificate-request');
const homeownersUrl = getRelativeLocaleUrl(lang, 'personal/homeowners');
const personalAutoUrl = getRelativeLocaleUrl(lang, 'personal/auto');
const umbrellaUrl = getRelativeLocaleUrl(lang, 'personal/umbrella');
const rentersUrl = getRelativeLocaleUrl(lang, 'personal/renters');
const glUrl = getRelativeLocaleUrl(lang, 'commercial/general-liability');
const commercialAutoUrl = getRelativeLocaleUrl(lang, 'commercial/auto');
const wcUrl = getRelativeLocaleUrl(lang, 'commercial/workers-compensation');
const locationsUrl = getRelativeLocaleUrl(lang, 'locations');
const danburyUrl = getRelativeLocaleUrl(lang, 'locations/danbury');
const watertownUrl = getRelativeLocaleUrl(lang, 'locations/watertown');
const bridgeportUrl = getRelativeLocaleUrl(lang, 'locations/bridgeport');
---

<footer class="bg-zinc-950 text-zinc-400 border-t border-zinc-900 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
      <!-- Brand & Info -->
      <div class="space-y-4">
        <a href={homeUrl} class="flex items-center gap-3">
          <!-- AIA Brand Logo -->
          <Image
            src={aiaLogo}
            alt={`${t('header.title')} ${t('header.subtitle')}`}
            class="h-12 w-auto object-contain"
            loading="lazy"
          />
          <div class="flex flex-col">
            <span class="text-xs sm:text-sm font-semibold tracking-tight text-zinc-100 leading-none">{t('header.title')}</span>
            <span class="text-[10px] sm:text-xs font-light tracking-widest text-zinc-400">{t('header.subtitle')}</span>
          </div>
        </a>
        <p class="text-sm leading-relaxed">
          {t('footer.desc')}
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-sm font-semibold text-zinc-100 tracking-wider uppercase mb-4">{t('footer.links')}</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href={aboutUrl} class="hover:text-white transition-colors">{t('footer.about')}</a></li>
          <li><a href={teamUrl} class="hover:text-white transition-colors">{t('footer.team')}</a></li>
          <li><a href={locationsUrl} class="hover:text-white transition-colors text-accent-gold/90 font-medium">{t('nav.locations')}</a></li>
          <li><a href={personalUrl} class="hover:text-white transition-colors">{t('footer.personal')}</a></li>
          <li><a href={commercialUrl} class="hover:text-white transition-colors">{t('footer.commercial')}</a></li>
          <li><a href={serviceUrl} class="hover:text-white transition-colors">{t('footer.service')}</a></li>
          <li><a href={payBillUrl} class="hover:text-white transition-colors">{t('footer.payBill')}</a></li>
          <li><a href={quoteUrl} class="hover:text-white transition-colors">{t('footer.quote')}</a></li>
          <li><a href={contactUrl} class="hover:text-white transition-colors">{t('footer.contactLink')}</a></li>
          <li><a href={certificateUrl} class="hover:text-white transition-colors text-accent-gold/90">{t('footer.certificateRequest')}</a></li>
          <li><a href={termsUrl} class="hover:text-white transition-colors">{t('footer.terms')}</a></li>
          <li><a href={privacyUrl} class="hover:text-white transition-colors">{t('footer.privacy')}</a></li>
          <li><a href={sitemapUrl} class="hover:text-white transition-colors">{t('footer.sitemap')}</a></li>
        </ul>
      </div>

      <!-- Insurance Solutions -->
      <div>
        <h3 class="text-sm font-semibold text-zinc-100 tracking-wider uppercase mb-4">{t('footer.solutions')}</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href={homeownersUrl} class="hover:text-white transition-colors">{t('footer.homeowners')}</a></li>
          <li><a href={personalAutoUrl} class="hover:text-white transition-colors">{t('footer.auto')}</a></li>
          <li><a href={umbrellaUrl} class="hover:text-white transition-colors">{t('footer.umbrella')}</a></li>
          <li><a href={rentersUrl} class="hover:text-white transition-colors">{t('footer.renters')}</a></li>
          <li><a href={glUrl} class="hover:text-white transition-colors">{t('footer.gl')}</a></li>
          <li><a href={commercialAutoUrl} class="hover:text-white transition-colors">{t('footer.commercialAuto')}</a></li>
          <li><a href={wcUrl} class="hover:text-white transition-colors">{t('footer.wc')}</a></li>
          <li><a href={certificateUrl} class="hover:text-white transition-colors font-medium text-accent-gold/90">{t('footer.certificate')}</a></li>
        </ul>
      </div>

      <!-- Contact & Office Locations -->
      <div>
        <h3 class="text-sm font-semibold text-zinc-100 tracking-wider uppercase mb-4 flex items-center justify-between">
          <span>{t('footer.locations')}</span>
          <a href={locationsUrl} class="text-[11px] text-accent-gold/90 hover:text-accent-gold font-normal">View All →</a>
        </h3>
        <ul class="space-y-3.5 text-xs font-light">
          <!-- Danbury HQ -->
          <li class="border-b border-zinc-900 pb-2.5">
            <a href={danburyUrl} class="font-semibold text-zinc-200 hover:text-accent-gold transition-colors block text-sm">
              Danbury HQ
            </a>
            <span class="text-zinc-400">50 Newtown Rd, Suite 1</span><br />
            <a href="tel:2037489272" class="text-accent-gold hover:text-white transition-colors font-mono">(203) 748-9272</a>
          </li>
          <!-- Watertown -->
          <li class="border-b border-zinc-900 pb-2.5">
            <a href={watertownUrl} class="font-semibold text-zinc-200 hover:text-accent-gold transition-colors block text-sm">
              Watertown Branch
            </a>
            <span class="text-zinc-400">51 Depot St, Ste 112</span><br />
            <a href="tel:2037489272" class="text-accent-gold hover:text-white transition-colors font-mono">(203) 748-9272</a>
          </li>
          <!-- Bridgeport -->
          <li>
            <a href={bridgeportUrl} class="font-semibold text-zinc-200 hover:text-accent-gold transition-colors block text-sm">
              Bridgeport Branch
            </a>
            <span class="text-zinc-400">2465 Main Street</span><br />
            <a href="tel:2037489272" class="text-accent-gold hover:text-white transition-colors font-mono">(203) 748-9272</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Legal Disclaimer -->
    <div class="border-t border-zinc-900 pt-8 pb-6">
      <p class="text-sm sm:text-base text-zinc-200 font-medium text-center max-w-4xl mx-auto leading-relaxed">
        {t('footer.disclaimer')}
      </p>
    </div>

    <!-- Bottom Copy -->
    <div class="border-t border-zinc-900/60 pt-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs">
      <div class="flex items-center gap-3">
        <p>Copyright &copy; {currentYear} Associated Insurance Agency. {t('footer.copyright')}</p>
      </div>
      <div class="flex flex-wrap items-center gap-4 text-[11px]">
        <a href={privacyUrl} class="text-zinc-400 hover:text-white transition-colors">
          {t('footer.privacy')}
        </a>
        <span class="text-zinc-700">•</span>
        <a href={termsUrl} class="text-zinc-400 hover:text-white transition-colors">
          {t('footer.terms')}
        </a>
        <span class="text-zinc-700">•</span>
        <a href={sitemapUrl} class="text-zinc-400 hover:text-white transition-colors">
          {t('footer.sitemap')}
        </a>
        <span class="text-zinc-700">•</span>
        <a href={certificateUrl} class="text-zinc-400 hover:text-white transition-colors">
          {t('footer.certificate')}
        </a>
        <span class="text-zinc-700">•</span>
        <a href="/sitemap-index.xml" target="_blank" class="text-accent-gold/80 hover:text-accent-gold transition-colors font-mono">
          XML Sitemap
        </a>
        <span class="text-zinc-700">•</span>
        <a href="/llms.txt" class="text-accent-gold/80 hover:text-accent-gold transition-colors font-mono">
          /llms.txt (AI Context)
        </a>
        <span class="text-zinc-700">•</span>
        <a href="/api/mcp" class="text-accent-gold/80 hover:text-accent-gold transition-colors font-mono">
          /api/mcp (WebMCP)
        </a>
        <span class="text-zinc-700">•</span>
        <a href="/.well-known/security.txt" class="text-accent-gold/80 hover:text-accent-gold transition-colors font-mono">
          security.txt
        </a>
        <span class="text-zinc-700">•</span>
        <span class="text-zinc-400">
          <a href={danburyUrl} class="hover:text-white transition-colors">Danbury HQ</a> • 
          <a href={watertownUrl} class="hover:text-white transition-colors">Watertown</a> • 
          <a href={bridgeportUrl} class="hover:text-white transition-colors">Bridgeport</a>
        </span>
      </div>
    </div>

    <!-- Powered By Attribution -->
    <div class="mt-3 flex justify-center sm:justify-end">
      <p class="text-[11px] text-zinc-500 hover:text-zinc-400 transition-colors">
        {t('footer.poweredBy')}
      </p>
    </div>
  </div>
</footer>
