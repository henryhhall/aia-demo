        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 41.4087,
          "longitude": -73.4285
        },
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
            "opens": "08:30",
            "closes": "17:00"
          }
        ],
        "knowsLanguage": ["en", "es", "pt", "tr"]
      },
      {
        "@type": "InsuranceAgency",
        "@id": "https://aia-danbury.com/#watertown",
        "name": "Associated Insurance Agency - Watertown Branch",
