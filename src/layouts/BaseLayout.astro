        "availableLanguage": ["English", "Spanish", "Portuguese"]
      },
      {
        "@type": "ContactPoint",
        "telephone": "+1-203-333-8880",
        "contactType": "customer service",
        "areaServed": "US-CT",
        "availableLanguage": ["English", "Spanish", "Portuguese"]
      }
    ]
  }
];

// Merge page-specific structured data into the Schema.org graph
const pageGraphItems: any[] = [];
if (props.structuredData) {
  if (Array.isArray((props.structuredData as any)['@graph'])) {
    pageGraphItems.push(...(props.structuredData as any)['@graph']);
  } else if (Array.isArray(props.structuredData)) {
    pageGraphItems.push(...props.structuredData);
  } else {
    pageGraphItems.push(props.structuredData);
  }
}

const mergedStructuredData = {
  "@context": "https://schema.org",
  "@graph": [...baseAgencyGraph, ...pageGraphItems]
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <SEOHead {...props} structuredData={mergedStructuredData} />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@100..900&family=Geist:wght@100..900&display=swap" rel="stylesheet">
    <script src="../lib/webmcp/init.ts"></script>
  </head>
  <body class="min-h-[100dvh] flex flex-col bg-bg-primary text-text-primary">
    <Header lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <!-- WebMCP Client Inspector & Agent Sandbox -->
    <WebMcpInspector client:load />
  </body>
</html>

