---
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WebMcpInspector from '../components/WebMcpInspector';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  canonicalUrl?: string;
  author?: string;
  publishDate?: string;
  modifiedDate?: string;
  tags?: string[];
  structuredData?: object;
  lang?: string;
}

const props = Astro.props;
const lang = props.lang || Astro.currentLocale || 'en';

// Default structured data for Associated Insurance Agency (AIA) - Multi-Location Graph
const baseAgencyGraph = [
