# ==============================================================================
# Associated Insurance Agency (AIA) - Environment Variables Configuration
# ==============================================================================

# Google reCAPTCHA v3 Keys
# Public site key exposed to the client browser (must start with PUBLIC_)
# Replace with your actual site key from https://www.google.com/recaptcha/admin
PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

# Private reCAPTCHA secret key (kept private on server, never exposed in client bundles)
# Replace with your actual secret key from https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# ==============================================================================
# Resend Email Configuration (Quote Form & Staged Lead Dispatch)
# ==============================================================================
# 1. Sign up for free at https://resend.com
# 2. Create an API Key at https://resend.com/api-keys
# 3. Add your key below:
RESEND_API_KEY=re_your_api_key_here

# The sender address shown to recipients:
# - Development / Sandbox: Associated Insurance Agency <onboarding@resend.dev>
# - Production (verified domain): Associated Insurance Agency <quotes@aia-danbury.com>
RESEND_FROM_EMAIL=Associated Insurance Agency <onboarding@resend.dev>

# Agency notification recipient:
# - Production: Automatically defaults to ron@aia-danbury.com without needing any variable set.
# - Sandbox Testing (with onboarding@resend.dev): Defaults to delivered@resend.dev (Resend test sink)
#   or your personal registered Resend email (set via RESEND_TEST_RECIPIENT).
# (Optional overrides):
# QUOTE_NOTIFICATION_EMAIL=ron@aia-danbury.com
# RESEND_TEST_RECIPIENT=your-resend-account-email@example.com

# ==============================================================================
# Email Branding Configuration
# ==============================================================================
# Absolute URL to the official AIA logo image used in transactional emails.
# Defaults to the GitHub-hosted production asset:
# https://raw.githubusercontent.com/henryhhall/aia-demo/main/public/images/logo.png
# Once deployed to your custom domain, you can optionally override with:
# AIA_LOGO_URL=https://aia-danbury.com/images/logo.png


